<Window x:Class="IBTM.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:MainViewModel, IsDesignTimeCreatable=False}"
    Title="IBTM"
    Width="1920"
    Height="1080"
    Icon="{StaticResource AppIcon}"
    ResizeMode="CanResize"
    WindowState="Maximized"
    FontSize="14" WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Background="{StaticResource AppBgBrush}"
    Validation.ErrorTemplate="{x:Null}">
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClosing}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <ui:SignalTextConverter x:Key="SignalText"/>
        <DataTemplate DataType="{x:Type ui:OperationViewModel}">
            <ui:OperationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:TeachingViewModel}">
            <ui:TeachingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:InspectionTeachingViewModel}">
            <ui:InspectionTeachingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:SettingsViewModel}">
            <ui:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:ManualHardwareViewModel}">
            <ui:ManualHardwareView/>
        </DataTemplate>
        <Style x:Key="SidebarToolButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="8,6,8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="NotificationTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusMessageStyle}">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="TowerLampLensStyle" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource EquipBgBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>False</sys:Boolean></Trigger.Value>
                    <Setter Property="Opacity" Value="0.25"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderThickness="0,0,1,0"
            BorderBrush="{StaticResource DividerBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20,20,20,16" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="IBTM" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,8">
                    <Button Content="{Binding Source={x:Static ui:AppPage.Operation}, Converter={StaticResource UiTextConverter}}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static ui:AppPage.Operation}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static ui:AppPage.Operation}">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{ui:Text 'Inspection'}" Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static ui:AppPage.Inspection}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static ui:AppPage.Inspection}">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,8">
                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="12,0,12,8"/>
                    <Button Content="{Binding Source={x:Static ui:AppPage.ManualHardware}, Converter={StaticResource UiTextConverter}}"
                        IsEnabled="{Binding IsMaintenanceAccessAllowed}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static ui:AppPage.ManualHardware}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static ui:AppPage.ManualHardware}">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{Binding Source={x:Static ui:AppPage.Teaching}, Converter={StaticResource UiTextConverter}}"
                        IsEnabled="{Binding IsMaintenanceAccessAllowed}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static ui:AppPage.Teaching}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static ui:AppPage.Teaching}">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{Binding Source={x:Static ui:AppPage.Settings}, Converter={StaticResource UiTextConverter}}"
                        IsEnabled="{Binding IsMaintenanceAccessAllowed}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static ui:AppPage.Settings}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static ui:AppPage.Settings}">
                                        <Setter Property="Tag" Value="Selected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="12,8,12,0"/>
                    <Button Content="{ui:Text 'INPUTS'}" Margin="8,8,8,0" Style="{StaticResource SidebarToolButtonStyle}" Command="{Binding OpenInputsCommand}"/>

                    <Button Content="{ui:Text 'OUTPUTS'}" Style="{StaticResource SidebarToolButtonStyle}"
                        Command="{Binding OpenOutputsCommand}" IsEnabled="{Binding IsMaintenanceAccessAllowed}"/>

                    <Button Content="{ui:Text 'MOTION'}" Style="{StaticResource SidebarToolButtonStyle}"
                        Command="{Binding OpenMotionCommand}" IsEnabled="{Binding IsMaintenanceAccessAllowed}"/>

                    <Button Content="{ui:Text 'ADC TEST'}" Style="{StaticResource SidebarToolButtonStyle}"
                        Command="{Binding OpenAdcProtocolCommand}" IsEnabled="{Binding IsMaintenanceAccessAllowed}"/>
                    <Button Content="{ui:Text 'LOGS'}" Style="{StaticResource SidebarToolButtonStyle}" Command="{Binding OpenLogsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="338"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Width="20" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border Tag="{Binding Operation.Signals.Outputs[TowerLampRed].IsOn}"
                                ToolTip="{Binding Operation.Signals.Outputs[TowerLampRed].IsOn, Converter={StaticResource SignalText}}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TowerLampLensStyle}">
                                        <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Tag="{Binding Operation.Signals.Outputs[TowerLampYellow].IsOn}"
                                ToolTip="{Binding Operation.Signals.Outputs[TowerLampYellow].IsOn, Converter={StaticResource SignalText}}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TowerLampLensStyle}">
                                        <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Tag="{Binding Operation.Signals.Outputs[TowerLampGreen].IsOn}"
                                ToolTip="{Binding Operation.Signals.Outputs[TowerLampGreen].IsOn, Converter={StaticResource SignalText}}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TowerLampLensStyle}">
                                        <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Width="3" Height="5" Background="{StaticResource TextMutedBrush}"/>
                            <Border Width="14" Height="3" CornerRadius="1" Background="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <Border Tag="{Binding Operation.MachineDisplayState}" Style="{StaticResource MachineStateBadgeStyle}"
                            Width="160" BorderThickness="0" VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding Operation.MachineDisplayState,
                                                     Converter={StaticResource UiTextConverter}}"
                                Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" ToolTip="{Binding Operation.MachineDisplayState, Converter={StaticResource UiTextConverter}}"/>
                        </Border>
                        <TextBlock
                            Text="{Binding Operation.Alarm,
                                                  Converter={StaticResource UiTextConverter}}"
                            ToolTip="{Binding Operation.AlarmDetail}"
                            Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource AccentRedBrush}" FontSize="16"
                            FontWeight="SemiBold" Width="140" MaxHeight="48" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                            Visibility="{Binding Operation.HasAlarm,
                                                        Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="90" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StateBadgeStyle}">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Operation.State.AutoMode}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Operation.State.Available}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                            <Setter Property="ToolTip" Value="{ui:Text 'Mode feedback unavailable'}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Operation.ModeText}"
                                FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AppBgBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Operation.State.Available}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource StateBadgeStyle}" Margin="8,0,0,0" BorderBrush="{StaticResource AccentAmberBrush}"
                            Visibility="{Binding Operation.SafetyBypass,
                                                     Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{ui:Text 'SAFETY BYPASS'}" Foreground="{StaticResource AccentAmberBrush}" FontSize="11"
                                FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{ui:Text 'RECIPE'}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Grid Width="240" IsEnabled="{Binding RecipeEditingEnabled}" ToolTip="{Binding RecipeEditor.ActiveName}">
                            <ComboBox ItemsSource="{Binding RecipeEditor.Recipes}" AutomationProperties.Name="{ui:Text 'Change recipe'}"
                                SelectedItem="{Binding SelectedRecipeName, Mode=TwoWay}"/>
                            <TextBlock Text="{Binding RecipeEditor.ActiveName}" Margin="10,0,28,0" VerticalAlignment="Center"
                                Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRecipeName}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <WrapPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right"
                        Visibility="{Binding Operation.State.Available, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse Tag="{Binding Operation.State.ServoPowerOn}" Style="{StaticResource SetupLedStyle}"/>
                            <TextBlock Tag="{Binding Operation.State.ServoPowerOn}" Style="{StaticResource ServoStatusTextStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse Tag="{Binding Operation.State.FeedbackReadiness.Homed}" Style="{StaticResource SetupLedStyle}"/>
                            <TextBlock Tag="{Binding Operation.State.FeedbackReadiness.Homed}" Style="{StaticResource HomeStatusTextStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse Tag="{Binding Operation.State.EmergencyStopReleased}" Style="{StaticResource SafetyLedStyle}"/>
                            <TextBlock Tag="{Binding Operation.State.EmergencyStopReleased}" Style="{StaticResource EmergencyStopStatusTextStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse Tag="{Binding Operation.State.DoorClosed}" Style="{StaticResource SafetyLedStyle}"/>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IndicatorTextStyle}">
                                        <Setter Property="Text" Value="{ui:Text 'DOORS OPEN'}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Operation.State.DoorClosed}" Value="True">
                                                <Setter Property="Text" Value="{ui:Text 'DOORS CLOSED'}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Tag="{Binding Operation.State.AirPressureOk}" Style="{StaticResource SafetyLedStyle}"/>
                            <TextBlock Tag="{Binding Operation.State.AirPressureOk}" Style="{StaticResource AirPressureStatusTextStyle}"/>
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" IsEnabled="{Binding CurrentPageEnabled}">
                <ContentPresenter Content="{Binding CurrentPage}"/>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="18,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{ui:Text 'Messages'}" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                        VerticalAlignment="Center"/>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{Binding Operation.AlarmMessage}" ToolTip="{Binding Operation.AlarmDetail}"
                                Style="{StaticResource NotificationTextStyle}" Foreground="{StaticResource AccentRedBrush}"/>
                            <TextBlock Text="{Binding Operation.ResetError}"
                                Style="{StaticResource NotificationTextStyle}" Foreground="{StaticResource AccentRedBrush}"/>
                            <TextBlock Text="{Binding NavigationError}"
                                Style="{StaticResource NotificationTextStyle}" Foreground="{StaticResource AccentRedBrush}"/>
                            <TextBlock Text="{Binding RecipeEditor.Error}"
                                Style="{StaticResource NotificationTextStyle}" Foreground="{StaticResource AccentRedBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedPage}" Value="{x:Static ui:AppPage.Operation}"/>
                                            <Condition Binding="{Binding Operation.StartBlocked}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{StaticResource AccentAmberBrush}"/>
                        <TextBlock
                            Text="{Binding Operation.StartBlock,
                                                  Converter={StaticResource UiTextConverter}}"
                            VerticalAlignment="Center" Foreground="{StaticResource AccentAmberBrush}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Static ui:AppPage.Operation}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="{ui:Text 'START'}"
                                Command="{Binding Operation.StartCommand}"
                                MinWidth="144" Height="48" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Operation.State.IsRunning}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Operation.MachineDisplayState}"
                                                        Value="{x:Static ui:MachineDisplayState.Ready}"/>
                                                    <Condition Binding="{Binding Operation.StartBlocked}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <Button
                            Command="{Binding Operation.ResetCommand}" IsEnabled="{Binding Operation.IsResetAllowed}"
                            ToolTip="{ui:Text 'Silence buzzer / recover stopped hardware; servos may turn ON.'}"
                            ToolTipService.ShowOnDisabled="True" MinWidth="120" Height="48" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Content" Value="{ui:Text 'RESET'}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Operation.ResetCommand.IsRunning}" Value="True">
                                            <Setter Property="Content" Value="{ui:Text 'RESETTING...'}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{ui:Text 'STOP'}" Command="{Binding Operation.StopCommand}" MinWidth="144" Height="48">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Operation.MachineDisplayState}"
                                            Value="{x:Static ui:MachineDisplayState.Running}">
                                            <Setter Property="Background" Value="{StaticResource AttentionBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Operation.State.IsHoming}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AttentionBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
