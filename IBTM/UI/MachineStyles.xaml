<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core">

    <SolidColorBrush x:Key="MaterialPcbBrush" Color="#6FA67D"/>
    <SolidColorBrush x:Key="MaterialIpmBrush" Color="#89929A"/>
    <SolidColorBrush x:Key="CarrierBrush" Color="#668BA4"/>
    <SolidColorBrush x:Key="HeatSinkBrush" Color="#A98D5C"/>

    <sys:Double x:Key="PcbWidth">60</sys:Double>
    <sys:Double x:Key="PcbHeight">48</sys:Double>
    <sys:Double x:Key="PcbSlotWidth">68</sys:Double>
    <sys:Double x:Key="PcbSlotHeight">56</sys:Double>
    <sys:Double x:Key="CarrierJigWidth">268</sys:Double>
    <sys:Double x:Key="CarrierJigHeight">84</sys:Double>
    <sys:Double x:Key="BackupPlateWidth">284</sys:Double>
    <sys:Double x:Key="BackupPlateHeight">100</sys:Double>

    <GeometryGroup x:Key="BackupPlatePinGeometry">
        <EllipseGeometry Center="5,5" RadiusX="3" RadiusY="3"/>
        <EllipseGeometry Center="279,5" RadiusX="3" RadiusY="3"/>
        <EllipseGeometry Center="5,95" RadiusX="3" RadiusY="3"/>
        <EllipseGeometry Center="279,95" RadiusX="3" RadiusY="3"/>
    </GeometryGroup>

    <DrawingBrush x:Key="BackupPlateBrush"
                  Viewbox="0,0,284,100"
                  ViewboxUnits="Absolute"
                  Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#202832"
                                 Geometry="M0,0 H284 V100 H0 Z"/>
                <GeometryDrawing Brush="{StaticResource EquipBgBrush}"
                                 Geometry="{StaticResource BackupPlatePinGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource TextMutedBrush}"
                             Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="MapLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="MapHintStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MapLabelStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="EquipmentRoleLabelStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MapHintStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="HeatSinkPocketLabelStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MapHintStyle}">
        <Setter Property="Margin" Value="4,3,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Panel.ZIndex" Value="3"/>
    </Style>

    <Style x:Key="SafetyTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MapLabelStyle}">
        <Setter Property="Margin" Value="7,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="StatusLedStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ReadinessLedStyle"
           TargetType="Ellipse"
           BasedOn="{StaticResource StatusLedStyle}">
        <Setter Property="Fill" Value="{StaticResource AccentAmberBrush}"/>
    </Style>

    <Style x:Key="ReadyLedStyle"
           TargetType="Ellipse"
           BasedOn="{StaticResource StatusLedStyle}">
        <Setter Property="Fill" Value="{StaticResource DividerBrush}"/>
    </Style>

    <Style x:Key="StateTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MapHintStyle}">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="ResultTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MapHintStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static core:PcbResult.Ok}">
                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static core:PcbResult.Ng}">
                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StateBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="6,1,1,1"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <Style x:Key="MachineStateBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource StateBadgeStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.Ready}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.HomeRequired}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.ServoOff}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.Running}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.Homing}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.MotionFault}">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.SafetyStop}">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.Alarm}">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HandlerStateBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource StateBadgeStyle}">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="10,7"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:HandlerDisplayState.Disabled}">
                <Setter Property="Opacity" Value="0.65"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:HandlerDisplayState.CarrierAvailable}">
                <Setter Property="Background" Value="#1C2C25"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:HandlerDisplayState.PcbDetected}">
                <Setter Property="Background" Value="#1C2C25"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:HandlerDisplayState.PcbAvailable}">
                <Setter Property="Background" Value="#1C2C25"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:HandlerDisplayState.Moving}">
                <Setter Property="Background" Value="#1B2934"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:HandlerDisplayState.IoAlarm}">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StationStateBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource StateBadgeStyle}">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="10,7"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:StationDisplayState.Disabled}">
                <Setter Property="Opacity" Value="0.65"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:StationDisplayState.HeatSinkDetected}">
                <Setter Property="Background" Value="#1C2C25"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:StationDisplayState.Working}">
                <Setter Property="Background" Value="#1B2934"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:StationDisplayState.CarrierOk}">
                <Setter Property="Background" Value="#1C2C25"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:StationDisplayState.CarrierNg}">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:StationDisplayState.IoAlarm}">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryStateTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StateTextStyle}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DeviceBodyStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="3"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OverheadBodyStyle"
           TargetType="Border"
           BasedOn="{StaticResource DeviceBodyStyle}">
        <Setter Property="Background" Value="#A6202832"/>
    </Style>

    <Style x:Key="HeatSinkPocketStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Background" Value="#42351F"/>
                <Setter Property="BorderBrush" Value="{StaticResource HeatSinkBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CarrierJigStyle" TargetType="ContentControl">
        <Setter Property="Width" Value="{StaticResource CarrierJigWidth}"/>
        <Setter Property="Height" Value="{StaticResource CarrierJigHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="#263A46"
                            BorderBrush="{StaticResource CarrierBrush}"
                            BorderThickness="2"
                            CornerRadius="2">
                        <Grid>
                            <Grid Margin="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="9"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource HeatSinkPocketStyle}"/>
                                <Border Grid.Column="2"
                                        Style="{StaticResource HeatSinkPocketStyle}"/>
                            </Grid>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolHeadFootprintStyle" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HeatSinkBrush}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="CornerRadius" Value="17"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Background" Value="#1B2934"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="4"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoadedBoltVisualStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="Stroke" Value="#D9E6FA"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <Style x:Key="ActiveToolNumberStyle" TargetType="TextBlock">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="WorkTargetStyle" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="#26313A"/>
        <Setter Property="BorderBrush" Value="#71808D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:WorkTargetState.Active}">
                <Setter Property="Background" Value="#1C3D61"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:WorkTargetState.Ok}">
                <Setter Property="Background" Value="#244C32"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:WorkTargetState.Ng}">
                <Setter Property="Background" Value="#542529"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PcbLandingTargetStyle" TargetType="Border">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Background" Value="#18222A"/>
        <Setter Property="BorderBrush" Value="#61717E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <Style x:Key="DownFootprintStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlacementBodyStyle"
           TargetType="Border"
           BasedOn="{StaticResource OverheadBodyStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding PcbPlacementHandlerDown}"
                         Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PcbFootprintStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource PcbWidth}"/>
        <Setter Property="Height" Value="{StaticResource PcbHeight}"/>
        <Setter Property="Background" Value="{StaticResource MaterialPcbBrush}"/>
        <Setter Property="BorderBrush" Value="#476B52"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="1"/>
    </Style>

    <Style x:Key="UnknownPcbFootprintStyle"
           TargetType="Border"
           BasedOn="{StaticResource PcbFootprintStyle}">
        <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="PcbSlotStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource PcbSlotWidth}"/>
        <Setter Property="Height" Value="{StaticResource PcbSlotHeight}"/>
        <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <Style x:Key="LeftGripperJawStyle" TargetType="Border">
        <Setter Property="Width" Value="4"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="5,0,0,4"/>
        <Setter Property="Background" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Margin" Value="11,0,0,4"/>
                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RightGripperJawStyle"
           TargetType="Border"
           BasedOn="{StaticResource LeftGripperJawStyle}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,0,5,4"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Margin" Value="0,0,11,4"/>
                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BackupPlateVisualStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource BackupPlateWidth}"/>
        <Setter Property="Height" Value="{StaticResource BackupPlateHeight}"/>
        <Setter Property="Background" Value="{StaticResource BackupPlateBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StopperVisualStyle" TargetType="Border">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Opacity" Value="0.3"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
                <Setter Property="BorderBrush" Value="#FFF0C4"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConveyorBedStyle" TargetType="Border">
        <Setter Property="Background" Value="#222C35"/>
        <Setter Property="BorderBrush" Value="#667886"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BufferStyle"
           TargetType="Border"
           BasedOn="{StaticResource DeviceBodyStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding BufferConflict}" Value="True">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
