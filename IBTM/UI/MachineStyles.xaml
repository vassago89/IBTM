<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:IBTM.UI">

    <SolidColorBrush x:Key="MaterialPcbBrush" Color="#63D58D"/>
    <SolidColorBrush x:Key="CarrierJigBrush" Color="#67A8D8"/>
    <SolidColorBrush x:Key="HousingBrush" Color="#D7AD61"/>

    <Style x:Key="MapLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="MapHintStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MapLabelStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="SafetyTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MapLabelStyle}">
        <Setter Property="Margin" Value="7,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatusLedStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StateTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MapHintStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="StateBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="Background" Value="#12171D"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style x:Key="MachineStateBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource StateBadgeStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.Ready}">
                <Setter Property="Background" Value="#172A1E"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.ManualMode}">
                <Setter Property="Background" Value="#2A2416"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.HomeRequired}">
                <Setter Property="Background" Value="#2A2416"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.ServoOff}">
                <Setter Property="Background" Value="#2A2416"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.Running}">
                <Setter Property="Background" Value="#172238"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.Homing}">
                <Setter Property="Background" Value="#172238"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.MotionFault}">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:MachineDisplayState.Alarm}">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HandlerStateBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource StateBadgeStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:HandlerDisplayState.CarrierAvailable}">
                <Setter Property="Background" Value="#172A1E"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:HandlerDisplayState.PcbDetected}">
                <Setter Property="Background" Value="#172238"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:HandlerDisplayState.Moving}">
                <Setter Property="Background" Value="#172238"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:HandlerDisplayState.IoAlarm}">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StationStateBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource StateBadgeStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:StationDisplayState.HousingDetected}">
                <Setter Property="Background" Value="#172A1E"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:StationDisplayState.Working}">
                <Setter Property="Background" Value="#172238"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:StationDisplayState.CarrierOk}">
                <Setter Property="Background" Value="#172A1E"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:StationDisplayState.CarrierNg}">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:StationDisplayState.IoAlarm}">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CellStyle" TargetType="Border">
        <Setter Property="Background" Value="#090C10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="DeviceBodyStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Background" Value="#172238"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StageBodyStyle"
           TargetType="Border"
           BasedOn="{StaticResource DeviceBodyStyle}">
        <Setter Property="CornerRadius" Value="3"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Background" Value="#20394D"/>
                <Setter Property="BorderBrush" Value="{StaticResource CarrierJigBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HousingPocketStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Background" Value="#42351F"/>
                <Setter Property="BorderBrush" Value="{StaticResource HousingBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolHeadVisualStyle" TargetType="Border">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background" Value="{StaticResource HousingBrush}"/>
        <Setter Property="CornerRadius" Value="3,3,1,1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Height" Value="48"/>
                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LeftGripperJawStyle" TargetType="Border">
        <Setter Property="Width" Value="4"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="Background" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Margin" Value="11,0,0,0"/>
                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RightGripperJawStyle"
           TargetType="Border"
           BasedOn="{StaticResource LeftGripperJawStyle}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Margin" Value="0,0,11,0"/>
                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BackupPlateVisualStyle" TargetType="Border">
        <Setter Property="Background" Value="#0D1116"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Opacity" Value="0.45"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Background" Value="#172A1E"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StopperVisualStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Fill" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="Stroke" Value="{StaticResource DividerBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Fill" Value="{StaticResource AccentAmberBrush}"/>
                <Setter Property="Stroke" Value="#FFF0C4"/>
                <Setter Property="StrokeThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConveyorBedStyle" TargetType="Border">
        <Setter Property="Background" Value="#0D1116"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ConveyorRunning}" Value="True">
                <Setter Property="Background" Value="#122019"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BufferStyle"
           TargetType="Border"
           BasedOn="{StaticResource StageBodyStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding PcbBufferPcbPresent}" Value="True">
                <Setter Property="Background" Value="#244C32"/>
                <Setter Property="BorderBrush" Value="{StaticResource MaterialPcbBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding BufferConflict}" Value="True">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
