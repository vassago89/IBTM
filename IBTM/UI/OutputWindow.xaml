<Window x:Class="IBTM.UI.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:IBTM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ui:OutputWindow, IsDesignTimeCreatable=False}"
        Title="Digital Outputs"
        Width="1040"
        Height="720"
        MinWidth="900"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Digital Outputs"
                       Style="{StaticResource TitleStyle}"/>
            <Button Content="Refresh"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,5"
                    Click="OnRefresh"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="DO is a command. The green indicator is the mapped digital input."
                   Style="{StaticResource PageSubtitleStyle}"
                   Margin="0,4,0,18"/>

        <Grid Grid.Row="2"
              Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="OUTPUT" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="1" Text="OUTPUT STATE" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="2" Text="FEEDBACK INPUT / EXPECTED" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="3" Text="ACTUAL" Style="{StaticResource SectionHeaderStyle}"/>
        </Grid>

        <ListBox x:Name="OutputList"
                 Grid.Row="3"
                 ItemsSource="{Binding Rows}"
                 Style="{StaticResource IoListStyle}"
                 ItemContainerStyle="{StaticResource IoListItemStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="270"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Output, Converter={StaticResource EnumDescriptionConverter}}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <ContentControl Grid.Column="1"
                                        Tag="{Binding OutputOn}"
                                        Style="{StaticResource IoOutputStateStyle}"/>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding FeedbackInput, Converter={StaticResource EnumDescriptionConverter}}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}">
                            <Ellipse Tag="{Binding InputOn}"
                                     Style="{StaticResource IoInputLedStyle}"/>
                            <TextBlock Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Waiting"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InputOn}" Value="True">
                                                <Setter Property="Text" Value="Matched"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TimedOut}" Value="True">
                                                <Setter Property="Text" Value="Timeout"/>
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource AccentRedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="4"
                                Content="Toggle"
                                Style="{StaticResource IoToggleButtonStyle}"
                                Click="OnToggleOutput"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Window>
