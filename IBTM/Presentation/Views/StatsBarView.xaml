<UserControl x:Class="IBTM.Presentation.Views.StatsBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource BarPanelStyle}">
        <Grid Margin="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Margin="0,0,9,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#2D333B"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="PROCESS" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Height="24" VerticalAlignment="Center"
                       Fill="{StaticResource DividerBrush}" Margin="18,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                <TextBlock Text="TOTAL" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding TotalCount, StringFormat='{}{0:N0}'}" Style="{StaticResource StatValueStyle}" FontSize="18"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                <TextBlock Text="GOOD" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding GoodCount, StringFormat='{}{0:N0}'}" Style="{StaticResource StatValueStyle}" FontSize="18" Foreground="{StaticResource AccentGreenBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                <TextBlock Text="NG" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding NgCount, StringFormat='{}{0:N0}'}" Style="{StaticResource StatValueStyle}" FontSize="18" Foreground="{StaticResource AccentRedBrush}"/>
            </StackPanel>

            <Rectangle Grid.Column="5" Width="1" Height="24" VerticalAlignment="Center"
                       Fill="{StaticResource DividerBrush}" Margin="0,0,18,0"/>

            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                <TextBlock Text="NG%" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding NgRate, StringFormat='{}{0:F2}%'}" Style="{StaticResource StatValueStyle}" FontSize="15"/>
            </StackPanel>
            <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CT" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding LastCycleTime, StringFormat='{}{0:F1}s'}" Style="{StaticResource StatValueStyle}" FontSize="15"/>
            </StackPanel>

            <TextBlock Grid.Column="9" Text="{Binding StatusMessage}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11" FontWeight="SemiBold"/>
        </Grid>
    </Border>
</UserControl>
