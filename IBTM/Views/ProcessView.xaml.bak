<UserControl x:Class="IBTM.Views.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IBTM.ViewModels"
             xmlns:models="clr-namespace:IBTM.Models"
             xmlns:conv="clr-namespace:IBTM.Converters"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <conv:StageStatusToBrushConverter      x:Key="StatusToBrush"/>
        <conv:StageStatusToBackgroundConverter x:Key="StatusToBg"/>
        <conv:LogLevelToBrushConverter         x:Key="LogLevelToBrush"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InspectionResultToBrushConverter x:Key="InspResultToBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>    <!-- ?µê³„ ë°?-->
            <RowDefinition Height="220"/>   <!-- ê³µì • ?ë¦„ -->
            <RowDefinition Height="90"/>    <!-- ì¶??„ì¹˜ -->
            <RowDefinition Height="56"/>    <!-- ?œì–´ ë²„íŠ¼ -->
            <RowDefinition Height="*"/>     <!-- ?´ë²¤??ë¡œê·¸ -->
        </Grid.RowDefinitions>

        <!-- ?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•
             Row 0: ?ì‚° ?µê³„ ë°?
             ?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â• -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBgBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1" MinWidth="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1" MinWidth="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1" MinWidth="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1" MinWidth="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1" MinWidth="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <!-- ?íƒœ ë©”ì‹œì§€ -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ì´??ì‚° -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="ì´??ì‚°" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat='{}{0:N0} ea'}"
                               Style="{StaticResource StatValueStyle}"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="{StaticResource DividerBrush}" Margin="0,10"/>

                <!-- GOOD -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="GOOD" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding GoodCount, StringFormat='{}{0:N0} ea'}"
                               Style="{StaticResource StatValueStyle}"
                               Foreground="{StaticResource AccentGreenBrush}"/>
                </StackPanel>

                <Rectangle Grid.Column="3" Fill="{StaticResource DividerBrush}" Margin="0,10"/>

                <!-- NG -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="NG" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding NgCount, StringFormat='{}{0:N0} ea'}"
                               Style="{StaticResource StatValueStyle}"
                               Foreground="{StaticResource AccentRedBrush}"/>
                </StackPanel>

                <Rectangle Grid.Column="5" Fill="{StaticResource DividerBrush}" Margin="0,10"/>

                <!-- NG??-->
                <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="NG?? Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding NgRate, StringFormat='{}{0:F2} %'}"
                               Style="{StaticResource StatValueStyle}"
                               Foreground="{StaticResource AccentOrangeBrush}"/>
                </StackPanel>

                <Rectangle Grid.Column="7" Fill="{StaticResource DividerBrush}" Margin="0,10"/>

                <!-- ?¬ì´???€??-->
                <StackPanel Grid.Column="8" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="Cycle Time" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding LastCycleTime, StringFormat='{}{0:F1} s'}"
                               Style="{StaticResource StatValueStyle}"/>
                </StackPanel>

                <Rectangle Grid.Column="9" Fill="{StaticResource DividerBrush}" Margin="0,10"/>

                <!-- ê°€???œê°„ -->
                <StackPanel Grid.Column="10" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="ê°€???œê°„" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding Uptime}"
                               Style="{StaticResource StatValueStyle}"
                               Foreground="{StaticResource AccentCyanBrush}"/>
                </StackPanel>

                <!-- ?íƒœ ë©”ì‹œì§€ (?°ì¸¡ ?•ë ¬) -->
                <Border Grid.Column="12" VerticalAlignment="Center"
                        Background="#1A58A6FF" CornerRadius="4" Padding="12,5">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource AccentBlueBrush}"
                               FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•
             Row 1: ê³µì • ?ë¦„ ?œê°??
             ?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â• -->
        <Border Grid.Row="1"
                Background="{StaticResource AppBgBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid>
                <!-- ?¹ì…˜ ?œëª© -->
                <TextBlock Text="ê³µì • ?ë¦„" Margin="24,12,0,0"
                           VerticalAlignment="Top"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" FontWeight="SemiBold"
/>

                <!-- ?¤í…Œ?´ì? ì¹´ë“œ -->
                <ItemsControl ItemsSource="{Binding Stages}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,24,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StageCardViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <!-- ?€?€ ?¤í…Œ?´ì? ì¹´ë“œ ?€?€ -->
                                <Border Width="158" Height="158" CornerRadius="10"
                                        Background="{Binding Status, Converter={StaticResource StatusToBg}}"
                                        BorderThickness="1.5"
                                        BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                    <Grid Margin="12,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- ?¤ë”: ?„ì´ì½?+ ?íƒœ ?¸ë””ì¼€?´í„° -->
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Icon}"
                                                       FontSize="20"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                       VerticalAlignment="Center"/>
                                            <!-- ?„ìŠ¤ ?¸ë””ì¼€?´í„° -->
                                            <Ellipse Width="9" Height="9"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                     Opacity="{Binding IndicatorOpacity}"/>
                                        </Grid>

                                        <!-- ?€?´í? -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Title}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <!-- ?œë¸Œ?€?´í? -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Subtitle}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,8"/>

                                        <!-- ?•ë³´ ì¤?-->
                                        <StackPanel Grid.Row="3">
                                            <TextBlock Text="{Binding Info1}"
                                                       FontSize="10" FontFamily="Consolas"
                                                       Foreground="{Binding Info1, Converter={StaticResource InspResultToBrush}}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Info2}"
                                                       FontSize="10" FontFamily="Consolas"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ?€?€ ?”ì‚´??êµ¬ë¶„??(ë§ˆì?ë§?ì¹´ë“œ ?œì™¸) ?€?€ -->
                                <Grid Width="38"
                                      Visibility="{Binding IsLastCard, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock Text="??
                                               FontSize="32"
                                               FontWeight="Thin"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•
             Row 2: ì¶??„ì¹˜ ?œì‹œ
             ?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â• -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBgBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Transfer ì¶?-->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="TRANSFER AXIS" Margin="0,0,0,4"
                               FontSize="10" FontWeight="SemiBold"

                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TransferPos}"
                               FontFamily="Consolas" FontSize="13"
                               Foreground="{StaticResource AccentBlueBrush}"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="{StaticResource DividerBrush}" Margin="0,12"/>

                <!-- Fiducial ì¶?-->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="FIDUCIAL AXIS" Margin="0,0,0,4"
                               FontSize="10" FontWeight="SemiBold"

                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding FiducialPos}"
                               FontFamily="Consolas" FontSize="13"
                               Foreground="{StaticResource AccentCyanBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•
             Row 3: ?œì–´ ë²„íŠ¼
             ?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â• -->
        <Border Grid.Row="3"
                Background="{StaticResource PanelBgBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="24,0" Spacing="10">

                <!-- ?¼ì¸ ? íƒ -->
                <Border VerticalAlignment="Center" Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Source:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <ComboBox SelectedIndex="{Binding SelectedLineIndex}"
                                  VerticalAlignment="Center" FontSize="12"
                                  MinWidth="80"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InvBoolToVis}}">
                            <ComboBoxItem Content="Line 1"/>
                            <ComboBoxItem Content="Line 2"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- ëª©í‘œ ? í¬ -->
                <Border VerticalAlignment="Center" Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="ëª©í‘œ ? í¬:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <TextBox Text="{Binding TargetTorque, StringFormat='{}{0:F1}', UpdateSourceTrigger=LostFocus}"
                                 VerticalAlignment="Center" FontSize="12"
                                 MinWidth="60" TextAlignment="Right"
                                 IsEnabled="{Binding IsRunning, Converter={StaticResource InvBoolToVis}}"/>
                        <TextBlock Text="Nm" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Separator/>

                <!-- ?œìž‘ ë²„íŠ¼ -->
                <Button Content="?? ?œìž‘"
                        Command="{Binding StartCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="100"/>

                <!-- ?•ì? ë²„íŠ¼ -->
                <Button Content="?? ?•ì?"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="100"/>

                <!-- E-STOP -->
                <Button Content="?? E-STOP"
                        Command="{Binding EStopCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        MinWidth="120"/>

            </StackPanel>
        </Border>

        <!-- ?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•
             Row 4: ?´ë²¤??ë¡œê·¸
             ?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â•?â• -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ë¡œê·¸ ?¤ë” -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBgBrush}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource DividerBrush}"
                    Padding="24,0">
                <TextBlock Text="?´ë²¤??ë¡œê·¸" VerticalAlignment="Center"
                           FontSize="11" FontWeight="SemiBold"

                           Foreground="{StaticResource TextMutedBrush}"/>
            </Border>

            <!-- ë¡œê·¸ ëª©ë¡ -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Logs}"
                     Style="{StaticResource LogListBoxStyle}"
                     ItemContainerStyle="{StaticResource LogListBoxItemStyle}"
                     Padding="8,4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- ?œê°„ -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding FormattedTime}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <!-- ?¤í…Œ?´ì? -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Stage}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <!-- ë©”ì‹œì§€ -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Message}"
                                       FontSize="12"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
