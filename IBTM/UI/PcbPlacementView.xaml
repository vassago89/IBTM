<UserControl x:Class="IBTM.UI.PcbPlacementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             xmlns:placement="clr-namespace:IBTM.PcbPlacement;assembly=IBTM.PcbPlacement"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
             Width="566"
             Height="650">
    <UserControl.Resources>
        <Style x:Key="BufferLocatingPinStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="Fill" Value="{StaticResource CardBorderBrush}"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Canvas>
            <TextBlock Canvas.Left="20" Canvas.Top="14"
                       Text="PCB SUPPLY / PLACEMENT"
                       Style="{StaticResource TitleStyle}"
                       FontWeight="Bold"/>
            <Button Canvas.Right="20" Canvas.Top="14"
                    Content="RESUME WORK"
                    Command="{Binding OpenPcbPlacementRecoveryCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="92"
                    Height="30"
                    Visibility="{Binding PcbPlacementRecoveryAvailable,
                                         Converter={StaticResource BoolToVis}}"/>

            <StackPanel Canvas.Left="20" Canvas.Top="52"
                        Orientation="Horizontal">
                <Border Tag="{Binding SupplyDisplayState}"
                        Style="{StaticResource HandlerStateBadgeStyle}"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SUPPLY"
                                   Style="{StaticResource MapHintStyle}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SupplyDisplayState,
                                                  Converter={StaticResource EnumDescriptionConverter}}"
                                   Style="{StaticResource PrimaryStateTextStyle}"/>
                    </Grid>
                </Border>
                <Border Tag="{Binding PlacementDisplayState}"
                        Style="{StaticResource HandlerStateBadgeStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PLACEMENT"
                                   Style="{StaticResource MapHintStyle}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PlacementDisplayState,
                                                  Converter={StaticResource EnumDescriptionConverter}}"
                                   Style="{StaticResource PrimaryStateTextStyle}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Canvas.Left="304" Canvas.Top="108"
                       Width="190"
                       Text="{Binding PcbPlacementProcessState,
                                      Converter={StaticResource EnumDescriptionConverter}}"
                       TextAlignment="Left">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                           BasedOn="{StaticResource MapLabelStyle}">
                        <Setter Property="FontSize" Value="14"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PcbPlacementProcessState}"
                                         Value="{x:Static placement:PcbPlacementState.WaitingForBufferPcb}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PcbPlacementProcessState}"
                                         Value="{x:Static placement:PcbPlacementState.WaitingForCarrier}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Canvas.Left="54" Canvas.Top="142"
                       Width="220"
                       Text="PCB IN"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>

            <Border Canvas.Left="54" Canvas.Top="164"
                    Width="220" Height="108"
                    Style="{StaticResource DeviceBodyStyle}">
                <Grid Width="208" Height="66"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Border Width="192"
                            HorizontalAlignment="Left"
                            Tag="{Binding Supply.UpstreamCarrierAvailable}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="{StaticResource EquipBgBrush}"/>
                                <Setter Property="BorderBrush"
                                        Value="{StaticResource DividerBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="CornerRadius" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag,
                                                                  RelativeSource={RelativeSource Self}}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource MapActiveBackgroundBrush}"/>
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource CarrierBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource UnknownPcbFootprintStyle}"/>
                            <Border Grid.Column="2"
                                    Style="{StaticResource UnknownPcbFootprintStyle}"/>
                        </Grid>
                    </Border>
                    <Ellipse HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Tag="{Binding Supply.UpstreamCarrierAvailable}"
                             Style="{StaticResource PresenceLedStyle}"/>
                </Grid>
            </Border>
            <Grid Width="100" Height="112"
                  Panel.ZIndex="20">
                <Grid.RenderTransform>
                    <TranslateTransform X="{Binding PcbSupplyMapLeft}"
                                        Y="{Binding PcbSupplyMapTop}"/>
                </Grid.RenderTransform>
                <Grid Width="92" Height="72"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom">
                    <Border Tag="{Binding Supply.Motion.IsMoving}"
                            Style="{StaticResource OverheadBodyStyle}"/>
                    <Grid Width="18" Height="18"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Margin="0,4,0,0">
                        <Ellipse Width="12" Height="12"
                                 VerticalAlignment="Top"
                                 Fill="{StaticResource EquipBgBrush}"
                                 Stroke="{StaticResource TextMutedBrush}"
                                 StrokeThickness="2"/>
                        <Border Width="2" Height="7"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource TextMutedBrush}"/>
                    </Grid>
                    <Border Width="66" Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,2"
                            Background="#26313C"
                            BorderBrush="{StaticResource TextMutedBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Visibility="{Binding PcbSupplyNestForward,
                                                 Converter={StaticResource BoolToVis}}"/>
                    <Grid Width="{StaticResource PcbWidth}"
                          Height="{StaticResource PcbHeight}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,1"
                          Visibility="{Binding PcbSupplyPcbSecured,
                                               Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource PcbFootprintStyle}"/>
                        <Border Width="22" Height="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0"
                                Background="{StaticResource MaterialIpmBrush}"
                                CornerRadius="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PcbSupplyRotated}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                    <Border Tag="{Binding PcbSupplyIpmFixed}"
                            Style="{StaticResource LeftGripperJawStyle}"/>
                    <Border Tag="{Binding PcbSupplyIpmFixed}"
                            Style="{StaticResource RightGripperJawStyle}"/>
                </Grid>
            </Grid>

            <TextBlock Canvas.Left="276" Canvas.Top="216"
                       Width="116"
                       Text="BUFFER"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>

            <Border Canvas.Left="276" Canvas.Top="236"
                    Width="116" Height="84"
                    Style="{StaticResource BufferStyle}">
                <Grid Width="104" Height="66"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Border Background="{StaticResource EquipBgBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="2"
                            CornerRadius="2"/>
                    <Border Style="{StaticResource PcbSlotStyle}"/>
                    <Border Style="{StaticResource PcbFootprintStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding PcbBufferPcbPresent,
                                                 Converter={StaticResource BoolToVis}}"/>
                    <Ellipse HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Style="{StaticResource BufferLocatingPinStyle}"/>
                    <Ellipse HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Style="{StaticResource BufferLocatingPinStyle}"/>
                    <Ellipse HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"
                             Style="{StaticResource BufferLocatingPinStyle}"/>
                    <Ellipse HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Style="{StaticResource BufferLocatingPinStyle}"/>
                </Grid>
            </Border>

            <Grid Width="104" Height="106"
                  Panel.ZIndex="21">
                <Grid.RenderTransform>
                    <TranslateTransform X="{Binding PcbPlacementMapLeft}"
                                        Y="{Binding PcbPlacementMapTop}"/>
                </Grid.RenderTransform>
                <Grid Width="92" Height="72"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,13">
                    <Border Tag="{Binding Placement.Motion.IsMoving}"
                            Style="{StaticResource PlacementBodyStyle}"/>
                    <Grid Width="24" Height="18"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Margin="0,4,0,0">
                        <Border Width="20" Height="3"
                                VerticalAlignment="Top"
                                Background="{StaticResource TextMutedBrush}"
                                CornerRadius="1"/>
                        <Border Width="3" Height="10"
                                VerticalAlignment="Center"
                                Background="{StaticResource TextMutedBrush}"/>
                        <Ellipse Width="9" Height="5"
                                 VerticalAlignment="Bottom"
                                 Fill="{StaticResource EquipBgBrush}"
                                 Stroke="{StaticResource TextMutedBrush}"
                                 StrokeThickness="1"/>
                    </Grid>
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0"
                            Style="{StaticResource PcbFootprintStyle}"
                            Visibility="{Binding PcbPlacementPcbSecured,
                                                 Converter={StaticResource BoolToVis}}"/>
                    <Ellipse Width="9" Height="9"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,7"
                             Fill="{StaticResource EquipBgBrush}"
                             Stroke="{StaticResource AccentGreenBrush}"
                             StrokeThickness="2"
                             Panel.ZIndex="2"
                             Visibility="{Binding Placement.VacuumDetected,
                                                  Converter={StaticResource BoolToVis}}"/>
                    <Border Width="24" Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,10"
                            Background="{StaticResource MaterialIpmBrush}"
                            CornerRadius="1"
                            Visibility="{Binding PcbPlacementIpmDown,
                                                 Converter={StaticResource BoolToVis}}"/>
                    <Border Tag="{Binding PcbPlacementIpmGripperClosed}"
                            Style="{StaticResource LeftGripperJawStyle}"/>
                    <Border Tag="{Binding PcbPlacementIpmGripperClosed}"
                            Style="{StaticResource RightGripperJawStyle}"/>
                </Grid>
            </Grid>

        </Canvas>
    </Grid>
</UserControl>
