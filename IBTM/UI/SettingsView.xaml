<UserControl x:Class="IBTM.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:SettingsViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <Style x:Key="SettingFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SettingFieldBox"
               TargetType="TextBox"
               BasedOn="{StaticResource FieldTextBoxStyle}">
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="SettingSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SettingComboBox"
               TargetType="ComboBox"
               BasedOn="{StaticResource FieldComboBoxStyle}">
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <Style x:Key="SettingCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,16,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HardwareList" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="HardwareListItem"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource FlatListItemStyle}">
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Settings" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Machine setup and configuration"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1480" HorizontalAlignment="Center" Margin="0,0,8,0">
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Enabled Units" Style="{StaticResource SettingSectionTitle}"/>
                        <UniformGrid Columns="8">
                            <CheckBox Content="Main Conveyor"
                                      IsChecked="{Binding Settings.Units.MainConveyor}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="PCB Supply"
                                      IsChecked="{Binding Settings.Units.PcbSupply}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="PCB Placement"
                                      IsChecked="{Binding Settings.Units.PcbPlacement}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Pickup Feeder"
                                      IsChecked="{Binding Settings.Units.PickupBoltFeeder}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Linear Feeder"
                                      IsChecked="{Binding Settings.Units.LinearBoltFeeder}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Bolt Fastening"
                                      IsChecked="{Binding Settings.Units.BoltFastening}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Inspection"
                                      IsChecked="{Binding Settings.Units.Inspection}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="NG Conveyor"
                                      IsChecked="{Binding Settings.Units.NgConveyor}"
                                      Style="{StaticResource SettingCheckBox}"/>
                        </UniformGrid>
                        <TextBlock Text="Disabled units are excluded from machine readiness and homing. Settings and I/O remain available."
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Motion" Style="{StaticResource SettingSectionTitle}"/>
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Motion Group" Style="{StaticResource SettingFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding MotionGroups}"
                                          SelectedItem="{Binding SelectedMotionGroup, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource EnumItemTemplate}"
                                          Style="{StaticResource SettingComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Horizontal Speed (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding CurrentMotionSettings.HorizontalSpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0"
                                        Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Z Speed (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding CurrentMotionSettings.ZSpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="Conveyor" Style="{StaticResource SettingFieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Run" Command="{Binding RunConveyorCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0"/>
                                    <Button Content="Stop" Command="{Binding StopConveyorCommand}"
                                            Style="{StaticResource DangerButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Actuator Feedback"
                                       Style="{StaticResource SettingSectionTitle}"
                                       Margin="0"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Input Wait Timeout (ms)"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,8,0"/>
                                <TextBox Text="{Binding Settings.Options.TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"
                                         Width="100"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="6,0,6,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OUTPUT" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="ON INPUT"
                                       Style="{StaticResource SettingFieldLabel}"/>
                            <TextBlock Grid.Column="2" Text="OFF INPUT"
                                       Style="{StaticResource SettingFieldLabel}"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding FeedbackMappings}"
                                 Style="{StaticResource HardwareList}"
                                 MaxHeight="240"
                                 ItemContainerStyle="{StaticResource HardwareListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key, Converter={StaticResource EnumDescriptionConverter}}"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.InputSignals, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Value.OnInput, Mode=TwoWay}"
                                                  ItemTemplate="{StaticResource EnumItemTemplate}"
                                                  Style="{StaticResource SettingComboBox}"
                                                  MinWidth="0"
                                                  Padding="5,3"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding DataContext.InputSignals, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Value.OffInput, Mode=TwoWay}"
                                                  ItemTemplate="{StaticResource EnumItemTemplate}"
                                                  Style="{StaticResource SettingComboBox}"
                                                  MinWidth="0"
                                                  Padding="5,3"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Hardware and Homing" Style="{StaticResource SettingSectionTitle}" Margin="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Stop Axis" Command="{Binding StopHomingCommand}"
                                        Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="Refresh" Command="{Binding RefreshHardwareCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Motion / IO Driver" Style="{StaticResource SettingFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ControlDrivers}"
                                          SelectedItem="{Binding Settings.Drivers.Control, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource EnumItemTemplate}"
                                          Style="{StaticResource SettingComboBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Home Horizontal (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Home.HorizontalSpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="Home Z (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Home.ZSpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,16,0">
                                <TextBlock Text="Pulse Length (mm/pulse)"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding CurrentMotionHardwareSettings.MillimetersPerPulse, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="4"
                                       Text="Motion / IO driver, axis number, and direction changes apply after restart."
                                       VerticalAlignment="Bottom"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="INPUTS" Style="{StaticResource SettingFieldLabel}"/>
                                <ListBox ItemsSource="{Binding InputMappings}" Height="420"
                                         Style="{StaticResource HardwareList}"
                                         ItemContainerStyle="{StaticResource HardwareListItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="44"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Area, Converter={StaticResource EnumDescriptionConverter}}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="9"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBox Grid.Column="2" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SettingFieldBox}"
                                                         MinWidth="0" Padding="5,3" Margin="4,0"/>
                                                <ContentControl Grid.Column="3"
                                                                Tag="{Binding IsOn}"
                                                                Style="{StaticResource IoInputStateStyle}"
                                                                HorizontalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="OUTPUTS" Style="{StaticResource SettingFieldLabel}"/>
                                <ListBox ItemsSource="{Binding OutputMappings}" Height="420"
                                         Style="{StaticResource HardwareList}"
                                         ItemContainerStyle="{StaticResource HardwareListItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="58"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Area, Converter={StaticResource EnumDescriptionConverter}}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="9"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBox Grid.Column="2" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SettingFieldBox}"
                                                         MinWidth="0" Padding="5,3" Margin="4,0"/>
                                                <TextBox Grid.Column="3" Text="{Binding OffNumber, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Reverse output channel"
                                                         Style="{StaticResource SettingFieldBox}"
                                                         MinWidth="0" Padding="5,3" Margin="4,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="AREA  AXIS  NUMBER  DIRECTION  MIN  MAX"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <ListBox ItemsSource="{Binding AxisMappings}" Height="420"
                                         Style="{StaticResource HardwareList}"
                                         ItemContainerStyle="{StaticResource HardwareListItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="74"/>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="48"/>
                                                     <ColumnDefinition Width="100"/>
                                                     <ColumnDefinition Width="54"/>
                                                     <ColumnDefinition Width="54"/>
                                                     <ColumnDefinition Width="108"/>
                                                     <ColumnDefinition Width="50"/>
                                                     <ColumnDefinition Width="50"/>
                                                 </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Area, Converter={StaticResource EnumDescriptionConverter}}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="9"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                 <TextBox Grid.Column="2" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource SettingFieldBox}"
                                                          MinWidth="0" Padding="5,3" Margin="4,0"/>
                                                 <ComboBox Grid.Column="3"
                                                           ItemsSource="{Binding DataContext.AxisDirections, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           SelectedItem="{Binding Direction, Mode=TwoWay}"
                                                           ItemTemplate="{StaticResource EnumItemTemplate}"
                                                           Padding="4,2" Margin="2,0"/>
                                                 <TextBox Grid.Column="4"
                                                          Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource SettingFieldBox}"
                                                          MinWidth="0" Padding="4,3" Margin="2,0"/>
                                                 <TextBox Grid.Column="5"
                                                          Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource SettingFieldBox}"
                                                          MinWidth="0" Padding="4,3" Margin="2,0"/>
                                                 <TextBlock Grid.Column="6"
                                                            VerticalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis"
                                                            FontFamily="Cascadia Mono, Consolas"
                                                            FontSize="10"
                                                            FontWeight="SemiBold">
                                                     <TextBlock.Style>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="Text" Value="Ready"/>
                                                             <Setter Property="Foreground"
                                                                     Value="{StaticResource AccentGreenBrush}"/>
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding AxisState.Homed}" Value="False">
                                                                     <Setter Property="Text" Value="Home Required"/>
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentAmberBrush}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding AxisState.InPosition}" Value="False">
                                                                     <Setter Property="Text" Value="Moving"/>
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentBlueBrush}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding AxisState.ServoOn}" Value="False">
                                                                     <Setter Property="Text" Value="Servo Off"/>
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentAmberBrush}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding AxisState.NegativeLimit}" Value="True">
                                                                     <Setter Property="Text" Value="Negative Limit"/>
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentRedBrush}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding AxisState.PositiveLimit}" Value="True">
                                                                     <Setter Property="Text" Value="Positive Limit"/>
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentRedBrush}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding AxisState.Alarm}" Value="True">
                                                                     <Setter Property="Text" Value="Alarm"/>
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentRedBrush}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding AxisState.Emergency}" Value="True">
                                                                     <Setter Property="Text" Value="Emergency"/>
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentRedBrush}"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </TextBlock.Style>
                                                 </TextBlock>
                                                 <Button Grid.Column="7" Content="Servo"
                                                        Command="{Binding DataContext.ToggleServoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="6,3" Margin="0,0,4,0"/>
                                                 <Button Grid.Column="8" Content="Home"
                                                        Command="{Binding DataContext.HomeAxisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="6,3"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2">
                    <Border Style="{StaticResource SettingCard}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Text="AJIN Controller" Style="{StaticResource SettingSectionTitle}"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,4,10">
                                    <TextBlock Text="Interrupt Number" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Ajin.InterruptNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,10">
                                    <TextBlock Text="Motion Parameter File" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Ajin.MotionParameterFile, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="Acceleration Multiplier" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Ajin.AccelerationMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock Text="AlphaMotion Controller" Style="{StaticResource SettingSectionTitle}"/>
                            <TextBlock Text="Controller Number" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.AlphaMotion.ControllerNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Station Number" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.AlphaMotion.StationNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Communication Speed" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.AlphaMotion.CommunicationSpeed, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Columns="2">
                    <Border Style="{StaticResource SettingCard}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Text="Inspection Camera" Style="{StaticResource SettingSectionTitle}"/>
                            <TextBlock Text="Device ID / Serial Number" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.InspectionCamera.DeviceId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Exposure (us)" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.InspectionCamera.ExposureMicroseconds, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Gain" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.InspectionCamera.Gain, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Frame Timeout (ms)" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.InspectionCamera.FrameTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Bolt Recess Model" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.BoltInspection.ModelFile, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="Mask Threshold" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.BoltInspection.MaskThreshold, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Minimum Mask Ratio" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.BoltInspection.MinimumMaskRatio, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingCard}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Controllers" Style="{StaticResource SettingSectionTitle}"/>
                            <TextBlock Text="Camera Driver" Style="{StaticResource SettingFieldLabel}"/>
                             <ComboBox ItemsSource="{Binding CameraDrivers}"
                                       SelectedItem="{Binding Settings.Drivers.Camera, Mode=TwoWay}"
                                       ItemTemplate="{StaticResource EnumItemTemplate}"
                                       Style="{StaticResource SettingComboBox}" Margin="0,0,0,10"/>
                             <TextBlock Text="Bolt Head Driver" Style="{StaticResource SettingFieldLabel}"/>
                             <ComboBox ItemsSource="{Binding BoltDrivers}"
                                       SelectedItem="{Binding Settings.Drivers.Bolt, Mode=TwoWay}"
                                       ItemTemplate="{StaticResource EnumItemTemplate}"
                                       Style="{StaticResource SettingComboBox}" Margin="0,0,0,10"/>
                             <TextBlock Text="Light Controller Connection" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.Lighting.Connection, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="Light Channel" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Lighting.InspectionChannel, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}" MinWidth="0"/>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Light Level" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Lighting.InspectionLevel, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}" MinWidth="0"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Columns="2">
                    <Border Style="{StaticResource SettingCard}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Text="HANTAS ADC"
                                       Style="{StaticResource SettingSectionTitle}"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,4,10">
                                    <TextBlock Text="COM Port" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Hantas.PortName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,10">
                                    <TextBlock Text="Baud Rate" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Hantas.BaudRate, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="Fastener 1 · Pickup" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Hantas.PickupSlaveAddress, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Fastener 2 · Shooting" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Hantas.ShootingSlaveAddress, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingCard}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Bolt Supply"
                                       Style="{StaticResource SettingSectionTitle}"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="Pickup Timeout (ms)"
                                               Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.BoltFeeder.PickupTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Linear Timeout (ms)"
                                               Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.BoltFeeder.LinearTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Configuration Scope" Style="{StaticResource SettingSectionTitle}"/>
                        <TextBlock Text="Driver, device connection, I/O channel and axis mapping changes apply after restart."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Interlocks" Style="{StaticResource SettingSectionTitle}"/>
                        <UniformGrid Columns="2">
                            <CheckBox Content="Emergency Stop"
                                      IsChecked="{Binding Settings.Options.UseEmergencyStop}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Reset Button"
                                      IsChecked="{Binding Settings.Options.UseResetButton}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Door Interlock"
                                      IsChecked="{Binding Settings.Options.UseDoorInterlock}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Air Pressure Interlock"
                                      IsChecked="{Binding Settings.Options.UseAirPressureInterlock}"
                                      Style="{StaticResource SettingCheckBox}"/>
                        </UniformGrid>
                        <TextBlock Text="Enable each item after its logical I/O mapping and electrical behavior have been verified."
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" MinWidth="150"/>
        </Border>
    </Grid>
</UserControl>
