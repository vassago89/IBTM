<UserControl x:Class="IBTM.UI.StationTeachingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:StationTeachingViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource AppBgBrush}">

    <Grid Margin="24,20">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CaptureCarrierImagesCommand.IsRunning}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Station Teaching"
                   Style="{StaticResource TitleStyle}"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="2" Background="{StaticResource EquipBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="3" ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInspectionSelected}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <ui:ImageTeachingView x:Name="ImageMap"
                                          Source="{Binding LiveImage}"
                                          Tiles="{Binding CarrierImages}"
                                          MillimetersPerPixel="{Binding MillimetersPerPixel}"
                                          Markers="{Binding ImageMarkers}"
                                          CameraFieldOfView="{Binding CameraFieldOfView}"
                                          CoordinateOrigin="{Binding CarrierOrigin}"
                                          ClickCommand="{Binding TeachImagePointCommand}"
                                          Cursor="Cross"
                                          ToolTip="Wheel: zoom   Right drag: pan   Right double-click: fit"
                                          RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="8" Padding="8,5"
                            Background="#D820252A" CornerRadius="2"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HoverPositionText, ElementName=ImageMap}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding HoverPositionText, ElementName=ImageMap}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="White"/>
                    </Border>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,8,0,0" Padding="10,6"
                            Background="#E020252A" CornerRadius="2"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasCarrierImages}" Value="True"/>
                                            <Condition Binding="{Binding CarrierOrigin}" Value="{x:Null}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Teach the carrier UL, then LR locating pin"
                                   Foreground="White"/>
                    </Border>
                    <Border Width="1" HorizontalAlignment="Center"
                            Background="{StaticResource AccentBrush}"
                            IsHitTestVisible="False" Opacity="0.35"
                            Visibility="{Binding IsCameraLive, Converter={StaticResource BoolToVis}}"/>
                    <Border Height="1" VerticalAlignment="Center"
                            Background="{StaticResource AccentBrush}"
                            IsHitTestVisible="False" Opacity="0.35"
                            Visibility="{Binding IsCameraLive, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="NO IMAGE" FontSize="14" FontFamily="Cascadia Mono, Consolas"
                               Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding LiveImage}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding HasCarrierImages}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="Live"
                            Command="{Binding ToggleLiveViewCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"
                            MinWidth="70" Opacity="0.9"
                            Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCameraLive}" Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Scan Carrier"
                            Command="{Binding CaptureCarrierImagesCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="92,0,0,8"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="112" Opacity="0.9"
                            Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,8,8" Padding="8,5"
                            Background="#D820252A" CornerRadius="2"
                            Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="mm/px" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding MillimetersPerPixel, UpdateSourceTrigger=PropertyChanged}"
                                     Width="72" Margin="0,0,10,0"/>
                            <TextBlock Text="Overlap" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding ScanOverlap, UpdateSourceTrigger=PropertyChanged}"
                                     Width="58"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
              <StackPanel>
                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="Motion"
                                   Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding MotionGroups}"
                                  SelectedItem="{Binding SelectedMotionGroup, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource EnumItemTemplate}"
                                  Padding="8,5"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="Current Position"
                                   Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="X" Style="{StaticResource StatLabelStyle}"/>
                                <TextBlock Text="{Binding CurrentX, StringFormat=F3}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Style="{StaticResource StatValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Y" Style="{StaticResource StatLabelStyle}"/>
                                <TextBlock Text="{Binding CurrentY, StringFormat=F3}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Style="{StaticResource StatValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Z" Style="{StaticResource StatLabelStyle}"/>
                                <TextBlock Text="{Binding CurrentZ, StringFormat=F3}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Style="{StaticResource StatValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="Jog" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,10"/>
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <ui:HoldButton Grid.Row="0" Grid.Column="1" Content="Y+" Style="{StaticResource JogButtonStyle}"
                                           PressCommand="{Binding JogYPlusCommand}"
                                           ReleaseCommand="{Binding JogStopCommand}"/>
                            <ui:HoldButton Grid.Row="1" Grid.Column="0" Content="X-" Style="{StaticResource JogButtonStyle}"
                                           PressCommand="{Binding JogXMinusCommand}"
                                           ReleaseCommand="{Binding JogStopCommand}"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="STOP" Style="{StaticResource JogStopButtonStyle}"
                                    Command="{Binding JogStopCommand}"/>
                            <ui:HoldButton Grid.Row="1" Grid.Column="2" Content="X+" Style="{StaticResource JogButtonStyle}"
                                           PressCommand="{Binding JogXPlusCommand}"
                                           ReleaseCommand="{Binding JogStopCommand}"/>
                            <ui:HoldButton Grid.Row="2" Grid.Column="1" Content="Y-" Style="{StaticResource JogButtonStyle}"
                                           PressCommand="{Binding JogYMinusCommand}"
                                           ReleaseCommand="{Binding JogStopCommand}"/>

                            <ui:HoldButton Grid.Row="0" Grid.Column="4" Content="Z+" Style="{StaticResource JogButtonStyle}"
                                           Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}"
                                           PressCommand="{Binding JogZPlusCommand}"
                                           ReleaseCommand="{Binding JogStopCommand}"/>
                            <ui:HoldButton Grid.Row="2" Grid.Column="4" Content="Z-" Style="{StaticResource JogButtonStyle}"
                                           Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}"
                                           PressCommand="{Binding JogZMinusCommand}"
                                           ReleaseCommand="{Binding JogStopCommand}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="Travel Z"
                                    Command="{Binding MoveToHorizontalZCommand}"
                                    Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="58" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding JogSpeeds}"
                                      SelectedItem="{Binding JogSpeed, Mode=TwoWay}"
                                      MinWidth="58" Padding="6,4"/>
                            <TextBlock Text="mm/s" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

              </StackPanel>
            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Grid.Column" Value="2"/>
                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                        <Setter Property="Padding" Value="14,12"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInspectionSelected}"
                                         Value="True">
                                <Setter Property="Grid.Column" Value="4"/>
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Teaching points"
                               Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,10"/>

                    <ListView Grid.Row="1" ItemsSource="{Binding FilteredPoints}"
                              SelectedItem="{Binding SelectedPoint}"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource FlatListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               ToolTip="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                                FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding HeatSink, Converter={StaticResource EnumDescriptionConverter}}"
                                               VerticalAlignment="Center"
                                                FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Head, Converter={StaticResource EnumDescriptionConverter}}"
                                               VerticalAlignment="Center"
                                                FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding PositionLabel}"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                                FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Teach"
                                    Command="{Binding TeachCurrentPositionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="70" Margin="0,0,6,0"/>
                            <Button Content="Move To"
                                    Command="{Binding MoveToPointCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="70"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding BoltPointEditorVisible,
                                                         Converter={StaticResource BoolToVis}}">
                            <ComboBox ItemsSource="{Binding HeatSinkSlots}"
                                      SelectedItem="{Binding NewHeatSinkSlot, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource EnumItemTemplate}"
                                       FontSize="11" MinWidth="74" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding FasteningHeads}"
                                      SelectedItem="{Binding NewFasteningHead, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource EnumItemTemplate}"
                                       FontSize="11" MinWidth="74" Margin="0,0,6,0"/>
                            <Button Content="Add Bolt"
                                    Command="{Binding AddBoltPointCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="70" Margin="0,0,6,0"/>
                            <Button Content="Remove"
                                    Command="{Binding RemoveBoltPointCommand}"
                                    Style="{StaticResource DangerButtonStyle}" MinWidth="70"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,6,0,0"
                                    Visibility="{Binding BoltPresetEditorVisible,
                                                         Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="PCB" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding BoltRecipe.PcbPreset, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="11" Width="36" Margin="4,0,10,0"/>
                            <TextBlock Text="IPM 1" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding BoltRecipe.IpmSeatingPreset, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="11" Width="36" Margin="4,0,10,0"/>
                            <TextBlock Text="IPM 2" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding BoltRecipe.IpmFinalPreset, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="11" Width="36" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
