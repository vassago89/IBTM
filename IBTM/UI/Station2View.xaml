<UserControl x:Class="IBTM.UI.Station2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
             Width="448"
             Height="492">
    <Grid>
        <Border Style="{DynamicResource CellStyle}"/>

        <Canvas>
            <TextBlock Canvas.Left="20" Canvas.Top="18"
                       Text="STATION 2   BOLT FASTENING"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="17"
                       FontWeight="SemiBold"/>
            <Border Canvas.Right="20" Canvas.Top="52"
                    Tag="{Binding BoltDisplayState}"
                    Style="{DynamicResource StationStateBadgeStyle}">
                <TextBlock Text="{Binding BoltDisplayState,
                                          Converter={StaticResource EnumDescriptionConverter}}"
                           Style="{DynamicResource StateTextStyle}"/>
            </Border>

            <Grid Canvas.Left="{Binding BoltFasteningMapLeft}"
                  Canvas.Top="{Binding BoltFasteningMapTop}"
                  Width="126" Height="138"
                  Panel.ZIndex="20"
                  ToolTip="{Binding BoltFasteningPosition}">
                <Border Tag="{Binding BoltFasteningMoving}"
                        Style="{DynamicResource DeviceBodyStyle}"/>
                <Grid Margin="10,9,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="DUAL HEAD"
                               HorizontalAlignment="Center"
                               Style="{DynamicResource MapLabelStyle}"/>

                    <Grid Grid.Row="1" Margin="8,10,8,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Tag="{Binding BoltHead1Down}"
                                Style="{DynamicResource ToolHeadVisualStyle}"
                                HorizontalAlignment="Center"/>
                        <Border Grid.Column="2"
                                Tag="{Binding BoltHead2Down}"
                                Style="{DynamicResource ToolHeadVisualStyle}"
                                HorizontalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PICKUP"
                                   HorizontalAlignment="Center"
                                   Style="{DynamicResource MapHintStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="SHOOTING"
                                   HorizontalAlignment="Center"
                                   Style="{DynamicResource MapHintStyle}"/>
                    </Grid>
                </Grid>
            </Grid>

            <TextBlock Canvas.Left="20" Canvas.Top="438"
                       Text="FASTENING POSITION"
                       Style="{DynamicResource MapLabelStyle}"/>
            <TextBlock Canvas.Left="20" Canvas.Top="458"
                       Text="{Binding BoltFasteningPosition}"
                       Style="{DynamicResource MapHintStyle}"/>
        </Canvas>
    </Grid>
</UserControl>
