<Window x:Class="IBTM.UI.MotionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:MotionWindowViewModel, IsDesignTimeCreatable=False}"
    Title="Motion Monitor"
    Width="1240"
    Height="720"
    MinWidth="1120"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource AppBgBrush}">
    <Window.Resources>
        <Style x:Key="MotionBit" TargetType="TextBlock" BasedOn="{StaticResource IoInputStateStyle}">
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="5,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="ON">
                    <Setter Property="Background" Value="{StaticResource IoInputOnBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MotionFaultBit" TargetType="TextBlock" BasedOn="{StaticResource MotionBit}">
            <Style.Triggers>
                <Trigger Property="Text" Value="ON">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Motion Monitor" Style="{StaticResource TitleStyle}"/>
            <Button Content="STOP"
                Command="{Binding StopCommand}"
                Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Right" MinWidth="100"
                ToolTip="Stop all machine operations."/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,6,0,16">
            <TextBlock Text="{Binding ControlStatus}" Foreground="{StaticResource AccentAmberBrush}" TextWrapping="Wrap"/>
            <TextBlock
                Text="All configured axes are monitored, including disabled axes · blue = ON · red = limit / alarm · — = read unavailable"
                Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SEARCH · AXIS NUMBER / MECHANISM / AXIS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Content="Enabled axes only"
                IsChecked="{Binding EnabledOnly}"
                Margin="20,0,0,0" VerticalAlignment="Bottom"/>
        </Grid>
        <Grid Grid.Row="3" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="108"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="196"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="NO." Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="1" Text="AXIS" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="2" Text="POSITION (mm)" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="3" Text="STATE" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="4" Text="SERVO" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="HOMED" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="HOME IN" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="7" Text="−LIMIT" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="8" Text="+LIMIT" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="9" Text="ALARM" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
        </Grid>
        <ListBox Grid.Row="4" ItemsSource="{Binding View}" Style="{StaticResource IoListStyle}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItemStyle}">
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}" HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type ui:MotionMonitorAxis}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="108"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="196"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Address}"
                            Style="{StaticResource IoAddressStyle}" ToolTip="Active controller axis number."/>
                        <TextBlock Grid.Column="1" Text="{Binding Axis}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2"
                            Text="{Binding Diagnostics.Snapshot.Position, StringFormat=F3, TargetNullValue=—}"
                            VerticalAlignment="Center" FontFamily="Consolas" FontSize="15"/>
                        <TextBlock Grid.Column="3"
                            ToolTip="{Binding Diagnostics.Snapshot.ReadError.Message}"
                            VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0">
                            <Run Text="{Binding Diagnostics.Snapshot.Condition, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}}"/>
                            <Run>
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter Property="Text" Value=" · Disabled"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                        <TextBlock Grid.Column="4"
                            Text="{Binding Diagnostics.Snapshot.State.ServoOn, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource MotionBit}"/>
                        <TextBlock Grid.Column="5"
                            Text="{Binding Diagnostics.Snapshot.State.Homed, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource MotionBit}"/>
                        <TextBlock Grid.Column="6"
                            Text="{Binding Diagnostics.Snapshot.State.HomeSensor, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource MotionBit}"/>
                        <TextBlock Grid.Column="7"
                            Text="{Binding Diagnostics.Snapshot.State.NegativeLimit, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource MotionFaultBit}"/>
                        <TextBlock Grid.Column="8"
                            Text="{Binding Diagnostics.Snapshot.State.PositiveLimit, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource MotionFaultBit}"/>
                        <TextBlock Grid.Column="9"
                            Text="{Binding Diagnostics.Snapshot.Faulted, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource MotionFaultBit}" ToolTip="Axis alarm or emergency."/>
                        <StackPanel Grid.Column="10" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="96" Margin="8,0,6,0" CommandParameter="{Binding}" Command="{Binding ToggleServoCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Content" Value="Servo ON"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Diagnostics.Snapshot.State.ServoOn}" Value="True">
                                                <Setter Property="Content" Value="Servo OFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Home" Width="80" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="{Binding HomeHint}"
                                ToolTipService.ShowOnDisabled="True"
                                CommandParameter="{Binding}"
                                Command="{Binding HomeAxisCommand}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
