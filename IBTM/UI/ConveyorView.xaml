                        <TextBlock Text="{Binding Signals.Inputs[PcbPlacementStopperUp].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Stopper up" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
