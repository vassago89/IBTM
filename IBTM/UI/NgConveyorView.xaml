<UserControl x:Class="IBTM.UI.NgConveyorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             xmlns:ng="clr-namespace:IBTM.NgConveyor;assembly=IBTM.NgConveyor"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
             Width="{x:Static ui:MachinePlan.InspectionWidth}"
             Height="{x:Static ui:MachinePlan.PlanHeight}">
    <UserControl.Resources>
        <Style x:Key="NgPositionStyle" TargetType="Border">
            <Setter Property="Width" Value="{StaticResource CarrierWidth}"/>
            <Setter Property="Height" Value="{StaticResource CarrierHeight}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <Style x:Key="PositionLabelStyle" TargetType="TextBlock"
               BasedOn="{StaticResource EquipmentRoleLabelStyle}">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,5,12,0"/>
            <Setter Property="Panel.ZIndex" Value="5"/>
            <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <Canvas>
        <StackPanel Canvas.Left="{x:Static ui:MachinePlan.NgStatusLeft}"
                    Canvas.Top="{x:Static ui:MachinePlan.StatusTop}" Width="170">
            <TextBlock Text="NG Conveyor" TextAlignment="Left"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>
            <TextBlock Text="{Binding State.Display.NgConveyorState, Converter={StaticResource EnumDescriptionConverter}}"
                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State.Display.NgConveyorState}" Value="{x:Static ng:NgConveyorState.WaitingForCarrier}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State.Display.NgConveyorState}" Value="{x:Static ng:NgConveyorState.ReadyToEject}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State.Display.NgConveyorState}" Value="{x:Static ng:NgConveyorState.Full}">
                                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NgConveyor.AlarmRequired}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <Grid Canvas.Left="{x:Static ui:MachinePlan.NgConveyorLeft}"
              Canvas.Top="{x:Static ui:MachinePlan.NgConveyorTop}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="5" Width="{x:Static ui:MachinePlan.NgConveyorWidth}"
                    Tag="{Binding NgConveyorRun.IsOn}" Style="{StaticResource ConveyorBedStyle}"/>
            <Border Height="{x:Static ui:MachinePlan.PlatePadding}"/>
            <Border Grid.Row="4" Height="{x:Static ui:MachinePlan.PlatePadding}"/>
            <Grid Grid.Row="1" Height="{x:Static ui:MachinePlan.NgPositionHeight}">
                <Border Style="{StaticResource NgPositionStyle}"/>
                <ui:CarrierView>
                    <ui:CarrierView.Style>
                        <Style TargetType="{x:Type ui:CarrierView}" BasedOn="{StaticResource CarrierStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Signals.Inputs[NgShuttleCarrierDetected].IsOn}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:CarrierView.Style>
                </ui:CarrierView>
                <Border x:Name="NgShuttle">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource NgPositionStyle}">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NgShuttle.Feedback.Lift}" Value="{x:Static ng:NgShuttleLiftState.Up}">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NgShuttle.Feedback.Lift}" Value="{x:Static ng:NgShuttleLiftState.Down}">
                                    <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
            <TextBlock Grid.Row="1" Text="P3" Style="{StaticResource PositionLabelStyle}"/>
            <Grid Grid.Row="2" Height="{x:Static ui:MachinePlan.NgPositionHeight}">
                <Border Style="{StaticResource NgPositionStyle}"/>
                <ui:CarrierView Visibility="{Binding Signals.Inputs[NgConveyorPosition2Occupied].IsOn, Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <TextBlock Grid.Row="2" Text="P2" Style="{StaticResource PositionLabelStyle}"/>
            <Grid Grid.Row="3" Height="{x:Static ui:MachinePlan.NgPositionHeight}">
                <Border Style="{StaticResource NgPositionStyle}"/>
                <ui:CarrierView Visibility="{Binding Signals.Inputs[NgConveyorPosition1Occupied].IsOn, Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <TextBlock Grid.Row="3" Text="P1 / EJECT" Style="{StaticResource PositionLabelStyle}"/>
        </Grid>
        <Border Canvas.Left="{x:Static ui:MachinePlan.NgStatusLeft}" Canvas.Top="132" Width="170" Style="{StaticResource MapIoCardStyle}">
            <StackPanel>
                <TextBlock Text="NG · LIVE I/O" Style="{StaticResource MapIoTitleStyle}"/>
                <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[NgShuttleCarrierDetected].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                    <TextBlock Text="{Binding Signals.Inputs[NgShuttleCarrierDetected].IsOn, Converter={StaticResource SignalTextConverter}}"
                               Style="{StaticResource MapIoInputStyle}"/>
                    <TextBlock Text="{Binding Signals.Inputs[NgShuttleCarrierDetected].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                    <TextBlock Text="DI P3" Style="{StaticResource MapIoLabelStyle}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[NgShuttleUp].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                    <TextBlock Text="{Binding Signals.Inputs[NgShuttleUp].IsOn, Converter={StaticResource SignalTextConverter}}"
                               Style="{StaticResource MapIoInputStyle}"/>
                    <TextBlock Text="{Binding Signals.Inputs[NgShuttleUp].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                    <TextBlock Text="DI Lift up" Style="{StaticResource MapIoLabelStyle}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[NgShuttleDown].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                    <TextBlock Text="{Binding Signals.Inputs[NgShuttleDown].IsOn, Converter={StaticResource SignalTextConverter}}"
                               Style="{StaticResource MapIoInputStyle}"/>
                    <TextBlock Text="{Binding Signals.Inputs[NgShuttleDown].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                    <TextBlock Text="DI Lift down" Style="{StaticResource MapIoLabelStyle}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[NgConveyorPosition2Occupied].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                    <TextBlock Text="{Binding Signals.Inputs[NgConveyorPosition2Occupied].IsOn, Converter={StaticResource SignalTextConverter}}"
                               Style="{StaticResource MapIoInputStyle}"/>
                    <TextBlock Text="{Binding Signals.Inputs[NgConveyorPosition2Occupied].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                    <TextBlock Text="DI P2" Style="{StaticResource MapIoLabelStyle}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[NgConveyorPosition1Occupied].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                    <TextBlock Text="{Binding Signals.Inputs[NgConveyorPosition1Occupied].IsOn, Converter={StaticResource SignalTextConverter}}"
                               Style="{StaticResource MapIoInputStyle}"/>
                    <TextBlock Text="{Binding Signals.Inputs[NgConveyorPosition1Occupied].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                    <TextBlock Text="DI P1" Style="{StaticResource MapIoLabelStyle}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[NgConveyorStopperUp].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                    <TextBlock Text="{Binding Signals.Inputs[NgConveyorStopperUp].IsOn, Converter={StaticResource SignalTextConverter}}"
                               Style="{StaticResource MapIoInputStyle}"/>
                    <TextBlock Text="{Binding Signals.Inputs[NgConveyorStopperUp].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                    <TextBlock Text="DI Stopper up" Style="{StaticResource MapIoLabelStyle}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[NgConveyorStopperDown].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                    <TextBlock Text="{Binding Signals.Inputs[NgConveyorStopperDown].IsOn, Converter={StaticResource SignalTextConverter}}"
                               Style="{StaticResource MapIoInputStyle}"/>
                    <TextBlock Text="{Binding Signals.Inputs[NgConveyorStopperDown].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                    <TextBlock Text="DI Stopper down" Style="{StaticResource MapIoLabelStyle}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Outputs[NgConveyorRun].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                    <TextBlock Text="{Binding Signals.Outputs[NgConveyorRun].IsOn, Converter={StaticResource SignalTextConverter}}"
                               Style="{StaticResource MapIoOutputStyle}"/>
                    <TextBlock Text="{Binding Signals.Outputs[NgConveyorRun].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                    <TextBlock Text="DO Run" Style="{StaticResource MapIoLabelStyle}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Outputs[NgConveyorReverse].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                    <TextBlock Text="{Binding Signals.Outputs[NgConveyorReverse].IsOn, Converter={StaticResource SignalTextConverter}}"
                               Style="{StaticResource MapIoOutputStyle}"/>
                    <TextBlock Text="{Binding Signals.Outputs[NgConveyorReverse].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                    <TextBlock Text="DO Reverse" Style="{StaticResource MapIoLabelStyle}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Outputs[NgConveyorNormalSpeed].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                    <TextBlock Text="{Binding Signals.Outputs[NgConveyorNormalSpeed].IsOn, Converter={StaticResource SignalTextConverter}}"
                               Style="{StaticResource MapIoOutputStyle}"/>
                    <TextBlock Text="{Binding Signals.Outputs[NgConveyorNormalSpeed].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                    <TextBlock Text="DO Normal spd" Style="{StaticResource MapIoLabelStyle}"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Canvas>
</UserControl>
