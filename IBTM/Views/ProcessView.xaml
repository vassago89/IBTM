<UserControl x:Class="IBTM.Views.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IBTM.ViewModels"
             xmlns:conv="clr-namespace:IBTM.Converters"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <conv:StageStatusToBrushConverter      x:Key="StatusToBrush"/>
        <conv:StageStatusToBackgroundConverter x:Key="StatusToBg"/>
        <conv:LogLevelToBrushConverter         x:Key="LogLevelToBrush"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InspectionResultToBrushConverter x:Key="InspResultToBrush"/>
        <conv:BoolToOpacityConverter           x:Key="BoolToOpacity"/>
        <conv:NgSlotFillConverter              x:Key="NgSlotFill"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>   <!-- Row 0: 통계 바 -->
            <RowDefinition Height="190"/>  <!-- Row 1: 공정 흐름 카드 -->
            <RowDefinition Height="120"/>  <!-- Row 2: 라우팅 분기 (NG / GOOD) -->
            <RowDefinition Height="88"/>   <!-- Row 3: 축 위치 + 볼트 진행 -->
            <RowDefinition Height="58"/>   <!-- Row 4: 제어 버튼 -->
            <RowDefinition Height="*"/>    <!-- Row 5: 이벤트 로그 -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════
             NG 알람 배너 (알람 시 Row 1 최상위 오버레이)
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Panel.ZIndex="10"
                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Margin="16,8,16,0"
                Background="#D08B1A1A"
                BorderBrush="{StaticResource AccentRedBrush}"
                BorderThickness="1" CornerRadius="6"
                Padding="16,10"
                Visibility="{Binding NgStackAlarm, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="&#x26A0;  " FontSize="16"
                               Foreground="{StaticResource AccentRedBrush}" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentRedBrush}">
                        <Run Text="NG 적재 수량 초과 ("/>
                        <Run Text="{Binding NgStackCount}"/>
                        <Run Text="개) &#x2014; 작업자 NG 스택 확인 후 리셋하세요"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="NG 리셋"
                        Command="{Binding ResetNgStackCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Padding="12,5"/>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════
             Row 0: 생산 통계 바
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBgBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="총 생산" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat='{}{0:N0} ea'}"
                               Style="{StaticResource StatValueStyle}"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Fill="{StaticResource DividerBrush}" Margin="0,10"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="GOOD" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding GoodCount, StringFormat='{}{0:N0} ea'}"
                               Style="{StaticResource StatValueStyle}"
                               Foreground="{StaticResource AccentGreenBrush}"/>
                </StackPanel>
                <Rectangle Grid.Column="3" Fill="{StaticResource DividerBrush}" Margin="0,10"/>

                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="NG" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding NgCount, StringFormat='{}{0:N0} ea'}"
                               Style="{StaticResource StatValueStyle}"
                               Foreground="{StaticResource AccentRedBrush}"/>
                </StackPanel>
                <Rectangle Grid.Column="5" Fill="{StaticResource DividerBrush}" Margin="0,10"/>

                <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="NG율" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding NgRate, StringFormat='{}{0:F2} %'}"
                               Style="{StaticResource StatValueStyle}"
                               Foreground="{StaticResource AccentOrangeBrush}"/>
                </StackPanel>
                <Rectangle Grid.Column="7" Fill="{StaticResource DividerBrush}" Margin="0,10"/>

                <StackPanel Grid.Column="8" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="Cycle Time" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding LastCycleTime, StringFormat='{}{0:F1} s'}"
                               Style="{StaticResource StatValueStyle}"/>
                </StackPanel>
                <Rectangle Grid.Column="9" Fill="{StaticResource DividerBrush}" Margin="0,10"/>

                <StackPanel Grid.Column="10" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="가동 시간" Style="{StaticResource StatLabelStyle}"/>
                    <TextBlock Text="{Binding Uptime}"
                               Style="{StaticResource StatValueStyle}"
                               Foreground="{StaticResource AccentCyanBrush}"/>
                </StackPanel>

                <Border Grid.Column="12" VerticalAlignment="Center"
                        Background="#1A58A6FF" CornerRadius="4" Padding="12,5">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource AccentBlueBrush}"
                               FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════
             Row 1: 공정 흐름 카드 (7장, 병렬 시 동시 Running 가능)
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource AppBgBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid>
                <TextBlock Text="PROCESS FLOW" Margin="24,10,0,0"
                           VerticalAlignment="Top"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10" FontWeight="SemiBold"/>

                <ItemsControl ItemsSource="{Binding Stages}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,20,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StageCardViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <!-- 스테이지 카드 -->
                                <Border Width="140" Height="152" CornerRadius="10"
                                        Background="{Binding Status, Converter={StaticResource StatusToBg}}"
                                        BorderThickness="1.5"
                                        BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                    <Grid Margin="10,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Icon}" FontSize="16"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                       VerticalAlignment="Center"/>
                                            <Ellipse Width="9" Height="9"
                                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                     Opacity="{Binding IndicatorOpacity}"/>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding Title}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="2" Text="{Binding Subtitle}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,6"/>

                                        <StackPanel Grid.Row="3">
                                            <TextBlock Text="{Binding Info1}"
                                                       FontSize="10" FontFamily="Consolas"
                                                       Foreground="{Binding Info1, Converter={StaticResource InspResultToBrush}}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Info2}"
                                                       FontSize="10" FontFamily="Consolas"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 화살표 (마지막 카드 제외) -->
                                <Grid Width="24"
                                      Visibility="{Binding IsLastCard, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock Text="&#x203A;" FontSize="28"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════
             Row 2: 라우팅 분기 (NG / GOOD 경로 시각화)
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBgBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <!-- 결과 배지 -->
                    <ColumnDefinition Width="90"/>
                    <!-- 세로 구분선 -->
                    <ColumnDefinition Width="1"/>
                    <!-- NG 경로 -->
                    <ColumnDefinition Width="*"/>
                    <!-- 세로 구분선 -->
                    <ColumnDefinition Width="1"/>
                    <!-- GOOD 경로 -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── 결과 배지 ────────────────────────────────────── -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="RESULT" FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Border CornerRadius="6" Padding="10,5" HorizontalAlignment="Center"
                            BorderThickness="1.5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1C2033"/>
                                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNgPath}" Value="True">
                                        <Setter Property="Background" Value="#2A1010"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGoodPath}" Value="True">
                                        <Setter Property="Background" Value="#102A10"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding LastRouteText}"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNgPath}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsGoodPath}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <Rectangle Grid.Column="1" Fill="{StaticResource DividerBrush}" Margin="0,12"/>

                <!-- ── NG 경로 ──────────────────────────────────────── -->
                <Border Grid.Column="2" Margin="0,10" CornerRadius="8"
                        Padding="12,8" BorderThickness="1"
                        Opacity="{Binding IsNgPath, Converter={StaticResource BoolToOpacity}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#14151A"/>
                            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNgPath}" Value="True">
                                    <Setter Property="Background" Value="#1F1010"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- NG 경로 헤더 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="{StaticResource AccentRedBrush}" CornerRadius="3"
                                    Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="NG" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="NG ROUTE" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentRedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- NG 서브 스테이지 + 스택 시각화 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- NG 라우팅 서브 스테이지 칩 -->
                            <ItemsControl ItemsSource="{Binding NgRoutePath}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RouteStageItem}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="5" Padding="8,4"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBg}}"
                                                    BorderThickness="1"
                                                    BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                            </Border>
                                            <TextBlock Text=" &#x203A; " FontSize="14"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- NG 스택 시각화 (슬롯 박스) -->
                            <Border CornerRadius="5" Padding="8,4"
                                    Background="#1C2033" BorderThickness="1"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="STACK " FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- 슬롯 박스 -->
                                    <ItemsControl ItemsSource="{Binding NgStackSlots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NgSlotViewModel}">
                                                <Border Width="24" Height="24" CornerRadius="3" Margin="2,0"
                                                        BorderThickness="1.5"
                                                        BorderBrush="{StaticResource AccentRedBrush}"
                                                        Background="{Binding IsFilled, Converter={StaticResource NgSlotFill}}">
                                                    <TextBlock VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               FontSize="10"
                                                               Visibility="{Binding IsFilled, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#x25A0;"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 카운트 텍스트 -->
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                               FontSize="13" FontWeight="Bold" FontFamily="Consolas">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NgStackAlarm}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding NgStackCount, Mode=OneWay}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding NgStackSlots.Count, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- ALARM 배지 -->
                                    <Border Margin="6,0,0,0"
                                            Background="{StaticResource AccentRedBrush}"
                                            CornerRadius="3" Padding="5,2"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding NgStackAlarm, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="ALARM" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <Rectangle Grid.Column="3" Fill="{StaticResource DividerBrush}" Margin="0,12"/>

                <!-- ── GOOD 경로 ─────────────────────────────────────── -->
                <Border Grid.Column="4" Margin="0,10" CornerRadius="8"
                        Padding="12,8" BorderThickness="1"
                        Opacity="{Binding IsGoodPath, Converter={StaticResource BoolToOpacity}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#14151A"/>
                            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGoodPath}" Value="True">
                                    <Setter Property="Background" Value="#10201A"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- GOOD 경로 헤더 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="{StaticResource AccentGreenBrush}" CornerRadius="3"
                                    Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="GOOD" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="GOOD ROUTE" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentGreenBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- GOOD 서브 스테이지 칩 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">

                            <ItemsControl ItemsSource="{Binding GoodRoutePath}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RouteStageItem}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="5" Padding="8,4"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBg}}"
                                                    BorderThickness="1"
                                                    BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                            </Border>
                                            <TextBlock Text=" &#x203A; " FontSize="14"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- OUT 인디케이터 -->
                            <Border CornerRadius="5" Padding="8,4"
                                    VerticalAlignment="Center"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1C2033"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGoodPath}" Value="True">
                                                <Setter Property="Background" Value="#10201A"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#x25BA;&#x25BA; OUT"
                                           FontSize="12" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGoodPath}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════
             Row 3: 축 위치 + 볼트 진행
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource PanelBgBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <!-- Transfer 축 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="TRANSFER AXIS" Margin="0,0,0,4"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TransferPos}"
                               FontFamily="Consolas" FontSize="13"
                               Foreground="{StaticResource AccentBlueBrush}"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Fill="{StaticResource DividerBrush}" Margin="0,12"/>

                <!-- Fiducial 축 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="FIDUCIAL / BOLT AXIS" Margin="0,0,0,4"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding FiducialPos}"
                               FontFamily="Consolas" FontSize="13"
                               Foreground="{StaticResource AccentCyanBrush}"/>
                </StackPanel>
                <Rectangle Grid.Column="3" Fill="{StaticResource DividerBrush}" Margin="0,12"/>

                <!-- 볼트 진행 -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="BOLT PROGRESS" Margin="0,0,0,4"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding BoltProgress}"
                               FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource AccentOrangeBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════
             Row 4: 제어 버튼
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{StaticResource PanelBgBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">

                <!-- 업스트림 라인 도착 상태 표시 -->
                <Border VerticalAlignment="Center" Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,5" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="INPUT  " VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>

                        <!-- Line 1 인디케이터 -->
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLine1Ready}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="L1" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <!-- Line 2 인디케이터 -->
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLine2Ready}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="L2" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 목표 토크 -->
                <Border VerticalAlignment="Center" Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,4" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="기본 토크: " VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <TextBox Text="{Binding TargetTorque, StringFormat='{}{0:F1}', UpdateSourceTrigger=LostFocus}"
                                 VerticalAlignment="Center" FontSize="12"
                                 MinWidth="55" TextAlignment="Right"/>
                        <TextBlock Text=" Nm" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Button Content="&#x25BA;  시작"
                        Command="{Binding StartCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="100" Margin="0,0,8,0"/>

                <Button Content="&#x25A0;  정지"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="100" Margin="0,0,8,0"/>

                <Button Content="&#x26A0;  E-STOP"
                        Command="{Binding EStopCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        MinWidth="120" Margin="0,0,16,0"/>

                <!-- NG 리셋 (알람 시만 표시) -->
                <Button Content="NG 리셋"
                        Command="{Binding ResetNgStackCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="80"
                        Visibility="{Binding NgStackAlarm, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════
             Row 5: 이벤트 로그
             ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBgBrush}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource DividerBrush}"
                    Padding="24,0">
                <TextBlock Text="EVENT LOG" VerticalAlignment="Center"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </Border>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Logs}"
                     Style="{StaticResource LogListBoxStyle}"
                     ItemContainerStyle="{StaticResource LogListBoxItemStyle}"
                     Padding="8,4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding FormattedTime}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Stage}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Message}"
                                       FontSize="12"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

    </Grid>
</UserControl>
