<Window x:Class="IBTM.UI.Station1RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:IBTM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ui:PcbPlacementRecoveryViewModel, IsDesignTimeCreatable=False}"
        Title="Station 1 Work Setup"
        Width="520"
        Height="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Station 1 Work Setup"
                   Style="{StaticResource TitleStyle}"/>
        <TextBlock Grid.Row="1"
                   Margin="0,5,0,16"
                   Text="Check heat sinks with PCB already placed. Unchecked heat sinks run again."
                   TextWrapping="Wrap"
                   Style="{StaticResource PageSubtitleStyle}"/>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HEAT SINK"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Grid.Column="1"
                               Text="COMPLETED"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionHeaderStyle}"/>
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,1,0,0">
                                <Grid Height="52" Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding HeatSink,
                                                Converter={StaticResource EnumDescriptionConverter}}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <CheckBox Grid.Column="1"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Completed}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="78"
                    Margin="0,0,6,0"/>
            <Button Content="Apply"
                    IsDefault="True"
                    Click="OnApply"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="78"/>
        </StackPanel>
    </Grid>
</Window>
