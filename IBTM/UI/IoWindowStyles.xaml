<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:IBTM.UI">

    <ui:TeachingOutputConverter x:Key="TeachingOutputConverter"/>
    <SolidColorBrush x:Key="IoInputOnBrush" Color="#39BAFF"/>
    <SolidColorBrush x:Key="IoOutputOnBrush" Color="#FFD166"/>

    <Style x:Key="IoAddressStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip" Value="Configured I/O channel number. Paired outputs show ON / OFF numbers."/>
    </Style>

    <Style x:Key="IoListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
    </Style>

    <DataTemplate x:Key="IoGroupHeaderTemplate">
        <Grid Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding ItemCount, StringFormat={}{0} items}"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <Style x:Key="IoGroupItemStyle" TargetType="GroupItem">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource ControlBgBrush}"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="4,4,0,0">
                                <ContentPresenter/>
                            </Border>
                            <ItemsPresenter Grid.Row="1"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="IoSectionGroupHeaderTemplate">
        <Border x:Name="Header"
                Padding="12,7"
                Background="{StaticResource EquipBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                <Setter TargetName="Header" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="IoSectionGroupItemStyle" TargetType="GroupItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter/>
                        <ItemsPresenter Grid.Row="1"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IoListItemStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource FlatListItemStyle}">
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="IoToggleButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="IoInputListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource IoListItemStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOn}" Value="True">
                <Setter Property="Background" Value="#173B50"/>
                <Setter Property="BorderBrush" Value="{StaticResource IoInputOnBrush}"/>
                <Setter Property="BorderThickness" Value="3,0,0,1"/>
                <Setter Property="Padding" Value="8,7,11,7"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IoOutputListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource IoListItemStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Io.IsOn}" Value="True">
                <Setter Property="Background" Value="#493B21"/>
                <Setter Property="BorderBrush" Value="{StaticResource IoOutputOnBrush}"/>
                <Setter Property="BorderThickness" Value="3,0,0,1"/>
                <Setter Property="Padding" Value="8,7,11,7"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IoInputLedStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Fill" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Fill" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="Stroke" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="StrokeThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IoInputStateStyle" TargetType="ContentControl">
        <Setter Property="Content" Value="—"/>
        <Setter Property="ToolTip" Value="UNKNOWN: feedback is unavailable."/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="Background" Value="#222C32"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinWidth" Value="68"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="Indicator" Width="10" Height="10" Fill="Transparent"
                                     Stroke="{TemplateBinding Foreground}" StrokeThickness="1"/>
                            <TextBlock Margin="7,0,0,0" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="Indicator" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                <Setter Property="Content" Value="OFF"/>
                <Setter Property="ToolTip" Value="OFF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Content" Value="ON"/>
                <Setter Property="ToolTip" Value="ON"/>
                <Setter Property="Foreground" Value="#0D1B26"/>
                <Setter Property="Background" Value="{StaticResource IoInputOnBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource IoInputOnBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IoOutputStateStyle" TargetType="ContentControl" BasedOn="{StaticResource IoInputStateStyle}">
        <Setter Property="Content" Value="—"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Content" Value="ON"/>
                <Setter Property="Background" Value="{StaticResource IoOutputOnBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource IoOutputOnBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="False">
                <Setter Property="Content" Value="OFF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="IoFilterTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SEARCH" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBox Margin="0,6,0,0"
                         ToolTip="Search by signal name or configured I/O number."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="UNIT" Style="{StaticResource SectionHeaderStyle}"/>
                <ComboBox Margin="0,6,0,0" ItemsSource="{Binding Areas}"
                          ItemTemplate="{x:Null}" DisplayMemberPath="Value"
                          SelectedItem="{Binding SelectedArea, Mode=TwoWay}"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="IoSignalReadoutTemplate">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Address}" Style="{StaticResource IoAddressStyle}" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                       TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            <ContentControl Grid.Column="2" Tag="{Binding IsOn}"
                            Style="{StaticResource IoInputStateStyle}" FontSize="11"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="IoStatusTemplate">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Related I/O" Style="{StaticResource PanelTitleStyle}"/>
                <TextBlock Text="DI = feedback · DO = command"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ui:IoGroupList ItemsSource="{Binding IoGroups}">
                    <ui:IoGroupList.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,10,18">
                                <TextBlock Text="{Binding Area, Converter={StaticResource EnumDescriptionConverter}}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Sensors}"
                                              ItemTemplate="{StaticResource IoSignalReadoutTemplate}"/>
                                <ItemsControl ItemsSource="{Binding Outputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,8,0,0">
                                                <Grid Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="72"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                               TextWrapping="Wrap" Margin="0,0,8,0" FontSize="12"
                                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <ContentControl Grid.Column="1" Tag="{Binding IsOn}"
                                                                    Style="{StaticResource IoOutputStateStyle}" FontSize="11"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Feedback}" Margin="12,0,0,0"
                                                              ItemTemplate="{StaticResource IoSignalReadoutTemplate}"/>
                                                <ContentControl HorizontalAlignment="Right" Margin="0,4,0,0">
                                                    <ContentControl.Content>
                                                        <MultiBinding Converter="{StaticResource TeachingOutputConverter}">
                                                            <Binding Path="Signal"/>
                                                            <Binding Path="DataContext.TeachingOutputs" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </ContentControl.Content>
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Style.Triggers>
                                                                <Trigger Property="Content" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                    <ContentControl.ContentTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <StackPanel x:Name="SwitchButtons" Orientation="Horizontal">
                                                                    <Button Content="ON" CommandParameter="{Binding}"
                                                                            Command="{Binding DataContext.SetOutputOnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" MinWidth="48" Margin="0,0,6,0"/>
                                                                    <Button Content="OFF" CommandParameter="{Binding}"
                                                                            Command="{Binding DataContext.SetOutputOffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" MinWidth="48"/>
                                                                </StackPanel>
                                                                <ui:HoldButton x:Name="HoldOutput" Content="HOLD" Visibility="Collapsed"
                                                                               ToolTip="Hold to run; release to stop."
                                                                               CommandParameter="{Binding}"
                                                                               PressCommand="{Binding DataContext.SetOutputOnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                               ReleaseCommand="{Binding DataContext.SetOutputOnCancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                               Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" MinWidth="102"/>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding HoldToRun}" Value="True">
                                                                    <Setter TargetName="SwitchButtons" Property="Visibility" Value="Collapsed"/>
                                                                    <Setter TargetName="HoldOutput" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ContentControl.ContentTemplate>
                                                </ContentControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ui:IoGroupList.ItemTemplate>
                </ui:IoGroupList>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
