<Window x:Class="IBTM.UI.AdcProtocolWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    xmlns:hantas="clr-namespace:IBTM.Hantas;assembly=IBTM.Hantas"
    xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:AdcProtocolViewModel, IsDesignTimeCreatable=False}"
    Title="{ui:Text 'HANTAS ADC Protocol'}"
    Width="1120"
    Height="980"
    MinWidth="960"
    MinHeight="680"
    FontSize="14" WindowStartupLocation="CenterOwner"
    Background="{StaticResource AppBgBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition MinHeight="180">
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="*"/>
                        <Setter Property="MaxHeight" Value="280"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ProtocolTabs, Path=SelectedIndex}" Value="1">
                                <Setter Property="Height" Value="3*"/>
                                <Setter Property="MaxHeight" Value="800"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{ui:Text 'HANTAS ADC Protocol'}" Style="{StaticResource TitleStyle}"/>
            <ComboBox Margin="0,10,0,0" Width="220" HorizontalAlignment="Left"
                ItemsSource="{Binding Heads}" SelectedItem="{Binding SelectedHead, Mode=TwoWay}"
                IsEnabled="{Binding ConnectionControlsEnabled}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:FasteningHead}">
                        <TextBlock Text="{Binding Converter={StaticResource UiTextConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,12" Padding="16,14" Style="{StaticResource CardStyle}">
            <Grid IsEnabled="{Binding ConnectionControlsEnabled}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{ui:Text 'Port'}" VerticalAlignment="Center" Style="{StaticResource SectionHeaderStyle}"/>
                <ComboBox Grid.Column="1" Margin="10,0,8,0"
                    ItemsSource="{Binding PortNames}"
                    SelectedItem="{Binding SelectedPort, Mode=TwoWay}" IsEnabled="{Binding PortSelectionEnabled}"/>
                <Button Grid.Column="2" Content="{ui:Text 'Refresh Ports'}" Padding="12,5"
                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshPortsCommand}" IsEnabled="{Binding PortSelectionEnabled}"/>

                <ComboBox IsEnabled="{Binding PortSelectionEnabled}" SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}" Grid.Column="3" Margin="16,0,0,0" ItemsSource="{Binding BaudRates}"/>

                <TextBlock Grid.Column="4" Margin="16,0,0,0" Text="{ui:Text 'Slave'}" VerticalAlignment="Center"
                    Style="{StaticResource SectionHeaderStyle}"/>
                <TextBox IsEnabled="{Binding SlaveSelectionEnabled}" Grid.Column="5" Margin="10,0,0,0" Text="{Binding SlaveText, UpdateSourceTrigger=PropertyChanged}"/>

                <Button x:Name="ConnectButton" Grid.Column="6" Margin="16,0,0,0"
                    Content="{Binding ConnectionAction}" Width="110"
                    Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ToggleConnectionCommand}" IsEnabled="{Binding IsConnectAllowed}"/>
                <TextBlock Grid.Column="7" Margin="16,0,0,0"
                    Text="{Binding ConnectionStatus}" TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding ConnectionStatus}" ToolTipService.ShowOnDisabled="True"
                    VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Padding="18,16" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="{ui:Text 'Controller'}" VerticalAlignment="Center" Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:HoldButton Content="{ui:Text 'Loosen (hold)'}" Margin="0,0,8,0"
                                PressCommand="{Binding ReverseCommand}"
                                ReleaseCommand="{Binding ReleaseReverseCommand}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{ui:Text 'Release or STOP to stop rotation.'}">
                                <ui:HoldButton.Style>
                                    <Style TargetType="ui:HoldButton" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="IsEnabled" Value="{Binding IsTestBoltHeadAllowed}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReverseCommand.IsRunning}" Value="True"><Setter Property="IsEnabled" Value="True"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:HoldButton.Style>
                            </ui:HoldButton>
                            <Button Content="{ui:Text 'Stop'}" Style="{StaticResource DangerButtonStyle}" Command="{Binding StopCommand}" IsEnabled="{Binding IsStopAllowed}"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel IsEnabled="{Binding ProtocolEnabled}">
                            <Button Content="{ui:Text 'Select Preset 1'}"
                                Margin="0,14,0,12" HorizontalAlignment="Left" Padding="14,5"
                                Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectPresetCommand}"/>

                            <WrapPanel Margin="0,0,0,14">
                                <Button Content="{ui:Text 'Start Fastening'}" Margin="0,0,8,8"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{ui:Text 'Clear interrupted work, then RESET.'}"
                                    Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartCommand}" IsEnabled="{Binding IsTestBoltHeadAllowed}"/>
                                <Button Content="{ui:Text 'Alarm Reset'}" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ResetAlarmCommand}"/>
                                <Button Content="{ui:Text 'Read Last Result'}" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ReadResultCommand}"/>
                                <Button Content="{ui:Text 'Read Device Info'}" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ReadDeviceInformationCommand}"/>
                                <Button Content="{ui:Text 'Capture RX (3s)'}" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CaptureDeviceInformationCommand}"/>
                            </WrapPanel>

                            <TextBlock Text="{ui:Text 'CONTROLLER / LAST RESULT'}" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas">
                                <Run Text="{ui:Text 'Ready '}"/><Run Text="{Binding Bus.Monitor.Sample.Status.Ready, Converter={StaticResource SignalTextConverter}, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"/>
                                <Run Text="{ui:Text '  Run '}"/><Run Text="{Binding Bus.Monitor.Sample.Status.Running, Converter={StaticResource SignalTextConverter}, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"/>
                                <Run Text="{ui:Text '  Preset '}"/><Run Text="{Binding Bus.Monitor.Sample.Status.Preset, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"/>
                                <LineBreak/><Run Text="{ui:Text 'Alarm '}"/><Run Text="{Binding Bus.Monitor.Sample.Status.Alarm, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"/>
                            </TextBlock>
                            <ScrollViewer Height="48" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="{Binding Bus.Monitor.Sample.Error.Message}" TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}"/>
                                    <TextBlock Text="{Binding Bus.Monitor.Sample.Rejection}" TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}"/>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock Margin="0,10,0,0"
                                Text="{Binding ResultMessage}"
                                Tag="{Binding ResultSuccess}" Style="{StaticResource ResultValueStyle}"
                                TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Padding="18,16" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsEnabled="{Binding ProtocolEnabled}">
                        <TextBlock Text="{ui:Text 'Register access'}" Style="{StaticResource SectionHeaderStyle}"/>

                        <ComboBox SelectedItem="{Binding RegisterAccess, Mode=TwoWay}" Margin="0,14,0,12" ItemsSource="{Binding RegisterAccesses}"/>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RegisterAccess}" Value="{x:Static device:AdcFunctionCode.RequestTorqueCurve}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{ui:Text 'Address'}" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBox Margin="0,6,0,0" Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{ui:Text 'Count'}" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBox Margin="0,6,0,0" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{ui:Text 'Value'}" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBox Margin="0,6,0,0" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="{ui:Text 'Send Command'}" Margin="0,14,0,14" HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExecuteRegisterCommand}"/>

                        <TextBlock Text="{ui:Text 'Response'}" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                            Text="{Binding RegisterResult}"
                            TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TabControl x:Name="ProtocolTabs" Grid.Row="3" Style="{StaticResource SectionTabs}" ItemContainerStyle="{StaticResource SectionTab}">
        <TabItem Header="{ui:Text 'Frame Log'}">
        <Border Padding="18,14" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Content="{ui:Text 'Pause display'}" IsChecked="{Binding IsLogPaused}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="{ui:Text 'Copy'}" Command="{Binding CopyLogCommand}" Padding="12,4" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="{ui:Text 'Copy all'}" Command="{Binding CopyAllLogCommand}" Padding="12,4" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="{ui:Text 'Clear Display'}" Command="{Binding ClearLogCommand}" Padding="12,4" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
                <ui:LogTextBox x:Name="FrameLogBox" Style="{StaticResource FieldTextBoxStyle}" Grid.Row="1" Margin="0,8,0,0"
                    Text="{Binding FrameLogText, Mode=OneWay}"
                    IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" IsInactiveSelectionHighlightEnabled="True"
                    SelectionText="{Binding SelectedLogText, Mode=TwoWay}" IsPaused="{Binding IsLogPaused, Mode=TwoWay}" FontFamily="Cascadia Mono, Consolas" FontSize="13" TextWrapping="NoWrap"
                    Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <TextBlock Grid.Row="2" Text="{Binding ClipboardError}" Height="20" Foreground="{StaticResource AccentRedBrush}"
                    TextTrimming="CharacterEllipsis" ToolTip="{Binding ClipboardError}"/>
            </Grid>
        </Border>
        </TabItem>
        <TabItem Header="{ui:Text '오류 코드 / 조치'}">
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="1" Text="{Binding Source={x:Static hantas:AdcControllerError.ReferenceNote}, Converter={StaticResource UiTextConverter}}" TextWrapping="Wrap"
                    Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,8,0,0"/>
                <DataGrid ItemsSource="{x:Static hantas:AdcControllerError.All}" IsReadOnly="True"
                    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                    Background="{StaticResource ControlBgBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                    <DataGrid.Resources>
                        <Style x:Key="ErrorReferenceText" TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="0,4,8,4"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{ui:Text '코드 · 10진수 (16진수)'}" Binding="{Binding CodeText, Mode=OneWay}" Width="180"/>
                        <DataGridTextColumn Header="{ui:Text '분류'}" Binding="{Binding Group, Mode=OneWay, Converter={StaticResource UiTextConverter}}" Width="115"/>
                        <DataGridTextColumn Header="{ui:Text '의미'}" Binding="{Binding Description, Mode=OneWay, Converter={StaticResource UiTextConverter}}" ElementStyle="{StaticResource ErrorReferenceText}" Width="*"/>
                        <DataGridTextColumn Header="{ui:Text '확인 / 조치'}" Binding="{Binding Action, Mode=OneWay, Converter={StaticResource UiTextConverter}}" ElementStyle="{StaticResource ErrorReferenceText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        </TabControl>
    </Grid>
</Window>
