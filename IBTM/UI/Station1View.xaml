<UserControl x:Class="IBTM.UI.Station1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="566"
             Height="414">
    <Grid>
        <Border Style="{DynamicResource CellStyle}"/>

        <Canvas>
            <TextBlock Canvas.Left="18" Canvas.Top="18"
                       Text="STATION 1 · PCB HANDLING"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"/>

            <StackPanel Canvas.Left="18" Canvas.Top="50"
                        Orientation="Horizontal">
                <Border Tag="{Binding SupplyTone}"
                        Style="{DynamicResource StateBadgeStyle}"
                        Margin="0,0,8,0">
                    <TextBlock Style="{DynamicResource MapHintStyle}">
                        <Run Text="SUPPLY  "/>
                        <Run Text="{Binding SupplyDisplayState,
                                            Converter={StaticResource EnumDescriptionConverter}}"/>
                    </TextBlock>
                </Border>
                <Border Tag="{Binding PlacementTone}"
                        Style="{DynamicResource StateBadgeStyle}">
                    <TextBlock Style="{DynamicResource MapHintStyle}">
                        <Run Text="PLACEMENT  "/>
                        <Run Text="{Binding PlacementDisplayState,
                                            Converter={StaticResource EnumDescriptionConverter}}"/>
                    </TextBlock>
                </Border>
            </StackPanel>

            <Border Canvas.Left="18" Canvas.Top="98"
                    Width="112" Height="78"
                    Tag="{Binding PcbSupplyUpstreamBoardAvailable}"
                    Style="{DynamicResource StageBodyStyle}">
                <TextBlock Text="PCB CARRIER"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{DynamicResource MapHintStyle}"/>
            </Border>

            <TextBlock Canvas.Left="24" Canvas.Top="186"
                       Text="SMEMA IN"
                       Style="{DynamicResource MapHintStyle}"/>

            <Grid Canvas.Left="{Binding PcbSupplyMapLeft}"
                  Canvas.Top="88"
                  Width="82" Height="104"
                  Panel.ZIndex="20">
                <Grid Width="72" Height="38"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="{Binding PcbSupplyRotationAngle}"/>
                    </Grid.RenderTransform>
                    <Border Tag="{Binding PcbSupplyActive}"
                            Style="{DynamicResource DeviceBodyStyle}"/>
                    <TextBlock Text="SUPPLY"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,3,0,0"
                               Style="{DynamicResource MapHintStyle}"/>
                    <Border Width="46" Height="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,3"
                            Background="{DynamicResource MaterialPcbBrush}"
                            CornerRadius="2"
                            Visibility="{Binding PcbSupplyPcbDetected,
                                                 Converter={StaticResource BoolToVis}}"/>
                    <Border Tag="{Binding PcbSupplyGripperClosed}"
                            Style="{DynamicResource LeftGripperJawStyle}"/>
                    <Border Tag="{Binding PcbSupplyGripperClosed}"
                            Style="{DynamicResource RightGripperJawStyle}"/>
                </Grid>
            </Grid>

            <Border Canvas.Left="302" Canvas.Top="98"
                    Width="104" Height="92"
                    Style="{DynamicResource BufferStyle}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="BUFFER"
                               Style="{DynamicResource MapLabelStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BufferOwner,
                                             Converter={StaticResource EnumDescriptionConverter}}"
                               Style="{DynamicResource MapHintStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                    <Border Width="48" Height="14"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0"
                            Background="{DynamicResource MaterialPcbBrush}"
                            CornerRadius="2"
                            Visibility="{Binding PcbBufferPcbPresent,
                                                 Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <Grid Canvas.Left="{Binding PcbPlacementMapLeft}"
                  Canvas.Top="{Binding PcbPlacementMapTop}"
                  Width="82" Height="88"
                  Panel.ZIndex="21">
                <Grid Width="74" Height="38"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom">
                    <Border Tag="{Binding PcbPlacementActive}"
                            Style="{DynamicResource DeviceBodyStyle}"/>
                    <TextBlock Text="PLACE"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,3,0,0"
                               Style="{DynamicResource MapHintStyle}"/>
                    <Border Width="48" Height="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,3"
                            Background="{DynamicResource MaterialPcbBrush}"
                            CornerRadius="2"
                            Visibility="{Binding PcbPlacementPcbDetected,
                                                 Converter={StaticResource BoolToVis}}"/>
                    <Border Tag="{Binding PcbPlacementGripperClosed}"
                            Style="{DynamicResource LeftGripperJawStyle}"/>
                    <Border Tag="{Binding PcbPlacementGripperClosed}"
                            Style="{DynamicResource RightGripperJawStyle}"/>
                </Grid>
            </Grid>

            <Grid Canvas.Left="324" Canvas.Top="272"
                  Width="58" Height="58">
                <Ellipse Tag="{Binding PcbPlacementLaserOutput}"
                         Style="{DynamicResource LightVisualStyle}"/>
                <Ellipse Width="38" Height="38"
                         Stroke="{StaticResource DividerBrush}"/>
                <TextBlock Text="C"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"/>
            </Grid>
            <TextBlock Canvas.Left="312" Canvas.Top="336"
                       Width="84"
                       Text="ALIGN CAMERA"
                       TextAlignment="Center"
                       Style="{DynamicResource MapHintStyle}"/>

            <TextBlock Canvas.Left="18" Canvas.Top="244"
                       Text="SUPPLY"
                       Style="{DynamicResource MapLabelStyle}"/>
            <TextBlock Canvas.Left="18" Canvas.Top="269"
                       Text="{Binding PcbSupplyPosition}"
                       Style="{DynamicResource MapHintStyle}"/>

            <TextBlock Canvas.Left="406" Canvas.Top="244"
                       Text="PLACEMENT"
                       Style="{DynamicResource MapLabelStyle}"/>
            <TextBlock Canvas.Left="406" Canvas.Top="269"
                       Text="{Binding PcbPlacementPosition}"
                       Style="{DynamicResource MapHintStyle}"/>
        </Canvas>
    </Grid>
</UserControl>
