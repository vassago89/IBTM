<UserControl x:Class="IBTM.UI.SupplyTeachingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
             xmlns:ui="clr-namespace:IBTM.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:SupplyTeachingViewModel, IsDesignTimeCreatable=False}"
             Foreground="{StaticResource TextPrimaryBrush}"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedPoints" Source="{Binding Points}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="MotionGroup"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Supply Teaching"
                   Style="{StaticResource TitleStyle}"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding ActiveMotionGroup, Converter={StaticResource EnumDescriptionConverter}}"
                               Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,16"/>
                    <ui:TeachingMotionView/>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding HorizontalZTarget, Converter={StaticResource EnumDescriptionConverter}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding HorizontalZ, StringFormat={}{0:F3} mm}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Cascadia Mono, Consolas"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Positions"
                                   Style="{StaticResource PanelTitleStyle}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Command="{Binding ToggleActuatorCommand}"
                                    CommandParameter="{x:Static ui:SupplyTeachingActuator.SupplyFlip}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="170"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding SupplyEnabled,
                                                         Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Source={x:Static ui:SupplyTeachingActuator.SupplyFlip}, Converter={StaticResource EnumDescriptionConverter}}"/>
                                    <TextBlock Text="{Binding SupplyRotation, Converter={StaticResource EnumDescriptionConverter}}"
                                               Margin="10,0,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleActuatorCommand}"
                                    CommandParameter="{x:Static ui:SupplyTeachingActuator.SupplyIpmFixer}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="170"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding SupplyEnabled,
                                                         Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Source={x:Static ui:SupplyTeachingActuator.SupplyIpmFixer}, Converter={StaticResource EnumDescriptionConverter}}"/>
                                    <ContentControl Tag="{Binding SupplyIpmFixed}"
                                                    Style="{StaticResource IoInputStateStyle}"
                                                    Margin="10,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleActuatorCommand}"
                                    CommandParameter="{x:Static ui:SupplyTeachingActuator.PlacementIpmGripper}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="180"
                                    Visibility="{Binding PlacementEnabled,
                                                         Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Source={x:Static ui:SupplyTeachingActuator.PlacementIpmGripper}, Converter={StaticResource EnumDescriptionConverter}}"/>
                                    <ContentControl Tag="{Binding PlacementIpmGripperClosed}"
                                                    Style="{StaticResource IoInputStateStyle}"
                                                    Margin="10,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding Source={x:Static device:InputIo.PcbSupplyPcbDetected}, Converter={StaticResource EnumDescriptionConverter}}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SupplyEnabled,
                                                            Converter={StaticResource BoolToVis}}"/>
                            <ContentControl Tag="{Binding SupplyPcbDetected}"
                                            Style="{StaticResource IoInputStateStyle}"
                                            Margin="8,0,24,0"
                                            Visibility="{Binding SupplyEnabled,
                                                                 Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Source={x:Static device:InputIo.PcbPlacementPcbDetected}, Converter={StaticResource EnumDescriptionConverter}}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding PlacementEnabled,
                                                            Converter={StaticResource BoolToVis}}"/>
                            <ContentControl Tag="{Binding PlacementPcbDetected}"
                                            Style="{StaticResource IoInputStateStyle}"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding PlacementEnabled,
                                                                 Converter={StaticResource BoolToVis}}"/>
                        </WrapPanel>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Source={StaticResource GroupedPoints}}"
                             SelectedItem="{Binding SelectedPoint}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource FlatListItemStyle}"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}"
                                                   Style="{StaticResource SectionHeaderStyle}"
                                                   Margin="2,14,0,8"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="270"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PositionLabel}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock Text="{Binding SaveBehavior, Converter={StaticResource EnumDescriptionConverter}}"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                        <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Move To"
                                Command="{Binding MoveToPointCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="90"
                                Margin="0,0,8,0"/>
                        <Button Content="Teach Selected"
                                Command="{Binding TeachCurrentPositionCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="110"
                                Margin="0,0,8,0"/>
                        <Button Content="Apply &amp; Save Buffer"
                                Command="{Binding SaveBufferSetupCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="140"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
