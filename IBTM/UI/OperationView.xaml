<UserControl x:Class="IBTM.UI.OperationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    xmlns:storage="clr-namespace:IBTM.Storage;assembly=IBTM.Storage"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
    Background="{StaticResource AppBgBrush}" Unloaded="OnViewUnloaded">
    <UserControl.Resources>
        <DataTemplate x:Key="PcbHistoryCard" DataType="{x:Type storage:PcbRecord}">
            <StackPanel MinWidth="94" Margin="8,4">
                <TextBlock Text="{Binding Number, StringFormat={ui:Text 'PCB {0}'}}" FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,4,0,0"
                    Text="{Binding Result, Converter={StaticResource UiTextConverter}}"
                    Tag="{Binding Result}" Style="{StaticResource ResultValueStyle}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,8,16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="316"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="12,8"
            Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{ui:Text 'DOORS'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding DoorSensors}" ItemTemplate="{StaticResource DoorSensorTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <StackPanel Grid.Column="2" Margin="24,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{ui:Text 'Total'}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Recipes.Counts.TotalCount, StringFormat=N0}" Margin="8,0,24,0" FontSize="22" FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="OK" VerticalAlignment="Center" Foreground="{StaticResource AccentGreenBrush}"/>
                    <TextBlock Text="{Binding Recipes.Counts.OkCount, StringFormat=N0}" Margin="8,0,24,0" FontSize="22" FontWeight="SemiBold"
                        Foreground="{StaticResource AccentGreenBrush}"/>
                    <TextBlock Text="NG" VerticalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                    <TextBlock Text="{Binding Recipes.Counts.NgCount, StringFormat=N0}" Margin="8,0,16,0" FontSize="22" FontWeight="SemiBold"
                        Foreground="{StaticResource AccentRedBrush}"/>
                    <Button Content="{ui:Text 'Clear counts'}" Command="{Binding ClearCountsCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="12,2" MinHeight="24" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource EquipBgBrush}"
            ClipToBounds="True">
            <ui:MachineDiagramView Margin="8"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Padding="12"
            Background="{StaticResource PanelBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{ui:Text 'Inspection Image'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Grid.Row="1" Margin="0,4,0,10" Text="{Binding InspectionImageCaption, TargetNullValue={ui:Text 'Waiting for inspection'}}"
                    Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InspectionImageCaption}"/>
                <Border Grid.Row="2" Background="{StaticResource ImageBackgroundBrush}" ClipToBounds="True">
                    <Image Source="{Binding InspectionImage}" Stretch="Uniform"/>
                </Border>
                <Grid Grid.Row="3" Margin="0,14,0,8">
                    <TextBlock Text="{ui:Text 'Latest fastening'}" FontSize="16" FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="{Binding RecentFastening.Result.RecordedAt, StringFormat=HH:mm:ss, TargetNullValue=—, FallbackValue=—}"/>
                </Grid>
                <Border Grid.Row="4" Height="280" Padding="10,8" BorderThickness="3,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentFastening.Result.Success}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource AlarmStateBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RecentFastening.Result.TurnsResult}" Value="{x:Static core:AssemblyResult.Ng}">
                                    <Setter Property="Background" Value="{StaticResource AlarmStateBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock Text="{ui:Text 'Waiting for a fastening result'}" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Foreground="{StaticResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentFastening}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentFastening}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding RecentFastening.BoltName}" FontSize="15" FontWeight="SemiBold"
                                    TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42"
                                    ToolTip="{Binding RecentFastening.BoltName}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Margin="0,4,0,8" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding RecentFastening.HeatSink, Converter={StaticResource UiTextConverter}, Mode=OneWay}"/>
                                    <Run Text=" · "/><Run Text="{Binding RecentFastening.Head, Converter={StaticResource UiTextConverter}, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="—"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentFastening.Result.Success}" Value="True">
                                                    <Setter Property="Text" Value="{ui:Text 'FASTEN OK'}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RecentFastening.Result.Success}" Value="False">
                                                    <Setter Property="Text" Value="{ui:Text 'FASTEN NG'}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RecentFastening.Result.Source}" Value="{x:Static core:BoltResultSource.DryRun}">
                                                    <Setter Property="Text" Value="{ui:Text 'DRY RUN'}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{ui:Text 'TURNS'}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding RecentFastening.Result.TotalTurns, StringFormat=0.###, TargetNullValue=—, FallbackValue=—}"
                                    FontSize="36" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentFastening.Result.TurnsResult}" Value="{x:Static core:AssemblyResult.Ng}">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="{ui:Text 'Min / Max'}"/><Run Text=" "/><Run Text="{Binding RecentFastening.Result.MinimumTurns, Mode=OneWay, StringFormat=0.###, TargetNullValue=—, FallbackValue=—}"/>
                                        <Run Text=" / "/><Run Text="{Binding RecentFastening.Result.MaximumTurns, Mode=OneWay, StringFormat=0.###, TargetNullValue=—, FallbackValue=—}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value=""/>
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecentFastening.Result.TurnsResult}" Value="{x:Static core:AssemblyResult.Ok}">
                                                        <Setter Property="Text" Value="{ui:Text 'TURNS OK'}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RecentFastening.Result.TurnsResult}" Value="{x:Static core:AssemblyResult.Ng}">
                                                        <Setter Property="Text" Value="{ui:Text 'TURNS NG'}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RecentFastening.Result.TurnsResult}" Value="{x:Static core:AssemblyResult.Pending}">
                                                        <Setter Property="Text" Value="{ui:Text 'No measurement'}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <UniformGrid Columns="2" Margin="0,10,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{ui:Text 'TORQUE / TARGET'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14">
                                            <Run Text="{Binding RecentFastening.Result.Torque, Mode=OneWay, StringFormat=0.##, TargetNullValue=—, FallbackValue=—}"/>
                                            <Run Text=" / "/><Run Text="{Binding RecentFastening.Result.Controller.TargetTorque, Mode=OneWay, StringFormat=0.##, TargetNullValue=—, FallbackValue=—}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{ui:Text 'FASTENING TIME (ms)'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                            Text="{Binding RecentFastening.Result.Controller.FasteningTimeMilliseconds, TargetNullValue=—, FallbackValue=—}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding RecentFastening.Result.Error}" ToolTip="{Binding RecentFastening.Result.Error}"
                                    FontSize="13" TextWrapping="Wrap"
                                    Foreground="{StaticResource AccentRedBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="12,8" Height="108"
            Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,0,1">
            <ListBox ItemsSource="{Binding PcbRecords}" SelectedItem="{Binding PcbDetails.Record, Mode=TwoWay}"
                SelectionChanged="OnPcbSelectionChanged"
                ItemTemplate="{StaticResource PcbHistoryCard}" ItemContainerStyle="{StaticResource FlatListItemStyle}"
                Background="{StaticResource ControlBgBrush}" BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Margin="20,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                    Foreground="{StaticResource AccentRedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Machine.PcbHistory.SaveError}"/>
                                            <Setter Property="ToolTip" Value="{Binding Machine.PcbHistory.SaveError}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Machine.PcbHistory.SaveError}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="{Binding PcbHistoryError}"/>
                                                    <Setter Property="ToolTip" Value="{Binding PcbHistoryError}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{ui:Text 'PCB Results'}" FontWeight="SemiBold" VerticalAlignment="Center"
                                        Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,24,0"/>
                                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                        Text="{Binding Machine.PcbHistory.PendingCount, StringFormat={ui:Text 'Pending saves: {0}'}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Machine.PcbHistory.PendingCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="{ui:Text 'Retry save'}" Margin="0,0,8,0" Padding="12,2" MinHeight="24"
                                        Command="{Binding RetryPcbSaveCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Machine.PcbHistory.SaveError}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{ui:Text '← Newer'}" Padding="12,2" MinHeight="24" Margin="0,0,6,0"
                                        Command="{x:Static ScrollBar.PageLeftCommand}" CommandTarget="{Binding ElementName=PcbHistoryScroll}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=PcbHistoryScroll, Path=HorizontalOffset}" Value="0">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{ui:Text 'Older →'}" Padding="12,2" MinHeight="24" Margin="0,0,12,0"
                                        Command="{x:Static ScrollBar.PageRightCommand}" CommandTarget="{Binding ElementName=PcbHistoryScroll}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=PcbHistoryScroll, Path=ScrollableWidth}" Value="0">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Width="120" Padding="12,2" MinHeight="24" Command="{Binding LoadOlderPcbsCommand}" IsEnabled="{Binding HasOlderPcbs}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Content" Value="{ui:Text 'Retry loading'}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PcbHistoryError}" Value="{x:Null}">
                                                        <Setter Property="Content" Value="{ui:Text 'Load older'}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LoadOlderPcbsCommand.IsRunning}" Value="True">
                                                        <Setter Property="Content" Value="{ui:Text 'Loading...'}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="PcbHistoryScroll" Grid.Row="1" Margin="0,4,0,0"
                                Background="{TemplateBinding Background}" Focusable="False" CanContentScroll="True"
                                HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Text" Value="{ui:Text 'PCB history unavailable'}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PcbRecords.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PcbHistoryError}" Value="{x:Null}">
                                                <Setter Property="Text" Value="{ui:Text 'No PCB results'}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LoadOlderPcbsCommand.IsRunning}" Value="True">
                                                <Setter Property="Text" Value="{ui:Text 'Loading PCB results...'}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
