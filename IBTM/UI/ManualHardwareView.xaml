<UserControl x:Class="IBTM.UI.ManualHardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:ManualHardwareViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <Style x:Key="ManualAxisList" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="ManualAxisListItem"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource FlatListItemStyle}">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Manual"
                       Style="{StaticResource TitleStyle}"/>
            <Button Content="Stop Home"
                    Command="{Binding StopHomeCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     MinWidth="120"
                     Visibility="{Binding IsHoming, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Main Conveyor"
                                   Style="{StaticResource PanelTitleStyle}"
                                   Margin="0"/>
                        <Border Margin="12,0,0,0"
                                Padding="10,3"
                                 CornerRadius="2"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#18242B"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConveyorStatus}"
                                                     Value="{x:Static ui:ManualConveyorStatus.Running}">
                                            <Setter Property="Background" Value="#17372E"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ConveyorStatus,
                                                      Converter={StaticResource EnumDescriptionConverter}}"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConveyorStatus}"
                                                         Value="{x:Static ui:ManualConveyorStatus.Running}">
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Run controls only the conveyor motor."
                               Margin="0,8,0,0"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Run"
                            Command="{Binding RunConveyorCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="100"
                            Margin="0,0,8,0"/>
                    <Button Content="Stop"
                            Command="{Binding StopConveyorCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource CardStyle}"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Axes"
                               Style="{StaticResource PanelTitleStyle}"
                               Margin="0"/>
                    <TextBlock Text="PCB Supply: Home All"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>

                <Grid Grid.Row="2" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MECHANISM" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Grid.Column="1" Text="AXIS" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Grid.Column="2" Text="POSITION (mm)" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Grid.Column="3" Text="STATE" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Grid.Column="4" Text="CONTROL" Style="{StaticResource SectionHeaderStyle}"/>
                </Grid>

                <ListBox Grid.Row="4"
                         ItemsSource="{Binding Axes}"
                         Style="{StaticResource ManualAxisList}"
                         ItemContainerStyle="{StaticResource ManualAxisListItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="40" Margin="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.1*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="250"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Group, Converter={StaticResource EnumDescriptionConverter}}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Axis, Converter={StaticResource EnumDescriptionConverter}}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Position, StringFormat=F3}"
                                           VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="14"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Status, Converter={StaticResource EnumDescriptionConverter}}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:ManualAxisStatus.Ready}">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:ManualAxisStatus.Moving}">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:ManualAxisStatus.HomeRequired}">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:ManualAxisStatus.ServoOff}">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:ManualAxisStatus.NegativeLimit}">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:ManualAxisStatus.PositiveLimit}">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:ManualAxisStatus.Alarm}">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:ManualAxisStatus.Emergency}">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="4"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Command="{Binding DataContext.ToggleServoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            MinWidth="108"
                                            Margin="0,0,8,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Content" Value="Servo On"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ServoOn}" Value="True">
                                                        <Setter Property="Content" Value="Servo Off"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding DataContext.HomeAxisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            MinWidth="92">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Content" Value="Home"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IndividualHomeAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
