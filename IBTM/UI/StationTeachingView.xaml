<UserControl x:Class="IBTM.UI.StationTeachingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:StationTeachingViewModel, IsDesignTimeCreatable=False}"
             Foreground="{StaticResource TextPrimaryBrush}"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TeachingOverlayBrush" Color="#D820252A"/>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Station Teaching"
                   Style="{StaticResource TitleStyle}"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="4" Padding="14,12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Grid.RowSpan" Value="3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInspectionSelected}" Value="True">
                                <Setter Property="Grid.Row" Value="2"/>
                                <Setter Property="Grid.RowSpan" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource IoStatusTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Border>
            <GridSplitter Grid.Column="4" Grid.Row="1" Height="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="{StaticResource DividerBrush}"
                          Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}"/>

            <Border Grid.Column="2" Grid.RowSpan="3" Background="{StaticResource EquipBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="3" ClipToBounds="True"
                    Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ui:ImageTeachingView x:Name="ImageMap"
                                          Source="{Binding LiveImage}"
                                          Tiles="{Binding CarrierImages}"
                                          MillimetersPerPixel="{Binding MillimetersPerPixel}"
                                          Markers="{Binding ImageMarkers}"
                                          CameraFieldOfView="{Binding CameraFieldOfView}"
                                          CoordinateOrigin="{Binding CarrierOrigin}"
                                          ClickCommand="{Binding TeachImagePointCommand}"
                                          Cursor="Cross"
                                          ToolTip="Wheel: zoom   Right drag: pan   Right double-click: fit"
                                          RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="8" Padding="8,5"
                            Background="{StaticResource TeachingOverlayBrush}"
                            CornerRadius="2"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HoverPositionText, ElementName=ImageMap}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding HoverPositionText, ElementName=ImageMap}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="White"/>
                    </Border>
                    <Border Width="1" HorizontalAlignment="Center"
                            Background="{StaticResource AccentBrush}"
                            IsHitTestVisible="False" Opacity="0.35"
                            Visibility="{Binding IsCameraLive, Converter={StaticResource BoolToVis}}"/>
                    <Border Height="1" VerticalAlignment="Center"
                            Background="{StaticResource AccentBrush}"
                            IsHitTestVisible="False" Opacity="0.35"
                            Visibility="{Binding IsCameraLive, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="NO IMAGE" FontSize="14" FontFamily="Cascadia Mono, Consolas"
                               Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding LiveImage}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding HasCarrierImages}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <WrapPanel Grid.Row="1" Margin="8">
                    <Button Content="Live"
                            Command="{Binding ToggleLiveViewCommand}"
                            Margin="0,0,8,0" MinWidth="70"
                            Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCameraLive}" Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource AppBgBrush}"/>
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Scan Carrier"
                            Command="{Binding CaptureCarrierImagesCommand}"
                            Margin="0,0,12,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="112"
                            Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding CanEditTeaching}">
                            <TextBlock Text="mm/px" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding MillimetersPerPixel, UpdateSourceTrigger=PropertyChanged}"
                                     Width="72" Margin="0,0,10,0"/>
                            <TextBlock Text="Overlap" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding ScanOverlap, UpdateSourceTrigger=PropertyChanged}"
                                     Width="58"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding CameraError}" TextWrapping="Wrap"
                               VerticalAlignment="Bottom" Margin="8,0,8,48" Padding="8"
                               Background="{StaticResource TeachingOverlayBrush}"
                               Foreground="{StaticResource AccentRedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CameraError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Column="0" Grid.RowSpan="3" Style="{StaticResource CardStyle}" Padding="16">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="Motion"
                                   Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding MotionGroups}"
                                  SelectedItem="{Binding SelectedMotionGroup, Mode=TwoWay}"
                                  Padding="8,5"/>
                    </StackPanel>
                </Border>

                <ui:TeachingMotionView/>
                <Button Content="Move XY at Safe Z" Command="{Binding MoveToXYCommand}"
                        ToolTip="Move above the bolt without lowering to its taught Z."
                        Margin="0,12,0,0" Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{Binding BoltPresetEditorVisible, Converter={StaticResource BoolToVis}}"/>
              </StackPanel>
              </ScrollViewer>
            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Grid.Column" Value="2"/>
                        <Setter Property="Grid.RowSpan" Value="3"/>
                        <Setter Property="Padding" Value="14,12"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInspectionSelected}"
                                         Value="True">
                                <Setter Property="Grid.Column" Value="4"/>
                                <Setter Property="Grid.RowSpan" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Teaching points"
                               Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,10"/>

                    <ui:TeachingPointList Grid.Row="1" ItemsSource="{Binding FilteredPoints}"
                              SelectedItem="{Binding SelectedPoint}"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource FlatListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Name}"
                                               ToolTip="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding PositionLabel}"
                                               Margin="0,3,0,0"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PositionLabel}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HeatSink}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding HeatSink, Converter={StaticResource EnumDescriptionConverter}}"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding Head, Converter={StaticResource EnumDescriptionConverter}}"
                                                   Margin="12,0,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ui:TeachingPointList>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0" IsEnabled="{Binding CanEditTeaching}">
                        <Grid Visibility="{Binding BoltPointEditorVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ComboBox ItemsSource="{Binding HeatSinkSlots}" SelectedItem="{Binding NewHeatSinkSlot}" FontSize="11"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding FasteningHeads}" SelectedItem="{Binding NewFasteningHead}" FontSize="11"/>
                            <Button Grid.Row="2" Content="Add Bolt" Command="{Binding AddBoltPointCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="Remove" Command="{Binding RemoveBoltPointCommand}"
                                    Style="{StaticResource DangerButtonStyle}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,6,0,0"
                                    Visibility="{Binding BoltPresetEditorVisible,
                                                         Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="PCB" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding BoltRecipe.PcbPreset, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="11" Width="36" Margin="4,0,10,0"/>
                            <TextBlock Text="IPM 1" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding BoltRecipe.IpmSeatingPreset, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="11" Width="36" Margin="4,0,10,0"/>
                            <TextBlock Text="IPM 2" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding BoltRecipe.IpmFinalPreset, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="11" Width="36" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
