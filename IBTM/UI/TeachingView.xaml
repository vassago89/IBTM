<UserControl x:Class="IBTM.UI.TeachingView"
    x:Name="TeachingRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:machine="clr-namespace:IBTM"
    xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
    xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:TeachingViewModel, IsDesignTimeCreatable=False}"
    Foreground="{StaticResource TextPrimaryBrush}"
    Background="{StaticResource AppBgBrush}"
    Validation.ErrorTemplate="{x:Null}" Loaded="OnViewLoaded">
    <UserControl.BindingGroup>
        <BindingGroup/>
    </UserControl.BindingGroup>
    <UserControl.Resources>
        <CollectionViewSource x:Key="TeachingPoints" Source="{Binding FilteredPoints}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="{Binding State.SetupEditingEnabled}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Content="{ui:Text 'New Recipe'}" Command="{Binding RecipeEditor.NewCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" Margin="0,0,16,0"/>
                <TextBlock Text="{ui:Text 'Recipe'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding RecipeEditor.Recipes}" IsEditable="True" IsTextSearchEnabled="False"
                    Text="{Binding RecipeEditor.Name, Mode=TwoWay, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{ui:Text 'Recipe'}" Width="180" Margin="0,0,6,0"/>
                <Button Content="{ui:Text 'Load'}" Command="{Binding RecipeEditor.LoadCommand}"
                    CommandParameter="{Binding RecipeEditor.Name}"
                    IsEnabled="{Binding RecipeEditor.IsSaveAllowed}"
                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" Margin="0,0,6,0"/>
                <Button Command="{Binding SaveCommand}" MinWidth="100">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Content" Value="{ui:Text 'Save'}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveCommand.IsRunning}" Value="True">
                                    <Setter Property="Content" Value="{ui:Text 'Saving...'}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=TeachingRoot, Path=(Validation.HasError)}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <TextBlock Text="{ui:Text 'Teaching'}" Style="{StaticResource TitleStyle}"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="240" MaxWidth="280"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3*" MinWidth="380"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.3*" MinWidth="340" MaxWidth="360"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{ui:Text 'Teaching Unit'}" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding TeachingUnits}"
                            SelectedItem="{Binding SelectedTeachingUnit, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox ItemsSource="{Binding HeatSinkSlots}"
                            SelectedItem="{Binding SelectedPcb, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,6,0,0"
                            Visibility="{Binding BoltPointEditorVisible, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <ui:TeachingPointListBox Grid.Row="1"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding Source={StaticResource TeachingPoints}}"
                        SelectedItem="{Binding SelectedPoint, UpdateSourceTrigger=PropertyChanged}"
                        Background="{StaticResource EquipBgBrush}" BorderThickness="1" BorderBrush="{StaticResource DividerBrush}"
                        ItemContainerStyle="{StaticResource FlatListItemStyle}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate DataType="{x:Type data:CollectionViewGroup}">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource UiTextConverter}}"
                                            TextWrapping="Wrap" FontWeight="SemiBold" Margin="8,10,4,4"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:TeachingPoint}">
                                <StackPanel Margin="4,4">
                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding BoltLabel}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Position.Bolt}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{Binding Name}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="11"
                                        Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding PositionLabel}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Position.Mode}" Value="{x:Static device:TeachMode.Image}">
                                                        <Setter Property="Text">
                                                            <Setter.Value>
                                                                <MultiBinding StringFormat="X {0:F3}  Y {1:F3}">
                                                                    <Binding Path="Coordinates.X"/>
                                                                    <Binding Path="Coordinates.Y"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Coordinates}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{Binding PositionLabel}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ui:TeachingPointListBox>
                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,8,0,0"
                        Visibility="{Binding IsFasteningSelected, Converter={StaticResource BoolToVis}}">
                        <Button Content="{ui:Text '↑ Earlier'}" Command="{Binding MoveFasteningEarlierCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="8,6" Margin="0,0,3,0"/>
                        <Button Content="{ui:Text '↓ Later'}" Command="{Binding MoveFasteningLaterCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="8,6" Margin="3,0,0,0"/>
                    </UniformGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding SelectedPoint.Name}" Style="{StaticResource PanelTitleStyle}"
                            Height="20" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedPoint.PositionLabel, TargetNullValue=—}"
                            Height="36" ToolTip="{Binding SelectedPoint.PositionLabel}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" Margin="0,4,0,0"
                            TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding State.SetupEditingEnabled}">
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Bolt}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <StackPanel Width="240" Margin="0,0,12,0">
                                <TextBlock Text="{ui:Text 'Bolt name'}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedPoint.BoltName, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="140">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPoint.Position.Target}" Value="{x:Static device:TeachingTarget.BoltPosition}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{ui:Text 'Z offset (mm)'}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedPoint.FasteningZOffset, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                    <TabControl Grid.Row="1" Style="{StaticResource SectionTabs}"
                        ItemContainerStyle="{StaticResource SectionTab}"
                        Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                        <TabItem Header="{ui:Text 'Camera'}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,4">
                                    <ComboBox ItemsSource="{Binding FasteningHeads}" Width="180" Margin="0,0,8,4"
                                        SelectedItem="{Binding NewFasteningHead, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="{ui:Text 'Add Bolt'}" Command="{Binding AddBoltPointCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="0,0,8,4"/>
                                    <Button Content="{ui:Text 'Remove Bolt'}" Command="{Binding RemoveBoltPointCommand}"
                                        Style="{StaticResource DangerButtonStyle}" Padding="12,7" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                                    <Button Command="{Binding ToggleLiveViewCommand}" Margin="0,0,8,4" Width="96" Padding="12,7">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="Content" Value="{ui:Text 'Start Live'}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Inspection.IsLiveView}" Value="True">
                                                        <Setter Property="Content" Value="{ui:Text 'Stop Live'}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{ui:Text 'Update Image + Light'}" Command="{Binding GrabCommand}" Margin="0,0,12,4" Padding="12,7"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" IsEnabled="{Binding State.SetupEditingEnabled}">
                                        <TextBlock Text="{ui:Text 'Light (0–255)'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Width="55" Margin="0,0,8,0"
                                            Text="{Binding LiveLightLevel, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                        <Button Content="{ui:Text 'Apply Light'}" Command="{Binding ApplyLightCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,7"/>
                                    </StackPanel>
                                </WrapPanel>
                                <Border Grid.Row="2" Background="{StaticResource ImageBackgroundBrush}">
                                    <Grid>
                                        <ui:InspectionImageView Source="{Binding CameraImage}" ShowCrosshair="True"/>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Text" Value="{ui:Text 'No reference image'}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CameraImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Inspection.IsLiveView}" Value="True">
                                                            <Setter Property="Text" Value="{ui:Text 'Waiting for camera image'}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{ui:Text 'Related I/O'}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IoStatusTemplate}"/>
                        </TabItem>
                    </TabControl>
                    <ContentPresenter Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource IoStatusTemplate}">
                        <ContentPresenter.Style>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInspectionSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentPresenter.Style>
                    </ContentPresenter>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <ui:RecordPositionButton Command="{Binding TeachCurrentPositionCommand}"
                            MinWidth="150" Padding="12,8" Margin="0,0,8,0">
                            <ui:RecordPositionButton.Style>
                                <Style TargetType="ui:RecordPositionButton" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Content" Value="{ui:Text 'Record Position'}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Mode}" Value="{x:Static device:TeachMode.Full}">
                                            <Setter Property="Content" Value="{ui:Text 'Record X/Y/Z'}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Mode}" Value="{x:Static device:TeachMode.XYOnly}">
                                            <Setter Property="Content" Value="{ui:Text 'Record X/Y'}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Mode}" Value="{x:Static device:TeachMode.ZOnly}">
                                            <Setter Property="Content" Value="{ui:Text 'Record Z'}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Mode}" Value="{x:Static device:TeachMode.Image}">
                                            <Setter Property="Content" Value="{ui:Text 'Save X/Y + Image'}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:RecordPositionButton.Style>
                        </ui:RecordPositionButton>
                        <ui:MoveToPositionButton Content="{ui:Text 'Move to Selected Point'}" Command="{Binding MoveToPointCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" MinWidth="150" Padding="12,8"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{ui:Text 'Motion'}" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,10"/>
                            <ui:TeachingMotionView/>
                            <Button Content="{ui:Text 'Safe Z → Raise Pickup Head'}" Command="{Binding ReturnFromPickupCommand}"
                                Margin="0,8,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding IsFasteningSelected, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,0"
                        Foreground="{StaticResource AccentAmberBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding HomeBlock, Converter={StaticResource UiTextConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HomeBlock}" Value="{x:Static machine:HomeBlockReason.None}">
                                        <Setter Property="Text" Value="{Binding MotionHint, Converter={StaticResource UiTextConverter}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ManualBlock}" Value="{x:Static ui:ManualControlBlock.AutoMode}">
                                        <Setter Property="Text" Value="{Binding ManualBlock, Converter={StaticResource UiTextConverter}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ManualBlock}" Value="{x:Static ui:ManualControlBlock.Busy}">
                                        <Setter Property="Text" Value="{Binding ManualBlock, Converter={StaticResource UiTextConverter}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{ui:Text 'Check the highlighted input.'}"
                    Style="{StaticResource StatusMessageStyle}"
                    Visibility="{Binding ElementName=TeachingRoot, Path=(Validation.HasError), Converter={StaticResource BoolToVis}}"
                    Foreground="{StaticResource AccentRedBrush}"/>
                <TextBlock Text="{Binding SaveError}" Style="{StaticResource StatusMessageStyle}" Foreground="{StaticResource AccentRedBrush}"/>
                <TextBlock Text="{Binding CameraError}" Style="{StaticResource StatusMessageStyle}" Foreground="{StaticResource AccentRedBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
