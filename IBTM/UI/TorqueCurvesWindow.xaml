<Window x:Class="IBTM.UI.TorqueCurvesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:bolt="clr-namespace:IBTM.BoltFastening;assembly=IBTM.BoltFastening"
    mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=ui:TorqueCurvesViewModel, IsDesignTimeCreatable=False}"
    Title="{ui:Text 'Torque curves'}" Width="1100" Height="640" MinWidth="760" MinHeight="460" FontSize="14"
    Background="{StaticResource AppBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Right" Text="{Binding JobId, StringFormat={ui:Text 'Carrier work {0}'}, TargetNullValue='—'}"
                VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding JobId}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{ui:Text 'Torque curves'}" FontSize="24" FontWeight="SemiBold"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Curves}" SelectedItem="{Binding SelectedCurve}"
                Style="{StaticResource PanelListStyle}" ItemContainerStyle="{StaticResource FlatListItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type bolt:FasteningTorqueCurve}">
                        <StackPanel Margin="8,6">
                            <TextBlock Text="{Binding BoltName}" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,4,0,0" TextBlock.FontSize="12">
                                <TextBlock Text="{Binding HeatSink, Converter={StaticResource UiTextConverter}}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Head, Converter={StaticResource UiTextConverter}}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Result.Stage, Converter={StaticResource UiTextConverter}}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding SelectedCurve.BoltName}" FontSize="18" FontWeight="SemiBold" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding SelectedCurve.Result.Stage, Converter={StaticResource UiTextConverter}}" VerticalAlignment="Center"/>
                </WrapPanel>
                <ui:TorqueCurvePlot Grid.Row="1" Curve="{Binding SelectedCurve.Result.TorqueCurve}"
                    TargetTorque="{Binding SelectedCurve.Result.Controller.CompensatedTargetTorque}"/>
                <TextBlock Grid.Row="2" Text="{Binding SelectedCurve.Result.TorqueCurveError}" Foreground="{StaticResource AccentAmberBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" Text="{ui:Text 'Stored with PCB results'}"
            Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,0"/>
    </Grid>
</Window>
