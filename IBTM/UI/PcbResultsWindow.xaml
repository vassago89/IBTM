<Window x:Class="IBTM.UI.PcbResultsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:PcbResultsViewModel, IsDesignTimeCreatable=False}"
    Title="{Binding Record.Number, StringFormat={ui:Text 'PCB {0} · Results'}}"
    Width="1600" Height="960" MinWidth="1000" MinHeight="700"
    FontSize="14" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource AppBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
    KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="Metric" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style x:Key="FasteningVerdict" TargetType="TextBlock" BasedOn="{StaticResource ResultValueStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Verdict}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Result.IsComplete}" Value="False"><Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Result.Source}" Value="{x:Static core:BoltResultSource.DryRun}"><Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/></DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Result.Stage}" Value="{x:Static core:BoltFasteningStage.Preliminary}"/>
                        <Condition Binding="{Binding Result.IsComplete}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource ControlSelectedBackgroundBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="{ui:Text 'Export CSV'}" Command="{Binding ExportCsvCommand}"
                MinWidth="110" Margin="12,0,0,0" VerticalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Record}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="{Binding Record.Number, StringFormat={ui:Text 'PCB {0}'}}" FontSize="24" FontWeight="SemiBold"/>
                <Border Background="{StaticResource ControlBgBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Record.Result, Converter={StaticResource UiTextConverter}}" Tag="{Binding Record.Result}" Style="{StaticResource ResultValueStyle}"/>
                </Border>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <WrapPanel TextBlock.Foreground="{StaticResource TextSecondaryBrush}" TextBlock.FontSize="13">
                    <TextBlock Text="{Binding Record.RecipeName}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding Record.HeatSink, Converter={StaticResource UiTextConverter}}"/>
                </WrapPanel>
                <WrapPanel TextBlock.Foreground="{StaticResource TextMutedBrush}" TextBlock.FontSize="13" Margin="0,3,0,0">
                    <TextBlock Text="{Binding Record.CreatedAt, StringFormat={ui:Text 'Created {0:yyyy-MM-dd HH:mm:ss}'}}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding Record.UpdatedAt, StringFormat={ui:Text 'Updated {0:HH:mm:ss}'}}"/>
                </WrapPanel>
            </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,8">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="12,6">
                <DockPanel><StackPanel><TextBlock Text="{ui:Text 'Bolt fastening'}" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Record.FasteningResult, Converter={StaticResource UiTextConverter}}" Tag="{Binding Record.FasteningResult}" Style="{StaticResource ResultValueStyle}" Margin="0,5,0,0"/>
                </StackPanel><TextBlock Text="{Binding BoltResults.Count, StringFormat={ui:Text '{}{0} results'}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/></DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="12,6">
                <DockPanel><StackPanel><TextBlock Text="{ui:Text 'Vision inspection'}" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Record.InspectionResult, Converter={StaticResource UiTextConverter}}" Tag="{Binding Record.InspectionResult}" Style="{StaticResource ResultValueStyle}" Margin="0,5,0,0"/>
                </StackPanel><TextBlock Text="{Binding Images.Count, StringFormat={ui:Text '{}{0} images'}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/></DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,6">
                <DockPanel><StackPanel><TextBlock Text="{ui:Text 'Turns result'}" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Record.TurnsResult, Converter={StaticResource UiTextConverter}, TargetNullValue={ui:Text 'Not set'}}" Tag="{Binding Record.TurnsResult}" Style="{StaticResource ResultValueStyle}" Margin="0,5,0,0"/>
                </StackPanel></DockPanel>
            </Border>
        </UniformGrid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="160"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MaxHeight="268"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{ui:Text 'Inspection images'}" Style="{StaticResource PanelTitleStyle}"/>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="{ui:Text 'Data Matrix · '}" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding Record.PcbBarcode, TargetNullValue={ui:Text 'Not read'}, FallbackValue={ui:Text 'Not read'}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Record.PcbBarcode}"
                                Tag="{Binding Record.PcbBarcodeResult}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ResultValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Record.IsDataMatrixNgExcluded}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{ui:Text 'Excluded from NG'}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                            Visibility="{Binding Record.IsDataMatrixNgExcluded, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource ImageBackgroundBrush}" CornerRadius="4" MinHeight="160">
                        <Grid>
                            <ui:InspectionImageView Source="{Binding SelectedImage.Image}" SourceRegion="{Binding SelectedImage.Region}" ShowCrosshair="False" IsHitTestVisible="False"/>
                            <TextBlock Text="{Binding SelectedImage.Error}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentAmberBrush}"/>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Text" Value="{Binding ImageError}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ImageError}" Value="{x:Null}">
                                                <Setter Property="Text" Value="{ui:Text 'No saved image for this point'}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LoadImagesCommand.IsRunning}" Value="True">
                                                <Setter Property="Text" Value="{ui:Text 'Loading images…'}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,8,0,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedImage.Verdict}" Tag="{Binding SelectedImage.Verdict}" Style="{StaticResource ResultValueStyle}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding SelectedImage.Title, TargetNullValue={ui:Text 'Inspection capture'}, FallbackValue={ui:Text 'Inspection capture'}}" Height="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedImage.Title}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedImage.Details}" Height="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedImage.Details}" Margin="0,4,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DockPanel Height="20" TextBlock.FontSize="13" TextBlock.Foreground="{StaticResource TextMutedBrush}">
                            <TextBlock Text="{Binding SelectedImage.Record.CapturedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}"/>
                            <TextBlock Text="{Binding SelectedImage.Resolution}" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                    <ListBox Grid.Row="3" ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                        BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource FlatListItemStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate DataType="{x:Type ui:PcbInspectionImageItem}">
                            <StackPanel Width="108" Margin="4,4,6,6" ToolTip="{Binding Title}">
                                <Grid Height="56">
                                    <Image Source="{Binding Image}" Stretch="Uniform"/>
                                    <Border Background="{StaticResource ImageBackgroundBrush}" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Verdict}" Tag="{Binding Verdict}" Style="{StaticResource ResultValueStyle}" FontSize="12"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Title}" Height="36" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Error}" Height="18" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Error}" Foreground="{StaticResource AccentAmberBrush}"/>
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <ScrollViewer Grid.Row="4" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{ui:Text 'Loading images…'}" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding LoadImagesCommand.IsRunning, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding ImageError}" TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}"/>
                            <ItemsControl ItemsSource="{Binding InspectionOnlyResults}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type ui:PcbBoltPresenceView}">
                                    <StackPanel Orientation="Horizontal" Margin="0,3,12,0"><TextBlock Text="{Binding BoltLabel, StringFormat='{}{0}: '}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="Presence" Text="NG" Foreground="{StaticResource AccentRedBrush}" FontSize="13"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers><DataTrigger Binding="{Binding Present}" Value="True">
                                        <Setter TargetName="Presence" Property="Text" Value="OK"/><Setter TargetName="Presence" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger></DataTemplate.Triggers>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{ui:Text 'Bolt results'}" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="BoltResultsGrid" Grid.Row="1" ItemsSource="{Binding BoltResults}" SelectedItem="{Binding SelectedBolt, Mode=TwoWay}" AutoGenerateColumns="False"
                        IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False"
                        CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                        BorderThickness="0" Background="{StaticResource ControlBgBrush}" RowHeight="48" ColumnHeaderHeight="34" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{ui:Text 'Bolt name'}" Width="*" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type ui:PcbBoltResultView}">
                                <StackPanel>
                                    <TextBlock Text="{Binding BoltLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BoltLabel}"/>
                                    <TextBlock Text="{Binding Result.Stage, Converter={StaticResource UiTextConverter}}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="{ui:Text 'Fastening method'}" Binding="{Binding HeadLabel, Mode=OneWay}" Width="85"/>
                            <DataGridTemplateColumn Header="{ui:Text 'Fasten'}" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type ui:PcbBoltResultView}">
                                <TextBlock Text="{Binding Verdict}" Tag="{Binding Verdict}" Style="{StaticResource FasteningVerdict}" FontSize="13"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{ui:Text 'VISION'}" Width="62"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type ui:PcbBoltResultView}">
                                <TextBlock Text="{Binding VisionVerdict}" Tag="{Binding VisionVerdict}" Style="{StaticResource ResultValueStyle}" FontSize="13"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{ui:Text 'Turns'}" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type ui:PcbBoltResultView}">
                                <TextBlock Text="{Binding TurnsVerdict}" Tag="{Binding TurnsVerdict}" Style="{StaticResource ResultValueStyle}" FontSize="13"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{ui:Text 'ACTUAL / MIN / MAX'}" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type ui:PcbBoltResultView}">
                                <TextBlock FontSize="13"><Run Text="{Binding Result.TotalTurns, Mode=OneWay, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}"/><Run Text=" / "/><Run Text="{Binding Result.MinimumTurns, Mode=OneWay, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}"/><Run Text=" / "/><Run Text="{Binding Result.MaximumTurns, Mode=OneWay, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}"/></TextBlock>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="{ui:Text 'No fastening results recorded'}" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoltResults.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Row="2" Height="340" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                        <Border.Style><Style TargetType="Border"><Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedBolt}" Value="{x:Null}"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{ui:Text 'Min / Max'}" Style="{StaticResource MetricLabel}"/>
                                    <StackPanel Orientation="Horizontal" TextBlock.FontSize="14" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding SelectedBolt.Result.MinimumTurns, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}"/>
                                        <TextBlock Text=" / "/>
                                        <TextBlock Text="{Binding SelectedBolt.Result.MaximumTurns, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}"/>
                                        <TextBlock Text=" · "/>
                                        <TextBlock Text="{Binding SelectedBolt.TurnsVerdict}" Tag="{Binding SelectedBolt.Result.TurnsResult}"
                                            Style="{StaticResource ResultValueStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedBolt.Title, TargetNullValue={ui:Text 'Controller details'}, FallbackValue={ui:Text 'Controller details'}}"
                                        ToolTip="{Binding SelectedBolt.Title}" Height="24" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="16"/>
                                    <WrapPanel Margin="0,3,0,4" TextBlock.FontSize="13" TextBlock.Foreground="{StaticResource TextMutedBrush}">
                                        <ComboBox ItemsSource="{Binding SelectedBolt.StageResults}" SelectedItem="{Binding SelectedBoltStage, Mode=TwoWay}"
                                            MinWidth="120" Margin="0,0,12,0">
                                            <ComboBox.ItemTemplate><DataTemplate DataType="{x:Type ui:PcbBoltResultView}">
                                                <TextBlock Text="{Binding Result.Stage, Converter={StaticResource UiTextConverter}}"/>
                                            </DataTemplate></ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding SelectedBoltStage.Result.Source, Converter={StaticResource UiTextConverter}}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedBoltStage.Result.RecordedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}', TargetNullValue={ui:Text 'Time not recorded'}, FallbackValue={ui:Text 'Time not recorded'}}" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                            <TabControl Grid.Row="1" Style="{StaticResource SectionTabs}" ItemContainerStyle="{StaticResource SectionTab}">
                                <TabItem Header="{ui:Text 'Fastening stages'}" Padding="10,4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,8,0,0">
                                            <DataGrid ItemsSource="{Binding SelectedBolt.StageResults}" SelectedItem="{Binding SelectedBoltStage, Mode=TwoWay}"
                                                AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                                CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                                HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0" BorderThickness="0"
                                                Background="{StaticResource ControlBgBrush}" RowHeight="38">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{ui:Text 'Stage'}" Binding="{Binding Result.Stage, Converter={StaticResource UiTextConverter}}" Width="*" MinWidth="100"/>
                                                    <DataGridTextColumn Header="{ui:Text 'Preset'}" Binding="{Binding Result.Controller.Preset, TargetNullValue='—', FallbackValue='—'}" Width="75"/>
                                                    <DataGridTemplateColumn Header="{ui:Text 'Result'}" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type ui:PcbBoltResultView}">
                                                        <TextBlock Text="{Binding StageVerdict}" Tag="{Binding Result.Success}">
                                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ResultValueStyle}"><Style.Triggers>
                                                                <DataTrigger Binding="{Binding Result.Source}" Value="{x:Static core:BoltResultSource.DryRun}"><Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/></DataTrigger>
                                                            </Style.Triggers></Style></TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="{ui:Text 'Turns'}" Binding="{Binding Result.MeasuredTurns, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Width="95"/>
                                                    <DataGridTextColumn Header="{ui:Text 'Result torque'}" Binding="{Binding Result.Torque, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Width="95"/>
                                                    <DataGridTextColumn Header="{ui:Text 'Fastening time (ms)'}" Binding="{Binding Result.Controller.FasteningTimeMilliseconds, TargetNullValue='—', FallbackValue='—'}" Width="130"/>
                                                    <DataGridTemplateColumn Header="{ui:Text 'Torque curves'}" Width="100">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate DataType="{x:Type ui:PcbBoltResultView}">
                                                                <Button Content="{ui:Text 'Graph'}" CommandParameter="{Binding}" Click="OnTorqueCurveClick" Padding="8,2" FontSize="12"
                                                                    ToolTipService.ShowOnDisabled="True">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Result.TorqueCurve}" Value="{x:Null}">
                                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                                    <Setter Property="ToolTip" Value="{ui:Text 'No torque curve'}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <StackPanel Orientation="Horizontal" Margin="8,14,0,0" VerticalAlignment="Center">
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock.Style><Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{ui:Text 'Combined turns'}"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding SelectedBolt.Result.Stage}" Value="{x:Static core:BoltFasteningStage.Preliminary}">
                                                            <Setter Property="Text" Value="{ui:Text 'Pre-tightening turns'}"/>
                                                        </DataTrigger></Style.Triggers>
                                                    </Style></TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding SelectedBolt.Result.TotalTurns, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" FontSize="26" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SelectedBolt.TurnsVerdict}" Tag="{Binding SelectedBolt.Result.TurnsResult}" Style="{StaticResource ResultValueStyle}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Margin="8,8,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedBolt.Result.IsComplete}" Value="False"><Setter Property="Text" Value="{ui:Text 'Final tightening pending'}"/></DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding SelectedBolt.Result.IsComplete}" Value="False"/>
                                                            <Condition Binding="{Binding SelectedBolt.Result.Stage}" Value="{x:Static core:BoltFasteningStage.FinalBeforeRetightening}"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="{ui:Text 'Retightening pending'}"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedBolt.Result.Stage}" Value="{x:Static core:BoltFasteningStage.Preliminary}"/>
                                                        <Condition Binding="{Binding SelectedBolt.Result.IsComplete}" Value="True"/>
                                                    </MultiDataTrigger.Conditions><Setter Property="Text" Value="{ui:Text 'Pre-tightening NG: skip final tightening'}"/></MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedBolt.Result.Source}" Value="{x:Static core:BoltResultSource.DryRun}"><Setter Property="Text" Value="{ui:Text 'Dry run · NG'}"/></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="{ui:Text 'Measurements'}" Padding="10,4">
                                    <UniformGrid Columns="4" Margin="0,8,0,0" VerticalAlignment="Top">
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Result torque'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.Torque, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Target torque'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.Controller.CompensatedTargetTorque, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Target speed (rpm)'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.Controller.TargetSpeedRpm, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Fastening time (ms)'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.Controller.FasteningTimeMilliseconds, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Angle A1 (°)'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.Controller.Angle1, StringFormat=0.##, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Angle A2 (°)'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.Controller.Angle2, StringFormat=0.##, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Angle A3 (°)'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.Controller.Angle3, StringFormat=0.##, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Stage turns'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.MeasuredTurns, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Snug angle (°)'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.Controller.SnugAngle, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Preset'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.Controller.Preset, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Event count'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.Controller.EventCount, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Screw count'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.Controller.ScrewCount, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}" ToolTip="{Binding SelectedBoltStage.ControllerErrorDescription}"><TextBlock Text="{ui:Text 'Error code'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Result.Controller.ErrorCode, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}">
                                            <TextBlock Text="{ui:Text 'Status'}" Style="{StaticResource MetricLabel}"/>
                                            <TextBlock Text="{Binding SelectedBoltStage.ControllerStatus, TargetNullValue='—', FallbackValue='—'}" ToolTip="{Binding SelectedBoltStage.ControllerStatus}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedBoltStage.Result.Controller.StatusCode}" Value="1">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedBoltStage.Result.Controller.StatusCode}" Value="2">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Direction'}" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBoltStage.Direction, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}" ToolTip="{Binding SelectedBoltStage.Direction}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="{ui:Text 'Port / address'}" Style="{StaticResource MetricLabel}"/>
                                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding SelectedBoltStage.Result.Controller.Port, Mode=OneWay, TargetNullValue='—', FallbackValue='—'}"/><Run Text=" / "/><Run Text="{Binding SelectedBoltStage.Result.Controller.SlaveAddress, Mode=OneWay, TargetNullValue='—', FallbackValue='—'}"/></TextBlock>
                                        </StackPanel>
                                    </UniformGrid>
                                </TabItem>
                                <TabItem Header="{ui:Text 'Diagnostics'}" Padding="10,4">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="64"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Left" Text="{ui:Text 'Error / message'}" Style="{StaticResource MetricLabel}" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding SelectedBoltStage.ControllerErrorDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedBoltStage.ControllerErrorDescription}"/>
                                        </DockPanel>
                                        <TextBox Grid.Row="1" Text="{Binding SelectedBoltStage.Result.Error, Mode=OneWay, TargetNullValue='—', FallbackValue='—'}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="13" Padding="6" BorderThickness="0" Foreground="{StaticResource AccentRedBrush}"/>
                                        <TextBlock Grid.Row="2" Text="{ui:Text 'ORIGINAL ADC REGISTERS · ADDRESS : HEX'}" Style="{StaticResource MetricLabel}" Margin="0,8,0,4"/>
                                        <TextBox Grid.Row="3" Text="{Binding SelectedBoltStage.RegisterText, Mode=OneWay, TargetNullValue={ui:Text 'Not recorded'}, FallbackValue={ui:Text 'Not recorded'}}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Padding="6" BorderThickness="0"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,8,0,0" Height="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                Text="{ui:Text 'Torque: controller unit'}"/>
            <TextBlock Grid.Column="1" Text="{Binding ExportMessage}" ToolTip="{Binding ExportMessage}"
                Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</Window>
