<UserControl x:Class="IBTM.UI.OperationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    xmlns:storage="clr-namespace:IBTM.Storage;assembly=IBTM.Storage"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
    Background="{StaticResource AppBgBrush}" Unloaded="OnViewUnloaded">
    <UserControl.Resources>
        <Style x:Key="FeederDetectionStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="UNKNOWN"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="Text" Value="DETECTED"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </Trigger>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>False</sys:Boolean></Trigger.Value>
                    <Setter Property="Text" Value="NOT DETECTED"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FeederEnabledStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="DISABLED"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="Text" Value="ENABLED"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="PcbHistoryCard" DataType="{x:Type storage:PcbRecord}">
            <StackPanel MinWidth="94" Margin="8,4">
                <TextBlock Text="{Binding Number, StringFormat='PCB {0}'}" FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="ResultText" Margin="0,4,0,0"
                    Text="{Binding Result, Converter={StaticResource EnumDescriptionConverter}}"
                    Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Result}" Value="{x:Static core:AssemblyResult.Ok}">
                    <Setter TargetName="ResultText" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="{x:Static core:AssemblyResult.Ng}">
                    <Setter TargetName="ResultText" Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="DoorSensorTemplate" DataType="{x:Type ui:DoorSensorDisplay}">
            <Border x:Name="DoorCard" Margin="4,0" Padding="10,7" CornerRadius="3"
                Background="{StaticResource ControlBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock x:Name="DoorState" Grid.Column="1" Text="UNKNOWN"
                        Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Input.IsOn}" Value="True">
                    <Setter TargetName="DoorState" Property="Text" Value="CLOSED"/>
                    <Setter TargetName="DoorState" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Input.IsOn}" Value="False">
                    <Setter TargetName="DoorState" Property="Text" Value="OPEN"/>
                    <Setter TargetName="DoorState" Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                    <Setter TargetName="DoorCard" Property="Background" Value="{StaticResource AlarmStateBackgroundBrush}"/>
                    <Setter TargetName="DoorCard" Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,8,16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="316"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="12,8"
            Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DOORS" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding DoorSensors}" ItemTemplate="{StaticResource DoorSensorTemplate}"
                    ToolTip="Live door positions. UNKNOWN means feedback is unavailable.">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource EquipBgBrush}"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1" Padding="12,8">
                    <UniformGrid Columns="3">
                        <StackPanel>
                            <TextBlock Text="Supply · Z" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="—"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SupplyPositionKnown}" Value="True">
                                                <Setter Property="Text" Value="{Binding Supply.Motion.Position.Z, StringFormat='{}{0:F2} mm'}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Supply.Motion.IsMoving}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Placement · Z" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="—"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementPositionKnown}" Value="True">
                                                <Setter Property="Text" Value="{Binding Placement.Motion.Position.Z, StringFormat='{}{0:F2} mm'}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Placement.Motion.IsMoving}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Bolt Fastening · Z" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="—"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FasteningPositionKnown}" Value="True">
                                                <Setter Property="Text" Value="{Binding Fastening.Motion.Position.Z, StringFormat='{}{0:F2} mm'}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Fastening.Motion.IsMoving}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>
                </Border>
                <Viewbox Grid.Row="1" Margin="8" Stretch="Uniform">
                    <Canvas Width="1600" Height="{x:Static ui:MachinePlan.PlanHeight}">
                        <ui:NgConveyorView Canvas.Left="{x:Static ui:MachinePlan.InspectionLeft}" Canvas.Top="0" Panel.ZIndex="-10"/>
                        <ui:ConveyorView Canvas.Left="{x:Static ui:MachinePlan.MainLeft}" Canvas.Top="{x:Static ui:MachinePlan.MainTop}"
                            Panel.ZIndex="0"/>
                        <ui:PcbPlacementView Canvas.Left="{x:Static ui:MachinePlan.MainLeft}" Canvas.Top="0" Panel.ZIndex="10"/>
                        <ui:BoltFasteningView Canvas.Left="{x:Static ui:MachinePlan.FasteningLeft}" Canvas.Top="0" Panel.ZIndex="10"/>
                        <ui:InspectionView Canvas.Left="{x:Static ui:MachinePlan.InspectionLeft}" Canvas.Top="0" Panel.ZIndex="10"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Padding="12"
            Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Inspection Image" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Grid.Row="1" Margin="0,4,0,10" Text="{Binding InspectionImageCaption, TargetNullValue='Waiting for inspection'}"
                    Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InspectionImageCaption}"/>
                <Border Grid.Row="2" Background="{StaticResource ImageBackgroundBrush}" ClipToBounds="True">
                    <Image Source="{Binding InspectionImage}" Stretch="Uniform"/>
                </Border>
                <Border Grid.Row="3" Margin="0,10,0,10" BorderThickness="0,1,0,0" BorderBrush="{StaticResource DividerBrush}"/>
                <TextBlock Grid.Row="4" Text="Bolt Heads / Feeders" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <Border Grid.Row="5" Padding="10" Background="{StaticResource ControlBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="3" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Pickup Feeder" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Tag="{Binding Units.PickupBoltFeeder}" Style="{StaticResource FeederEnabledStyle}"
                                HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Tag="{Binding Signals.Inputs[PickupFeederBoltDetected].IsOn}"
                            Style="{StaticResource FeederDetectionStyle}"/>
                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="ADC · Ready "/><Run Text="{Binding Fastening.PickupHead.Monitor.Status.Ready, TargetNullValue=—, FallbackValue=—, Mode=OneWay}"/>
                            <Run Text=" · Run "/><Run Text="{Binding Fastening.PickupHead.Monitor.Status.Running, TargetNullValue=—, FallbackValue=—, Mode=OneWay}"/>
                            <Run Text=" · Alarm "/><Run Text="{Binding Fastening.PickupHead.Monitor.Status.Alarm, TargetNullValue=—, FallbackValue=—, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Row="6" Padding="10" Background="{StaticResource ControlBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="3">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Shooting Feeder" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Tag="{Binding Units.ShootingBoltFeeder}" Style="{StaticResource FeederEnabledStyle}"
                                HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Tag="{Binding Signals.Inputs[ShootingFeederBoltDetected].IsOn}"
                            Style="{StaticResource FeederDetectionStyle}"/>
                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="ADC · Ready "/><Run Text="{Binding Fastening.ShootingHead.Monitor.Status.Ready, TargetNullValue=—, FallbackValue=—, Mode=OneWay}"/>
                            <Run Text=" · Run "/><Run Text="{Binding Fastening.ShootingHead.Monitor.Status.Running, TargetNullValue=—, FallbackValue=—, Mode=OneWay}"/>
                            <Run Text=" · Alarm "/><Run Text="{Binding Fastening.ShootingHead.Monitor.Status.Alarm, TargetNullValue=—, FallbackValue=—, Mode=OneWay}"/>
                        </TextBlock>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Feeder · UNKNOWN"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Signals.Outputs[ShootingFeederOff].IsOn}" Value="False">
                                                <Setter Property="Text" Value="Feeder · RUN"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Signals.Outputs[ShootingFeederOff].IsOn}" Value="True">
                                                <Setter Property="Text" Value="Feeder · STOP"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Escape · UNKNOWN"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="True"/>
                                                    <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="Escape · BACKWARD"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="False"/>
                                                    <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="Escape · FORWARD"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="12,8" Height="124"
            Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PCB Results" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="New → Old" Margin="14,0,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Margin="20,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                        Foreground="{StaticResource AccentRedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Machine.PcbHistory.SaveError}"/>
                                <Setter Property="ToolTip" Value="{Binding Machine.PcbHistory.SaveError}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Machine.PcbHistory.SaveError}" Value="{x:Null}">
                                        <Setter Property="Text" Value="{Binding PcbHistoryError}"/>
                                        <Setter Property="ToolTip" Value="{Binding PcbHistoryError}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                            Text="{Binding Machine.PcbHistory.PendingCount, StringFormat='Pending saves: {0}'}"/>
                        <Button Content="Retry save" Margin="0,0,8,0" Padding="12,2" MinHeight="24"
                            Command="{Binding RetryPcbSaveCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Machine.PcbHistory.SaveError}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Older" Padding="12,2" MinHeight="24"
                            Command="{Binding LoadOlderPcbsCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
                <ListBox Grid.Row="1" Margin="0,4,0,0" ItemsSource="{Binding PcbRecords}" SelectedItem="{Binding SelectedPcb, Mode=TwoWay}"
                    SelectionChanged="OnPcbSelectionChanged"
                    ItemTemplate="{StaticResource PcbHistoryCard}" ItemContainerStyle="{StaticResource FlatListItemStyle}"
                    Background="{StaticResource ControlBgBrush}" BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
