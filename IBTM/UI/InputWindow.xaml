<Window x:Class="IBTM.UI.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:IBTM.UI"
        xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ui:InputWindow, IsDesignTimeCreatable=False}"
        Title="Digital Inputs"
        Width="720"
        Height="720"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Digital Inputs"
                       Style="{StaticResource TitleStyle}"/>
            <CheckBox Content="Auto Response"
                      ToolTip="Turn off to change sensors manually. Outputs and motion still run."
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      IsChecked="{Binding AutoResponseEnabled, Mode=TwoWay}"
                      Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   Margin="0,4,0,18">
            <TextBlock.Style>
                <Style TargetType="TextBlock"
                       BasedOn="{StaticResource PageSubtitleStyle}">
                    <Setter Property="Text" Value="Blue = energized raw input"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                            <Setter Property="Text"
                                    Value="Virtual mode · blue = energized · toggle inputs to simulate the machine"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding InputsAvailable}" Value="False">
                            <Setter Property="Text" Value="I/O disconnected · UNKNOWN (—). Input states are unavailable, not OFF."/>
                            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ContentControl Grid.Row="2" Margin="0,0,0,14"
                        Content="{Binding Filter}" ContentTemplate="{StaticResource IoFilterTemplate}"
                        HorizontalContentAlignment="Stretch"/>

        <Grid Grid.Row="3"
              Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="NO." Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="1" Text="INPUT" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="2"
                       Text="STATE"
                       Style="{StaticResource SectionHeaderStyle}"/>
        </Grid>

        <ListBox Grid.Row="4"
                 ItemsSource="{Binding Filter.FilteredRows}"
                 Style="{StaticResource IoListStyle}"
                 ItemContainerStyle="{StaticResource IoInputListItemStyle}">
            <ListBox.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}"
                            HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
                <GroupStyle ContainerStyle="{StaticResource IoSectionGroupItemStyle}"
                            HeaderTemplate="{StaticResource IoSectionGroupHeaderTemplate}"/>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Address}" Style="{StaticResource IoAddressStyle}"/>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Signal,
                                                 Converter={StaticResource EnumDescriptionConverter}}"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="ON = MANUAL / OFF = AUTO" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Signal}" Value="{x:Static device:InputIo.AutoMode}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <ContentControl Grid.Column="2"
                                        Tag="{Binding IsOn}"
                                        Style="{StaticResource IoInputStateStyle}"/>
                        <Button Grid.Column="3"
                                Content="Toggle"
                                Style="{StaticResource IoToggleButtonStyle}"
                                Visibility="{Binding IsVirtual,
                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                     Converter={StaticResource BoolToVis}}"
                                Click="OnToggleInput"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
