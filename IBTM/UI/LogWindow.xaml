<Window x:Class="IBTM.UI.LogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:LogWindowViewModel, IsDesignTimeCreatable=False}"
    Title="Logs"
    Width="1100"
    Height="720"
    MinWidth="680"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource AppBgBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox Content="Pause display" IsChecked="{Binding IsPaused}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Copy" Command="{Binding CopyCommand}" ToolTip="Copy selected text, or all displayed logs if nothing is selected."
                    Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" Margin="0,0,8,0"/>
                <Button Content="Copy all" Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" Command="{Binding CopyAllCommand}" Margin="0,0,8,0"/>
                <Button Content="Clear view" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="16,6"/>
            </StackPanel>
            <TextBlock Text="Logs" Style="{StaticResource TitleStyle}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Grid.Row="1" Margin="0,8,0,16" Style="{StaticResource PageSubtitleStyle}"
            Text="Newest messages first. Drag across lines to select, or use Ctrl+A / Ctrl+C. Selecting text pauses the display; file logging continues."
            TextWrapping="Wrap"/>
        <ui:LogTextBox x:Name="LogText" Style="{StaticResource FieldTextBoxStyle}" Grid.Row="2"
            Text="{Binding Text, Mode=OneWay}"
            IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" IsInactiveSelectionHighlightEnabled="True"
            SelectionText="{Binding SelectedText, Mode=TwoWay}" IsPaused="{Binding IsPaused, Mode=TwoWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" Padding="8"
            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding ClipboardError}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ClipboardError}" Value="{x:Null}">
                                <Setter Property="Text" Value="{Binding Log.FileError, StringFormat='FILE ERROR: {0}'}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ClipboardError}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding Log.FileError}" Value="{x:Null}"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="Recent messages are shown here; the log file contains the full session history."/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ClipboardError}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding Log.FileError}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding Log.FilePath}" Value="{x:Null}"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="Recent messages are shown here; file logging is disabled."/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Machine log" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
            <TextBox Text="{Binding Log.FilePath, Mode=OneWay, TargetNullValue='File logging is disabled in this session.'}"
                IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                Padding="0,4,0,0"/>
            <TextBlock Text="ADC communication log" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
            <TextBox Text="{Binding Log.CommunicationFilePath, Mode=OneWay, TargetNullValue='Communication file logging is disabled in this session.'}"
                IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                Padding="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>
