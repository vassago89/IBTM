                        <TextBlock Text="DI Heat sink 2" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Canvas.Left="{x:Static ui:MachinePlan.RearInterfaceLeft}" Canvas.Top="228" Width="214" Style="{StaticResource MapIoCardStyle}">
                <StackPanel>
                    <TextBlock Text="REAR · SMEMA →" Style="{StaticResource MapIoTitleStyle}"/>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[MainConveyorReadyFromRear].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[MainConveyorReadyFromRear].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[MainConveyorReadyFromRear].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Ready from rear" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Outputs[MainConveyorAvailableToRear].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Outputs[MainConveyorAvailableToRear].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoOutputStyle}"/>
                        <TextBlock Text="{Binding Signals.Outputs[MainConveyorAvailableToRear].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DO Available to rear" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Canvas.Left="18" Canvas.Top="324" Width="172" Style="{StaticResource MapIoCardStyle}">
                <StackPanel>
                    <TextBlock Text="MAIN BELT" Style="{StaticResource MapIoTitleStyle}"/>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[MainConveyorAutoMode].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[MainConveyorAutoMode].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[MainConveyorAutoMode].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Auto input" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Outputs[MainConveyorRun].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Outputs[MainConveyorRun].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoOutputStyle}"/>
                        <TextBlock Text="{Binding Signals.Outputs[MainConveyorRun].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DO Run" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Outputs[MainConveyorForward].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Outputs[MainConveyorForward].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoOutputStyle}"/>
                        <TextBlock Text="{Binding Signals.Outputs[MainConveyorForward].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DO Forward" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Canvas.Left="494" Canvas.Top="438"
                       Text="DI blue · DO amber · OFF gray · — no feedback"
                       Style="{StaticResource MapIoLabelStyle}"/>

        </Canvas>
    </Grid>
</UserControl>
