<UserControl x:Class="IBTM.UI.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
             xmlns:ui="clr-namespace:IBTM.UI"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <Style x:Key="IoLedStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#3B4149"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="68"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="16,12">
            <Border Style="{StaticResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="MACHINE"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Border Tag="{Binding MachineTone}"
                                    Style="{StaticResource StateBadgeStyle}">
                                <TextBlock Text="{Binding MachineDisplayState,
                                                         Converter={StaticResource EnumDescriptionConverter}}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding OperatorMessage,
                                                  Converter={StaticResource EnumDescriptionConverter}}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{StaticResource EquipBgBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <Canvas Width="1600"
                                Height="720"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <ui:Station1View Canvas.Left="24" Canvas.Top="10"/>
                            <ui:Station2View Canvas.Left="610" Canvas.Top="10"/>
                            <ui:Station3View Canvas.Left="1078" Canvas.Top="10"/>
                            <ui:ConveyorView Canvas.Left="24" Canvas.Top="434"/>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,12,0">
                        <Ellipse Tag="{Binding EmergencyStopReleased}"
                                 Style="{StaticResource IoLedStyle}"/>
                        <TextBlock Text="{Binding Source={x:Static device:InputIo.EmergencyStopReleased},
                                                  Converter={StaticResource EnumDescriptionConverter}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,12,0">
                        <Ellipse Tag="{Binding DoorClosed}"
                                 Style="{StaticResource IoLedStyle}"/>
                        <TextBlock Text="{Binding Source={x:Static device:InputIo.DoorClosed},
                                                  Converter={StaticResource EnumDescriptionConverter}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,12,0">
                        <Ellipse Tag="{Binding AirPressureOk}"
                                 Style="{StaticResource IoLedStyle}"/>
                        <TextBlock Text="{Binding Source={x:Static device:InputIo.AirPressureOk},
                                                  Converter={StaticResource EnumDescriptionConverter}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsVirtual,
                                                     Converter={StaticResource BoolToVis}}">
                        <Border Width="1"
                                Height="20"
                                Background="{StaticResource DividerBrush}"
                                Margin="2,0,14,0"/>
                        <Button Content="Supply → Buffer"
                            Command="{Binding SupplyToBufferCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,6,0"/>
                        <Button Content="Buffer → Placement"
                            Command="{Binding BufferToPlacementCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Home All"
                            Command="{Binding HomeCommand}"
                            MinWidth="88"
                            Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MachineDisplayState}"
                                                 Value="{x:Static ui:MachineDisplayState.HomeRequired}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Stop Home"
                            Command="{Binding StopHomeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="88"
                            Margin="0,0,6,0"
                            Visibility="{Binding IsHoming,
                                                 Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Recover Buffer"
                            Command="{Binding RecoverBufferCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="112"
                            Margin="0,0,6,0"
                            Visibility="{Binding BufferRecoveryRequired,
                                                 Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Stop"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="76"
                            Margin="0,0,6,0"/>
                    <Button Content="Reset"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="70"
                            Margin="0,0,6,0"/>
                    <Button Content="NG Carrier Reset"
                            Command="{Binding ResetNgCarrierCountCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="76"
                            Margin="0,0,6,0"
                            Visibility="{Binding NgCarrierFull, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="E-STOP"
                            Command="{Binding EStopCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            MinWidth="84"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
