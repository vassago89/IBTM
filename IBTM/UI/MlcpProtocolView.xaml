<UserControl x:Class="IBTM.UI.MlcpProtocolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:mlcp="clr-namespace:IBTM.Mlcp;assembly=IBTM.Mlcp"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:MlcpProtocolViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <Style x:Key="MeasurementVerdict" TargetType="TextBlock" BasedOn="{StaticResource ResultValueStyle}">
            <Setter Property="Text" Value="—"/>
            <Style.Triggers>
                <Trigger Property="Tag"><Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value><Setter Property="Text" Value="OK"/></Trigger>
                <Trigger Property="Tag"><Trigger.Value><sys:Boolean>False</sys:Boolean></Trigger.Value><Setter Property="Text" Value="NG"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="140"/>
            <RowDefinition Height="*" MinHeight="140"/>
        </Grid.RowDefinitions>
        <Border Padding="16,14" Style="{StaticResource CardStyle}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="{ui:Text 'Port'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Width="140" Margin="0,0,8,0" IsEditable="True"
                        ItemsSource="{Binding PortNames}" Text="{Binding SelectedPort, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsConnectionSettingsEnabled}"/>
                    <Button Content="{ui:Text 'Refresh'}" Style="{StaticResource CompactButtonStyle}"
                        Command="{Binding RefreshPortsCommand}" Margin="0,0,16,0"/>
                    <ComboBox Width="120" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate}"
                        IsEnabled="{Binding IsConnectionSettingsEnabled}" Margin="0,0,16,0"/>
                    <Button x:Name="ConnectButton" Content="{Binding ConnectionAction}" Command="{Binding ToggleConnectionCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="100"/>
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{ui:Text 'Disconnected'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Controller.IsOpen}" Value="True">
                                        <Setter Property="Text" Value="{ui:Text 'Port open'}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </WrapPanel>
                <WrapPanel Margin="0,14,0,0" IsEnabled="{Binding IsRequestSettingsEnabled}">
                    <TextBlock Text="{ui:Text 'Response timeout (s)'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Width="85" Text="{Binding ResponseTimeoutText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,24,0"/>
                    <TextBlock Text="{ui:Text 'Command format'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Width="210" SelectedValuePath="Tag" SelectedValue="{Binding Controller.CommandFormat}">
                        <ComboBoxItem Content="COMMAND CR LF" Tag="{x:Static mlcp:MlcpCommandFormat.CommandCrLf}"/>
                        <ComboBoxItem Content="CR COMMAND CR" Tag="{x:Static mlcp:MlcpCommandFormat.CrCommandCr}"/>
                    </ComboBox>
                    <TextBlock Text="ASCII · 8N1" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <WrapPanel Grid.Row="1" Margin="0,16,0,10">
            <Button x:Name="MeasureButton" Content="{ui:Text 'Measure (START)'}" Command="{Binding MeasureCommand}"
                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
            <Button x:Name="ReadLastButton" Content="{ui:Text 'Last result (RECALL)'}" Command="{Binding ReadLastCommand}"
                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="{ui:Text 'Cancel wait'}" Command="{Binding CancelCommand}"
                Style="{StaticResource SecondaryButtonStyle}"/>
        </WrapPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorStatusMessageStyle}"/>
        </StackPanel>
        <Border Grid.Row="3" Padding="16,14" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultHeader" Text="{Binding Result.Header, TargetNullValue=—}" FontSize="20" FontWeight="SemiBold"
                        Tag="{Binding Result.Success}" Style="{StaticResource ResultValueStyle}"/>
                    <TextBlock Grid.Column="1" Text="{ui:Text 'Received'}" Margin="24,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding ResultReadAt, StringFormat=yyyy-MM-dd HH:mm:ss.fff, TargetNullValue=—}"
                        VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
                <DataGrid x:Name="MeasurementsGrid" ItemsSource="{Binding Result.Measurements}" IsReadOnly="True"
                    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{ui:Text 'Measurement'}" Binding="{Binding Value}" Width="*"/>
                        <DataGridTemplateColumn Header="{ui:Text 'Result'}" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type mlcp:MlcpMeasurement}">
                                    <TextBlock Tag="{Binding Success}" Style="{StaticResource MeasurementVerdict}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Row="4" Padding="16,14" Style="{StaticResource CardStyle}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{ui:Text 'Clear Display'}" Command="{Binding ClearLogCommand}" Style="{StaticResource CompactButtonStyle}"/>
                    <TextBlock Text="{ui:Text 'Frame Log'}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="FrameLogBox" Text="{Binding FrameLogText, Mode=OneWay}" IsReadOnly="True"
                    IsUndoEnabled="False" AcceptsReturn="True" IsInactiveSelectionHighlightEnabled="True"
                    FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
