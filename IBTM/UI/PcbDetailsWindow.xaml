<Window x:Class="IBTM.UI.PcbDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:PcbDetailsViewModel, IsDesignTimeCreatable=False}"
    Title="{Binding Record.Number, StringFormat='PCB {0} · Results'}"
    Width="1600" Height="960" MinWidth="1000" MinHeight="700"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource AppBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
    KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style x:Key="ResultBadge" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static core:AssemblyResult.Ok}">
                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static core:AssemblyResult.Ng}">
                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="OK"><Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/></Trigger>
                <Trigger Property="Tag" Value="NG"><Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="Metric" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource ControlSelectedBackgroundBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="{Binding Record.Number, StringFormat='PCB {0}'}" FontSize="24" FontWeight="SemiBold"/>
                <Border Background="{StaticResource ControlBgBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Record.Result, Converter={StaticResource EnumDescriptionConverter}}" Tag="{Binding Record.Result}" Style="{StaticResource ResultBadge}"/>
                </Border>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <WrapPanel TextBlock.Foreground="{StaticResource TextSecondaryBrush}" TextBlock.FontSize="12">
                    <TextBlock Text="{Binding Record.RecipeName}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding Record.HeatSink, Converter={StaticResource EnumDescriptionConverter}}"/>
                </WrapPanel>
                <WrapPanel TextBlock.Foreground="{StaticResource TextMutedBrush}" TextBlock.FontSize="11" Margin="0,3,0,0">
                    <TextBlock Text="{Binding Record.CreatedAt, StringFormat='Created {0:yyyy-MM-dd HH:mm:ss}'}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding Record.UpdatedAt, StringFormat='Updated {0:HH:mm:ss}'}"/>
                </WrapPanel>
            </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,8">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="12,6">
                <DockPanel><StackPanel><TextBlock Text="BOLT FASTENING" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Record.FasteningResult, Converter={StaticResource EnumDescriptionConverter}}" Tag="{Binding Record.FasteningResult}" Style="{StaticResource ResultBadge}" Margin="0,5,0,0"/>
                </StackPanel><TextBlock Text="{Binding BoltResults.Count, StringFormat='{}{0} results'}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/></DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="12,6">
                <DockPanel><StackPanel><TextBlock Text="VISION INSPECTION" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Record.InspectionResult, Converter={StaticResource EnumDescriptionConverter}}" Tag="{Binding Record.InspectionResult}" Style="{StaticResource ResultBadge}" Margin="0,5,0,0"/>
                </StackPanel><TextBlock Text="{Binding Images.Count, StringFormat='{}{0} images'}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/></DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,6">
                <DockPanel><StackPanel><TextBlock Text="MINIMUM TURNS" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Record.TurnsResult, Converter={StaticResource EnumDescriptionConverter}, TargetNullValue='Not set'}" Tag="{Binding Record.TurnsResult}" Style="{StaticResource ResultBadge}" Margin="0,5,0,0"/>
                </StackPanel><TextBlock Text="A3 ÷ 360 ≥ minimum" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/></DockPanel>
            </Border>
        </UniformGrid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Inspection images" Style="{StaticResource PanelTitleStyle}"/>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Data Matrix · " Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding Record.PcbBarcode, TargetNullValue='Not read', FallbackValue='Not read'}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Record.PcbBarcode}"
                                Tag="{Binding Record.PcbBarcodeResult}" Style="{StaticResource ResultBadge}" FontSize="11"/>
                        </DockPanel>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource ImageBackgroundBrush}" CornerRadius="4" MinHeight="160">
                        <Grid>
                            <ui:ImageTeachingView Source="{Binding SelectedImage.Image}" SourceRegion="{Binding SelectedImage.Region}" ShowCrosshair="False" IsHitTestVisible="False"/>
                            <TextBlock Text="No saved image for this point" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,8,0,8">
                        <DockPanel><TextBlock Text="{Binding SelectedImage.Title, TargetNullValue='Inspection capture', FallbackValue='Inspection capture'}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedImage.Verdict}" Tag="{Binding SelectedImage.Verdict}" Style="{StaticResource ResultBadge}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedImage.Details}" ToolTip="{Binding SelectedImage.Details}" TextTrimming="CharacterEllipsis" Margin="0,4,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DockPanel TextBlock.FontSize="11" TextBlock.Foreground="{StaticResource TextMutedBrush}">
                            <TextBlock Text="{Binding SelectedImage.Record.CapturedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}"/>
                            <TextBlock Text="{Binding SelectedImage.Resolution}" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                    <ListBox Grid.Row="3" ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage, Mode=TwoWay}" Height="148"
                        BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource FlatListItemStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate DataType="{x:Type ui:PcbInspectionImageView}">
                            <StackPanel Width="74" Margin="0,0,4,6" ToolTip="{Binding Title}"><Image Source="{Binding Image}" Height="48" Stretch="Uniform"/>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Verdict}" Tag="{Binding Verdict}" Style="{StaticResource ResultBadge}" FontSize="10" Margin="4,0,0,0"/>
                                    <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                        <TextBlock Text="Loading images…" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding LoadImagesCommand.IsRunning, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ImageError}" ToolTip="{Binding ImageError}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AccentRedBrush}"/>
                        <ItemsControl ItemsSource="{Binding PresenceResults}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3,12,0"><TextBlock Text="{Binding Key, StringFormat='Bolt {0}: '}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="Presence" Text="NG" Foreground="{StaticResource AccentRedBrush}" FontSize="11"/>
                                </StackPanel>
                                <DataTemplate.Triggers><DataTrigger Binding="{Binding Value}" Value="True">
                                    <Setter TargetName="Presence" Property="Text" Value="OK"/><Setter TargetName="Presence" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                </DataTrigger></DataTemplate.Triggers>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Bolt results" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding BoltResults}" SelectedItem="{Binding SelectedBolt, Mode=TwoWay}" AutoGenerateColumns="False"
                        IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False"
                        CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                        BorderThickness="0" Background="{StaticResource ControlBgBrush}" RowHeight="28" ColumnHeaderHeight="28" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BOLT NAME" Binding="{Binding BoltLabel, Mode=OneWay}" Width="1.5*" MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding BoltLabel}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="HEAD" Binding="{Binding HeadLabel}" Width="108"/>
                            <DataGridTemplateColumn Header="FASTEN" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type ui:PcbBoltResultView}">
                                <TextBlock Text="{Binding Verdict}" Tag="{Binding Verdict}" Style="{StaticResource ResultBadge}" FontSize="11"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="VISION" Width="62"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type ui:PcbBoltResultView}">
                                <TextBlock Text="{Binding VisionVerdict}" Tag="{Binding VisionVerdict}" Style="{StaticResource ResultBadge}" FontSize="11"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="TURNS" Width="66"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type ui:PcbBoltResultView}">
                                <TextBlock Text="{Binding TurnsVerdict}" Tag="{Binding TurnsVerdict}" Style="{StaticResource ResultBadge}" FontSize="11"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ACTUAL / MIN" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="{x:Type ui:PcbBoltResultView}">
                                <TextBlock FontSize="11"><Run Text="{Binding Result.TotalTurns, Mode=OneWay, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}"/><Run Text=" / "/><Run Text="{Binding Result.MinimumTurns, Mode=OneWay, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}"/></TextBlock>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="TORQUE" Binding="{Binding Result.Torque, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="No fastening results recorded" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoltResults.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="204"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="MINIMUM TURNS" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock FontSize="14" Margin="0,3,0,0"><Run Text="{Binding SelectedBolt.Result.MinimumTurns, Mode=OneWay, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}"/><Run Text=" · "/><Run Text="{Binding SelectedBolt.TurnsVerdict, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedBolt.Title, TargetNullValue='Controller details', FallbackValue='Controller details'}"
                                        ToolTip="{Binding SelectedBolt.Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="16"/>
                                    <WrapPanel Margin="0,3,0,4" TextBlock.FontSize="11" TextBlock.Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock Text="{Binding SelectedBolt.Result.Source, Converter={StaticResource EnumDescriptionConverter}}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding SelectedBolt.Result.RecordedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}', TargetNullValue='Time not recorded', FallbackValue='Time not recorded'}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource TextPrimaryBrush}">
                                <TabItem Header="Measurements" Padding="10,4">
                                    <UniformGrid Columns="4" Rows="4" Margin="0,8,0,0" VerticalAlignment="Top">
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="RESULT TORQUE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Torque, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="TARGET TORQUE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.TargetTorque, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="TARGET SPEED (rpm)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.TargetSpeedRpm, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="FASTENING TIME (ms)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.FasteningTimeMilliseconds, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="ANGLE A1 (°)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.Angle1, StringFormat=0.##, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="ANGLE A2 (°)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.Angle2, StringFormat=0.##, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="ANGLE A3 (°)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.Angle3, StringFormat=0.##, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="TOTAL TURNS" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.TotalTurns, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="SNUG ANGLE (°)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.SnugAngle, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="PRESET" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.Preset, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="EVENT COUNT" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.EventCount, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="SCREW COUNT" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.ScrewCount, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}" ToolTip="{Binding SelectedBolt.ControllerErrorDescription}"><TextBlock Text="ERROR CODE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.ErrorCode, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="STATUS" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.ControllerStatus, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}" ToolTip="{Binding SelectedBolt.ControllerStatus}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="DIRECTION" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Direction, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}" ToolTip="{Binding SelectedBolt.Direction}"/></StackPanel>
                                        <StackPanel Style="{StaticResource Metric}"><TextBlock Text="PORT / ADDRESS" Style="{StaticResource MetricLabel}"/>
                                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding SelectedBolt.Result.Controller.Port, Mode=OneWay, TargetNullValue='—', FallbackValue='—'}"/><Run Text=" / "/><Run Text="{Binding SelectedBolt.Result.Controller.SlaveAddress, Mode=OneWay, TargetNullValue='—', FallbackValue='—'}"/></TextBlock>
                                        </StackPanel>
                                    </UniformGrid>
                                </TabItem>
                                <TabItem Padding="10,4">
                                    <TabItem.Header>
                                        <TextBlock Text="Diagnostics">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedBolt.Result.Success}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </TabItem.Header>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="64"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Left" Text="ERROR / MESSAGE" Style="{StaticResource MetricLabel}" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding SelectedBolt.ControllerErrorDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedBolt.ControllerErrorDescription}"/>
                                        </DockPanel>
                                        <TextBox Grid.Row="1" Text="{Binding SelectedBolt.Result.Error, Mode=OneWay, TargetNullValue='—', FallbackValue='—'}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" Padding="6" BorderThickness="0" Foreground="{StaticResource AccentRedBrush}"/>
                                        <TextBlock Grid.Row="2" Text="ORIGINAL ADC REGISTERS · ADDRESS : HEX" Style="{StaticResource MetricLabel}" Margin="0,8,0,4"/>
                                        <TextBox Grid.Row="3" Text="{Binding SelectedBolt.RegisterText, Mode=OneWay, TargetNullValue='Not recorded', FallbackValue='Not recorded'}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Padding="6" BorderThickness="0"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
            Text="Torque: controller unit" TextWrapping="Wrap"/>
    </Grid>
</Window>
