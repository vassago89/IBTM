<UserControl x:Class="IBTM.UI.TeachingView"
    x:Name="TeachingRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:TeachingViewModel, IsDesignTimeCreatable=False}"
    Foreground="{StaticResource TextPrimaryBrush}"
    Background="{StaticResource AppBgBrush}"
    Validation.ErrorTemplate="{x:Null}">
    <UserControl.BindingGroup>
        <BindingGroup Name="RecipeInputs"/>
    </UserControl.BindingGroup>
    <UserControl.Resources>
        <CollectionViewSource x:Key="TeachingPoints" Source="{Binding FilteredPoints}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"
                IsEnabled="{Binding IsTeachingEditAllowed}">
                <TextBlock Text="Recipe" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding RecipeEditor.Name, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged}"
                    Width="180" Margin="0,0,6,0" ToolTip="Recipe name"/>
                <Button Command="{Binding SaveCommand}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Content" Value="Save"/>
                            <Setter Property="ToolTip" Value="Save the recorded machine coordinates and the current product recipe. This does not record or change any position."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveCommand.IsRunning}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=TeachingRoot, Path=(Validation.HasError)}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="ToolTip" Value="Correct the highlighted input before saving."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="New Recipe" Command="{Binding RecipeEditor.NewCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Start a new product recipe. Supply and Placement handoff coordinates are kept."/>
            </StackPanel>
            <TextBlock Text="Teaching" Style="{StaticResource TitleStyle}"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="330" MaxWidth="420"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*" MinWidth="280"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="270"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80" MaxHeight="260"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="270"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Teaching Unit" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding TeachingUnits}"
                            SelectedItem="{Binding SelectedTeachingUnit, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock
                            Text="{Binding ActiveMotionGroup, Converter={StaticResource EnumDescriptionConverter}, StringFormat=Axes · {0}}"
                            Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        <ComboBox ItemsSource="{Binding HeatSinkSlots}"
                            SelectedItem="{Binding SelectedPcb, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,6,0,0"
                            Visibility="{Binding BoltPointEditorVisible, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <ui:TeachingPointList x:Name="TeachingPointsList" Grid.Row="1"
                        ItemsSource="{Binding Source={StaticResource TeachingPoints}}"
                        SelectedItem="{Binding SelectedPoint, UpdateSourceTrigger=PropertyChanged}"
                        Background="{StaticResource EquipBgBrush}" BorderThickness="1" BorderBrush="{StaticResource DividerBrush}"
                        ItemContainerStyle="{StaticResource FlatListItemStyle}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate DataType="{x:Type data:CollectionViewGroup}">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}"
                                            TextWrapping="Wrap" FontWeight="SemiBold" Margin="8,10,4,4"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:TeachingPoint}">
                                <StackPanel Margin="4,4" ToolTip="{Binding Description}">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding PositionLabel}" TextWrapping="Wrap"
                                        FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ui:TeachingPointList>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0"
                        Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Live → Align with crosshair → Record Position"
                            TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding FasteningHeads}"
                            SelectedItem="{Binding NewFasteningHead, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2">
                            <Button x:Name="AddBoltButton" Content="Add Bolt"
                                Command="{Binding AddBoltPointCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,3,0"/>
                            <Button Content="Remove Bolt"
                                Command="{Binding RemoveBoltPointCommand}"
                                Style="{StaticResource DangerButtonStyle}" Margin="3,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                    <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding SelectedPoint.Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedPoint.Description}" TextWrapping="Wrap"
                                Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding HomeBlock, Converter={StaticResource EnumDescriptionConverter}}"
                                Foreground="{StaticResource AccentAmberBrush}" TextWrapping="Wrap"/>
                            <ui:TeachingMotionView/>
                            <Button Content="Return from Bolt Pickup"
                                Command="{Binding ReturnFromPickupCommand}"
                                Margin="0,6,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Move Z to Safe Z, then raise the pickup head (Head 1). XY and vacuum remain unchanged."
                                Visibility="{Binding IsFasteningSelected, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="8"
                Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Command="{Binding ToggleLiveViewCommand}" Margin="0,0,8,0" MinWidth="90">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="Content" Value="Live"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Inspection.IsLiveView}" Value="True">
                                                <Setter Property="Content" Value="Stop Live"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="{Binding SelectedPoint.Name}" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <Border Grid.Row="1" Background="{StaticResource ImageBackgroundBrush}">
                            <ui:ImageTeachingView Source="{Binding LiveImage}" ShowCrosshair="True"/>
                        </Border>
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                            Text="Align the target with the crosshair, then Record Position. The coordinates and reference image are saved together. Edit ROI and inspection parameters in Inspection Teaching."/>
                    </Grid>
                    <TextBlock Grid.Row="2"
                        Text="{Binding CameraError}"
                        TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}" Margin="4"/>
                </Grid>
            </Border>
            <Border Padding="12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Grid.Column" Value="2"/>
                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInspectionSelected}" Value="True">
                                <Setter Property="Grid.Column" Value="4"/>
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IoStatusTemplate}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
