<Application x:Class="IBTM.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:IBTM.UI"
             ThemeMode="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/AppStyles.xaml"/>
                <ResourceDictionary Source="UI/MachineStyles.xaml"/>
                <ResourceDictionary Source="UI/IoWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <ui:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
            <DrawingImage x:Key="AppIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#D9DCE1"
                                         Geometry="M 0,0 H 16 V 16 H 0 Z"/>
                        <GeometryDrawing Brush="#111318"
                                         Geometry="M 2,2 H 14 V 14 H 2 Z"/>
                        <GeometryDrawing Brush="#858C96"
                                         Geometry="M 4,4 H 12 V 6 H 4 Z M 4,10 H 12 V 12 H 4 Z"/>
                        <GeometryDrawing Brush="#58A86B"
                                         Geometry="M 6,6 H 10 V 10 H 6 Z"/>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
            <DataTemplate x:Key="EnumItemTemplate">
                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
