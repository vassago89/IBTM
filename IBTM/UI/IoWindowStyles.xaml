<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="IoListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
    </Style>

    <DataTemplate x:Key="IoGroupHeaderTemplate">
        <Grid Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding ItemCount, StringFormat={}{0} items}"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <Style x:Key="IoGroupItemStyle" TargetType="GroupItem">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource ControlBgBrush}"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="4,4,0,0">
                                <ContentPresenter/>
                            </Border>
                            <ItemsPresenter Grid.Row="1"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="IoSectionGroupHeaderTemplate">
        <Border x:Name="Header"
                Padding="12,7"
                Background="{StaticResource EquipBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                <Setter TargetName="Header" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="IoSectionGroupItemStyle" TargetType="GroupItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter/>
                        <ItemsPresenter Grid.Row="1"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IoListItemStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource FlatListItemStyle}">
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="IoToggleButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="IoInputLedStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Fill" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Fill" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="Stroke" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="StrokeThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IoInputStateStyle" TargetType="ContentControl">
        <Setter Property="Content" Value="OFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{TemplateBinding Foreground}"/>
                        <TextBlock Margin="8,0,0,0"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Content" Value="ON"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IoOutputStateStyle" TargetType="ContentControl">
        <Setter Property="Content" Value="OFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10"
                                Height="10"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="1"/>
                        <TextBlock Margin="8,0,0,0"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Content" Value="ON"/>
                <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
