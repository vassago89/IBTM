<UserControl x:Class="IBTM.UI.ManualHardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:ManualHardwareViewModel, IsDesignTimeCreatable=False}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,18">
            <TextBlock Text="Manual" Style="{StaticResource TitleStyle}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding Conveyors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:ManualConveyorRow}">
                        <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Io.Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                               Style="{StaticResource PanelTitleStyle}" Margin="0,0,16,0"/>
                                    <TextBlock Text="{Binding Io.IsOn, Converter={StaticResource SignalTextConverter}}" Style="{StaticResource IoOutputStateStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Run" Command="{Binding RunCommand}"
                                        ToolTip="{Binding ActionMessage}" ToolTipService.ShowOnDisabled="True"
                                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="100" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="Stop" Command="{Binding StopCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="100"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
