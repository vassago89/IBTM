<Window x:Class="IBTM.Presentation.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IBTM.Presentation.ViewModels"
        xmlns:views="clr-namespace:IBTM.Presentation.Views"
        Title="IBTM — SMT Inline Control System"
        WindowState="Maximized"
        MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ProcessViewModel}">
            <views:ProcessView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TeachingViewModel}">
            <views:TeachingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════════════════════════════════
             사이드바 (Fluent NavigationView 스타일)
             ═════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBgBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 로고 -->
                <Border Grid.Row="0" Padding="16,16,16,12">
                    <StackPanel>
                        <TextBlock Text="IBTM"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="SMT Inline Control"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 네비게이션 -->
                <StackPanel Grid.Row="1" Margin="0,4">
                    <RadioButton Content="  Process Monitor"
                                 GroupName="Navigation"
                                 IsChecked="True"
                                 Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Process"/>

                    <RadioButton Content="  Teaching"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Teaching"/>

                    <RadioButton Content="  Settings"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Settings"/>

                    <RadioButton Content="  Log Viewer"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavButtonStyle}"
                                 IsEnabled="False"/>
                </StackPanel>

                <!-- 하단 디바이스 상태 -->
                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource DividerBrush}"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="DEVICE" Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Ellipse Style="{StaticResource StatusLedStyle}" Fill="{StaticResource AccentGreenBrush}"/>
                            <TextBlock Text="Zone1 Axis (Pick)" Style="{StaticResource DeviceStatusStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Ellipse Style="{StaticResource StatusLedStyle}" Fill="{StaticResource AccentGreenBrush}"/>
                            <TextBlock Text="Zone2 Axis (Bolt)" Style="{StaticResource DeviceStatusStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Ellipse Style="{StaticResource StatusLedStyle}" Fill="{StaticResource AccentGreenBrush}"/>
                            <TextBlock Text="Zone3 Axis (Inspect)" Style="{StaticResource DeviceStatusStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Ellipse Style="{StaticResource StatusLedStyle}" Fill="{StaticResource AccentYellowBrush}"/>
                            <TextBlock Text="IO (Virtual)" Style="{StaticResource DeviceStatusStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Ellipse Style="{StaticResource StatusLedStyle}" Fill="{StaticResource AccentYellowBrush}"/>
                            <TextBlock Text="Bolt Ctrl (Stub)" Style="{StaticResource DeviceStatusStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Ellipse Style="{StaticResource StatusLedStyle}" Fill="{StaticResource AccentYellowBrush}"/>
                            <TextBlock Text="Camera (Sim)" Style="{StaticResource DeviceStatusStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 메인 콘텐츠 -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"/>
    </Grid>
</Window>
