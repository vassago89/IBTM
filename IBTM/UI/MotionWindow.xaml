<Window x:Class="IBTM.UI.MotionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Motion Monitor" Width="1240" Height="720" MinWidth="1120" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBgBrush}">
    <Window.Resources>
        <Style x:Key="MotionBit" TargetType="ContentControl">
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="Badge" CornerRadius="3" Padding="5,6" BorderThickness="1"
                                BorderBrush="{StaticResource DividerBrush}" Background="{StaticResource EquipBgBrush}">
                            <TextBlock x:Name="Label" Text="—" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                <Setter TargetName="Label" Property="Text" Value="OFF"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Label" Property="Text" Value="ON"/>
                                <Setter TargetName="Label" Property="Foreground" Value="#101C24"/>
                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource IoInputOnBrush}"/>
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource IoInputOnBrush}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Value="Fault"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="White"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Motion Monitor" Style="{StaticResource TitleStyle}"/>
            <Button Content="STOP" Command="{Binding StopCommand}" Style="{StaticResource DangerButtonStyle}"
                    HorizontalAlignment="Right" MinWidth="100" ToolTip="Stop all machine operations."/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,6,0,16">
            <TextBlock Text="{Binding ControlStatus}" Foreground="{StaticResource AccentAmberBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="Blue = ON · red = limit / alarm · — = unavailable · PCB Supply homing uses Home All"
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SEARCH · AXIS NUMBER / MECHANISM / AXIS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Content="Enabled axes only" IsChecked="{Binding EnabledOnly}"
                      Margin="20,0,0,0" VerticalAlignment="Bottom"/>
        </Grid>
        <Grid Grid.Row="3" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/><ColumnDefinition Width="42"/><ColumnDefinition Width="108"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="62"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/>
                <ColumnDefinition Width="62"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/>
                <ColumnDefinition Width="196"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="NO." Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="1" Text="AXIS" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="2" Text="POSITION (mm)" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="3" Text="STATE" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="4" Text="SERVO" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="HOMED" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="HOME IN" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="7" Text="−LIMIT" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="8" Text="+LIMIT" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="9" Text="ALARM" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
        </Grid>
        <ListBox Grid.Row="4" ItemsSource="{Binding View}" Style="{StaticResource IoListStyle}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItemStyle}">
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}" HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/><ColumnDefinition Width="42"/><ColumnDefinition Width="108"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="62"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/><ColumnDefinition Width="62"/><ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="196"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Address}" Style="{StaticResource IoAddressStyle}" ToolTip="Active controller axis number."/>
                        <TextBlock Grid.Column="1" Text="{Binding Axis}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{Binding Position}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="15"/>
                        <TextBlock Grid.Column="3" Text="{Binding Condition}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        <ContentControl Grid.Column="4" Tag="{Binding ServoOn}" Style="{StaticResource MotionBit}"/>
                        <ContentControl Grid.Column="5" Tag="{Binding Homed}" Style="{StaticResource MotionBit}"/>
                        <ContentControl Grid.Column="6" Tag="{Binding HomeSensor}" Style="{StaticResource MotionBit}"/>
                        <ContentControl Grid.Column="7" Tag="{Binding NegativeLimit}" Content="Fault" Style="{StaticResource MotionBit}"/>
                        <ContentControl Grid.Column="8" Tag="{Binding PositiveLimit}" Content="Fault" Style="{StaticResource MotionBit}"/>
                        <ContentControl Grid.Column="9" Tag="{Binding Alarm}" Content="Fault" Style="{StaticResource MotionBit}" ToolTip="Axis alarm or emergency."/>
                        <StackPanel Grid.Column="10" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding ServoAction}" Width="96" Margin="8,0,6,0"
                                    Style="{StaticResource SecondaryButtonStyle}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.ToggleServoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Content="Home" Width="80" Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="{Binding HomeHint}" ToolTipService.ShowOnDisabled="True" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.HomeAxisCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
