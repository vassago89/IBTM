<UserControl x:Class="IBTM.UI.OperationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource AppBgBrush}">

    <Grid Margin="18,14">
        <Border Background="{StaticResource EquipBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="3"
                ClipToBounds="True">
            <Canvas Width="1600"
                    Height="840"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,18,0,0">
                <ui:ConveyorView Canvas.Left="24" Canvas.Top="360"
                                 Panel.ZIndex="0"/>
                <ui:Station1View Canvas.Left="24" Canvas.Top="0"
                                 Panel.ZIndex="10"/>
                <ui:Station2View Canvas.Left="610" Canvas.Top="0"
                                 Panel.ZIndex="10"/>
                <ui:Station3View Canvas.Left="1018" Canvas.Top="0"
                                 Panel.ZIndex="10"/>
            </Canvas>
        </Border>
    </Grid>
</UserControl>
