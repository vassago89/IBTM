<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core">
    <SolidColorBrush x:Key="MaterialPcbBrush" Color="#68A97B"/>
    <SolidColorBrush x:Key="MaterialPcbBorderBrush" Color="#436C50"/>
    <SolidColorBrush x:Key="MaterialIpmBrush" Color="#87929B"/>
    <SolidColorBrush x:Key="CarrierBrush" Color="#638CA7"/>
    <SolidColorBrush x:Key="CarrierBodyBrush" Color="#263A47"/>
    <SolidColorBrush x:Key="HeatSinkBrush" Color="#B4935D"/>
    <SolidColorBrush x:Key="HeatSinkBodyBrush" Color="#3C3223"/>
    <SolidColorBrush x:Key="MachineStructureBrush" Color="#202A32"/>
    <SolidColorBrush x:Key="MachineStructureBorderBrush" Color="#5B6B78"/>
    <SolidColorBrush x:Key="MachineOverlayBrush" Color="#70212A31"/>
    <SolidColorBrush x:Key="MachineGhostBrush" Color="#30212A31"/>
    <SolidColorBrush x:Key="AlarmStateBackgroundBrush" Color="#341D20"/>
    <SolidColorBrush x:Key="ConfirmedStateBackgroundBrush" Color="#1D2E25"/>
    <SolidColorBrush x:Key="ActiveStateBackgroundBrush" Color="#1B2B38"/>
    <SolidColorBrush x:Key="MapActiveBackgroundBrush" Color="#26333D"/>

    <x:Static x:Key="PcbWidth" Member="ui:MachinePlan.PcbWidth"/>
    <x:Static x:Key="PcbHeight" Member="ui:MachinePlan.PcbHeight"/>
    <x:Static x:Key="PcbSlotWidth" Member="ui:MachinePlan.PcbSlotWidth"/>
    <x:Static x:Key="PcbSlotHeight" Member="ui:MachinePlan.PcbSlotHeight"/>
    <x:Static x:Key="CarrierWidth" Member="ui:MachinePlan.CarrierWidth"/>
    <x:Static x:Key="CarrierHeight" Member="ui:MachinePlan.CarrierHeight"/>
    <x:Static x:Key="BackupPlateWidth" Member="ui:MachinePlan.PlateWidth"/>
    <x:Static x:Key="BackupPlateHeight" Member="ui:MachinePlan.PlateHeight"/>

    <GeometryGroup x:Key="BackupPlatePinGeometry">
        <EllipseGeometry Center="5,5" RadiusX="3" RadiusY="3"/>
        <EllipseGeometry Center="279,5" RadiusX="3" RadiusY="3"/>
        <EllipseGeometry Center="5,95" RadiusX="3" RadiusY="3"/>
        <EllipseGeometry Center="279,95" RadiusX="3" RadiusY="3"/>
    </GeometryGroup>

    <DrawingBrush x:Key="BackupPlateBrush" Viewbox="0,0,284,100" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource MachineStructureBrush}" Geometry="M0,0 H284 V100 H0 Z"/>
                <GeometryDrawing Brush="{StaticResource EquipBgBrush}" Geometry="{StaticResource BackupPlatePinGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource TextMutedBrush}" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="MapLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="MapHintStyle" TargetType="TextBlock" BasedOn="{StaticResource MapLabelStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="EquipmentRoleLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MapHintStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="IndicatorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MapLabelStyle}">
        <Setter Property="Margin" Value="7,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="SafetyLedStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SetupLedStyle" TargetType="Ellipse" BasedOn="{StaticResource SafetyLedStyle}">
        <Setter Property="Fill" Value="{StaticResource AccentAmberBrush}"/>
    </Style>

    <Style x:Key="PresenceLedStyle" TargetType="Ellipse" BasedOn="{StaticResource SafetyLedStyle}">
        <Setter Property="Fill" Value="{StaticResource DividerBrush}"/>
    </Style>

    <Style x:Key="ResultTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MapHintStyle}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,6,4"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static core:AssemblyResult.Ok}">
                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static core:AssemblyResult.Ng}">
                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StateBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="4,1,1,1"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style x:Key="MachineStateBadgeStyle" TargetType="Border" BasedOn="{StaticResource StateBadgeStyle}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ui:MachineDisplayState.Ready}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:MachineDisplayState.HomeRequired}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:MachineDisplayState.ServoOff}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:MachineDisplayState.Running}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:MachineDisplayState.Homing}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:MachineDisplayState.MotionFault}">
                <Setter Property="Background" Value="{StaticResource AlarmStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:MachineDisplayState.SafetyStop}">
                <Setter Property="Background" Value="{StaticResource AlarmStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:MachineDisplayState.Alarm}">
                <Setter Property="Background" Value="{StaticResource AlarmStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HandlerStateBadgeStyle" TargetType="Border" BasedOn="{StaticResource StateBadgeStyle}">
        <Setter Property="Width" Value="258"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="10,7"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ui:HandlerDisplayState.Disabled}">
                <Setter Property="Opacity" Value="0.65"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:HandlerDisplayState.CarrierAvailable}">
                <Setter Property="Background" Value="{StaticResource ConfirmedStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:HandlerDisplayState.Working}">
                <Setter Property="Background" Value="{StaticResource ActiveStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:HandlerDisplayState.Moving}">
                <Setter Property="Background" Value="{StaticResource ActiveStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:HandlerDisplayState.IoAlarm}">
                <Setter Property="Background" Value="{StaticResource AlarmStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StationStateBadgeStyle" TargetType="Border" BasedOn="{StaticResource StateBadgeStyle}">
        <Setter Property="Width" Value="210"/>
        <Setter Property="MinHeight" Value="54"/>
        <Setter Property="Padding" Value="10,7"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ui:StationDisplayState.Disabled}">
                <Setter Property="Opacity" Value="0.65"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:StationDisplayState.HeatSinkDetected}">
                <Setter Property="Background" Value="{StaticResource ConfirmedStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:StationDisplayState.WaitingForTransfer}">
                <Setter Property="Background" Value="{StaticResource ConfirmedStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:StationDisplayState.Working}">
                <Setter Property="Background" Value="{StaticResource ActiveStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:StationDisplayState.IoAlarm}">
                <Setter Property="Background" Value="{StaticResource AlarmStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MapHintStyle}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DeviceBodyStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OverheadBodyStyle" TargetType="Border" BasedOn="{StaticResource DeviceBodyStyle}">
        <Setter Property="Background" Value="{StaticResource MachineOverlayBrush}"/>
        <Setter Property="Opacity" Value="0.82"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolHeadFootprintStyle" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HeatSinkBrush}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="CornerRadius" Value="17"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="Background" Value="{StaticResource ActiveStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VacuumDetectedVisualStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="Stroke" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <Style x:Key="ActiveToolNumberStyle" TargetType="TextBlock">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Panel.ZIndex" Value="5"/>
    </Style>

    <Style x:Key="BoltTargetStyle" TargetType="Border">
        <Setter Property="Width" Value="{x:Static ui:MachinePlan.BoltTargetSize}"/>
        <Setter Property="Height" Value="{x:Static ui:MachinePlan.BoltTargetSize}"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="{x:Static ui:MachinePlan.BoltTargetOffset}" Y="{x:Static ui:MachinePlan.BoltTargetOffset}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{StaticResource MachineStructureBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MachineStructureBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ui:BoltTargetState.Active}">
                <Setter Property="Background" Value="{StaticResource ActiveStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:BoltTargetState.Ok}">
                <Setter Property="Background" Value="{StaticResource ConfirmedStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ui:BoltTargetState.Ng}">
                <Setter Property="Background" Value="{StaticResource AlarmStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DownFootprintStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlacementBodyStyle" TargetType="Border" BasedOn="{StaticResource OverheadBodyStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding PcbPlacementHandlerDown}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LeftGripperJawStyle" TargetType="Border">
        <Setter Property="Width" Value="4"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="5,0,0,4"/>
        <Setter Property="Background" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="Margin" Value="11,0,0,4"/>
                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RightGripperJawStyle" TargetType="Border" BasedOn="{StaticResource LeftGripperJawStyle}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,0,5,4"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="Margin" Value="0,0,11,4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CarrierPickerLeftJawStyle" TargetType="Border">
        <Setter Property="Width" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="-6,8,0,8"/>
        <Setter Property="Background" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="Margin" Value="-2,8,0,8"/>
                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CarrierPickerRightJawStyle" TargetType="Border" BasedOn="{StaticResource CarrierPickerLeftJawStyle}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,8,-6,8"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="Margin" Value="0,8,-2,8"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BackupPlateVisualStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource BackupPlateWidth}"/>
        <Setter Property="Height" Value="{StaticResource BackupPlateHeight}"/>
        <Setter Property="Background" Value="{StaticResource BackupPlateBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Panel.ZIndex" Value="1"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StopperVisualStyle" TargetType="Border">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Opacity" Value="0.3"/>
        <Setter Property="Panel.ZIndex" Value="3"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="Background" Value="{StaticResource AccentAmberBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConveyorBedStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MachineStructureBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MachineStructureBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BufferStyle" TargetType="Border" BasedOn="{StaticResource DeviceBodyStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding State.Display.BufferConflict}" Value="True">
                <Setter Property="Background" Value="{StaticResource AlarmStateBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
