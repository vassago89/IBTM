<UserControl x:Class="IBTM.UI.TeachingMotionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:ui="clr-namespace:IBTM.UI"
             xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
             Foreground="{StaticResource TextPrimaryBrush}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:TeachingMotionViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <x:Array x:Key="JogSpeeds" Type="{x:Type sys:Double}">
            <sys:Double>0.1</sys:Double>
            <sys:Double>1</sys:Double>
            <sys:Double>10</sys:Double>
            <sys:Double>50</sys:Double>
        </x:Array>
        <x:Array x:Key="StepDistances" Type="{x:Type sys:Double}">
            <sys:Double>0.01</sys:Double>
            <sys:Double>0.1</sys:Double>
            <sys:Double>1</sys:Double>
        </x:Array>
        <DataTemplate x:Key="DirectionButton">
            <Grid Margin="3,2">
                <ui:HoldButton x:Name="Jog" Content="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                               Style="{StaticResource JogButtonStyle}"
                               PressCommand="{Binding DataContext.JogCommand, RelativeSource={RelativeSource AncestorType=ui:TeachingMotionView}}"
                               ReleaseCommand="{Binding DataContext.JogStopCommand, RelativeSource={RelativeSource AncestorType=ui:TeachingMotionView}}"
                               CommandParameter="{Binding}" ToolTip="Hold to move; release to stop."/>
                <Button x:Name="Step" Content="{Binding Converter={StaticResource EnumDescriptionConverter}}"
                        Style="{StaticResource JogButtonStyle}" Visibility="Collapsed"
                        Command="{Binding DataContext.StepCommand, RelativeSource={RelativeSource AncestorType=ui:TeachingMotionView}}"
                        CommandParameter="{Binding}" ToolTip="Move by the selected step distance."/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.MoveMode, RelativeSource={RelativeSource AncestorType=ui:TeachingMotionView}}"
                             Value="{x:Static ui:TeachingMoveMode.Step}">
                    <Setter TargetName="Jog" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Step" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="mm" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="Current Position" Style="{StaticResource PanelTitleStyle}"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="68"/>
                <ColumnDefinition Width="68"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding CurrentX, StringFormat=F3}" VerticalAlignment="Center"
                       FontFamily="Cascadia Mono, Consolas" FontSize="16"/>
            <ContentControl Grid.Column="1" Content="{x:Static ui:TeachingDirection.XMinus}" ContentTemplate="{StaticResource DirectionButton}"/>
            <ContentControl Grid.Column="2" Content="{x:Static ui:TeachingDirection.XPlus}" ContentTemplate="{StaticResource DirectionButton}"/>
            <Grid Grid.Row="1" Grid.ColumnSpan="3" Visibility="{Binding HasY, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="68"/><ColumnDefinition Width="68"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CurrentY, StringFormat=F3}" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas" FontSize="16"/>
                <ContentControl Grid.Column="1" Content="{x:Static ui:TeachingDirection.YMinus}" ContentTemplate="{StaticResource DirectionButton}"/>
                <ContentControl Grid.Column="2" Content="{x:Static ui:TeachingDirection.YPlus}" ContentTemplate="{StaticResource DirectionButton}"/>
            </Grid>
            <Grid Grid.Row="2" Grid.ColumnSpan="3" Visibility="{Binding HasZ, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="68"/><ColumnDefinition Width="68"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CurrentZ, StringFormat=F3}" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas" FontSize="16"/>
                <ContentControl Grid.Column="1" Content="{x:Static ui:TeachingDirection.ZMinus}" ContentTemplate="{StaticResource DirectionButton}"/>
                <ContentControl Grid.Column="2" Content="{x:Static ui:TeachingDirection.ZPlus}" ContentTemplate="{StaticResource DirectionButton}"/>
            </Grid>
        </Grid>
        <ComboBox ItemsSource="{Binding MoveModes}" SelectedItem="{Binding MoveMode}" Margin="0,12,0,8"/>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MoveMode}" Value="{x:Static ui:TeachingMoveMode.Step}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MotionHint}" Value="{x:Static ui:TeachingMotionHint.BoltAdjustment}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Move speed" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox Grid.Column="1" ItemsSource="{StaticResource JogSpeeds}" SelectedItem="{Binding JogSpeed}"/>
            <TextBlock Grid.Column="2" Text="mm/s" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MoveMode}" Value="{x:Static ui:TeachingMoveMode.Step}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Step distance" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox Grid.Column="1" ItemsSource="{StaticResource StepDistances}" SelectedItem="{Binding StepDistance}"
                      ToolTip="Bolt adjustments use the selected move speed. Other units use their configured axis speed."/>
            <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <UniformGrid Columns="2" Margin="0,12,0,0">
            <Button Content="STOP" Command="{Binding JogStopCommand}" Style="{StaticResource JogStopButtonStyle}" Margin="0,0,4,0"/>
            <Button Content="{Binding Source={x:Static device:TeachingTarget.SafeZ}, Converter={StaticResource EnumDescriptionConverter}}"
                    Command="{Binding MoveToHorizontalZCommand}" Style="{StaticResource SecondaryButtonStyle}"
                    Visibility="{Binding HasZ, Converter={StaticResource BoolToVis}}" Margin="4,0,0,0"/>
        </UniformGrid>
        <TextBlock Text="{Binding SelectedPoint.Name}" TextWrapping="Wrap"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,6"/>
        <UniformGrid Columns="2" Margin="0,0,0,8">
            <Button Content="Previous point" Command="{Binding SelectPreviousPointCommand}"
                    ToolTip="Select only; no axis movement."
                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
            <Button Content="Next point" Command="{Binding SelectNextPointCommand}"
                    ToolTip="Select only; no axis movement."
                    Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0"/>
        </UniformGrid>
        <UniformGrid Columns="2">
            <Button Content="Teach" Command="{Binding TeachCurrentPositionCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0"/>
            <Button Content="Move To" Command="{Binding MoveToPointCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0"/>
        </UniformGrid>
        <TextBlock Text="{Binding SaveBehavior, Converter={StaticResource EnumDescriptionConverter}}"
                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
        <TextBlock x:Name="TeachingSaveError" Text="{Binding SaveError}" TextWrapping="Wrap"
                   Foreground="{StaticResource AccentRedBrush}" Margin="0,8,0,0"
                   ToolTip="Your edits remain in memory. Resolve the storage problem and retry saving.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding ManualBlock, Converter={StaticResource EnumDescriptionConverter}}" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding MotionHint, Converter={StaticResource EnumDescriptionConverter}}" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
