<UserControl x:Class="IBTM.UI.ConveyorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             xmlns:conveyor="clr-namespace:IBTM.Conveyor;assembly=IBTM.Conveyor"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
             Width="1552"
             Height="460">
    <UserControl.Resources>
        <Style x:Key="MainConveyorSensorStyle"
               TargetType="Ellipse"
               BasedOn="{StaticResource IoInputLedStyle}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Panel.ZIndex" Value="3"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Canvas>
            <Grid Canvas.Left="0" Canvas.Top="197" Width="1552">
                <Border HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border"
                               BasedOn="{StaticResource StateBadgeStyle}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding State.Display.ConveyorState}"
                                                   Value="{x:Static conveyor:MainConveyorState.Idle}"/>
                                        <Condition Binding="{Binding Units.MainConveyor}"
                                                   Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CONVEYOR"
                                   Margin="0,0,9,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource EquipmentRoleLabelStyle}"/>
                        <TextBlock Text="{Binding ConveyorStatus, Converter={StaticResource EnumDescriptionConverter}}"
                                   FontSize="15" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource MapHintStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Units.MainConveyor}" Value="False">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MainConveyorRun.IsOn}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource AccentBlueBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Canvas.Left="18" Canvas.Top="64"
                    Width="1516" Height="112"
                    Tag="{Binding MainConveyorRun.IsOn}"
                    Style="{StaticResource ConveyorBedStyle}"/>

            <TextBlock Canvas.Left="{x:Static ui:MachinePlan.FirstPlateLeft}" Canvas.Top="{x:Static ui:MachinePlan.StationLabelTop}"
                        Width="{StaticResource BackupPlateWidth}"
                       Margin="6,0,0,0" TextAlignment="Left"
                       Text="Station 1"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>
            <TextBlock Canvas.Left="{x:Static ui:MachinePlan.FasteningPlateLeft}" Canvas.Top="{x:Static ui:MachinePlan.StationLabelTop}"
                        Width="{StaticResource BackupPlateWidth}"
                       Margin="6,0,0,0" TextAlignment="Left"
                       Text="Station 2"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>
            <TextBlock Canvas.Left="{x:Static ui:MachinePlan.InspectionPlateLeft}" Canvas.Top="{x:Static ui:MachinePlan.StationLabelTop}"
                        Width="{StaticResource BackupPlateWidth}"
                       Margin="6,0,0,0" TextAlignment="Left"
                       Text="Station 3"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>

            <Ellipse Canvas.Left="160" Canvas.Top="108"
                     Tag="{Binding Signals.Inputs[MainConveyorEntryCarrierDetected].IsOn}"
                     ToolTip="Entry carrier sensor"
                     Style="{StaticResource MainConveyorSensorStyle}"/>
            <TextBlock Canvas.Left="112" Canvas.Top="137"
                       Width="80"
                       Text="{Binding Signals.Inputs[MainConveyorEntryCarrierDetected].Address, StringFormat='IN · DI {0}'}"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>

            <Border Canvas.Left="{x:Static ui:MachinePlan.FirstPlateLeft}" Canvas.Top="{x:Static ui:MachinePlan.PlateTop}"
                    Tag="{Binding PcbPlacementBackupPlateUp}"
                    ToolTip="Placement backup plate"
                    Style="{StaticResource BackupPlateVisualStyle}"/>
            <ui:CarrierView Canvas.Left="{x:Static ui:MachinePlan.PlacementCarrierLeft}" Canvas.Top="{x:Static ui:MachinePlan.CarrierTop}" Panel.ZIndex="2"
                            HeatSink1Present="{Binding PcbPlacementHeatSink1Present}"
                            HeatSink2Present="{Binding PcbPlacementHeatSink2Present}"
                            Pcb1Placed="{Binding PcbPlacementHeatSink1Completed}"
                            Pcb2Placed="{Binding PcbPlacementHeatSink2Completed}"
                            ShowPcbSlots="True"
                            ActiveHeatSink="{Binding State.Display.PlacementTarget}">
                <ui:CarrierView.Style>
                    <Style TargetType="ui:CarrierView" BasedOn="{StaticResource CarrierStyle}">
                        <Setter Property="Visibility"
                                Value="{Binding Signals.Inputs[PcbPlacementCarrierPresent].IsOn, Converter={StaticResource BoolToVis}}"/>
                        <Style.Triggers>
                            <Trigger Property="HeatSink1Present" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HeatSink2Present" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ui:CarrierView.Style>
            </ui:CarrierView>
            <Border Canvas.Left="{x:Static ui:MachinePlan.PlacementStopperLeft}" Canvas.Top="{x:Static ui:MachinePlan.StopperTop}"
                     Tag="{Binding PcbPlacementStopperUp}"
                     ToolTip="Placement stopper"
                     Style="{StaticResource StopperVisualStyle}"/>
            <Border Canvas.Left="{x:Static ui:MachinePlan.FasteningPlateLeft}" Canvas.Top="{x:Static ui:MachinePlan.PlateTop}"
                    Tag="{Binding BoltFasteningBackupPlateUp}"
                    ToolTip="Bolt fastening backup plate"
                    Style="{StaticResource BackupPlateVisualStyle}"/>
            <ui:CarrierView Canvas.Left="{x:Static ui:MachinePlan.FasteningCarrierLeft}" Canvas.Top="{x:Static ui:MachinePlan.CarrierTop}" Panel.ZIndex="2"
                            HeatSink1Present="{Binding BoltFasteningHeatSink1Present}"
                            HeatSink2Present="{Binding BoltFasteningHeatSink2Present}"
                            HeatSink1Result="{Binding BoltFasteningHeatSink1Result}"
                            HeatSink2Result="{Binding BoltFasteningHeatSink2Result}"
                            BoltTargets="{Binding BoltTargets}">
                <ui:CarrierView.Style>
                    <Style TargetType="ui:CarrierView" BasedOn="{StaticResource CarrierStyle}">
                        <Setter Property="Visibility"
                                Value="{Binding Signals.Inputs[BoltFasteningCarrierPresent].IsOn, Converter={StaticResource BoolToVis}}"/>
                        <Style.Triggers>
                            <Trigger Property="HeatSink1Present" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HeatSink2Present" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ui:CarrierView.Style>
            </ui:CarrierView>
            <Border Canvas.Left="{x:Static ui:MachinePlan.FasteningStopperLeft}" Canvas.Top="{x:Static ui:MachinePlan.StopperTop}"
                     Tag="{Binding BoltFasteningStopperUp}"
                     ToolTip="Bolt fastening stopper"
                     Style="{StaticResource StopperVisualStyle}"/>
            <Border Canvas.Left="{x:Static ui:MachinePlan.InspectionPlateLeft}" Canvas.Top="{x:Static ui:MachinePlan.PlateTop}"
                    Tag="{Binding InspectionBackupPlateUp}"
                    ToolTip="Inspection backup plate"
                    Style="{StaticResource BackupPlateVisualStyle}"/>
            <ui:CarrierView x:Name="InspectionCarrier"
                            Canvas.Left="{x:Static ui:MachinePlan.InspectionCarrierLeft}"
                            Canvas.Top="{x:Static ui:MachinePlan.CarrierTop}" Panel.ZIndex="2"
                            HeatSink1Present="{Binding InspectionHeatSink1Present}"
                            HeatSink2Present="{Binding InspectionHeatSink2Present}"
                            HeatSink1Result="{Binding InspectionHeatSink1Result}"
                            HeatSink2Result="{Binding InspectionHeatSink2Result}"
                            ActiveHeatSink="{Binding InspectionActivePcb}"
                            BoltTargets="{Binding InspectionTargets}">
                <ui:CarrierView.Style>
                    <Style TargetType="ui:CarrierView" BasedOn="{StaticResource CarrierStyle}">
                        <Setter Property="Visibility"
                                Value="{Binding Signals.Inputs[InspectionCarrierPresent].IsOn, Converter={StaticResource BoolToVis}}"/>
                        <Style.Triggers>
                            <Trigger Property="HeatSink1Present" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HeatSink2Present" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ui:CarrierView.Style>
            </ui:CarrierView>
            <Border Canvas.Left="{x:Static ui:MachinePlan.InspectionStopperLeft}" Canvas.Top="{x:Static ui:MachinePlan.StopperTop}"
                     Tag="{Binding InspectionStopperUp}"
                     ToolTip="Inspection stopper"
                     Style="{StaticResource StopperVisualStyle}"/>
            <Ellipse Canvas.Left="1368" Canvas.Top="108"
                     Tag="{Binding Signals.Inputs[MainConveyorExitCarrierDetected].IsOn}"
                     ToolTip="Exit carrier sensor"
                     Style="{StaticResource MainConveyorSensorStyle}"/>
            <TextBlock Canvas.Left="1358" Canvas.Top="137"
                       Width="80"
                       Text="{Binding Signals.Inputs[MainConveyorExitCarrierDetected].Address, StringFormat='OUT · DI {0}'}"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>
            <Border Canvas.Left="18" Canvas.Top="228" Width="172" Style="{StaticResource MapIoCardStyle}">
                <StackPanel>
                    <TextBlock Text="FRONT 2 · SMEMA" Style="{StaticResource MapIoTitleStyle}"/>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[MainConveyorAvailableFromFront2].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[MainConveyorAvailableFromFront2].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[MainConveyorAvailableFromFront2].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Available" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Outputs[MainConveyorReadyToFront2].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Outputs[MainConveyorReadyToFront2].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoOutputStyle}"/>
                        <TextBlock Text="{Binding Signals.Outputs[MainConveyorReadyToFront2].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DO Ready" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Canvas.Left="194" Canvas.Top="228" Width="284" Style="{StaticResource MapIoCardStyle}">
                <StackPanel>
                    <TextBlock Text="STATION 1 · PCB PLACEMENT" Style="{StaticResource MapIoTitleStyle}"/>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[PcbPlacementCarrierPresent].Signal, Converter={StaticResource EnumDescriptionConverter}}">
