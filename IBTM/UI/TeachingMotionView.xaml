<UserControl x:Class="IBTM.UI.TeachingMotionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="clr-namespace:IBTM.UI"
    Foreground="{StaticResource TextPrimaryBrush}"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:TeachingViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <x:Array x:Key="JogSpeeds" Type="{x:Type sys:Double}">
            <sys:Double>0.1</sys:Double>
            <sys:Double>1</sys:Double>
            <sys:Double>10</sys:Double>
            <sys:Double>50</sys:Double>
        </x:Array>
        <x:Array x:Key="StepDistances" Type="{x:Type sys:Double}">
            <sys:Double>0.01</sys:Double>
            <sys:Double>0.1</sys:Double>
            <sys:Double>1</sys:Double>
            <sys:Double>10</sys:Double>
            <sys:Double>50</sys:Double>
        </x:Array>
        <Style x:Key="JogDirectionStyle" TargetType="ui:HoldButton" BasedOn="{StaticResource JogButtonStyle}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="ToolTip" Value="Hold to move; release to stop."/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MoveMode}" Value="{x:Static ui:TeachingMoveMode.Step}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepDirectionStyle" TargetType="Button" BasedOn="{StaticResource JogButtonStyle}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="ToolTip" Value="Move by the selected step distance."/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MoveMode}" Value="{x:Static ui:TeachingMoveMode.Step}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="Taught coordinates · " Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="{Binding SelectedPoint.PositionLabel, TargetNullValue=—}" FontFamily="Consolas" TextWrapping="Wrap"/>
            <TextBlock Text=" mm" Foreground="{StaticResource TextMutedBrush}"/>
        </WrapPanel>
        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="mm" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="Current axis position" FontWeight="SemiBold"/>
        </DockPanel>
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="X" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1"
                Text="{Binding Motion.Position.X, StringFormat=F3, TargetNullValue=—, FallbackValue=—}"
                VerticalAlignment="Center" FontFamily="Consolas" FontSize="15"/>
        </Grid>
        <Grid Margin="0,2" Visibility="{Binding Motion.Feedback.HasY, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Y" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1"
                Text="{Binding Motion.Position.Y, StringFormat=F3, TargetNullValue=—, FallbackValue=—}"
                VerticalAlignment="Center" FontFamily="Consolas" FontSize="15"/>
        </Grid>
        <Grid Margin="0,2" Visibility="{Binding Motion.Feedback.HasZ, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Z" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1"
                Text="{Binding Motion.Position.Z, StringFormat=F3, TargetNullValue=—, FallbackValue=—}"
                VerticalAlignment="Center" FontFamily="Consolas" FontSize="15"/>
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1" Margin="2"
                    Visibility="{Binding Motion.Feedback.HasY, Converter={StaticResource BoolToVis}}">
                    <ui:HoldButton Content="↑ Y−" Style="{StaticResource JogDirectionStyle}"
                        PressCommand="{Binding JogCommand}"
                        ReleaseCommand="{Binding JogStopCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.YMinus}"/>
                    <Button Content="↑ Y−" Style="{StaticResource StepDirectionStyle}"
                        Command="{Binding StepCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.YMinus}"/>
                </Grid>
                <Grid Grid.Row="1" Margin="2">
                    <ui:HoldButton Content="← X−" Style="{StaticResource JogDirectionStyle}"
                        PressCommand="{Binding JogCommand}"
                        ReleaseCommand="{Binding JogStopCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.XMinus}"/>
                    <Button Content="← X−" Style="{StaticResource StepDirectionStyle}"
                        Command="{Binding StepCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.XMinus}"/>
                </Grid>
                <Button Grid.Row="1" Grid.Column="1" Content="STOP" Margin="2" Height="40"
                    Command="{Binding JogStopCommand}" Style="{StaticResource JogStopButtonStyle}"/>
                <Grid Grid.Row="1" Grid.Column="2" Margin="2">
                    <ui:HoldButton Content="X+ →" Style="{StaticResource JogDirectionStyle}"
                        PressCommand="{Binding JogCommand}"
                        ReleaseCommand="{Binding JogStopCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.XPlus}"/>
                    <Button Content="X+ →" Style="{StaticResource StepDirectionStyle}"
                        Command="{Binding StepCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.XPlus}"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1" Margin="2"
                    Visibility="{Binding Motion.Feedback.HasY, Converter={StaticResource BoolToVis}}">
                    <ui:HoldButton Content="↓ Y+" Style="{StaticResource JogDirectionStyle}"
                        PressCommand="{Binding JogCommand}"
                        ReleaseCommand="{Binding JogStopCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.YPlus}"/>
                    <Button Content="↓ Y+" Style="{StaticResource StepDirectionStyle}"
                        Command="{Binding StepCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.YPlus}"/>
                </Grid>
            </Grid>
            <StackPanel Grid.Column="1" Width="68" Margin="12,0,0,0"
                Visibility="{Binding Motion.Feedback.HasZ, Converter={StaticResource BoolToVis}}">
                <Grid Margin="2">
                    <ui:HoldButton Content="↑ Z−" Style="{StaticResource JogDirectionStyle}"
                        PressCommand="{Binding JogCommand}"
                        ReleaseCommand="{Binding JogStopCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.ZMinus}"/>
                    <Button Content="↑ Z−" Style="{StaticResource StepDirectionStyle}"
                        Command="{Binding StepCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.ZMinus}"/>
                </Grid>
                <TextBlock Text="Z" Height="44" TextAlignment="Center" Padding="0,12,0,0"
                    FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                <Grid Margin="2">
                    <ui:HoldButton Content="↓ Z+" Style="{StaticResource JogDirectionStyle}"
                        PressCommand="{Binding JogCommand}"
                        ReleaseCommand="{Binding JogStopCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.ZPlus}"/>
                    <Button Content="↓ Z+" Style="{StaticResource StepDirectionStyle}"
                        Command="{Binding StepCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.ZPlus}"/>
                </Grid>
            </StackPanel>
        </Grid>
        <Button Content="Home Axes" Command="{Binding HomeCommand}" Margin="0,8,0,0"
            Style="{StaticResource SecondaryButtonStyle}"
            ToolTip="Home the selected unit: Z first, then X/Y. Units without Z home X/Y only."/>
        <ComboBox ItemsSource="{Binding MoveModes}"
            SelectedItem="{Binding MoveMode, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
        <Grid Margin="0,6,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding MoveMode}" Value="{x:Static ui:TeachingMoveMode.Step}"/>
                                <Condition Binding="{Binding IsInspectionSelected}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ManualSpeedLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox Grid.Column="1" ItemsSource="{StaticResource JogSpeeds}"
                SelectedItem="{Binding JogSpeed, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" Text="mm/s" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Margin="0,6,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MoveMode}" Value="{x:Static ui:TeachingMoveMode.Step}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Step distance" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox Grid.Column="1" ItemsSource="{StaticResource StepDistances}"
                SelectedItem="{Binding StepDistance, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <TextBlock Text="Step uses the configured XY speed." Margin="0,4,0,0" TextWrapping="Wrap"
            Foreground="{StaticResource TextMutedBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding MoveMode}" Value="{x:Static ui:TeachingMoveMode.Step}"/>
                                <Condition Binding="{Binding IsInspectionSelected}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:RecordPositionButton Content="Record Position"
                Command="{Binding TeachCurrentPositionCommand}"
                ToolTip="Record the current coordinates for this point only. Inspection points also record their teaching image. The axes must be homed and stopped. See the saving instructions below."
                ToolTipService.ShowOnDisabled="True"
                Style="{StaticResource PrimaryButtonStyle}" Padding="8,7" Margin="0,0,3,0"/>
            <Button Grid.Column="1" Content="Move to Position"
                Command="{Binding MoveToPointCommand}"
                Style="{StaticResource SecondaryButtonStyle}" Padding="8,7" Margin="3,0,0,0"
                ToolTip="Move to the selected position using its teaching coordinates and the configured axis speed. See the movement sequence below."/>
        </Grid>
        <Button Content="{Binding MoveToHorizontalZLabel}"
            Command="{Binding MoveToHorizontalZCommand}" Margin="0,6,0,0"
            Style="{StaticResource SecondaryButtonStyle}"
            ToolTip="Move Z only to this unit's recorded reference height. Placement uses PCB Receive Standby Z. This does not change any taught coordinates."
            Visibility="{Binding Motion.Feedback.HasZ, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Text="Position and Z moves use the configured axis speed." Margin="0,4,0,0" TextWrapping="Wrap"
            Foreground="{StaticResource TextMutedBrush}"/>
        <TextBlock Text="{Binding SaveBehavior, Converter={StaticResource EnumDescriptionConverter}}"
            TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
        <TextBlock x:Name="TeachingSaveError"
            Text="{Binding SaveError}"
            TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding ManualBlock, Converter={StaticResource EnumDescriptionConverter}}"
            TextWrapping="Wrap" Foreground="{StaticResource AccentAmberBrush}" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding MotionHint, Converter={StaticResource EnumDescriptionConverter}}"
            TextWrapping="Wrap" Foreground="{StaticResource AccentAmberBrush}" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
