<Window x:Class="IBTM.UI.StartConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI" xmlns:app="clr-namespace:IBTM"
    mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
    Title="{ui:Text 'Start confirmation'}" Width="1800" Height="960" MinWidth="1280" MinHeight="760"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource PanelBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
    Loaded="OnLoaded" Closed="OnClosed">
    <Window.Resources>
        <ui:SignalTextConverter x:Key="SignalText"/>
        <Style x:Key="ReviewSignal" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/></Trigger>
                <DataTrigger Binding="{Binding State.Available}" Value="False"><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReviewHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        <Style x:Key="CarrierActions" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StartStation}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16" MinHeight="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{ui:Text 'Start confirmation'}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{ui:Text 'Recipe'}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Recipes.Current.Name, Mode=OneTime}" FontWeight="SemiBold" MaxWidth="400"
                    TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border Background="{StaticResource ControlBgBrush}" Padding="12,8" Margin="20,0,0,0">
                    <TextBlock Text="{Binding ModeText}"/>
                </Border>
                <Border Background="{StaticResource AttentionBackgroundBrush}" Padding="12,8" Margin="8,0,0,0"
                    Visibility="{Binding State.RepeatEnabled, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{ui:Text 'REPEAT'}" Foreground="{StaticResource AccentAmberBrush}"/>
                </Border>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource ControlBgBrush}" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{ui:Text 'SERVO'}" Tag="{Binding State.ServoPowerOn}" Style="{StaticResource ReviewSignal}"/>
                    <TextBlock Text="{ui:Text 'HOME'}" Tag="{Binding State.FeedbackReadiness.Homed}" Style="{StaticResource ReviewSignal}"/>
                    <TextBlock Text="{ui:Text 'E-STOP'}" Tag="{Binding State.EmergencyStopReleased}" Style="{StaticResource ReviewSignal}"/>
                    <TextBlock Text="{ui:Text 'AIR'}" Tag="{Binding State.AirPressureOk}" Style="{StaticResource ReviewSignal}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding DoorSensors}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="16,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Input.IsOn}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Input.IsOn}" Value="False"><Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource EquipBgBrush}" Padding="12" Margin="0,0,16,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ui:MachineDiagramView ShowStartCheck="True"/>
                    <TextBlock Grid.Row="1" Text="{ui:Text 'Select a carrier or handler in the diagram.'}" Margin="10,8"
                        Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="108"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Padding="12" Margin="0,0,0,12" Background="{StaticResource ControlBgBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="17"
                            FontWeight="SemiBold" MinHeight="24" MaxHeight="48">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding StartBlock, Converter={StaticResource UiTextConverter}}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStartReviewAllowed}" Value="True">
                                            <Setter Property="Text" Value="{ui:Text 'Ready to start'}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CheckStartCommand.IsRunning}" Value="True">
                                            <Setter Property="Text" Value="{ui:Text 'Checking...'}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Text="{Binding AlarmMessage}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                            Margin="0,8,0,0" Foreground="{StaticResource AccentRedBrush}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="{Binding SelectedStartArea, Converter={StaticResource UiTextConverter}}" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StartMaterialState, Converter={StaticResource UiTextConverter}}" Margin="0,5,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{ui:Text 'Current position (mm)'}" Style="{StaticResource ReviewHeading}" Margin="0,0,0,8"/>
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="X" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding StartMotion.Position.X, StringFormat=F3, TargetNullValue=—}"/></StackPanel>
                            <StackPanel><TextBlock Text="Y" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding StartMotion.Position.Y, StringFormat=F3, TargetNullValue=—}"/></StackPanel>
                            <StackPanel><TextBlock Text="Z" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding StartMotion.Position.Z, StringFormat=F3, TargetNullValue=—}"/></StackPanel>
                        </UniformGrid>
                        <StackPanel Style="{StaticResource CarrierActions}">
                            <TextBlock Text="{ui:Text 'Carrier work'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding StartStation.CurrentJob.Id, StringFormat={ui:Text 'Work {0}'}}"/>
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <StackPanel><TextBlock Text="{ui:Text 'Backup plate'}" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding StartStation.BackupPlate, Converter={StaticResource UiTextConverter}}"/></StackPanel>
                                <StackPanel><TextBlock Text="{ui:Text 'Stopper'}" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding StartStation.Stopper, Converter={StaticResource UiTextConverter}}"/></StackPanel>
                            </UniformGrid>
                            <ItemsControl ItemsSource="{Binding StartStation.Assemblies}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource ControlBgBrush}" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding HeatSink, Converter={StaticResource UiTextConverter}}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding PcbNumber, StringFormat={ui:Text 'PCB {0}'}, TargetNullValue=—}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding PcbBarcode}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                                    <StackPanel><TextBlock Text="{ui:Text 'Fastening'}" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding FasteningResult, Converter={StaticResource UiTextConverter}}"/></StackPanel>
                                                    <StackPanel><TextBlock Text="{ui:Text 'Inspection'}" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding InspectionResult, Converter={StaticResource UiTextConverter}}"/></StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStartArea}" Value="{x:Static app:StartArea.Supply}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{ui:Text 'Gripper'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding Supply.Gripper, Converter={StaticResource UiTextConverter}}"/>
                            <TextBlock Text="{ui:Text 'Rotation'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding Supply.Rotation, Converter={StaticResource UiTextConverter}}"/>
                            <TextBlock Text="{ui:Text 'PCB detected'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding Signals.Inputs[PcbSupplyPcbDetected].IsOn, Converter={StaticResource SignalText}}"/>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStartArea}" Value="{x:Static app:StartArea.Placement}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{ui:Text 'Lift'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding Placement.Lift, Converter={StaticResource UiTextConverter}}"/>
                            <TextBlock Text="{ui:Text 'IPM'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding Placement.IpmLift, Converter={StaticResource UiTextConverter}}"/>
                            <TextBlock Text="{ui:Text 'PCB detected'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding Signals.Inputs[PcbPlacementPcbDetected].IsOn, Converter={StaticResource SignalText}}"/>
                            <TextBlock Text="{ui:Text 'Vacuum detected'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding Signals.Inputs[PcbPlacementVacuumDetected].IsOn, Converter={StaticResource SignalText}}"/>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStartArea}" Value="{x:Static app:StartArea.PickupHead}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{ui:Text 'Vacuum detected'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding Signals.Inputs[PickupHeadVacuumDetected].IsOn, Converter={StaticResource SignalText}}"/>
                            <TextBlock Text="{ui:Text 'Bolt detected'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding Signals.Inputs[PickupFeederBoltDetected].IsOn, Converter={StaticResource SignalText}}"/>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStartArea}" Value="{x:Static app:StartArea.ShootingHead}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{ui:Text 'Vacuum detected'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding Signals.Inputs[ShootingHeadVacuumDetected].IsOn, Converter={StaticResource SignalText}}"/>
                            <TextBlock Text="{ui:Text 'Bolt detected'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding Signals.Inputs[ShootingFeederBoltDetected].IsOn, Converter={StaticResource SignalText}}"/>
                            <TextBlock Text="{ui:Text 'Tube bolt detected'}" Style="{StaticResource ReviewHeading}"/>
                            <TextBlock Text="{Binding Signals.Inputs[ShootingTubeBoltDetected].IsOn, Converter={StaticResource SignalText}}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <StackPanel Style="{StaticResource CarrierActions}">
                        <TextBlock Text="{ui:Text 'Complete skips this station; clear requires carrier removal.'}"
                            TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2">
                            <Button Content="{ui:Text 'Mark complete'}" Command="{Binding ChangeCarrierWorkCommand}"
                                CommandParameter="{x:Static app:CarrierWorkAction.Complete}" Margin="0,0,4,0" Height="38" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="{ui:Text 'Clear work'}" Command="{Binding ChangeCarrierWorkCommand}"
                                CommandParameter="{x:Static app:CarrierWorkAction.Clear}" Margin="4,0,0,0" Height="38" Style="{StaticResource SecondaryButtonStyle}"/>
                        </UniformGrid>
                    </StackPanel>
                    <TextBlock Text="{Binding StartActionMessage}" TextWrapping="Wrap" Height="40" Margin="0,8,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Content="{ui:Text 'Cancel · Esc'}" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Left" MinWidth="130" Height="44" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Grid.Column="1" Content="{ui:Text 'Check again'}" Command="{Binding CheckStartCommand}"
                MinWidth="150" Height="44" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="ConfirmButton" Grid.Column="2" Content="{ui:Text 'Confirm and START'}" Click="OnConfirmClick" MinWidth="190" Height="44">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsStartReviewAllowed}" Value="True"/>
                                    <Condition Binding="{Binding CheckStartCommand.IsRunning}" Value="False"/>
                                    <Condition Binding="{Binding ChangeCarrierWorkCommand.IsRunning}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True"/>
                                <Setter Property="Background" Value="{StaticResource PrimaryButtonBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
