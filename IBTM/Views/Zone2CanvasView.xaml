<UserControl x:Class="IBTM.Views.Zone2CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IBTM.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToOpacityConverter   x:Key="BoolToOpacity"/>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="240" Height="180" ClipToBounds="True">
            <!-- 갠트리 범위 -->
            <Rectangle Canvas.Left="1" Canvas.Top="1" Width="218" Height="178"
                       Stroke="#281E10" StrokeThickness="0.8" StrokeDashArray="6 3" Fill="Transparent"/>
            <Rectangle Canvas.Left="2" Canvas.Top="0" Width="5" Height="180" Fill="#281E10"/>
            <Rectangle Canvas.Left="213" Canvas.Top="0" Width="5" Height="180" Fill="#281E10"/>
            <Rectangle Canvas.Left="2" Canvas.Top="{Binding Zone2Visual.BridgeTop}"
                       Width="216" Height="4" Fill="#38280E"/>

            <!-- 컨베이어 영역 -->
            <Rectangle Canvas.Left="0" Canvas.Top="62" Width="220" Height="56" Fill="#0C0A06"/>
            <Rectangle Canvas.Left="0" Canvas.Top="62" Width="220" Height="2" Fill="#3A2A18"/>
            <Rectangle Canvas.Left="0" Canvas.Top="116" Width="220" Height="2" Fill="#3A2A18"/>

            <!-- 스토퍼 -->
            <Rectangle Canvas.Left="10" Canvas.Top="68" Width="7" Height="44"
                       Fill="#382810" RadiusX="1" RadiusY="1"
                       Opacity="{Binding Zone2Visual.ShuttlePresent, Converter={StaticResource BoolToOpacity}}"/>
            <TextBlock Canvas.Left="7" Canvas.Top="114" Text="STP" FontSize="9" FontWeight="SemiBold"
                       Foreground="#A06020"/>
            <!-- 얼라인 -->
            <Border Canvas.Left="20" Canvas.Top="68" Width="12" Height="44"
                    Background="#141008" BorderBrush="#805020" BorderThickness="0.8" CornerRadius="1"
                    Opacity="{Binding Zone2Visual.ShuttlePresent, Converter={StaticResource BoolToOpacity}}">
                <TextBlock Text="▶" FontSize="10" Foreground="#C07830"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Canvas.Left="192" Canvas.Top="68" Width="12" Height="44"
                    Background="#141008" BorderBrush="#805020" BorderThickness="0.8" CornerRadius="1"
                    Opacity="{Binding Zone2Visual.ShuttlePresent, Converter={StaticResource BoolToOpacity}}">
                <TextBlock Text="◀" FontSize="10" Foreground="#C07830"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Canvas.Left="19" Canvas.Top="114" Text="ALN" FontSize="8" Foreground="#805020"/>
            <TextBlock Canvas.Left="191" Canvas.Top="114" Text="ALN" FontSize="8" Foreground="#805020"/>

            <!-- 셔틀 -->
            <Border Canvas.Left="36" Canvas.Top="70" Width="152" Height="40" CornerRadius="2"
                    Visibility="{Binding Zone2Visual.ShuttlePresent, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1A1808"/>
                        <Setter Property="BorderBrush" Value="#806030"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Zone2Visual.IsLifted}" Value="True">
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="#F0883E"/>
                                <Setter Property="Background" Value="#281A08"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="36" Height="22" Fill="{StaticResource PcbFillBrush}" Stroke="{StaticResource PcbStrokeBrush}"
                               StrokeThickness="0.5" RadiusX="1" RadiusY="1" Margin="4,0"
                               Visibility="{Binding Zone2Visual.Pcb1Visibility}"/>
                    <Rectangle Width="36" Height="22" Fill="{StaticResource PcbFillBrush}" Stroke="{StaticResource PcbStrokeBrush}"
                               StrokeThickness="0.5" RadiusX="1" RadiusY="1" Margin="4,0"
                               Visibility="{Binding Zone2Visual.Pcb2Visibility}"/>
                </StackPanel>
            </Border>
            <TextBlock Canvas.Left="75" Canvas.Top="72" Text="LIFT ▲" FontSize="9" FontWeight="Bold"
                       Foreground="#F0883E"
                       Visibility="{Binding Zone2Visual.LiftIndicatorVisibility}"/>

            <!-- 볼트 마커 -->
            <ItemsControl ItemsSource="{Binding BoltMarkers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                        <Setter Property="Canvas.Top" Value="{Binding CanvasTop}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Ellipse Width="9" Height="9"
                                     Stroke="{Binding MarkerBrush}"
                                     StrokeThickness="1.5" Fill="#0C0A08"/>
                            <StackPanel Orientation="Horizontal" Margin="11,-2,0,0">
                                <TextBlock Text="{Binding Name}" FontSize="8"
                                           Foreground="#806838" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TorqueText}" FontSize="7" FontFamily="Consolas"
                                           Foreground="{Binding MarkerBrush}" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 피듀셜 보정 십자선 -->
            <Ellipse Canvas.Left="{Binding Zone2Visual.FiducialOffsetLeft}" Canvas.Top="{Binding Zone2Visual.FiducialOffsetTop}"
                     Width="8" Height="8" Margin="-4,-4,0,0"
                     Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="1" Fill="Transparent"
                     Visibility="{Binding Zone2Visual.FiducialOffsetVisibility}"/>
            <Line X1="{Binding Zone2Visual.FiducialCrossH1}" Y1="{Binding Zone2Visual.FiducialOffsetTop}"
                  X2="{Binding Zone2Visual.FiducialCrossH2}" Y2="{Binding Zone2Visual.FiducialOffsetTop}"
                  Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="0.5" StrokeDashArray="2 1"
                  Visibility="{Binding Zone2Visual.FiducialOffsetVisibility}"/>
            <Line X1="{Binding Zone2Visual.FiducialOffsetLeft}" Y1="{Binding Zone2Visual.FiducialCrossV1}"
                  X2="{Binding Zone2Visual.FiducialOffsetLeft}" Y2="{Binding Zone2Visual.FiducialCrossV2}"
                  Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="0.5" StrokeDashArray="2 1"
                  Visibility="{Binding Zone2Visual.FiducialOffsetVisibility}"/>

            <!-- 헤드 십자선 -->
            <Line X1="{Binding Zone2Visual.CrosshairH1}" Y1="{Binding Zone2Visual.CrosshairTop}"
                  X2="{Binding Zone2Visual.CrosshairH2}" Y2="{Binding Zone2Visual.CrosshairTop}"
                  Stroke="#F0883E" StrokeThickness="0.5" Opacity="0.35" StrokeDashArray="3 2"/>
            <Line X1="{Binding Zone2Visual.CrosshairLeft}" Y1="{Binding Zone2Visual.CrosshairV1}"
                  X2="{Binding Zone2Visual.CrosshairLeft}" Y2="{Binding Zone2Visual.CrosshairV2}"
                  Stroke="#F0883E" StrokeThickness="0.5" Opacity="0.35" StrokeDashArray="3 2"/>

            <!-- 헤드 글로우 -->
            <Ellipse Canvas.Left="{Binding Zone2Visual.HeadLeft}" Canvas.Top="{Binding Zone2Visual.HeadTop}"
                     Width="{Binding Zone2Visual.HeadSize}" Height="{Binding Zone2Visual.HeadSize}"
                     Fill="#C08020" Opacity="0.5">
                <Ellipse.Effect><BlurEffect Radius="18"/></Ellipse.Effect>
            </Ellipse>
            <!-- 헤드 본체 (Bolt Driver — 원형 + 소켓 중심점) -->
            <Ellipse Canvas.Left="{Binding Zone2Visual.HeadLeft}" Canvas.Top="{Binding Zone2Visual.HeadTop}"
                     Width="{Binding Zone2Visual.HeadSize}" Height="{Binding Zone2Visual.HeadSize}"
                     Fill="{StaticResource AccentOrangeBrush}" Stroke="White" StrokeThickness="2"/>
            <Ellipse Canvas.Left="{Binding Zone2Visual.HeadCenterLeft}" Canvas.Top="{Binding Zone2Visual.HeadCenterTop}"
                     Width="4" Height="4" Fill="White" Opacity="0.8"/>

            <!-- Z 게이지 -->
            <Rectangle Canvas.Left="222" Canvas.Top="10" Width="6" Height="160"
                       Fill="#141010" RadiusX="2" RadiusY="2"/>
            <Rectangle Canvas.Left="222" Canvas.Top="10" Width="6"
                       Height="{Binding Zone2Visual.ZGaugeHeight}"
                       Fill="{StaticResource AccentOrangeBrush}" Opacity="0.6" RadiusX="2" RadiusY="2"/>
            <Rectangle Canvas.Left="218" Canvas.Top="{Binding Zone2Visual.ZToolTop}"
                       Width="14" Height="3"
                       Fill="{StaticResource AccentOrangeBrush}" Opacity="0.8" RadiusX="1" RadiusY="1"/>
        </Canvas>
    </Viewbox>
</UserControl>
