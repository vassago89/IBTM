<UserControl x:Class="IBTM.UI.BoltFasteningView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
    Width="408"
    Height="650">
    <UserControl.Resources>
        <Style x:Key="FeederDeviceStyle" TargetType="Grid">
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value>
                        <sys:Boolean>False</sys:Boolean>
                    </Trigger.Value>
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FeederLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource EquipmentRoleLabelStyle}">
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value>
                        <sys:Boolean>True</sys:Boolean>
                    </Trigger.Value>
                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FeederSensorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                    <Setter Property="Stroke" Value="{StaticResource AccentGreenBrush}"/>
                </Trigger>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>False</sys:Boolean></Trigger.Value>
                    <Setter Property="Fill" Value="{StaticResource EquipBgBrush}"/>
                    <Setter Property="Stroke" Value="{StaticResource MachineStructureBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FeederCommandLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource EquipmentRoleLabelStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Canvas>
            <TextBlock Canvas.Left="{x:Static ui:MachinePlan.HeaderInset}" Canvas.Top="{x:Static ui:MachinePlan.HeaderTop}"
                Text="Bolt Fastening" Style="{StaticResource TitleStyle}" FontWeight="Bold"/>
            <Border Canvas.Left="{x:Static ui:MachinePlan.HeaderInset}" Canvas.Top="{x:Static ui:MachinePlan.StatusTop}"
                Width="{x:Static ui:MachinePlan.PlateWidth}" Height="54" Tag="{Binding BoltDisplayState}"
                Style="{StaticResource StationStateBadgeStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding BoltDisplayState, Converter={StaticResource EnumDescriptionConverter}}"
                        Style="{StaticResource PrimaryStateTextStyle}" TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding BoltDisplayState, Converter={StaticResource EnumDescriptionConverter}}"/>
                    <TextBlock Text="{Binding FasteningState, Converter={StaticResource EnumDescriptionConverter}}"
                        Style="{StaticResource MapHintStyle}" FontSize="11" TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FasteningState, Converter={StaticResource EnumDescriptionConverter}}"
                        Visibility="{Binding FasteningStateVisible, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <Grid Canvas.Left="{x:Static ui:MachinePlan.HeaderInset}" Canvas.Top="{x:Static ui:MachinePlan.DetailTop}"
                Width="{x:Static ui:MachinePlan.PlateWidth}" Height="54">
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextAlignment" Value="Center"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="98"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="18"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ADC · HEAD" TextAlignment="Left" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="READY" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="2" Text="RUN" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="ALARM" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Row="1" Text="H1 Pickup" TextAlignment="Left" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Fastening.PickupHead.Monitor.Sample.Status.Ready, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Fastening.PickupHead.Monitor.Sample.Status.Running, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Fastening.PickupHead.Monitor.Sample.Status.Alarm, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"/>
                <TextBlock Grid.Row="2" Text="H2 Shooting" TextAlignment="Left" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Fastening.ShootingHead.Monitor.Sample.Status.Ready, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Fastening.ShootingHead.Monitor.Sample.Status.Running, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Fastening.ShootingHead.Monitor.Sample.Status.Alarm, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"/>
            </Grid>

            <Grid Width="{x:Static ui:MachinePlan.PickupFeederWidth}" Height="{x:Static ui:MachinePlan.PickupFeederHeight}"
                Tag="{Binding Units.PickupBoltFeeder}">
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource FeederDeviceStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BoltPickupFeederMapPosition}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RenderTransform>
                    <TranslateTransform X="{Binding BoltPickupFeederMapPosition.X, TargetNullValue=0, FallbackValue=0}" Y="{Binding BoltPickupFeederMapPosition.Y, TargetNullValue=0, FallbackValue=0}"/>
                </Grid.RenderTransform>
                <Border Width="{x:Static ui:MachinePlan.PickupFeederWidth}" Height="{x:Static ui:MachinePlan.PickupFeederHeight}"
                    VerticalAlignment="Top" Style="{StaticResource DeviceBodyStyle}">
                    <Grid Margin="4">
                        <TextBlock Tag="{Binding Signals.Inputs[PickupFeederBoltDetected].IsOn}"
                            VerticalAlignment="Top" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FeederLabelStyle}">
                                    <Setter Property="Text" Value="Pick Feeder"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Units.PickupBoltFeeder}" Value="False">
                                            <Setter Property="Text" Value="Pick Feeder (off)"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Height="18" Margin="6,0" VerticalAlignment="Center" Background="{StaticResource EquipBgBrush}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="1"/>
                        <Ellipse Width="18" Height="18"
                            Tag="{Binding Signals.Inputs[PickupFeederBoltDetected].IsOn}"
                            ToolTip="Pickup feeder bolt detected" Style="{StaticResource FeederSensorStyle}"/>
                    </Grid>
                </Border>
            </Grid>

            <Canvas Visibility="{Binding FasteningPositionKnown, Converter={StaticResource BoolToVis}}" Panel.ZIndex="20">
                <Grid Width="126" Height="138">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PickupHeadMapPosition}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RenderTransform>
                        <TranslateTransform X="{Binding PickupHeadMapPosition.X, TargetNullValue=0, FallbackValue=0}"
                            Y="{Binding PickupHeadMapPosition.Y, TargetNullValue=0, FallbackValue=0}"/>
                    </Grid.RenderTransform>
                    <Canvas>
                        <TextBlock Canvas.Left="{x:Static ui:MachinePlan.PickupHeadLeft}" Canvas.Top="65"
                            Text="Pick" FontSize="11" Style="{StaticResource EquipmentRoleLabelStyle}"/>
                        <TextBlock Canvas.Left="45" Canvas.Top="65" Text="{Binding BoltFasteningActiveOrdinal}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ActiveToolNumberStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BoltFasteningActiveBolt.Head}" Value="{x:Static core:FasteningHead.Pickup}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid Canvas.Left="{x:Static ui:MachinePlan.PickupHeadLeft}" Canvas.Top="{x:Static ui:MachinePlan.HeadTop}"
                            Width="{x:Static ui:MachinePlan.HeadSize}" Height="{x:Static ui:MachinePlan.HeadSize}">
                            <Border Margin="-6" Tag="{Binding Fastening.Motion.IsMoving}" Style="{StaticResource OverheadBodyStyle}"/>
                            <Border Tag="{Binding Fastening.PickupHeadPosition}" Style="{StaticResource ToolHeadFootprintStyle}"/>
                            <Border Width="14" Height="4" Background="{StaticResource TextMutedBrush}" CornerRadius="2"/>
                            <Ellipse Style="{StaticResource VacuumDetectedVisualStyle}"
                                Visibility="{Binding Signals.Inputs[PickupHeadVacuumDetected].IsOn, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Canvas>
                </Grid>
                <Grid Width="126" Height="138">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShootingHeadMapPosition}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RenderTransform>
                        <TranslateTransform X="{Binding ShootingHeadMapPosition.X, TargetNullValue=0, FallbackValue=0}"
                            Y="{Binding ShootingHeadMapPosition.Y, TargetNullValue=0, FallbackValue=0}"/>
                    </Grid.RenderTransform>
                    <Canvas>
                        <TextBlock Canvas.Left="{x:Static ui:MachinePlan.ShootingHeadLeft}" Canvas.Top="65" Text="Shoot"
                            FontSize="11" Style="{StaticResource EquipmentRoleLabelStyle}"/>
                        <TextBlock Canvas.Left="107" Canvas.Top="65" Text="{Binding BoltFasteningActiveOrdinal}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ActiveToolNumberStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BoltFasteningActiveBolt.Head}" Value="{x:Static core:FasteningHead.Shooting}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid Canvas.Left="{x:Static ui:MachinePlan.ShootingHeadLeft}" Canvas.Top="{x:Static ui:MachinePlan.HeadTop}"
                            Width="{x:Static ui:MachinePlan.HeadSize}" Height="{x:Static ui:MachinePlan.HeadSize}">
                            <Border Margin="-6" Tag="{Binding Fastening.Motion.IsMoving}" Style="{StaticResource OverheadBodyStyle}"/>
                            <Border Tag="{Binding Fastening.ShootingHeadPosition}" Style="{StaticResource ToolHeadFootprintStyle}"/>
                            <Ellipse Width="12" Height="12" Fill="{StaticResource EquipBgBrush}"
                                Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"/>
                            <Ellipse Style="{StaticResource VacuumDetectedVisualStyle}"
                                ToolTip="Shooting head vacuum feedback (display only)"
                                Visibility="{Binding Signals.Inputs[ShootingHeadVacuumDetected].IsOn, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Canvas>
                </Grid>
            </Canvas>
        </Canvas>
        <Button Command="{Binding OpenBoltStationTestCommand}" Background="Transparent" Cursor="Hand"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
            Visibility="{Binding State.ManualMode, Converter={StaticResource BoolToVis}}"
            ToolTip="Open selected-bolt test · Manual mode">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderThickness="1" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Grid Width="{x:Static ui:MachinePlan.PlateWidth}" Height="162" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,172,0,0">
            <Border Height="138" VerticalAlignment="Top" Style="{StaticResource DeviceBodyStyle}">
                <Canvas Width="280" Height="134">
                    <TextBlock Canvas.Left="12" Canvas.Top="8" Width="78"
                        ToolTip="Feeder command: ShootingFeederOff OFF = RUN, ON = STOP">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FeederCommandLabelStyle}">
                                <Setter Property="Text" Value="RUN · ?"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootingFeederOff].IsOn}" Value="False">
                                        <Setter Property="Text" Value="RUN"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootingFeederOff].IsOn}" Value="True">
                                        <Setter Property="Text" Value="STOP"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Canvas.Left="94" Canvas.Top="8" Width="94"
                        ToolTip="Escape output command; the B/F lamps below show actual sensor feedback">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FeederCommandLabelStyle}">
                                <Setter Property="Text" Value="CMD · ?"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootingEscapeForward].IsOn}" Value="False">
                                        <Setter Property="Text" Value="CMD ←"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootingEscapeForward].IsOn}" Value="True">
                                        <Setter Property="Text" Value="CMD →"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Canvas.Left="211" Canvas.Top="8" Width="68" ToolTip="ShootBolt output command">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FeederCommandLabelStyle}">
                                <Setter Property="Text" Value="SHOOT · ?"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootBolt].IsOn}" Value="True">
                                        <Setter Property="Text" Value="SHOOT ON"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootBolt].IsOn}" Value="False">
                                        <Setter Property="Text" Value="SHOOT OFF"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Linear feeder, escape slide, then the shooting tube. -->
                    <Border Canvas.Left="12" Canvas.Top="34" Width="78" Height="30"
                        Background="{StaticResource EquipBgBrush}" BorderBrush="{StaticResource MachineStructureBorderBrush}"
                        BorderThickness="1" CornerRadius="3"/>
                    <Path Data="M 23,41 L 31,49 L 23,57 M 39,41 L 47,49 L 39,57 M 55,41 L 63,49 L 55,57"
                        StrokeThickness="2">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{StaticResource AccentAmberBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootingFeederOff].IsOn}" Value="False">
                                        <Setter Property="Stroke" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootingFeederOff].IsOn}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource MachineStructureBorderBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Path Data="M 90,49 H 108 M 108,37 H 174 V 61 H 108 Z" StrokeThickness="2"
                        Stroke="{StaticResource MachineStructureBorderBrush}"/>
                    <Rectangle Canvas.Top="40" Width="18" Height="18" Fill="{StaticResource AccentGreenBrush}">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="True"/>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Canvas.Left" Value="111"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="False"/>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Canvas.Left" Value="153"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <Path Data="M 174,49 H 226 Q 245,49 245,68 V 96 M 239,89 L 245,96 L 251,89" StrokeThickness="3">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{StaticResource AccentAmberBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootBolt].IsOn}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootBolt].IsOn}" Value="False">
                                        <Setter Property="Stroke" Value="{StaticResource MachineStructureBorderBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <Ellipse Canvas.Left="68" Canvas.Top="42" Tag="{Binding Signals.Inputs[ShootingFeederBoltDetected].IsOn}"
                        Style="{StaticResource FeederSensorStyle}" ToolTip="Shooting feeder bolt detected · green=ON, gray=OFF, amber outline=unknown"/>
                    <TextBlock Canvas.Left="12" Canvas.Top="106" Width="78" Text="BOLT" Style="{StaticResource EquipmentRoleLabelStyle}"/>
                    <UniformGrid Canvas.Left="99" Canvas.Top="72" Width="84" Height="22" Rows="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Tag="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}"
                                Style="{StaticResource FeederSensorStyle}" ToolTip="Escape backward sensor"/>
                            <TextBlock Text="B" Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource EquipmentRoleLabelStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Tag="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}"
                                Style="{StaticResource FeederSensorStyle}" ToolTip="Escape forward sensor"/>
                            <TextBlock Text="F" Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource EquipmentRoleLabelStyle}"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Canvas.Left="94" Canvas.Top="106" Width="94">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FeederCommandLabelStyle}">
                                <Setter Property="Text" Value="ESC · ?"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="True"/>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="ESC · BACK"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="False"/>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="ESC · FWD"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="False"/>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="ESC · NO LIMIT"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="True"/>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="ESC · CONFLICT"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Ellipse Canvas.Left="238" Canvas.Top="76" Tag="{Binding Signals.Inputs[ShootingTubeBoltDetected].IsOn}"
                        Style="{StaticResource FeederSensorStyle}" ToolTip="Shooting tube bolt detected (current input)"/>
                    <TextBlock Canvas.Left="211" Canvas.Top="106" Width="68" Text="TUBE" Style="{StaticResource EquipmentRoleLabelStyle}"/>
                </Canvas>
            </Border>
            <TextBlock VerticalAlignment="Bottom">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EquipmentRoleLabelStyle}">
                        <Setter Property="Text" Value="Shoot Feeder"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Units.ShootingBoltFeeder}" Value="False">
                                <Setter Property="Text" Value="Shoot Feeder · Disabled"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
