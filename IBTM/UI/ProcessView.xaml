<UserControl x:Class="IBTM.UI.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:IBTM.UI"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <Style x:Key="EquipmentCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="EquipmentNameStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="EquipmentTypeStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="ActivityStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MotionPositionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>

        <Style x:Key="MovingStateStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="IDLE"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HandlerMarkerStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="62"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#193D2B"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style x:Key="HandlerLocationStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TrackNodeStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IoLedStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#3B4149"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOn}" Value="True"/>
                        <Condition Binding="{Binding IsOutput}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Fill" Value="{StaticResource OutputActiveBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="IoIndicatorTemplate" DataType="{x:Type ui:IoIndicator}">
            <Border Margin="0,0,0,4"
                    Padding="6,4"
                    Background="{StaticResource EquipBgBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Style="{StaticResource IoLedStyle}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Code}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="9"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CompactIoIndicatorTemplate" DataType="{x:Type ui:IoIndicator}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Style="{StaticResource IoLedStyle}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Code}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="9"
                           Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FooterIoIndicatorTemplate" DataType="{x:Type ui:IoIndicator}">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                <Ellipse Style="{StaticResource IoLedStyle}"/>
                <TextBlock Text="{Binding Name}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="9"
                           Margin="4,0,3,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Code}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="8"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="104"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="4"
                Panel.ZIndex="999"
                Background="#C0180000"
                Visibility="{Binding NgStackAlarm, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="NG STACK FULL"
                           FontSize="54"
                           Style="{StaticResource OverlayTextStyle}"
                           Foreground="White"/>
                <TextBlock HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           FontSize="20"
                           Foreground="#FFB0B0">
                    <Run Text="Loaded "/>
                    <Run Text="{Binding NgStackCount}"/>
                    <Run Text="/"/>
                    <Run Text="{Binding NgStackMaxCount}"/>
                    <Run Text="  ·  Automatic operation stopped"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,32,0,0">
                    <Button Content="Stop"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="110"
                            Margin="0,0,8,0"/>
                    <Button Content="NG Reset"
                            Command="{Binding ResetNgStackCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="130"
                            Margin="0,0,8,0"/>
                    <Button Content="E-STOP"
                            Command="{Binding EStopCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            MinWidth="120"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ui:StatsBarView Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:HandlingMapView Grid.Column="0"
                                    Grid.ColumnSpan="3"/>

                <TextBlock Grid.Column="3"
                           Text="›"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="24"/>

                <Border Grid.Column="4" Style="{StaticResource EquipmentCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="ST.2  BOLT FASTENING" Style="{StaticResource EquipmentNameStyle}"/>
                            <TextBlock Text="SHARED GANTRY · STANDARD + LOCTITE" Style="{StaticResource EquipmentTypeStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,14,0,10">
                            <TextBlock Text="{Binding BoltFasteningActivity}" Style="{StaticResource ActivityStyle}"/>
                            <TextBlock Text="{Binding BoltProgress}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding LastBoltResult}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Row="2"
                                Padding="8,6"
                                Background="{StaticResource EquipBgBrush}"
                                CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SHARED XYZ MOTION"
                                               Style="{StaticResource EquipmentTypeStyle}"
                                               Margin="0"/>
                                    <TextBlock Text="{Binding BoltFasteningPosition}"
                                               Style="{StaticResource MotionPositionStyle}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource MovingStateStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BoltFasteningMoving}" Value="True">
                                                    <Setter Property="Text" Value="MOVING"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="3" Height="64" Margin="0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="3"
                                       Text="{Binding BoltFasteningLocation}"
                                       Style="{StaticResource HandlerLocationStyle}"/>
                            <Border Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Height="3"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource DividerBrush}"/>
                            <Border Grid.Row="1"
                                    Grid.Column="{Binding BoltFasteningMapColumn}"
                                    Style="{StaticResource HandlerMarkerStyle}">
                                <TextBlock Text="BOLT GANTRY"
                                           Foreground="{StaticResource AccentGreenBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="2"
                                       Text="PCB 1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource TrackNodeStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BoltFasteningIo[1].IsOn}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="2 HEADS"
                                       Style="{StaticResource TrackNodeStyle}"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="PCB 2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource TrackNodeStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BoltFasteningIo[2].IsOn}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ItemsControl Grid.Row="4"
                                      ItemsSource="{Binding BoltFasteningIo}"
                                      ItemTemplate="{StaticResource IoIndicatorTemplate}"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="5"
                           Text="›"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="24"/>

                <Border Grid.Column="6" Style="{StaticResource EquipmentCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="ST.3  INSPECTION" Style="{StaticResource EquipmentNameStyle}"/>
                            <TextBlock Text="AREA CAMERA + NG HANDLER" Style="{StaticResource EquipmentTypeStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,14,0,10">
                            <TextBlock Text="{Binding InspectionActivity}" Style="{StaticResource ActivityStyle}"/>
                            <TextBlock Text="{Binding LastRouteText}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2"
                                Padding="8,6"
                                Background="{StaticResource EquipBgBrush}"
                                CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="XYZ MOTION"
                                               Style="{StaticResource EquipmentTypeStyle}"
                                               Margin="0"/>
                                    <TextBlock Text="{Binding InspectionPosition}"
                                               Style="{StaticResource MotionPositionStyle}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource MovingStateStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InspectionMoving}" Value="True">
                                                    <Setter Property="Text" Value="MOVING"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="3" Height="64" Margin="0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="3"
                                       Text="{Binding InspectionLocation}"
                                       Style="{StaticResource HandlerLocationStyle}"/>
                            <Border Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Height="3"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource DividerBrush}"/>
                            <Border Grid.Row="1"
                                    Grid.Column="{Binding InspectionMapColumn}"
                                    Style="{StaticResource HandlerMarkerStyle}">
                                <TextBlock Text="CAMERA / GRIP"
                                           Foreground="{StaticResource AccentGreenBrush}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="2"
                                       Text="PCB 1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource TrackNodeStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InspectionIo[1].IsOn}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="PCB 2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource TrackNodeStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InspectionIo[2].IsOn}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="{Binding NgStackCount, StringFormat=NG STACK {0}}"
                                       Style="{StaticResource TrackNodeStyle}"/>
                        </Grid>
                        <ItemsControl Grid.Row="4"
                                      ItemsSource="{Binding InspectionIo}"
                                      ItemTemplate="{StaticResource IoIndicatorTemplate}"/>
                    </Grid>
                </Border>

                <Border Grid.ColumnSpan="7"
                        Background="#60180000"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="E-STOP"
                               FontSize="34"
                               Style="{StaticResource OverlayTextStyle}"
                               Foreground="{StaticResource AccentRedBrush}"
                               Opacity="0.7"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <ui:ResultPanelView Grid.Column="2"/>
        </Grid>

        <Border Grid.Row="2"
                Margin="16,0,16,12"
                Padding="14,10"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="UPSTREAM SMEMA" Style="{StaticResource SectionHeaderStyle}"/>
                    <ItemsControl ItemsSource="{Binding UpstreamIo}"
                                  ItemTemplate="{StaticResource CompactIoIndicatorTemplate}"
                                  Margin="0,5,14,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource DividerBrush}"/>

                <StackPanel Grid.Column="2" Margin="14,0">
                    <TextBlock Text="CONVEYOR" Style="{StaticResource SectionHeaderStyle}"/>
                    <Grid Margin="0,8,0,3">
                        <Border Height="4"
                                VerticalAlignment="Center"
                                Background="{StaticResource DividerBrush}"/>
                        <TextBlock HorizontalAlignment="Center"
                                   Padding="8,2"
                                   Background="{StaticResource CardBgBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="STOPPED"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConveyorRunning}" Value="True">
                                            <Setter Property="Text" Value="RUNNING  ›"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock FontSize="9" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="SERVO NOT READY"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConveyorReady}" Value="True">
                                        <Setter Property="Text" Value="SERVO READY"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="3" Background="{StaticResource DividerBrush}"/>

                <StackPanel Grid.Column="4" Margin="14,0">
                    <TextBlock Text="SAFETY" Style="{StaticResource SectionHeaderStyle}"/>
                    <ItemsControl ItemsSource="{Binding SafetyIo}"
                                  ItemTemplate="{StaticResource CompactIoIndicatorTemplate}"
                                  Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Column="5" Background="{StaticResource DividerBrush}"/>

                <StackPanel Grid.Column="6" Margin="14,0,0,0">
                    <TextBlock Text="DOWNSTREAM SMEMA" Style="{StaticResource SectionHeaderStyle}"/>
                    <ItemsControl ItemsSource="{Binding DownstreamIo}"
                                  ItemTemplate="{StaticResource CompactIoIndicatorTemplate}"
                                  Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="STANDARD"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10"
                               Margin="0,0,8,0"/>
                    <TextBox Text="{Binding StandardTargetTorque, StringFormat='{}{0:F1}', UpdateSourceTrigger=LostFocus}"
                             VerticalAlignment="Center"
                             FontSize="11"
                             MinWidth="44"
                             TextAlignment="Right"/>
                    <TextBlock Text="Nm"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10"
                               Margin="5,0,16,0"/>
                    <TextBlock Text="LOCTITE"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10"
                               Margin="0,0,8,0"/>
                    <TextBox Text="{Binding LoctiteTargetTorque, StringFormat='{}{0:F1}', UpdateSourceTrigger=LostFocus}"
                             VerticalAlignment="Center"
                             FontSize="11"
                             MinWidth="44"
                             TextAlignment="Right"/>
                    <TextBlock Text="Nm"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10"
                               Margin="5,0,0,0"/>
                </StackPanel>

                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding SystemIo}"
                              ItemTemplate="{StaticResource FooterIoIndicatorTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Start"
                            Command="{Binding StartCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="76"
                            Margin="0,0,6,0"/>
                    <Button Content="Stop"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="76"
                            Margin="0,0,6,0"/>
                    <Button Content="Reset"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="70"
                            Margin="0,0,6,0"/>
                    <Button Content="NG Reset"
                            Command="{Binding ResetNgStackCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="76"
                            Margin="0,0,6,0"
                            Visibility="{Binding NgStackAlarm, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="E-STOP"
                            Command="{Binding EStopCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            MinWidth="84"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
