<UserControl x:Class="IBTM.UI.TeachingView"
    x:Name="TeachingRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:machine="clr-namespace:IBTM"
    xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
    xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:TeachingViewModel, IsDesignTimeCreatable=False}"
    Foreground="{StaticResource TextPrimaryBrush}"
    Background="{StaticResource AppBgBrush}"
    Validation.ErrorTemplate="{x:Null}" Loaded="OnViewLoaded">
    <UserControl.BindingGroup>
        <BindingGroup/>
    </UserControl.BindingGroup>
    <UserControl.Resources>
        <CollectionViewSource x:Key="TeachingPoints" Source="{Binding FilteredPoints}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="FasteningPoints" Source="{Binding FasteningPoints}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Position.Bolt.Head"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"
                IsEnabled="{Binding State.SetupEditingEnabled}">
                <TextBlock Text="Recipe" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding RecipeEditor.Name, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged}"
                    Width="180" Margin="0,0,6,0"/>
                <Button Command="{Binding SaveCommand}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Content" Value="Save"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveCommand.IsRunning}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=TeachingRoot, Path=(Validation.HasError)}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="New Recipe" Command="{Binding RecipeEditor.NewCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
            <TextBlock Text="Teaching" Style="{StaticResource TitleStyle}"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="240" MaxWidth="280"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3*" MinWidth="380"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.3*" MinWidth="340" MaxWidth="360"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Teaching Unit" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding TeachingUnits}"
                            SelectedItem="{Binding SelectedTeachingUnit, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox ItemsSource="{Binding HeatSinkSlots}"
                            SelectedItem="{Binding SelectedPcb, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,6,0,0"
                            Visibility="{Binding BoltPointEditorVisible, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <ui:TeachingPointList Grid.Row="1"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding Source={StaticResource TeachingPoints}}"
                        SelectedItem="{Binding SelectedPoint, UpdateSourceTrigger=PropertyChanged}"
                        Background="{StaticResource EquipBgBrush}" BorderThickness="1" BorderBrush="{StaticResource DividerBrush}"
                        ItemContainerStyle="{StaticResource FlatListItemStyle}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate DataType="{x:Type data:CollectionViewGroup}">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}"
                                            TextWrapping="Wrap" FontWeight="SemiBold" Margin="8,10,4,4"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:TeachingPoint}">
                                <StackPanel Margin="4,4">
                                    <TextBlock TextTrimming="CharacterEllipsis" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding BoltLabel}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Position.Bolt}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{Binding Name}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="11"
                                        Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding PositionLabel}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Position.Mode}" Value="{x:Static device:TeachMode.Image}">
                                                        <Setter Property="Text">
                                                            <Setter.Value>
                                                                <MultiBinding StringFormat="X {0:F3}  Y {1:F3}">
                                                                    <Binding Path="Coordinates.X"/>
                                                                    <Binding Path="Coordinates.Y"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Coordinates}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{Binding PositionLabel}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ui:TeachingPointList>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding SelectedPoint.Name}" Style="{StaticResource PanelTitleStyle}"
                            TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedPoint.PositionLabel, TargetNullValue=—}"
                            Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" Margin="0,4,0,0"
                            TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding State.SetupEditingEnabled}">
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Bolt}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <StackPanel Width="240" Margin="0,0,12,0">
                                <TextBlock Text="Bolt name" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedPoint.BoltName, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <WrapPanel>
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPoint.Position.Target}" Value="{x:Static device:TeachingTarget.BoltPosition}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <StackPanel Width="140" Margin="0,0,12,0">
                                    <TextBlock Text="Z offset (mm)" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedPoint.FasteningZOffset, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                                <StackPanel Width="180">
                                    <TextBlock Text="Min. turns (0 = off)" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedPoint.Position.Bolt.MinimumTurns, TargetNullValue=0, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                            </WrapPanel>
                        </WrapPanel>
                    </StackPanel>
                    <TabControl Grid.Row="1" Style="{StaticResource SectionTabs}"
                        ItemContainerStyle="{StaticResource SectionTab}"
                        Visibility="{Binding BoltPointEditorVisible, Converter={StaticResource BoolToVis}}">
                        <TabItem>
                            <TabItem.Style>
                                <Style TargetType="TabItem" BasedOn="{StaticResource SectionTab}">
                                    <Setter Property="Header" Value="Fastening order"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInspectionSelected}" Value="True">
                                            <Setter Property="Header" Value="Camera"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TabItem.Style>
                            <Grid>
                                <Grid Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <WrapPanel Margin="0,0,0,4">
                                        <ComboBox ItemsSource="{Binding FasteningHeads}" Width="180" Margin="0,0,8,4"
                                            SelectedItem="{Binding NewFasteningHead, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="Add Bolt" Command="{Binding AddBoltPointCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="0,0,8,4"/>
                                        <Button Content="Remove Bolt" Command="{Binding RemoveBoltPointCommand}"
                                            Style="{StaticResource DangerButtonStyle}" Padding="12,7" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                    <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                                        <Button Command="{Binding ToggleLiveViewCommand}" Margin="0,0,8,4" MinWidth="75" Padding="12,7">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                    <Setter Property="Content" Value="Live"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Inspection.IsLiveView}" Value="True">
                                                            <Setter Property="Content" Value="Stop Live"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Grab" Command="{Binding GrabCommand}" Margin="0,0,12,4" MinWidth="75" Padding="12,7"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" IsEnabled="{Binding State.SetupEditingEnabled}">
                                            <TextBlock Text="Light (0–255)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Width="55" Margin="0,0,8,0"
                                                Text="{Binding LiveLightLevel, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                            <Button Content="Apply" Command="{Binding ApplyLightCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Padding="12,7"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Border Grid.Row="2" Background="{StaticResource ImageBackgroundBrush}">
                                        <Grid>
                                            <ui:ImageTeachingView Source="{Binding CameraImage}" ShowCrosshair="True"/>
                                            <TextBlock Text="No image" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CameraImage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Border
                                    Visibility="{Binding IsFasteningSelected, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ListBox ItemsSource="{Binding Source={StaticResource FasteningPoints}}"
                                            SelectedItem="{Binding SelectedFasteningPoint, UpdateSourceTrigger=PropertyChanged}"
                                            Background="{StaticResource EquipBgBrush}" BorderBrush="{StaticResource DividerBrush}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            BorderThickness="1" ItemContainerStyle="{StaticResource FlatListItemStyle}">
                                            <ListBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate DataType="{x:Type data:CollectionViewGroup}">
                                                            <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}"
                                                                FontWeight="SemiBold" Margin="8,12,4,6" TextWrapping="Wrap"
                                                                Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ListBox.GroupStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ui:TeachingPoint}">
                                                    <TextBlock Text="{Binding BoltLabel}" Margin="6,8" FontWeight="SemiBold"
                                                        TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <UniformGrid Grid.Row="1" Columns="2" Margin="0,10,0,0">
                                            <Button Content="↑ Move up" Command="{Binding MoveFasteningEarlierCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,3,0"/>
                                            <Button Content="↓ Move down" Command="{Binding MoveFasteningLaterCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Margin="3,0,0,0"/>
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Related I/O">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IoStatusTemplate}"/>
                        </TabItem>
                    </TabControl>
                    <ContentPresenter Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource IoStatusTemplate}">
                        <ContentPresenter.Style>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoltPointEditorVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentPresenter.Style>
                    </ContentPresenter>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <ui:RecordPositionButton Content="Record Position" Command="{Binding TeachCurrentPositionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Padding="12,8" Margin="0,0,8,0"/>
                        <ui:MoveToPositionButton Content="Move to Position" Command="{Binding MoveToPointCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" MinWidth="150" Padding="12,8"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Motion" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,10"/>
                            <ui:TeachingMotionView/>
                            <Button Content="Return from Bolt Pickup" Command="{Binding ReturnFromPickupCommand}"
                                Margin="0,8,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding IsFasteningSelected, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,0"
                        Foreground="{StaticResource AccentAmberBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding HomeBlock, Converter={StaticResource EnumDescriptionConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HomeBlock}" Value="{x:Static machine:HomeBlockReason.None}">
                                        <Setter Property="Text" Value="{Binding MotionHint, Converter={StaticResource EnumDescriptionConverter}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ManualBlock}" Value="{x:Static ui:ManualControlBlock.AutoMode}">
                                        <Setter Property="Text" Value="{Binding ManualBlock, Converter={StaticResource EnumDescriptionConverter}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ManualBlock}" Value="{x:Static ui:ManualControlBlock.Busy}">
                                        <Setter Property="Text" Value="{Binding ManualBlock, Converter={StaticResource EnumDescriptionConverter}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="2" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Check the highlighted input."
                    Visibility="{Binding ElementName=TeachingRoot, Path=(Validation.HasError), Converter={StaticResource BoolToVis}}"
                    Foreground="{StaticResource AccentRedBrush}"/>
                <TextBlock Text="{Binding SaveError}" TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}"/>
                <TextBlock Text="{Binding CameraError}" TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
