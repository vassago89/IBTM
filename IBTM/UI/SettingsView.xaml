<UserControl x:Class="IBTM.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:IBTM.UI"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <Style x:Key="SettingFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SettingFieldBox"
               TargetType="TextBox"
               BasedOn="{StaticResource FieldTextBoxStyle}">
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="SettingSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SettingComboBox"
               TargetType="ComboBox"
               BasedOn="{StaticResource FieldComboBoxStyle}">
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <Style x:Key="SettingCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,16,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HardwareList" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="HardwareListItem"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource FlatListItemStyle}">
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Settings" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Machine setup and configuration"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1480" HorizontalAlignment="Center" Margin="0,0,8,0">
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Motion" Style="{StaticResource SettingSectionTitle}"/>
                        <UniformGrid Columns="6">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Motion Group" Style="{StaticResource SettingFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding MotionGroups}"
                                          SelectedItem="{Binding SelectedMotionGroup, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource EnumItemTemplate}"
                                          Style="{StaticResource SettingComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Horizontal Speed (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding CurrentMotionSettings.HorizontalSpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Z Speed (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding CurrentMotionSettings.ZSpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="Safe Z (mm)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding CurrentMotionSettings.SafeZ, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="Conveyor Speed (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.ConveyorVelocity, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="Conveyor" Style="{StaticResource SettingFieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Run" Command="{Binding RunConveyorCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0"/>
                                    <Button Content="Stop" Command="{Binding StopConveyorCommand}"
                                            Style="{StaticResource DangerButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Shared Buffer Collision Area"
                                       Style="{StaticResource SettingSectionTitle}"
                                       Margin="0"/>
                            <TextBlock Text="Required before buffer operation"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                        <UniformGrid Columns="6">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Supply X Min (mm)"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.PcbBuffer.SupplyMinimumX, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <TextBlock Text="Supply X Max (mm)"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.PcbBuffer.SupplyMaximumX, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <TextBlock Text="Placement X Min (mm)"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.PcbBuffer.PlacementMinimumX, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <TextBlock Text="Placement X Max (mm)"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.PcbBuffer.PlacementMaximumX, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <TextBlock Text="Placement Y Min (mm)"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.PcbBuffer.PlacementMinimumY, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Placement Y Max (mm)"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.PcbBuffer.PlacementMaximumY, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Actuator Feedback"
                                       Style="{StaticResource SettingSectionTitle}"
                                       Margin="0"/>
                            <TextBlock Text="Each actuator output waits for its mapped input state."
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                        <Grid Margin="6,0,6,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OUTPUT" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="ON INPUT"
                                       Style="{StaticResource SettingFieldLabel}"/>
                            <TextBlock Grid.Column="2" Text="VALUE"
                                       Style="{StaticResource SettingFieldLabel}"/>
                            <TextBlock Grid.Column="3" Text="OFF INPUT"
                                       Style="{StaticResource SettingFieldLabel}"/>
                            <TextBlock Grid.Column="4" Text="VALUE"
                                       Style="{StaticResource SettingFieldLabel}"/>
                            <TextBlock Grid.Column="5" Text="TIMEOUT (MS)"
                                       Style="{StaticResource SettingFieldLabel}"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding FeedbackMappings}"
                                 Style="{StaticResource HardwareList}"
                                 MaxHeight="240"
                                 ItemContainerStyle="{StaticResource HardwareListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key, Converter={StaticResource EnumDescriptionConverter}}"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.InputSignals, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Value.OnInput, Mode=TwoWay}"
                                                  ItemTemplate="{StaticResource EnumItemTemplate}"
                                                  Style="{StaticResource SettingComboBox}"
                                                  MinWidth="0"
                                                  Padding="5,3"/>
                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding Value.OnValue}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="3"
                                                  ItemsSource="{Binding DataContext.InputSignals, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Value.OffInput, Mode=TwoWay}"
                                                  ItemTemplate="{StaticResource EnumItemTemplate}"
                                                  Style="{StaticResource SettingComboBox}"
                                                  MinWidth="0"
                                                  Padding="5,3"/>
                                        <CheckBox Grid.Column="4"
                                                  IsChecked="{Binding Value.OffValue}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="5"
                                                 Text="{Binding Value.TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingFieldBox}"
                                                 MinWidth="0"
                                                 Padding="5,3"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Hardware and Homing" Style="{StaticResource SettingSectionTitle}" Margin="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Stop Axis" Command="{Binding StopHomingCommand}"
                                        Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="Refresh" Command="{Binding RefreshHardwareCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Motion / IO Driver" Style="{StaticResource SettingFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ControlDrivers}"
                                          SelectedItem="{Binding Settings.ControlDriver, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource EnumItemTemplate}"
                                          Style="{StaticResource SettingComboBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Home Horizontal (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Home.HorizontalSpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="Home Z (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Home.ZSpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,16,0">
                                <TextBlock Text="Pulse Length (mm/pulse)"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Hardware.MillimetersPerPulse, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="4"
                                       Text="Motion / IO driver, axis number, and direction changes apply after restart."
                                       VerticalAlignment="Bottom"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="INPUTS" Style="{StaticResource SettingFieldLabel}"/>
                                <ListBox ItemsSource="{Binding InputMappings}" Height="420"
                                         Style="{StaticResource HardwareList}"
                                         ItemContainerStyle="{StaticResource HardwareListItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="44"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           ToolTip="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBox Grid.Column="1" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SettingFieldBox}"
                                                         MinWidth="0" Padding="5,3" Margin="4,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding State}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="OUTPUTS" Style="{StaticResource SettingFieldLabel}"/>
                                <ListBox ItemsSource="{Binding OutputMappings}" Height="420"
                                         Style="{StaticResource HardwareList}"
                                         ItemContainerStyle="{StaticResource HardwareListItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="58"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           ToolTip="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBox Grid.Column="1" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SettingFieldBox}"
                                                         MinWidth="0" Padding="5,3" Margin="4,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="AXES · NUMBER · DIRECTION · MIN · MAX"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <ListBox ItemsSource="{Binding AxisMappings}" Height="420"
                                         Style="{StaticResource HardwareList}"
                                         ItemContainerStyle="{StaticResource HardwareListItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="48"/>
                                                     <ColumnDefinition Width="100"/>
                                                     <ColumnDefinition Width="54"/>
                                                     <ColumnDefinition Width="54"/>
                                                     <ColumnDefinition Width="108"/>
                                                     <ColumnDefinition Width="50"/>
                                                     <ColumnDefinition Width="50"/>
                                                 </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           ToolTip="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                 <TextBox Grid.Column="1" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource SettingFieldBox}"
                                                          MinWidth="0" Padding="5,3" Margin="4,0"/>
                                                 <ComboBox Grid.Column="2"
                                                           ItemsSource="{Binding DataContext.AxisDirections, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           SelectedItem="{Binding Direction, Mode=TwoWay}"
                                                           ItemTemplate="{StaticResource EnumItemTemplate}"
                                                           Padding="4,2" Margin="2,0"/>
                                                 <TextBox Grid.Column="3"
                                                          Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanSetRange}"
                                                          Style="{StaticResource SettingFieldBox}"
                                                          MinWidth="0" Padding="4,3" Margin="2,0"/>
                                                 <TextBox Grid.Column="4"
                                                          Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanSetRange}"
                                                          Style="{StaticResource SettingFieldBox}"
                                                          MinWidth="0" Padding="4,3" Margin="2,0"/>
                                                 <TextBlock Grid.Column="5"
                                                            Text="{Binding AxisDisplayState,
                                                                           Converter={StaticResource EnumDescriptionConverter}}"
                                                            VerticalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis"
                                                            FontFamily="Cascadia Mono, Consolas"
                                                            FontSize="10"
                                                            FontWeight="SemiBold">
                                                     <TextBlock.Style>
                                                         <Style TargetType="TextBlock">
                                                             <Setter Property="Foreground"
                                                                     Value="{StaticResource AccentGreenBrush}"/>
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding AxisDisplayState}"
                                                                              Value="{x:Static ui:AxisDisplayState.Moving}">
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentBlueBrush}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding AxisDisplayState}"
                                                                              Value="{x:Static ui:AxisDisplayState.HomeRequired}">
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentAmberBrush}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding AxisDisplayState}"
                                                                              Value="{x:Static ui:AxisDisplayState.ServoOff}">
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentAmberBrush}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding AxisDisplayState}"
                                                                              Value="{x:Static ui:AxisDisplayState.PositiveLimit}">
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentRedBrush}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding AxisDisplayState}"
                                                                              Value="{x:Static ui:AxisDisplayState.NegativeLimit}">
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentRedBrush}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding AxisDisplayState}"
                                                                              Value="{x:Static ui:AxisDisplayState.Emergency}">
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentRedBrush}"/>
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding AxisDisplayState}"
                                                                              Value="{x:Static ui:AxisDisplayState.Alarm}">
                                                                     <Setter Property="Foreground"
                                                                             Value="{StaticResource AccentRedBrush}"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </TextBlock.Style>
                                                 </TextBlock>
                                                 <Button Grid.Column="6" Content="Servo"
                                                        Command="{Binding DataContext.ToggleServoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanServo}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="6,3" Margin="0,0,4,0"/>
                                                 <Button Grid.Column="7" Content="Home"
                                                        Command="{Binding DataContext.HomeAxisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanHome}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="6,3"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="AJIN Controller" Style="{StaticResource SettingSectionTitle}"/>
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Interrupt Number" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Ajin.InterruptNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,8,12">
                                <TextBlock Text="Motion Parameter File" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Ajin.MotionParameterFile, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,4,12">
                                <TextBlock Text="Acceleration Multiplier" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Ajin.AccelerationMultiplier, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Input Module Offset" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Ajin.InputModuleOffset, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,8,0">
                                <TextBlock Text="Output Module Offset" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Ajin.OutputModuleOffset, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,4,0">
                                <TextBlock Text="I/O Channel Count" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Ajin.IoChannelCount, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="3">
                    <Border Style="{StaticResource SettingCard}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Text="Alignment Camera" Style="{StaticResource SettingSectionTitle}"/>
                            <TextBlock Text="Device ID / Serial Number" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.AlignmentCamera.DeviceId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Exposure (us)" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.AlignmentCamera.ExposureMicroseconds, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Gain" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.AlignmentCamera.Gain, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Frame Timeout (ms)" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.AlignmentCamera.FrameTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="X mm/pixel" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.PcbPlacement.AlignmentXMillimetersPerPixel, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Y mm/pixel" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.PcbPlacement.AlignmentYMillimetersPerPixel, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingCard}" Margin="6,0,6,12">
                        <StackPanel>
                            <TextBlock Text="Inspection Camera" Style="{StaticResource SettingSectionTitle}"/>
                            <TextBlock Text="Device ID / Serial Number" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.InspectionCamera.DeviceId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Exposure (us)" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.InspectionCamera.ExposureMicroseconds, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Gain" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.InspectionCamera.Gain, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Frame Timeout (ms)" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.InspectionCamera.FrameTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Pixels/mm" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.Inspection.PixelsPerMm, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingCard}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Controllers" Style="{StaticResource SettingSectionTitle}"/>
                            <TextBlock Text="Camera Driver" Style="{StaticResource SettingFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding CameraDrivers}"
                                      SelectedItem="{Binding Settings.CameraDriver, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource EnumItemTemplate}"
                                      Style="{StaticResource SettingComboBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Light Controller Connection" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.Lighting.Connection, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="Alignment Ch." Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Lighting.AlignmentChannel, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}" MinWidth="0"/>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Alignment Level" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Lighting.AlignmentLevel, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}" MinWidth="0"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,4,0">
                                    <TextBlock Text="Inspection Ch." Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Lighting.InspectionChannel, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}" MinWidth="0"/>
                                </StackPanel>
                                <StackPanel Margin="4,8,0,0">
                                    <TextBlock Text="Inspection Level" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.Lighting.InspectionLevel, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}" MinWidth="0"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Columns="2">
                    <Border Style="{StaticResource SettingCard}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Text="Head 1 · Standard / Blow Feed"
                                       Style="{StaticResource SettingSectionTitle}"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="Head Offset X (mm)" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.BoltFastening.StandardHead.OffsetX, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}" MinWidth="0"/>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Head Offset Y (mm)" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.BoltFastening.StandardHead.OffsetY, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}" MinWidth="0"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Default Torque (Nm)" Style="{StaticResource SettingFieldLabel}"
                                       Margin="0,8,0,0"/>
                            <TextBox Text="{Binding Settings.BoltFastening.StandardHead.DefaultTorqueNm, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingCard}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Head 2 · Loctite / Pickup"
                                       Style="{StaticResource SettingSectionTitle}"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="Head Offset X (mm)" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.BoltFastening.LoctiteHead.OffsetX, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}" MinWidth="0"/>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Head Offset Y (mm)" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBox Text="{Binding Settings.BoltFastening.LoctiteHead.OffsetY, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingFieldBox}" MinWidth="0"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Default Torque (Nm)" Style="{StaticResource SettingFieldLabel}"
                                       Margin="0,8,0,0"/>
                            <TextBox Text="{Binding Settings.BoltFastening.LoctiteHead.DefaultTorqueNm, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Columns="2">
                    <Border Style="{StaticResource SettingCard}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Text="NG Handling" Style="{StaticResource SettingSectionTitle}"/>
                            <TextBlock Text="Carrier Capacity" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Settings.Inspection.NgCarrierCapacity, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingCard}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Configuration Scope" Style="{StaticResource SettingSectionTitle}"/>
                            <TextBlock Text="Motion, I/O, driver and device connection changes apply after restart."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Camera and bolt settings are ready for their physical drivers."
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Interlocks" Style="{StaticResource SettingSectionTitle}"/>
                        <UniformGrid Columns="2">
                            <CheckBox Content="Emergency Stop"
                                      IsChecked="{Binding Settings.Options.UseEmergencyStop}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Reset Button"
                                      IsChecked="{Binding Settings.Options.UseResetButton}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Door Interlock"
                                      IsChecked="{Binding Settings.Options.UseDoorInterlock}"
                                      Style="{StaticResource SettingCheckBox}"/>
                            <CheckBox Content="Air Pressure Interlock"
                                      IsChecked="{Binding Settings.Options.UseAirPressureInterlock}"
                                      Style="{StaticResource SettingCheckBox}"/>
                        </UniformGrid>
                        <TextBlock Text="Enable each item after its logical I/O mapping and electrical behavior have been verified."
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right" MinWidth="150"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
