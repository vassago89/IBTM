<UserControl x:Class="IBTM.UI.Station3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
             Width="498"
             Height="492">
    <Grid>
        <Border Style="{DynamicResource CellStyle}"/>

        <Canvas>
            <TextBlock Canvas.Left="20" Canvas.Top="18"
                       Text="STATION 3   INSPECT / SORT"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="17"
                       FontWeight="SemiBold"/>
            <Border Canvas.Right="20" Canvas.Top="52"
                    Tag="{Binding InspectionDisplayState}"
                    Style="{DynamicResource StationStateBadgeStyle}">
                <TextBlock Text="{Binding InspectionDisplayState,
                                          Converter={StaticResource EnumDescriptionConverter}}"
                           Style="{DynamicResource StateTextStyle}"/>
            </Border>

            <Grid Canvas.Left="{Binding InspectionGantryMapLeft}"
                  Canvas.Top="{Binding InspectionGantryMapTop}"
                  Width="138" Height="132"
                  Panel.ZIndex="20"
                  ToolTip="{Binding InspectionGantryPosition}">
                <Border Tag="{Binding InspectionGantryMoving}"
                        Style="{DynamicResource DeviceBodyStyle}"/>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="INSPECTION GANTRY"
                               HorizontalAlignment="Center"
                               Style="{DynamicResource MapLabelStyle}"/>

                    <Grid Grid.Row="1" Margin="4,8,4,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Ellipse Width="38" Height="38"
                                     Fill="{StaticResource EquipBgBrush}"
                                     Stroke="{StaticResource AccentBlueBrush}"
                                     StrokeThickness="2"/>
                            <TextBlock Text="C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBlueBrush}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Grid.Column="1" Width="48" Height="42">
                            <Border Width="30" Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource CarrierJigBrush}"
                                    CornerRadius="2"
                                    Visibility="{Binding NgCarrierJigDetected,
                                                         Converter={StaticResource BoolToVis}}"/>
                            <Border Tag="{Binding NgCarrierGripperClosed}"
                                    Style="{DynamicResource LeftGripperJawStyle}"/>
                            <Border Tag="{Binding NgCarrierGripperClosed}"
                                    Style="{DynamicResource RightGripperJawStyle}"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CAMERA"
                                   HorizontalAlignment="Center"
                                   Style="{DynamicResource MapHintStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="GRIPPER"
                                   HorizontalAlignment="Center"
                                   Style="{DynamicResource MapHintStyle}"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Canvas.Left="112" Canvas.Top="316"
                  Width="276" Height="64">
                <Border Style="{DynamicResource ConveyorBedStyle}"/>
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Margin="4,0"
                            Tag="{Binding NgConveyorPosition1Occupied}"
                            Style="{DynamicResource StageBodyStyle}">
                        <TextBlock Text="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource MapHintStyle}"/>
                    </Border>
                    <Border Grid.Column="1" Margin="4,0"
                            Tag="{Binding NgConveyorPosition2Occupied}"
                            Style="{DynamicResource StageBodyStyle}">
                        <TextBlock Text="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource MapHintStyle}"/>
                    </Border>
                    <Border Grid.Column="2" Margin="4,0"
                            Tag="{Binding NgConveyorPosition3Occupied}"
                            Style="{DynamicResource StageBodyStyle}">
                        <TextBlock Text="3"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource MapHintStyle}"/>
                    </Border>
                </Grid>
            </Grid>
            <TextBlock Canvas.Left="112" Canvas.Top="388"
                       Text="NG CONVEYOR"
                       Style="{DynamicResource MapHintStyle}"/>
            <TextBlock Canvas.Left="112" Canvas.Top="405"
                       Width="220"
                       Text="{Binding NgConveyorState, Converter={StaticResource EnumDescriptionConverter}}"
                       TextAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11"/>

            <Border Canvas.Left="342" Canvas.Top="354"
                    Width="118" Height="58"
                    Tag="{Binding NgShuttleCarrierDetected}"
                    Style="{DynamicResource StageBodyStyle}">
                <TextBlock Text="NG SHUTTLE"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{DynamicResource MapHintStyle}"/>
            </Border>

            <TextBlock Canvas.Left="20" Canvas.Top="438"
                       Text="INSPECTION POSITION"
                       Style="{DynamicResource MapLabelStyle}"/>
            <TextBlock Canvas.Left="20" Canvas.Top="458"
                       Text="{Binding InspectionGantryPosition}"
                       Style="{DynamicResource MapHintStyle}"/>
        </Canvas>
    </Grid>
</UserControl>
