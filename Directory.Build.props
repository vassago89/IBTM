<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Configurations>Debug;Release;Virtual</Configurations>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Offline equipment PCs cannot fetch vulnerability data; keep the failure visible as a warning. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)packages-offline')">
    <RestoreSources>$(MSBuildThisFileDirectory)packages-offline</RestoreSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
