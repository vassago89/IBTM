<UserControl x:Class="IBTM.UI.OperationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
             xmlns:ui="clr-namespace:IBTM.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <Style x:Key="SideLaneStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                <Trigger.Value><sys:Boolean>False</sys:Boolean></Trigger.Value>
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SideCarriageStyle" TargetType="Border">
            <Setter Property="Height" Value="9"/>
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="Background"
                            Value="{StaticResource MapActiveBackgroundBrush}"/>
                    <Setter Property="BorderBrush"
                            Value="{StaticResource AccentBlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SideScaleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="SideAxisLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource EquipmentRoleLabelStyle}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
        <DataTemplate x:Key="ZAxisScaleTemplate" DataType="{x:Type device:MotionStatus}">
            <Grid Height="62">
                <Border Height="3" Margin="18,5,18,0" VerticalAlignment="Top"
                        Background="{StaticResource CardBorderBrush}"/>
                <Border Width="2" Height="51" Margin="0,5,0,0"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="{StaticResource DividerBrush}"/>
                <TextBlock Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Text="{Binding ZMinimum, StringFormat=F0}"
                           Style="{StaticResource SideScaleTextStyle}"/>
                <TextBlock Margin="2,46,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Text="{Binding ZMaximum, StringFormat=F0}"
                           Style="{StaticResource SideScaleTextStyle}"/>
                <Border Height="3" Margin="12,56,12,0" VerticalAlignment="Top"
                        Background="{StaticResource CardBorderBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18,2">
        <Border Background="{StaticResource EquipBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="3"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="820"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PanelBgBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Width="1552"
                          Margin="0,3"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="283"/>
                            <ColumnDefinition Width="283"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="408"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Tag="{Binding PcbSupplyEnabled}"
                                Style="{StaticResource SideLaneStyle}">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Source={x:Static core:MotionGroup.PcbSupply},
                                                              Converter={StaticResource EnumDescriptionConverter}}"
                                               Style="{StaticResource SideAxisLabelStyle}"/>
                                    <TextBlock Visibility="{Binding SupplyPositionKnown, Converter={StaticResource BoolToVis}}"
                                               Text="{Binding Supply.Motion.Position.Z,
                                                              StringFormat='Z {0:F2} mm'}"
                                               Style="{StaticResource PrimaryStateTextStyle}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="155" Height="62">
                                    <ContentPresenter Content="{Binding Supply.Motion}"
                                                      ContentTemplate="{StaticResource ZAxisScaleTemplate}"/>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top"
                                          Visibility="{Binding SupplyPositionKnown, Converter={StaticResource BoolToVis}}"
                                          Width="42" Height="18">
                                        <Grid.RenderTransform>
                                            <TranslateTransform Y="{Binding PcbSupplyZTop}"/>
                                        </Grid.RenderTransform>
                                        <Border Width="42"
                                                Tag="{Binding Supply.Motion.IsMoving}"
                                                Style="{StaticResource SideCarriageStyle}"/>
                                        <Border Width="3" Height="7"
                                                VerticalAlignment="Top"
                                                Margin="0,8,0,0"
                                                Background="{StaticResource TextMutedBrush}"/>
                                        <Border Width="26" Height="3"
                                                VerticalAlignment="Bottom"
                                                Background="{StaticResource MaterialPcbBrush}"
                                                CornerRadius="1"
                                                Visibility="{Binding PcbSupplyPcbSecured,
                                                                     Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Tag="{Binding PcbPlacementEnabled}"
                                Style="{StaticResource SideLaneStyle}">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Source={x:Static core:MotionGroup.PcbPlacementHandler},
                                                              Converter={StaticResource EnumDescriptionConverter}}"
                                               Style="{StaticResource SideAxisLabelStyle}"/>
                                    <TextBlock Visibility="{Binding PlacementPositionKnown, Converter={StaticResource BoolToVis}}"
                                               Text="{Binding Placement.Motion.Position.Z,
                                                              StringFormat='Z {0:F2} mm'}"
                                               Style="{StaticResource PrimaryStateTextStyle}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="155" Height="62">
                                    <ContentPresenter Content="{Binding Placement.Motion}"
                                                      ContentTemplate="{StaticResource ZAxisScaleTemplate}"/>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top"
                                          Visibility="{Binding PlacementPositionKnown, Converter={StaticResource BoolToVis}}"
                                          Width="42" Height="18">
                                        <Grid.RenderTransform>
                                            <TranslateTransform Y="{Binding PcbPlacementZTop}"/>
                                        </Grid.RenderTransform>
                                        <Border Width="42"
                                                Tag="{Binding Placement.Motion.IsMoving}"
                                                Style="{StaticResource SideCarriageStyle}"/>
                                        <Border Width="7" Height="7"
                                                VerticalAlignment="Top"
                                                Margin="0,8,0,0"
                                                Background="{StaticResource TextMutedBrush}"
                                                CornerRadius="1"/>
                                        <Border Width="26" Height="3"
                                                VerticalAlignment="Bottom"
                                                Background="{StaticResource MaterialPcbBrush}"
                                                CornerRadius="1"
                                                Visibility="{Binding PcbPlacementPcbSecured,
                                                                     Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3"
                                Tag="{Binding BoltFasteningEnabled}"
                                Style="{StaticResource SideLaneStyle}">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Source={x:Static core:MotionGroup.BoltFastening},
                                                              Converter={StaticResource EnumDescriptionConverter}}"
                                               Style="{StaticResource SideAxisLabelStyle}"/>
                                    <TextBlock Visibility="{Binding FasteningPositionKnown, Converter={StaticResource BoolToVis}}"
                                               Text="{Binding Fastening.Motion.Position.Z,
                                                              StringFormat='Z {0:F2} mm'}"
                                               Style="{StaticResource PrimaryStateTextStyle}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="240" Height="62">
                                    <ContentPresenter Content="{Binding Fastening.Motion}"
                                                      ContentTemplate="{StaticResource ZAxisScaleTemplate}"/>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top"
                                          Visibility="{Binding FasteningPositionKnown, Converter={StaticResource BoolToVis}}"
                                          Width="68" Height="18">
                                        <Grid.RenderTransform>
                                            <TranslateTransform Y="{Binding BoltFasteningZTop}"/>
                                        </Grid.RenderTransform>
                                        <Border Width="68"
                                                Tag="{Binding Fastening.Motion.IsMoving}"
                                                Style="{StaticResource SideCarriageStyle}"/>
                                        <Border Width="3" Height="9"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="18,8,0,0"
                                                Background="{StaticResource TextMutedBrush}"/>
                                        <Border Width="3" Height="9"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,8,18,0"
                                                Background="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Canvas Grid.Row="1"
                        Width="1600"
                        Height="820"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                    <ui:NgConveyorView Canvas.Left="{x:Static ui:MachinePlan.InspectionLeft}" Canvas.Top="0"
                                       Panel.ZIndex="-10"/>
                    <ui:ConveyorView Canvas.Left="{x:Static ui:MachinePlan.MainLeft}" Canvas.Top="{x:Static ui:MachinePlan.MainTop}"
                                     Panel.ZIndex="0"/>
                    <ui:PcbPlacementView Canvas.Left="{x:Static ui:MachinePlan.MainLeft}" Canvas.Top="0"
                                         Panel.ZIndex="10"/>
                    <ui:BoltFasteningView Canvas.Left="{x:Static ui:MachinePlan.FasteningLeft}" Canvas.Top="0"
                                          Panel.ZIndex="10"/>
                    <ui:InspectionView Canvas.Left="{x:Static ui:MachinePlan.InspectionLeft}" Canvas.Top="0"
                                       Panel.ZIndex="10"/>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</UserControl>
