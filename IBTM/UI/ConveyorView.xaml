                        <TextBlock Text="{Binding Signals.Inputs[InspectionStopperDown].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Stopper down" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[InspectionBackupPlateUp].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[InspectionBackupPlateUp].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[InspectionBackupPlateUp].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Plate up" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[InspectionBackupPlateDown].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[InspectionBackupPlateDown].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[InspectionBackupPlateDown].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Plate down" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[InspectionHeatSink1Present].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[InspectionHeatSink1Present].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[InspectionHeatSink1Present].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Heat sink 1" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[InspectionHeatSink2Present].Signal, Converter={StaticResource EnumDescriptionConverter}}">
