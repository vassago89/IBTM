<UserControl x:Class="IBTM.UI.TeachingView"
    x:Name="TeachingRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:machine="clr-namespace:IBTM"
    xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:TeachingViewModel, IsDesignTimeCreatable=False}"
    Foreground="{StaticResource TextPrimaryBrush}"
    Background="{StaticResource AppBgBrush}"
    Validation.ErrorTemplate="{x:Null}" Loaded="OnViewLoaded">
    <UserControl.BindingGroup>
        <BindingGroup/>
    </UserControl.BindingGroup>
    <UserControl.Resources>
        <ui:FiducialBinaryConverter x:Key="FiducialBinaryConverter"/>
        <CollectionViewSource x:Key="TeachingPoints" Source="{Binding FilteredPoints}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="12,0,0,10">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="IsEnabled" Value="{Binding State.SetupEditingEnabled}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Button Content="{ui:Text 'New Recipe'}" Command="{Binding RecipeEditor.NewCommand}" MinWidth="100" Margin="0,0,16,0"/>
            <TextBlock Text="{ui:Text 'Recipe'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding RecipeEditor.Recipes}" IsEditable="True" IsTextSearchEnabled="False"
                Text="{Binding RecipeEditor.Name, Mode=TwoWay, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="{ui:Text 'Recipe'}" ToolTip="{Binding RecipeEditor.Name}"
                Width="180" Margin="0,0,6,0"/>
            <Button Content="{ui:Text 'Load'}" Command="{Binding RecipeEditor.LoadCommand}"
                CommandParameter="{Binding RecipeEditor.Name}"
                IsEnabled="{Binding RecipeEditor.IsSaveAllowed}" MinWidth="100" Margin="0,0,6,0"/>
            <Button Command="{Binding SaveCommand}" MinWidth="100">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="IsEnabled" Value="{Binding IsSaveAllowed}"/>
                        <Setter Property="Content" Value="{ui:Text 'Save'}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SaveCommand.IsRunning}" Value="True">
                                <Setter Property="Content" Value="{ui:Text 'Saving...'}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsFiducialSelected}" Value="True"/>
                                    <Condition Binding="{Binding ElementName=FiducialActions, Path=IsEnabled}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding ElementName=TeachingRoot, Path=(Validation.HasError)}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="260" MaxWidth="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3*" MinWidth="380"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.3*" MinWidth="340" MaxWidth="360"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <ComboBox AutomationProperties.Name="{ui:Text 'Unit'}" ItemsSource="{Binding TeachingUnits}"
                            SelectedItem="{Binding SelectedTeachingUnit, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox ItemsSource="{Binding HeatSinkSlots}"
                            SelectedItem="{Binding SelectedPcb, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,6,0,0"
                            Visibility="{Binding BoltPointEditorVisible, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <ui:TeachingPointListBox Grid.Row="1"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding Source={StaticResource TeachingPoints}}"
                        SelectedItem="{Binding SelectedPoint, UpdateSourceTrigger=PropertyChanged}"
                        Background="{StaticResource EquipBgBrush}" BorderThickness="1" BorderBrush="{StaticResource DividerBrush}"
                        ItemContainerStyle="{StaticResource FlatListItemStyle}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate DataType="{x:Type data:CollectionViewGroup}">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource UiTextConverter}}"
                                            TextWrapping="Wrap" FontWeight="SemiBold" Margin="8,10,4,4"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:TeachingPoint}">
                                <StackPanel Margin="4,4">
                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding BoltLabel}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Position.Bolt}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{Binding Name}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Position.Target}" Value="{x:Static device:TeachingTarget.BoltPreliminaryPosition}">
                                                        <Setter Property="Text" Value="{Binding Name}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="12"
                                        Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding PositionLabel}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Position.Mode}" Value="{x:Static device:TeachMode.Image}">
                                                        <Setter Property="Text">
                                                            <Setter.Value>
                                                                <MultiBinding StringFormat="X {0:F3}  Y {1:F3}">
                                                                    <Binding Path="Coordinates.X"/>
                                                                    <Binding Path="Coordinates.Y"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Coordinates}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="{Binding PositionLabel}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ui:TeachingPointListBox>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0"
                        Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel"><Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPoint.Position.Bolt}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style>
                            </StackPanel.Style>
                            <TextBlock Text="{ui:Text 'Fastening order'}" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2">
                                <Button Content="{ui:Text '↑ Earlier'}" Command="{Binding MoveFasteningEarlierCommand}" IsEnabled="{Binding IsMoveFasteningEarlierAllowed}" Padding="8,6" Margin="0,0,3,0"/>
                                <Button Content="{ui:Text '↓ Later'}" Command="{Binding MoveFasteningLaterCommand}" IsEnabled="{Binding IsMoveFasteningLaterAllowed}" Padding="8,6" Margin="3,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding FasteningHeads}"
                                    SelectedItem="{Binding NewFasteningHead, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsAddBoltPointAllowed}" Margin="0,0,0,6"/>
                                <UniformGrid Columns="2">
                                    <Button Content="{ui:Text 'Add Bolt'}" Command="{Binding AddBoltPointCommand}" Padding="8,6" Margin="0,0,3,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Setter Property="IsEnabled" Value="{Binding IsAddBoltPointAllowed}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=LiveLightInput, Path=(Validation.HasError)}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{ui:Text 'Remove Bolt'}" Command="{Binding RemoveBoltPointCommand}" IsEnabled="{Binding IsRemoveBoltPointAllowed}"
                                        Style="{StaticResource DangerButtonStyle}" Padding="8,6" Margin="3,0,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding SelectedPoint.Name}" Style="{StaticResource PanelTitleStyle}"
                            TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SelectedPoint.PositionLabel, TargetNullValue=—}"
                            ToolTip="{Binding SelectedPoint.PositionLabel}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" Margin="0,2,0,0"
                            TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding State.SetupEditingEnabled}">
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Bolt}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <StackPanel Width="240" Margin="0,0,12,0">
                                <TextBlock Text="{ui:Text 'Bolt name'}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedPoint.BoltName, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                                <StackPanel Width="120" Margin="0,0,12,0">
                                    <TextBlock Text="{ui:Text 'Minimum height (mm)'}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="InspectionMinimumHeightInput" Text="{Binding SelectedPoint.Position.Bolt.MinimumHeight, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,12,0">
                                    <TextBlock Text="{ui:Text 'Maximum height (mm)'}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="InspectionMaximumHeightInput" Text="{Binding SelectedPoint.Position.Bolt.MaximumHeight, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Width="180">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPoint.Position.Target}" Value="{x:Static device:TeachingTarget.BoltPosition}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedPoint.Position.Target}" Value="{x:Static device:TeachingTarget.BoltPreliminaryPosition}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{ui:Text 'Fastening start offset (mm)'}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBox x:Name="FasteningZOffsetInput" Text="{Binding SelectedPoint.FasteningZOffset, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                            </StackPanel>
                        </WrapPanel>
                        <Border Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                            IsEnabled="{Binding State.SetupEditingEnabled}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Target}" Value="{x:Static device:TeachingTarget.BoltPosition}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Target}" Value="{x:Static device:TeachingTarget.BoltPreliminaryPosition}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{ui:Text 'Z feed during fastening'}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid Width="320" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{ui:Text 'Distance (+mm)'}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FasteningFeedDistanceInput" ToolTip="{ui:Text '0 = no movement'}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="Text" Value="{Binding SelectedPoint.Position.Bolt.FeedDistance, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Target}" Value="{x:Static device:TeachingTarget.BoltPreliminaryPosition}">
                                                            <Setter Property="Text" Value="{Binding SelectedPoint.Position.Bolt.PreliminaryFeedDistance, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{ui:Text 'Time (s)'}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FasteningFeedSecondsInput">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="Text" Value="{Binding SelectedPoint.Position.Bolt.FeedSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Target}" Value="{x:Static device:TeachingTarget.BoltPreliminaryPosition}">
                                                            <Setter Property="Text" Value="{Binding SelectedPoint.Position.Bolt.PreliminaryFeedSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Row="1" Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,4">
                            <Button x:Name="LiveCameraButton" Command="{Binding ToggleLiveViewCommand}" Margin="0,0,8,4" MinWidth="118" Padding="12,7">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="IsEnabled" Value="{Binding IsToggleLiveViewAllowed}"/>
                                        <Setter Property="Content" Value="{ui:Text 'Start Live'}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Inspection.IsLiveView}" Value="True">
                                                <Setter Property="Content" Value="{ui:Text 'Stop Live'}"/>
                                                <Setter Property="Background" Value="{StaticResource DangerButtonBackgroundBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerButtonBorderBrush}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=LiveLightInput, Path=(Validation.HasError)}" Value="True"/>
                                                    <Condition Binding="{Binding Inspection.IsLiveView}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="StopInspectionTestButton" Content="{ui:Text 'Stop'}" Command="{Binding StopInspectionTestCommand}"
                                Style="{StaticResource DangerButtonStyle}" Visibility="{Binding IsInspectionTestRunning, Converter={StaticResource BoolToVis}}" Padding="14,6" Margin="0,0,8,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" IsEnabled="{Binding State.SetupEditingEnabled}">
                                <TextBlock Text="{ui:Text 'Light (0–255)'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="LiveLightInput" Width="55" Margin="0,0,8,0"
                                    Text="{Binding LiveLightLevel, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                <Button Content="{ui:Text 'Apply Light'}" Command="{Binding ApplyLightCommand}" Padding="12,7">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Setter Property="IsEnabled" Value="{Binding IsApplyLightAllowed}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=LiveLightInput, Path=(Validation.HasError)}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </WrapPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition>
                                    <ColumnDefinition.Style><Style TargetType="ColumnDefinition">
                                        <Setter Property="Width" Value="0"/>
                                        <Style.Triggers><MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsFiducialSelected}" Value="True"/>
                                                <Condition Binding="{Binding IsSelected, ElementName=InspectionIoTab}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Width" Value="2*"/>
                                        </MultiDataTrigger></Style.Triggers>
                                    </Style></ColumnDefinition.Style>
                                </ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TabControl x:Name="InspectionCameraTabs">
                                <TabItem x:Name="CameraTab" Tag="{Binding CameraImage}" Header="{ui:Text 'Camera'}">
                                    <Grid Background="{StaticResource ImageBackgroundBrush}" ClipToBounds="True">
                                        <ui:InspectionImageView x:Name="TeachingCameraView" Source="{Binding CameraImage}" ShowCrosshair="True"
                                            FiducialSearchSize="{Binding SelectedPoint.Fiducial.SearchSizePixels, Mode=OneWay}"
                                            ReferenceRadiusPixels="{Binding FiducialReferenceRadiusPixels}">
                                            <ui:InspectionImageView.Style>
                                                <Style TargetType="ui:InspectionImageView">
                                                    <Setter Property="DetectedFiducial" Value="{Binding DetectedFiducial}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Inspection.IsLiveView}" Value="True">
                                                            <Setter Property="DetectedFiducial" Value="{x:Null}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:InspectionImageView.Style>
                                        </ui:InspectionImageView>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Text" Value="{ui:Text 'No reference image'}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CameraImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Inspection.IsLiveView}" Value="True">
                                                            <Setter Property="Text" Value="{ui:Text 'Waiting for camera image'}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,2"
                                            Background="{StaticResource ControlBgBrush}" CornerRadius="3" IsHitTestVisible="False"
                                            Visibility="{Binding Inspection.IsLiveView, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="LIVE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                                        </Border>
                                    </Grid>
                                </TabItem>
                                <TabItem x:Name="CapturedTab" Tag="{Binding FiducialImage}" Header="{ui:Text 'Captured image'}" IsVisibleChanged="OnCapturedTabVisibilityChanged">
                                    <TabItem.Style>
                                        <Style TargetType="TabItem" BasedOn="{StaticResource SectionTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FiducialImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Inspection.IsLiveView}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TabItem.Style>
                                    <Border Background="{StaticResource ImageBackgroundBrush}">
                                        <ui:InspectionImageView x:Name="FiducialResultView" Source="{Binding FiducialImage}"
                                            FiducialSearchSize="{Binding SelectedPoint.Fiducial.SearchSizePixels, Mode=OneWay}"
                                            ReferenceRadiusPixels="{Binding FiducialReferenceRadiusPixels}"
                                            DetectedFiducial="{Binding DetectedFiducial}" ShowCrosshair="False" IsHitTestVisible="False"/>
                                    </Border>
                                </TabItem>
                                <TabItem x:Name="InspectionIoTab" Header="{ui:Text 'Related I/O'}">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IoStatusTemplate}"/>
                                </TabItem>
                            </TabControl>
                            <Grid Grid.Column="1" Margin="8,0,0,0" ClipToBounds="True" Visibility="{Binding IsFiducialSelected, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="{ui:Text 'Search area · binary'}" FontWeight="SemiBold" Padding="4,8" MinHeight="42"/>
                                <Border Grid.Row="1" Background="{StaticResource ImageBackgroundBrush}">
                                    <ui:InspectionImageView x:Name="BinaryPreview" ShowCrosshair="False" IsHitTestVisible="False"
                                        ReferenceRadiusPixels="{Binding FiducialReferenceRadiusPixels}" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                        <ui:InspectionImageView.Source>
                                            <MultiBinding Converter="{StaticResource FiducialBinaryConverter}" Mode="OneWay">
                                                <Binding ElementName="InspectionCameraTabs" Path="SelectedItem.Tag"/>
                                                <Binding Path="SelectedPoint.Fiducial.SearchSizePixels"/>
                                                <Binding Path="SelectedPoint.Fiducial.Threshold"/>
                                                <Binding Path="SelectedPoint.Fiducial.WhiteMark"/>
                                            </MultiBinding>
                                        </ui:InspectionImageView.Source>
                                    </ui:InspectionImageView>
                                </Border>
                            </Grid>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, ElementName=InspectionIoTab}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <StackPanel x:Name="FiducialPanel" Margin="0,8,0,0" Visibility="{Binding IsFiducialSelected, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding State.SetupEditingEnabled}">
                                    <WrapPanel Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                            <TextBlock Text="{ui:Text 'Threshold (0–255)'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Slider Width="88" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                                Value="{Binding SelectedPoint.Fiducial.Threshold, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{ui:Text 'Threshold (0–255)'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="FiducialThresholdInput" Width="50" Text="{Binding SelectedPoint.Fiducial.Threshold, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <CheckBox Content="{ui:Text 'White mark'}" IsChecked="{Binding SelectedPoint.Fiducial.WhiteMark, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                            <TextBlock Text="{ui:Text 'Search width (px)'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="FiducialSizeInput" Width="55" Text="{Binding SelectedPoint.Fiducial.SearchSizePixels, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                            <TextBlock Text="{ui:Text 'Reference diameter (mm)'}" Foreground="DeepSkyBlue" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="FiducialDiameterInput" Width="72" Text="{Binding FiducialReferenceDiameterMm, StringFormat={}{0:0.####}, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                            <TextBlock Text="{ui:Text 'Diameter tolerance (±%)'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="FiducialToleranceInput" Width="55" Text="{Binding SelectedPoint.Fiducial.SizeTolerancePercent, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                            <TextBlock Text="{ui:Text 'Maximum shape error'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="FiducialShapeInput" Width="65" Text="{Binding SelectedPoint.Fiducial.MaximumShapeError, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                            <TextBlock Text="{ui:Text 'Minimum match score'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="FiducialScoreInput" Width="55" Text="{Binding SelectedPoint.Fiducial.MinimumMatchScore, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel x:Name="FiducialActions" Margin="0,0,0,2">
                                        <WrapPanel.Style><Style TargetType="WrapPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=FiducialThresholdInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=FiducialSizeInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=FiducialShapeInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=FiducialScoreInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=FiducialToleranceInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=FiducialDiameterInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=LiveLightInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style></WrapPanel.Style>
                                        <Button Content="{ui:Text 'Register mark'}" Command="{Binding RegisterFiducialCommand}" IsEnabled="{Binding IsFiducialCaptureAllowed}"
                                            Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="0,0,8,4"/>
                                        <Button Content="{ui:Text 'Find mark'}" Command="{Binding FindFiducialCommand}" IsEnabled="{Binding IsFiducialCaptureAllowed}"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,8,4"/>
                                        <Button x:Name="CheckAlignmentButton" Content="{ui:Text 'Check both marks'}" Command="{Binding CheckAlignmentCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,8,4"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding FiducialRegistration}" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsHeightTestSelected, Converter={StaticResource BoolToVis}}" Margin="0,8,0,6">
                                    <WrapPanel Margin="0,2,0,10">
                                        <Button x:Name="TeachingProbeButton" Command="{Binding InspectionProbe.ToggleOutputCommand}" MinWidth="96" Padding="12,7" Margin="0,0,14,0">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="IsEnabled" Value="{Binding InspectionProbe.IsToggleOutputAllowed}"/>
                                                <Setter Property="Content" Value="{ui:Text 'Lower LVDT'}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InspectionProbe.Io.IsOn}" Value="True"><Setter Property="Content" Value="{ui:Text 'Raise LVDT'}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding InspectionProbe.Io.IsOn}" Value="{x:Null}">
                                                        <Setter Property="Content" Value="{ui:Text 'LVDT unknown'}"/><Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style></Button.Style>
                                        </Button>
                                        <TextBlock Text="{ui:Text 'Up'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Tag="{Binding InspectionProbe.Io.Feedback[1].IsOn}" Text="{Binding InspectionProbe.Io.Feedback[1].IsOn, Converter={StaticResource SignalTextConverter}}"
                                            Style="{StaticResource IoInputStateStyle}" MinWidth="36" MinHeight="26" Padding="4" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{ui:Text 'Down'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Tag="{Binding InspectionProbe.Io.Feedback[0].IsOn}" Text="{Binding InspectionProbe.Io.Feedback[0].IsOn, Converter={StaticResource SignalTextConverter}}"
                                            Style="{StaticResource IoInputStateStyle}" MinWidth="36" MinHeight="26" Padding="4" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <Button x:Name="MeasureHeightButton" Command="{Binding MeasureHeightCommand}"
                                        HorizontalAlignment="Left" Padding="12,7"
                                        ToolTip="{ui:Text 'Move to the selected point and measure; bolts measure all three references first'}">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Setter Property="Content" Value="{ui:Text 'Test height'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MeasureHeightCommand.IsRunning}" Value="True"><Setter Property="Content" Value="{ui:Text 'Measuring'}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=InspectionMinimumHeightInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=InspectionMaximumHeightInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style></Button.Style>
                                    </Button>
                                    <TextBlock Text="{ui:Text 'Three references → selected bolt'}" Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPoint.Position.Bolt}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <ContentPresenter Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource IoStatusTemplate}">
                        <ContentPresenter.Style>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInspectionSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentPresenter.Style>
                    </ContentPresenter>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <ui:RecordPositionButton Content="{ui:Text 'Update inspection XY'}" Command="{Binding RecordInspectionBoltPositionCommand}"
                            ToolTip="{ui:Text 'Check both marks before updating inspection XY'}" ToolTipService.ShowOnDisabled="True"
                            IsEnabled="{Binding IsRecordInspectionBoltPositionAllowed}" Padding="12,8" Margin="0,0,8,0">
                            <ui:RecordPositionButton.Style>
                                <Style TargetType="ui:RecordPositionButton" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Target}" Value="{x:Static device:TeachingTarget.BoltReference}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:RecordPositionButton.Style>
                        </ui:RecordPositionButton>
                        <ui:RecordPositionButton Command="{Binding TeachCurrentPositionCommand}"
                            MinWidth="150" Padding="12,8" Margin="0,0,8,0">
                            <ui:RecordPositionButton.Style>
                                <Style TargetType="ui:RecordPositionButton" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="IsEnabled" Value="{Binding IsTeachCurrentPositionAllowed}"/>
                                    <Setter Property="Content" Value="{ui:Text 'Record Position'}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFiducialSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Mode}" Value="{x:Static device:TeachMode.Full}">
                                            <Setter Property="Content" Value="{ui:Text 'Record X/Y/Z'}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Mode}" Value="{x:Static device:TeachMode.XYOnly}">
                                            <Setter Property="Content" Value="{ui:Text 'Record X/Y'}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Mode}" Value="{x:Static device:TeachMode.ZOnly}">
                                            <Setter Property="Content" Value="{ui:Text 'Record Z'}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedPoint.Position.Mode}" Value="{x:Static device:TeachMode.Image}">
                                            <Setter Property="Content" Value="{ui:Text 'Update Image + Light'}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=LiveLightInput, Path=(Validation.HasError)}" Value="True"/>
                                                <Condition Binding="{Binding SelectedPoint.Position.Mode}" Value="{x:Static device:TeachMode.Image}"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:RecordPositionButton.Style>
                        </ui:RecordPositionButton>
                        <ui:MoveToPositionButton Content="{ui:Text 'Move to Selected Point'}" Command="{Binding MoveToPointCommand}" MinWidth="150" Padding="12,8">
                            <ui:MoveToPositionButton.Style>
                                <Style TargetType="ui:MoveToPositionButton" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="IsEnabled" Value="{Binding IsMoveToPointAllowed}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=FasteningZOffsetInput, Path=(Validation.HasError)}" Value="True"/>
                                                <Condition Binding="{Binding SelectedPoint.Position.Target}" Value="{x:Static device:TeachingTarget.BoltPosition}"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:MoveToPositionButton.Style>
                        </ui:MoveToPositionButton>
                    </WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ui:TeachingMotionView/>
                            <Button Content="{ui:Text 'Safe Z → Raise Pickup Head'}" Command="{Binding ReturnFromPickupCommand}" IsEnabled="{Binding IsReturnFromPickupAllowed}"
                                Margin="0,8,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="{Binding IsFasteningSelected, Converter={StaticResource BoolToVis}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveMotionGroup}" Value="{x:Static core:MotionGroup.BoltFasteningBackup}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" Style="{StaticResource MessageAreaStyle}" Height="42">
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource AccentAmberBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusMessageStyle}">
                                    <Setter Property="Text" Value="{Binding HomeBlock, Converter={StaticResource UiTextConverter}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HomeBlock}" Value="{x:Static machine:HomeBlockReason.None}">
                                            <Setter Property="Text" Value="{Binding MotionHint, Converter={StaticResource UiTextConverter}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ManualBlock}" Value="{x:Static ui:ManualControlBlock.AutoMode}">
                                            <Setter Property="Text" Value="{Binding ManualBlock, Converter={StaticResource UiTextConverter}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ManualBlock}" Value="{x:Static ui:ManualControlBlock.Busy}">
                                            <Setter Property="Text" Value="{Binding ManualBlock, Converter={StaticResource UiTextConverter}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="2" Height="42" Style="{StaticResource MessageAreaStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource ErrorStatusMessageStyle}" Text="{ui:Text 'Check the highlighted input.'}"
                    Visibility="{Binding ElementName=TeachingRoot, Path=(Validation.HasError), Converter={StaticResource BoolToVis}}"/>
                <TextBlock Style="{StaticResource ErrorStatusMessageStyle}" Text="{Binding SaveError}"/>
                <TextBlock Style="{StaticResource ErrorStatusMessageStyle}" Text="{Binding CameraError}"/>
                <TextBlock Text="{Binding FiducialMessage}" Style="{StaticResource StatusMessageStyle}"/>
                <TextBlock x:Name="HeightTestResultText" Text="{Binding HeightTestResult}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding HeightTestResult}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding HeightTestSuccess}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding HeightTestSuccess}" Value="False"><Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock x:Name="AlignmentTestResultText" Text="{Binding AlignmentTestResult}" TextWrapping="Wrap" Margin="0,0,0,6">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding AlignmentTestResult}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding InspectionTestMessage}" Style="{StaticResource StatusMessageStyle}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="InspectionTestErrorText" Text="{Binding InspectionTestError}" TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}" Margin="0,0,0,6">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding InspectionTestError}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
