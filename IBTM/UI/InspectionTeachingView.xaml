<UserControl x:Class="IBTM.UI.InspectionTeachingView" x:Name="EditorRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:storage="clr-namespace:IBTM.Storage;assembly=IBTM.Storage"
    mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=ui:InspectionTeachingViewModel, IsDesignTimeCreatable=False}"
    Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource AppBgBrush}"
    Validation.ErrorTemplate="{x:Null}">
    <UserControl.BindingGroup><BindingGroup Name="InspectionInputs"/></UserControl.BindingGroup>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsIdle}">
                <ComboBox ItemsSource="{Binding RecipeNames}" SelectedItem="{Binding SelectedRecipeName, BindingGroupName={x:Null}}"
                    Width="180" Margin="0,0,8,0"/>
                <Button Content="Load Recipe" Command="{Binding LoadRecipeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Save Inspection Settings" Command="{Binding SaveCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoaded}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=EditorRoot, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <TextBlock Text="Inspection Setup" Style="{StaticResource TitleStyle}"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,10,0">
                <TabControl Style="{StaticResource SectionTabs}" ItemContainerStyle="{StaticResource SectionTab}">
                    <TabItem Header="Taught points">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Draft.Name}" Style="{StaticResource PanelTitleStyle}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint, BindingGroupName={x:Null}}"
                                IsEnabled="{Binding IsIdle}" ItemContainerStyle="{StaticResource FlatListItemStyle}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                Background="{StaticResource EquipBgBrush}" BorderThickness="0">
                                <ListBox.ItemTemplate><DataTemplate DataType="{x:Type ui:InspectionPoint}">
                                    <StackPanel Margin="4,7"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding PositionLabel}" TextWrapping="Wrap"
                                            Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Saved results">
                        <Grid IsEnabled="{Binding IsIdle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1.2*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Results folder" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding HistoryDirectory, UpdateSourceTrigger=LostFocus}" Height="30"/>
                                <UniformGrid Columns="2" Margin="0,6,0,0">
                                    <Button Content="Refresh List" Command="{Binding RefreshHistoryCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" Margin="0,0,3,0"/>
                                    <Button Content="Load Older" Command="{Binding LoadOlderCommand}" IsEnabled="{Binding HasOlder}"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" Margin="3,0,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Records}"
                                SelectedItem="{Binding SelectedRecord, BindingGroupName={x:Null}}"
                                ItemContainerStyle="{StaticResource FlatListItemStyle}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                Background="{StaticResource EquipBgBrush}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type storage:PcbRecord}">
                                        <StackPanel Margin="4,5">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding InspectionResult}" FontSize="12" Margin="6,0,0,0"/>
                                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                    <Run Text="PCB "/><Run Text="{Binding Number, Mode=OneWay}"/>
                                                    <Run Text=" · "/><Run Text="{Binding HeatSink, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}}"/>
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding RecipeName}"
                                                Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0">
                                                <Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}}"/>
                                                <Run Text=" · "/><Run Text="{Binding RecipeName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="0,6,0,6">
                                <Button Content="Load PCB Images" Command="{Binding LoadRecordCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="8,5"/>
                                <TextBlock Text="{Binding LoadedRecord.Number, StringFormat='PCB {0} · images', TargetNullValue='No PCB loaded', FallbackValue='No PCB loaded'}"
                                    FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                            </StackPanel>
                            <ListBox Grid.Row="3" ItemsSource="{Binding HistoryImages}"
                                SelectedItem="{Binding SelectedHistoryImage, BindingGroupName={x:Null}}"
                                ItemContainerStyle="{StaticResource FlatListItemStyle}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                Background="{StaticResource EquipBgBrush}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:PcbInspectionImageItem}">
                                        <Grid Margin="4,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Image Source="{Binding Image}" Width="48" Height="40" Stretch="Uniform"/>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}">
                                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                                    <Run Text=" · "/><Run Text="{Binding Verdict, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"
                                                    FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource AccentAmberBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="4" Content="Load for Reinspection" Command="{Binding UseHistoryImageCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="8,6" Margin="0,8,0,0"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <WrapPanel IsEnabled="{Binding IsIdle}">
                            <Button Content="Inspect This Image" Command="{Binding InspectCommand}" Margin="0,0,8,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=EditorRoot, Path=(Validation.HasError)}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Show Reference Image" Command="{Binding ShowRecipeImageCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ImageSource}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ImageSource}"/>
                        <TextBlock Text="{Binding OriginalResult}" Style="{StaticResource StatusMessageStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalResult}"
                            Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                        <StackPanel IsEnabled="{Binding IsIdle}" Margin="0,8,0,0">
                            <TextBlock Text="Reference image unavailable" Foreground="{StaticResource AccentAmberBrush}" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPoint.Metadata}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <WrapPanel Visibility="{Binding IsDataMatrixSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Data Matrix" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox Content="Extended search" IsChecked="{Binding DataMatrix.TryHarder, BindingGroupName={x:Null}}"
                                    VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox Content="Inverted colors" IsChecked="{Binding DataMatrix.TryInverted, BindingGroupName={x:Null}}"
                                    VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox Content="Rotation" IsChecked="{Binding DataMatrix.AutoRotate, BindingGroupName={x:Null}}"
                                    VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox Content="Pure barcode" IsChecked="{Binding DataMatrix.PureBarcode, BindingGroupName={x:Null}}"
                                    VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Binary (0–255; blank = auto)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="70" Text="{Binding Preview.DataMatrixThreshold, BindingGroupName=InspectionInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPoint.Bolt, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <TextBlock Text="Bolt presence" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                    <TextBlock Text="Threshold (0–255)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="70" Text="{Binding Preview.BrightnessThreshold, BindingGroupName=InspectionInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Minimum bright (%)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="70" Text="{Binding Preview.MinimumBrightPercent, BindingGroupName=InspectionInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Original · edit ROI" FontWeight="SemiBold" Margin="0,0,6,6"/>
                        <TextBlock Grid.Column="1" Text="{Binding Preview.BinaryDescription}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="6,0,0,6"/>
                        <Border Grid.Row="1" Background="{StaticResource ImageBackgroundBrush}" Margin="0,0,6,0">
                            <ui:InspectionImageView x:Name="InspectionImage" Source="{Binding Preview.Image}"
                                SourceRegion="{Binding Preview.Region}" RegionCommand="{Binding DrawRegionCommand}"
                                IsEnabled="{Binding IsIdle}" ShowCrosshair="True" Cursor="Cross"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource ImageBackgroundBrush}" Margin="6,0,0,0">
                            <ui:InspectionImageView Source="{Binding Preview.Image}" SourceRegion="{Binding Preview.Region}"
                                SourceOverlay="{Binding Preview.Overlay}" ShowCrosshair="False"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Style="{StaticResource StatusMessageStyle}" Margin="0,8,0,0" Text="{Binding Preview.Result}" FontWeight="SemiBold" FontSize="17"
                        TextTrimming="CharacterEllipsis" ToolTip="{Binding Preview.Result}"/>
                </Grid>
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="2" MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Check the highlighted input."
                    Style="{StaticResource StatusMessageStyle}"
                    Visibility="{Binding ElementName=EditorRoot, Path=(Validation.HasError), Converter={StaticResource BoolToVis}}"
                    TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}"/>
                <TextBlock Text="{Binding Error}" Style="{StaticResource StatusMessageStyle}" Foreground="{StaticResource AccentRedBrush}"/>
                <TextBlock Text="{Binding Message}" Style="{StaticResource StatusMessageStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
