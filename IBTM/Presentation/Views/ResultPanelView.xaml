<UserControl x:Class="IBTM.Presentation.Views.ResultPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}">
    <StackPanel Margin="12,10">
        <Border CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                Background="{StaticResource EquipBgBrush}" Height="120" Margin="0,0,0,6"
                HorizontalAlignment="Stretch" ClipToBounds="True">
            <Grid>
                <Image Source="{Binding InspectionImage}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock Text="INSPECT" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InspectionImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Width="68" Height="28" CornerRadius="6" Margin="0,0,6,6"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGoodPath}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Background" Value="#DD102A10"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNgPath}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Background" Value="#DD2A1010"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding LastRouteText}" FontSize="14" FontWeight="Bold" FontFamily="Consolas"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGoodPath}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNgPath}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <Grid Margin="0,2,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Pcb1InspectionResult}" FontSize="10" FontFamily="Consolas"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Grid.Column="1" Text="{Binding Pcb2InspectionResult}" FontSize="10"
                       FontFamily="Consolas" HorizontalAlignment="Right"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Grid>

        <TextBlock Text="NG STACK" Style="{StaticResource SectionHeaderStyle}"
                   Foreground="{StaticResource AccentRedBrush}" Margin="0,6,0,4" Opacity="0.8"/>
        <ProgressBar Height="8" Minimum="0"
                     Maximum="{Binding NgStackMaxCount}"
                     Value="{Binding NgStackCount}"
                     Foreground="{StaticResource AccentRedBrush}"
                     Background="{StaticResource EquipBgBrush}"/>
        <TextBlock FontFamily="Consolas" FontSize="10" FontWeight="Bold" Margin="0,3,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NgStackAlarm}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            <Run Text="{Binding NgStackCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding NgStackMaxCount, Mode=OneWay}"/>
        </TextBlock>

        <TextBlock FontSize="10" FontWeight="SemiBold" Margin="0,14,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="SMEMA  OUT"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SmemaWaiting}" Value="True">
                            <Setter Property="Text" Value="SMEMA  WAIT"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SmemaReady}" Value="True">
                            <Setter Property="Text" Value="SMEMA  OK"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

    </StackPanel>
    </Border>
</UserControl>
