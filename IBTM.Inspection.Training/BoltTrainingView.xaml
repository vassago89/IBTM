<UserControl x:Class="IBTM.Inspection.Training.BoltTrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:training="clr-namespace:IBTM.Inspection.Training"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=training:BoltTrainingViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <Style x:Key="ReviewContentStyle" TargetType="{x:Type FrameworkElement}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Review}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Bolt Training"
                   Style="{StaticResource TitleStyle}"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1"
              MaxWidth="1600"
              HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Label Bolt Recess"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Left drag to mark · Right drag to erase"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="{Binding LabelImageName}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       MaxWidth="260"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right"/>
                            <TextBlock HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="{Binding LabelImageNumber}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding SelectedImageCount}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{StaticResource ImageBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                             Padding="4">
                        <training:BoltMaskEditor x:Name="MaskEditor"
                                                 Source="{Binding LabelImage}"
                                                 BrushSize="6"
                                                 MinHeight="420"/>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Capture Taught Points"
                                    Command="{Binding CaptureBoltPointsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="156"
                                    Margin="0,0,8,0"/>
                            <Button Content="Add Images"
                                    Command="{Binding AddImagesCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="18,0,18,0">
                            <TextBlock Text="BRUSH SIZE"
                                       Style="{StaticResource SectionHeaderStyle}"/>
                            <Slider Minimum="1"
                                    Maximum="20"
                                    Value="{Binding BrushSize, ElementName=MaskEditor}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Clear Mask"
                                Click="ClearMask"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="No Bolt &amp; Next"
                                    Command="{Binding EmptyLabelCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="116"
                                    Margin="0,0,8,0"/>
                            <Button Content="Save Mask &amp; Next"
                                    Command="{Binding CompleteLabelCommand}"
                                    CommandParameter="{Binding Mask, ElementName=MaskEditor}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="132"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <TextBlock Text="Training"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="{Binding State, Converter={StaticResource EnumDescriptionConverter}}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>

                        <TextBlock Text="Dataset Folder"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,5"/>
                        <Grid IsEnabled="{Binding DatasetEditingEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DatasetDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldTextBoxStyle}"/>
                            <Button Grid.Column="1"
                                    Content="Browse"
                                    Command="{Binding SelectDatasetCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel IsEnabled="{Binding ConfigurationEnabled}">
                                <TextBlock Text="Epochs"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Epochs, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom">
                                <Button Content="Train"
                                        Command="{Binding TrainCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="88"
                                        Margin="0,0,8,0"/>
                                <Button Content="Cancel"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        MinWidth="88"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar Minimum="0"
                                     Maximum="{Binding Epochs}"
                                     Value="{Binding Epoch}"
                                     Height="8"
                                     Margin="0,22,0,16"/>

                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock Text="EPOCH"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBlock FontSize="17"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="{Binding Epoch}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding Epochs}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="TRAIN LOSS"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBlock Text="{Binding TrainingLoss, StringFormat={}{0:F4}}"
                                           FontSize="17"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="VALID LOSS"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBlock Text="{Binding ValidationLoss, StringFormat={}{0:F4}}"
                                           FontSize="17"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="{Binding Error}"
                                   Foreground="{StaticResource AccentRedBrush}"
                                   Margin="0,16,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Padding="16">
                    <Border.Style>
                        <Style TargetType="Border"
                               BasedOn="{StaticResource CardStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Review}" Value="{x:Null}">
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Model Review"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel HorizontalAlignment="Right"
                                        Style="{StaticResource ReviewContentStyle}">
                                <TextBlock FontSize="16"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Right">
                                    <Run Text="{Binding Review.ImageNumber}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding Review.ImageCount}"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right">
                                    <Run Text="{Binding Review.CorrectCount}"/>
                                    <Run Text=" matched"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,18,0,16"
                              Style="{StaticResource ReviewContentStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="200"
                                    Height="200"
                                    Background="{StaticResource ImageBackgroundBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <Image Source="{Binding Review.Image}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <UniformGrid Columns="3"
                                             Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="EXPECTED"
                                                   Style="{StaticResource SectionHeaderStyle}"/>
                                        <TextBlock Text="{Binding Review.Expected, Converter={StaticResource EnumDescriptionConverter}}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="DETECTED"
                                                   Style="{StaticResource SectionHeaderStyle}"/>
                                        <TextBlock Text="{Binding Review.Result, Converter={StaticResource EnumDescriptionConverter}}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="MASK AREA"
                                                   Style="{StaticResource SectionHeaderStyle}"/>
                                        <TextBlock Text="{Binding Review.MaskRatioPercent, StringFormat={}{0:F3}%}"
                                                   FontSize="18"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="{Binding Review.Outcome, Converter={StaticResource EnumDescriptionConverter}}"
                                           FontSize="20"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource AccentGreenBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Review.Outcome}"
                                                             Value="{x:Static training:BoltValidationOutcome.Mismatch}">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource AccentRedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2"
                              Style="{StaticResource ReviewContentStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Previous"
                                        Command="{Binding Review.PreviousCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="88"
                                        Margin="0,0,8,0"/>
                                <Button Content="Next"
                                        Command="{Binding Review.NextCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="88"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
