<UserControl x:Class="IBTM.UI.MachineDiagramView" x:Name="Diagram"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI" xmlns:app="clr-namespace:IBTM"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <Style x:Key="StartCheckOutline" TargetType="Border">
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static app:StartCheckState.Disabled}">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static app:StartCheckState.MaterialRemaining}">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static app:StartCheckState.UnfinishedCarrier}">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static app:StartCheckState.NgGripperCheckRequired}">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static app:StartCheckState.Unknown}">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static app:StartCheckState.Completed}">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static app:StartCheckState.HandoffReady}">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static app:StartCheckState.ReworkReady}">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StartAreaTarget" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="3" CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#305E9BC6"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Canvas Width="1600" Height="{x:Static ui:MachineDiagramLayout.PlanHeight}">
            <Canvas Width="1600" Height="{x:Static ui:MachineDiagramLayout.PlanHeight}">
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowStartCheck, ElementName=Diagram}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="False"/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
            <ui:NgConveyorDiagram Canvas.Left="{x:Static ui:MachineDiagramLayout.InspectionLeft}" Canvas.Top="0" Panel.ZIndex="-10"/>
            <ui:MainConveyorDiagram Canvas.Left="{x:Static ui:MachineDiagramLayout.MainLeft}" Canvas.Top="{x:Static ui:MachineDiagramLayout.MainTop}"
                Panel.ZIndex="0"/>
            <ui:PcbTransferDiagram Canvas.Left="{x:Static ui:MachineDiagramLayout.MainLeft}" Canvas.Top="0" Panel.ZIndex="10"/>
            <ui:BoltFasteningDiagram Canvas.Left="{x:Static ui:MachineDiagramLayout.FasteningLeft}" Canvas.Top="0" Panel.ZIndex="10"/>
            <ui:InspectionStationDiagram Canvas.Left="{x:Static ui:MachineDiagramLayout.InspectionLeft}" Canvas.Top="0" Panel.ZIndex="10"/>
            </Canvas>

            <Canvas Panel.ZIndex="90" IsHitTestVisible="False">
                <Canvas Canvas.Left="{x:Static ui:MachineDiagramLayout.MainLeft}">
                    <Border Canvas.Left="{x:Static ui:MachineDiagramLayout.HeaderInset}" Canvas.Top="{x:Static ui:MachineDiagramLayout.StatusTop}" Width="{x:Static ui:MachineDiagramLayout.SupplyRailWidth}" Height="54">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AlarmOutlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SupplyDisplayState}" Value="{x:Static ui:HandlerDisplayState.IoAlarm}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Canvas.Left="{x:Static ui:MachineDiagramLayout.PlacementStatusLeft}" Canvas.Top="{x:Static ui:MachineDiagramLayout.StatusTop}" Width="{x:Static ui:MachineDiagramLayout.SupplyRailWidth}" Height="54">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AlarmOutlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementDisplayState}" Value="{x:Static ui:HandlerDisplayState.IoAlarm}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Canvas>
                <Canvas Canvas.Left="{x:Static ui:MachineDiagramLayout.FasteningLeft}">
                    <Border Canvas.Left="{x:Static ui:MachineDiagramLayout.HeaderInset}" Canvas.Top="{x:Static ui:MachineDiagramLayout.StatusTop}" Width="{x:Static ui:MachineDiagramLayout.PlateWidth}" Height="54">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AlarmOutlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoltDisplayState}" Value="{x:Static ui:StationDisplayState.IoAlarm}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Canvas.Left="{x:Static ui:MachineDiagramLayout.HeaderInset}" Canvas.Top="342" Width="{x:Static ui:MachineDiagramLayout.PlateWidth}" Height="{x:Static ui:MachineDiagramLayout.PickupFeederHeight}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AlarmOutlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Alarm}" Value="{x:Static app:MachineAlarm.PickupBoltFeeder}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Canvas.Top="192" Width="{x:Static ui:MachineDiagramLayout.PlateWidth}" Height="138">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AlarmOutlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Alarm}" Value="{x:Static app:MachineAlarm.ShootingBoltFeeder}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Canvas>
                <Canvas Canvas.Left="{x:Static ui:MachineDiagramLayout.InspectionLeft}">
                    <Border Canvas.Left="{x:Static ui:MachineDiagramLayout.HeaderInset}" Canvas.Top="{x:Static ui:MachineDiagramLayout.StatusTop}" Width="{x:Static ui:MachineDiagramLayout.PlateWidth}" Height="54">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AlarmOutlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InspectionDisplayState}" Value="{x:Static ui:StationDisplayState.IoAlarm}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Canvas>
                <Border Canvas.Left="{x:Static ui:MachineDiagramLayout.MainLeft}" Canvas.Top="{x:Static ui:MachineDiagramLayout.MainTop}" Width="1552" Height="200">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource AlarmOutlineStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Alarm}" Value="{x:Static app:MachineAlarm.MainConveyor}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Canvas>


            <Canvas Panel.ZIndex="100"
                Visibility="{Binding ShowStartCheck, ElementName=Diagram, Converter={StaticResource BoolToVis}}">
                <Canvas Canvas.Left="{x:Static ui:MachineDiagramLayout.MainLeft}">
                    <Border Tag="{Binding Machine.StartChecks[Supply]}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StartCheckOutline}">
                                <Setter Property="Width" Value="{x:Static ui:MachineDiagramLayout.SupplyWidth}"/>
                                <Setter Property="Height" Value="{x:Static ui:MachineDiagramLayout.SupplyHeight}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="{Binding PcbSupplyMapPosition.X, TargetNullValue=0, FallbackValue=0}"
                                            Y="{Binding PcbSupplyMapPosition.Y, TargetNullValue=0, FallbackValue=0}"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SupplyPositionKnown}" Value="False">
                                        <Setter Property="Width" Value="{x:Static ui:MachineDiagramLayout.SupplyRailWidth}"/>
                                        <Setter Property="Height" Value="54"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value><TranslateTransform X="{x:Static ui:MachineDiagramLayout.HeaderInset}" Y="{x:Static ui:MachineDiagramLayout.StatusTop}"/></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding SelectStartAreaCommand}" CommandParameter="{x:Static app:StartArea.Supply}"
                            AutomationProperties.Name="{Binding Source={x:Static app:StartArea.Supply}, Converter={StaticResource UiTextConverter}}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StartAreaTarget}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedStartArea}" Value="{x:Static app:StartArea.Supply}">
                                    <Setter Property="Background" Value="#305E9BC6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </Border>
                    <Border Tag="{Binding Machine.StartChecks[Placement]}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StartCheckOutline}">
                                <Setter Property="Width" Value="{x:Static ui:MachineDiagramLayout.PlacementWidth}"/>
                                <Setter Property="Height" Value="{x:Static ui:MachineDiagramLayout.PlacementHeight}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="{Binding PcbPlacementMapPosition.X, TargetNullValue=0, FallbackValue=0}"
                                            Y="{Binding PcbPlacementMapPosition.Y, TargetNullValue=0, FallbackValue=0}"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementPositionKnown}" Value="False">
                                        <Setter Property="Width" Value="{x:Static ui:MachineDiagramLayout.SupplyRailWidth}"/>
                                        <Setter Property="Height" Value="54"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value><TranslateTransform X="{x:Static ui:MachineDiagramLayout.PlacementStatusLeft}" Y="{x:Static ui:MachineDiagramLayout.StatusTop}"/></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding SelectStartAreaCommand}" CommandParameter="{x:Static app:StartArea.Placement}"
                            AutomationProperties.Name="{Binding Source={x:Static app:StartArea.Placement}, Converter={StaticResource UiTextConverter}}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StartAreaTarget}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedStartArea}" Value="{x:Static app:StartArea.Placement}">
                                    <Setter Property="Background" Value="#305E9BC6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </Border>
                </Canvas>
                <Canvas Canvas.Left="{x:Static ui:MachineDiagramLayout.FasteningLeft}">
                    <Border Tag="{Binding Machine.StartChecks[ShootingHead]}"
                        Width="{x:Static ui:MachineDiagramLayout.PlateWidth}"
                        Height="{x:Static ui:MachineDiagramLayout.ControllerRowHeight}"
                        BorderThickness="2" Style="{StaticResource StartCheckOutline}">
                        <Border.RenderTransform>
                            <TranslateTransform X="{x:Static ui:MachineDiagramLayout.HeaderInset}"
                                Y="{x:Static ui:MachineDiagramLayout.ShootingControllerRowTop}"/>
                        </Border.RenderTransform>
                        <Button Command="{Binding SelectStartAreaCommand}" CommandParameter="{x:Static app:StartArea.ShootingHead}"
                            AutomationProperties.Name="{Binding Source={x:Static app:StartArea.ShootingHead}, Converter={StaticResource UiTextConverter}}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StartAreaTarget}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedStartArea}" Value="{x:Static app:StartArea.ShootingHead}">
                                    <Setter Property="Background" Value="#305E9BC6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </Border>
                </Canvas>
                <Canvas Canvas.Left="{x:Static ui:MachineDiagramLayout.MainLeft}" Canvas.Top="{x:Static ui:MachineDiagramLayout.MainTop}">
                    <Border Canvas.Left="{x:Static ui:MachineDiagramLayout.PlacementCarrierLeft}" Canvas.Top="{x:Static ui:MachineDiagramLayout.CarrierTop}"
                        Width="{x:Static ui:MachineDiagramLayout.CarrierWidth}" Height="{x:Static ui:MachineDiagramLayout.CarrierHeight}"
                        Tag="{Binding Machine.StartChecks[Station1]}" Style="{StaticResource StartCheckOutline}">
                        <Button Command="{Binding SelectStartAreaCommand}" CommandParameter="{x:Static app:StartArea.Station1}"
                            AutomationProperties.Name="{Binding Source={x:Static app:StartArea.Station1}, Converter={StaticResource UiTextConverter}}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StartAreaTarget}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedStartArea}" Value="{x:Static app:StartArea.Station1}">
                                    <Setter Property="Background" Value="#305E9BC6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </Border>
                    <Border Canvas.Left="{x:Static ui:MachineDiagramLayout.FasteningCarrierLeft}" Canvas.Top="{x:Static ui:MachineDiagramLayout.CarrierTop}"
                        Width="{x:Static ui:MachineDiagramLayout.CarrierWidth}" Height="{x:Static ui:MachineDiagramLayout.CarrierHeight}"
                        Tag="{Binding Machine.StartChecks[Station2]}" Style="{StaticResource StartCheckOutline}">
                        <Button Command="{Binding SelectStartAreaCommand}" CommandParameter="{x:Static app:StartArea.Station2}"
                            AutomationProperties.Name="{Binding Source={x:Static app:StartArea.Station2}, Converter={StaticResource UiTextConverter}}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StartAreaTarget}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedStartArea}" Value="{x:Static app:StartArea.Station2}">
                                    <Setter Property="Background" Value="#305E9BC6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </Border>
                    <ListBox x:Name="ReviewBoltMap" Canvas.Left="{x:Static ui:MachineDiagramLayout.FasteningCarrierLeft}"
                        Canvas.Top="{x:Static ui:MachineDiagramLayout.CarrierTop}"
                        Width="{x:Static ui:MachineDiagramLayout.CarrierWidth}" Height="{x:Static ui:MachineDiagramLayout.CarrierHeight}"
                        IsHitTestVisible="False" Focusable="False" IsSynchronizedWithCurrentItem="False"
                        SelectedItem="{Binding SelectedReviewBolt, ElementName=Diagram, Mode=OneWay}">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></Setter.Value></Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowStartCheck, ElementName=Diagram}" Value="True">
                                        <Setter Property="ItemsSource" Value="{Binding FasteningResumeBolts}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Canvas.Left" Value="{Binding MarkerPosition.X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding MarkerPosition.Y}"/>
                                <Setter Property="Visibility" Value="{Binding HeatSinkPresence.IsOn, Converter={StaticResource BoolToVis}}"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Width" Value="{x:Static ui:MachineDiagramLayout.BoltMarkerSize}"/>
                                <Setter Property="Height" Value="{x:Static ui:MachineDiagramLayout.BoltMarkerSize}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Ellipse x:Name="Ring" StrokeThickness="3"/>
                                                <Ellipse x:Name="Bolt" Margin="3" Fill="{StaticResource ControlBgBrush}" Stroke="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Order}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Result.Success}" Value="True"><Setter TargetName="Bolt" Property="Stroke" Value="{StaticResource AccentGreenBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Result.IsComplete}" Value="False"><Setter TargetName="Bolt" Property="Stroke" Value="{StaticResource AccentAmberBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Result.Success}" Value="False"><Setter TargetName="Bolt" Property="Stroke" Value="{StaticResource AccentRedBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Result.Source}" Value="{x:Static core:BoltResultSource.DryRun}"><Setter TargetName="Bolt" Property="Stroke" Value="{StaticResource AccentRedBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Result.Source}" Value="{x:Static core:BoltResultSource.Interrupted}"><Setter TargetName="Bolt" Property="Stroke" Value="{StaticResource AccentRedBrush}"/></DataTrigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBlueBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MarkerPosition}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Panel.ZIndex" Value="1"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <Border Canvas.Left="{x:Static ui:MachineDiagramLayout.InspectionCarrierLeft}" Canvas.Top="{x:Static ui:MachineDiagramLayout.CarrierTop}"
                        Width="{x:Static ui:MachineDiagramLayout.CarrierWidth}" Height="{x:Static ui:MachineDiagramLayout.CarrierHeight}"
                        Tag="{Binding Machine.StartChecks[Station3]}" Style="{StaticResource StartCheckOutline}">
                        <Button Command="{Binding SelectStartAreaCommand}" CommandParameter="{x:Static app:StartArea.Station3}"
                            AutomationProperties.Name="{Binding Source={x:Static app:StartArea.Station3}, Converter={StaticResource UiTextConverter}}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StartAreaTarget}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedStartArea}" Value="{x:Static app:StartArea.Station3}">
                                    <Setter Property="Background" Value="#305E9BC6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </Border>
                </Canvas>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
