<UserControl x:Class="IBTM.UI.TeachingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBgBrush}"
             Loaded="OnLoaded" Unloaded="OnUnloaded">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Station Teaching" Style="{StaticResource TitleStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="272"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" Background="{StaticResource EquipBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding LiveImage}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           MouseLeftButtonDown="CameraImage_Click"/>
                    <Border Width="1" HorizontalAlignment="Center"
                            Background="{StaticResource AccentBrush}"
                            IsHitTestVisible="False" Opacity="0.35"/>
                    <Border Height="1" VerticalAlignment="Center"
                            Background="{StaticResource AccentBrush}"
                            IsHitTestVisible="False" Opacity="0.35"/>
                    <TextBlock Text="CAMERA" FontSize="16" FontFamily="Consolas"
                               Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCameraLive}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Command="{Binding ToggleLiveViewCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"
                            Style="{StaticResource SecondaryButtonStyle}" MinWidth="70" Opacity="0.8">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Live ON"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCameraLive}" Value="True">
                                                <Setter Property="Text" Value="Live OFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="Unit"
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Units}"
                                  SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                                  Padding="8,5"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="Current Position"
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <TextBlock FontFamily="Consolas" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="X: "/><Run Text="{Binding CurrentX, StringFormat=F3}"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="Y: "/><Run Text="{Binding CurrentY, StringFormat=F3}"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="Z: "/><Run Text="{Binding CurrentZ, StringFormat=F3}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel>
                        <TextBlock Text="JOG" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="1" Content="Y+" Style="{StaticResource SecondaryButtonStyle}"
                                    PreviewMouseLeftButtonDown="JogYPlus_Down" PreviewMouseLeftButtonUp="Jog_Up"
                                    MouseLeave="Jog_Cancel" LostMouseCapture="Jog_Cancel"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="X-" Style="{StaticResource SecondaryButtonStyle}"
                                    PreviewMouseLeftButtonDown="JogXMinus_Down" PreviewMouseLeftButtonUp="Jog_Up"
                                    MouseLeave="Jog_Cancel" LostMouseCapture="Jog_Cancel"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="■" Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding JogStopCommand}" FontSize="14"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="X+" Style="{StaticResource SecondaryButtonStyle}"
                                    PreviewMouseLeftButtonDown="JogXPlus_Down" PreviewMouseLeftButtonUp="Jog_Up"
                                    MouseLeave="Jog_Cancel" LostMouseCapture="Jog_Cancel"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="Y-" Style="{StaticResource SecondaryButtonStyle}"
                                    PreviewMouseLeftButtonDown="JogYMinus_Down" PreviewMouseLeftButtonUp="Jog_Up"
                                    MouseLeave="Jog_Cancel" LostMouseCapture="Jog_Cancel"/>

                            <Button Grid.Row="0" Grid.Column="4" Content="Z+" Style="{StaticResource SecondaryButtonStyle}"
                                    PreviewMouseLeftButtonDown="JogZPlus_Down" PreviewMouseLeftButtonUp="Jog_Up"
                                    MouseLeave="Jog_Cancel" LostMouseCapture="Jog_Cancel"/>
                            <Button Grid.Row="2" Grid.Column="4" Content="Z-" Style="{StaticResource SecondaryButtonStyle}"
                                    PreviewMouseLeftButtonDown="JogZMinus_Down" PreviewMouseLeftButtonUp="Jog_Up"
                                    MouseLeave="Jog_Cancel" LostMouseCapture="Jog_Cancel"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="Safe Z"
                                    Command="{Binding MoveToSafeZCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="58" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding JogSpeeds}"
                                      SelectedItem="{Binding JogSpeed, Mode=TwoWay}"
                                      MinWidth="58" Padding="6,4"/>
                            <TextBlock Text="mm/s" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#401818"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LaserOn}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Button Content="Laser"
                                Command="{Binding ToggleLaserCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="80"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Teaching Points"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                    <ListView Grid.Row="1" ItemsSource="{Binding FilteredPoints}"
                              SelectedItem="{Binding SelectedPoint}"
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#3A3F47"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTaught}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Border Background="{StaticResource EquipBgBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="3" Padding="3,1" Margin="0,0,4,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ModeLabel}" FontFamily="Consolas" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource TextPrimaryBrush}" Width="48"/>
                                    <TextBlock Text="{Binding BoltTypeLabel}" FontFamily="Consolas" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" Width="30"/>
                                    <TextBlock Text="{Binding PositionLabel}"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Teach"
                                    Command="{Binding TeachCurrentPositionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="70" Margin="0,0,6,0"/>
                            <Button Content="Move To"
                                    Command="{Binding MoveToPointCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="70"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding BoltTypes}"
                                      SelectedItem="{Binding NewBoltType, Mode=TwoWay}"
                                      FontSize="10" MinWidth="74" Margin="0,0,6,0"/>
                            <Button Content="Add Bolt"
                                    Command="{Binding AddBoltPointCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="70" Margin="0,0,6,0"/>
                            <Button Content="Remove"
                                    Command="{Binding RemoveBoltPointCommand}"
                                    Style="{StaticResource DangerButtonStyle}" MinWidth="70"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10" Margin="0,16,0,0">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Recipe"
                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="120" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="New"
                        Command="{Binding NewRecipeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="60" Margin="0,0,4,0"/>
                <Button Content="Save"
                        Command="{Binding SaveRecipeCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="60" Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding RecipeFiles}" MinWidth="180" Margin="0,0,8,0"
                          FontSize="10" VerticalAlignment="Center"
                          SelectionChanged="RecipeFile_Selected"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
