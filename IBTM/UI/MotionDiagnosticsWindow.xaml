<Window x:Class="IBTM.UI.MotionDiagnosticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:MotionDiagnosticsViewModel, IsDesignTimeCreatable=False}"
    Title="{ui:Text 'Motion Monitor'}"
    Width="1240"
    Height="900"
    MinWidth="1120"
    MinHeight="480"
    FontSize="14" WindowStartupLocation="CenterOwner"
    Background="{StaticResource AppBgBrush}">
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClosing}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <Style x:Key="MotionBit" TargetType="TextBlock" BasedOn="{StaticResource IoInputStateStyle}">
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="5,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value>
                        <sys:Boolean>True</sys:Boolean>
                    </Trigger.Value>
                    <Setter Property="Background" Value="{StaticResource IoInputOnBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MotionFaultBit" TargetType="TextBlock" BasedOn="{StaticResource MotionBit}">
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value>
                        <sys:Boolean>True</sys:Boolean>
                    </Trigger.Value>
                    <Setter Property="Foreground" Value="{StaticResource AppBgBrush}"/>
                    <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="{ui:Text 'Motion Monitor'}" Style="{StaticResource TitleStyle}"/>
            <Button Content="{ui:Text 'STOP'}"
                Command="{Binding StopCommand}"
                Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Right" MinWidth="100"/>
        </Grid>
        <TextBlock Grid.Row="1" Height="36" Margin="0,6,0,16" Text="{Binding ControlStatus}"
            Foreground="{StaticResource AccentAmberBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ControlStatus}"/>
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{ui:Text 'SEARCH · AXIS / NUMBER'}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Content="{ui:Text 'Enabled axes only'}"
                IsChecked="{Binding EnabledOnly}"
                Margin="20,0,0,0" VerticalAlignment="Bottom"/>
        </Grid>
        <Grid Grid.Row="3" Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="108"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="196"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{ui:Text 'NO.'}" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="1" Text="{ui:Text 'Axis'}" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="2" Text="{ui:Text 'Position (mm)'}" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="3" Text="{ui:Text 'State'}" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="4" Text="{ui:Text 'Servo'}" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="{ui:Text 'Homed'}" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="{ui:Text 'Home in'}" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="7" Text="{ui:Text '−LIMIT'}" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="8" Text="{ui:Text '+LIMIT'}" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="9" Text="{ui:Text 'Alarm'}" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="10" Text="{ui:Text 'Manual'}" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
        </Grid>
        <ListBox Grid.Row="4" ItemsSource="{Binding View}" Style="{StaticResource IoListStyle}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItemStyle}">
                    <Setter Property="Padding" Value="12,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}" HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type ui:MotionAxisViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="108"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="196"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Address}"
                            Style="{StaticResource IoAddressStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Axis}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2"
                            Text="{Binding Diagnostics.Sample.Position, StringFormat=F3, TargetNullValue=—}"
                            VerticalAlignment="Center" FontFamily="Consolas" FontSize="15"/>
                        <TextBlock Grid.Column="3"
                            ToolTip="{Binding Diagnostics.Sample.ReadError.Message}"
                            VerticalAlignment="Center" Height="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                            <Run Text="{Binding Diagnostics.Sample.Condition, Mode=OneWay, Converter={StaticResource UiTextConverter}}"/>
                            <Run>
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter Property="Text" Value="{ui:Text ' · Disabled'}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                        <TextBlock Grid.Column="4"
                            Tag="{Binding Diagnostics.Sample.State.ServoOn}"
                            Text="{Binding Diagnostics.Sample.State.ServoOn, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource MotionBit}"/>
                        <TextBlock Grid.Column="5"
                            Tag="{Binding Diagnostics.Sample.State.Homed}"
                            Text="{Binding Diagnostics.Sample.State.Homed, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource MotionBit}"/>
                        <TextBlock Grid.Column="6"
                            Tag="{Binding Diagnostics.Sample.State.HomeSensor}"
                            Text="{Binding Diagnostics.Sample.State.HomeSensor, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource MotionBit}"/>
                        <TextBlock Grid.Column="7"
                            Tag="{Binding Diagnostics.Sample.State.NegativeLimit}"
                            Text="{Binding Diagnostics.Sample.State.NegativeLimit, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource MotionFaultBit}"/>
                        <TextBlock Grid.Column="8"
                            Tag="{Binding Diagnostics.Sample.State.PositiveLimit}"
                            Text="{Binding Diagnostics.Sample.State.PositiveLimit, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource MotionFaultBit}"/>
                        <TextBlock Grid.Column="9"
                            Tag="{Binding Diagnostics.Sample.Faulted}"
                            Text="{Binding Diagnostics.Sample.Faulted, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource MotionFaultBit}" ToolTip="{ui:Text 'Alarm / E-stop'}"/>
                        <StackPanel Grid.Column="10" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="96" Padding="8,7" Margin="8,0,6,0" Command="{Binding ToggleServoCommand}" IsEnabled="{Binding IsToggleServoAllowed}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Content" Value="{ui:Text 'Servo ON'}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Diagnostics.Sample.State.ServoOn}" Value="True">
                                                <Setter Property="Content" Value="{ui:Text 'Servo OFF'}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{ui:Text 'Home'}" Width="80" Padding="8,7" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding HomeCommand}" IsEnabled="{Binding IsHomeAllowed}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
