<UserControl x:Class="IBTM.UI.Station3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="498"
             Height="414">
    <Grid>
        <Border Style="{DynamicResource CellStyle}"/>

        <Canvas>
            <TextBlock Canvas.Left="18" Canvas.Top="18"
                       Text="STATION 3 · INSPECT / SORT"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"/>
            <Border Canvas.Left="320" Canvas.Top="12"
                    Tag="{Binding InspectionTone}"
                    Style="{DynamicResource StateBadgeStyle}">
                <TextBlock Text="{Binding InspectionDisplayState,
                                          Converter={StaticResource EnumDescriptionConverter}}"
                           Style="{DynamicResource MapHintStyle}"/>
            </Border>
            <TextBlock Canvas.Left="18" Canvas.Top="88"
                       Text="{Binding NgTransferPosition}"
                       Style="{DynamicResource MapHintStyle}"/>

            <Grid Canvas.Left="{Binding NgTransferMapLeft}"
                  Canvas.Top="{Binding NgTransferMapTop}"
                  Width="86" Height="90"
                  Panel.ZIndex="20">
                <Border Width="82" Height="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Tag="{Binding NgTransferMoving}"
                        Style="{DynamicResource DeviceBodyStyle}">
                    <Grid>
                        <Ellipse Width="24" Height="24"
                                 HorizontalAlignment="Left"
                                 Margin="9,0,0,0"
                                 Tag="{Binding InspectionLaserOutput}"
                                 Style="{DynamicResource LightVisualStyle}"/>
                        <TextBlock Text="C"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="17,0,0,0"
                                   Foreground="{DynamicResource MaterialPcbBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                        <Grid Width="38" Height="30"
                              HorizontalAlignment="Right"
                              Margin="0,0,5,0">
                            <Border Width="24" Height="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource MaterialPcbBrush}"
                                    CornerRadius="2"/>
                            <Border Tag="{Binding InspectionGripperClosed}"
                                    Style="{DynamicResource LeftGripperJawStyle}"/>
                            <Border Tag="{Binding InspectionGripperClosed}"
                                    Style="{DynamicResource RightGripperJawStyle}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Canvas.Left="290" Canvas.Top="118"
                    Width="174" Height="132"
                    Tag="{Binding NgHandlingTone}"
                    Style="{DynamicResource DeviceBodyStyle}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="NG CARRIER"
                               Style="{DynamicResource MapLabelStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding NgHandlingDisplayState,
                                             Converter={StaticResource EnumDescriptionConverter}}"
                               Style="{DynamicResource MapHintStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="SemiBold">
                        <Run Text="{Binding NgCarrierCount, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding NgCarrierCapacity, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

        </Canvas>
    </Grid>
</UserControl>
