<UserControl x:Class="IBTM.UI.TeachingView"
    x:Name="TeachingRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:TeachingViewModel, IsDesignTimeCreatable=False}"
    Foreground="{StaticResource TextPrimaryBrush}"
    Background="{StaticResource AppBgBrush}"
    Validation.ErrorTemplate="{x:Null}">
    <UserControl.BindingGroup>
        <BindingGroup Name="RecipeInputs"/>
    </UserControl.BindingGroup>
    <UserControl.Resources>
        <CollectionViewSource x:Key="TeachingPoints" Source="{Binding FilteredPoints}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"
                IsEnabled="{Binding IsTeachingEditAllowed}">
                <TextBox Text="{Binding RecipeEditor.Name, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged}"
                    Width="180" Margin="0,0,6,0" ToolTip="Recipe name"/>
                <Button Command="{Binding RecipeEditor.SaveCommand}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Content" Value="Save Recipe"/>
                            <Setter Property="ToolTip" Value="Save this recipe, including inspection thresholds."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecipeEditor.SaveCommand.IsRunning}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=TeachingRoot, Path=(Validation.HasError)}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="ToolTip" Value="Correct the highlighted input before saving the recipe."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="New Recipe" Command="{Binding RecipeEditor.NewCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Apply &amp; Save Handoff"
                Command="{Binding SaveHandoffSetupCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                ToolTip="Apply and save staged handoff values for both Supply and Placement."
                Visibility="{Binding HandoffSaveVisible, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="Teaching" Style="{StaticResource TitleStyle}"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="330" MaxWidth="420"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*" MinWidth="280"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="270"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80" MaxHeight="260"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="270"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Teaching Unit" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding TeachingUnits}" SelectedItem="{Binding SelectedTeachingUnit}"/>
                        <TextBlock
                            Text="{Binding ActiveMotionGroup, Converter={StaticResource EnumDescriptionConverter}, StringFormat=Axes · {0}}"
                            Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        <ComboBox ItemsSource="{Binding HeatSinkSlots}"
                            SelectedItem="{Binding SelectedPcb}"
                            Margin="0,6,0,0"
                            Visibility="{Binding BoltPointEditorVisible, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <ui:TeachingPointList x:Name="TeachingPointsList" Grid.Row="1"
                        ItemsSource="{Binding Source={StaticResource TeachingPoints}}"
                        SelectedItem="{Binding SelectedPoint}"
                        Background="{StaticResource EquipBgBrush}" BorderThickness="1" BorderBrush="{StaticResource DividerBrush}"
                        ItemContainerStyle="{StaticResource FlatListItemStyle}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate DataType="{x:Type data:CollectionViewGroup}">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}"
                                            TextWrapping="Wrap" FontWeight="SemiBold" Margin="8,10,4,4"
                                            Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:TeachingPoint}">
                                <StackPanel Margin="4,4">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding PositionLabel}" TextWrapping="Wrap"
                                        FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ui:TeachingPointList>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0"
                        Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Add Bolt → Center in Live → Grab → Resize ROI"
                            TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding FasteningHeads}" SelectedItem="{Binding NewFasteningHead}" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2">
                            <Button x:Name="AddBoltButton" Content="Add Bolt"
                                Command="{Binding AddBoltPointCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,3,0"/>
                            <Button Content="Remove Bolt"
                                Command="{Binding RemoveBoltPointCommand}"
                                Style="{StaticResource DangerButtonStyle}" Margin="3,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                    <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding SelectedPoint.Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding HomeBlock, Converter={StaticResource EnumDescriptionConverter}}"
                                Foreground="{StaticResource AccentAmberBrush}" TextWrapping="Wrap"/>
                            <ui:TeachingMotionView/>
                            <Button Content="Return from Pickup"
                                Command="{Binding ReturnFromPickupCommand}"
                                Margin="0,6,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Raise Z to Safe Z, then raise Head 1. XY and vacuum remain unchanged."
                                Visibility="{Binding BoltPresetEditorVisible, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="8"
                Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TabControl SelectedIndex="{Binding SelectedCameraTab}">
                        <TabItem Header="Teaching / Inspect">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*" MinHeight="100"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*" MinHeight="100"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Command="{Binding ToggleLiveViewCommand}" Margin="0,0,6,6" MinWidth="70">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Content" Value="Live"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Inspector.IsLiveView}" Value="True">
                                                        <Setter Property="Content" Value="Stop Live"/>
                                                        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource EquipBgBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Grab"
                                        Command="{Binding GrabCommand}"
                                        Margin="0,0,6,6" Style="{StaticResource PrimaryButtonStyle}"
                                        ToolTip="Grab one teaching image for the selected point. Grabbing again replaces its image and capture XY. Live stays on."/>
                                    <Button Content="Move &amp; Inspect"
                                        Command="{Binding CaptureInspectionCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,6"/>
                                    <Button Content="Reinspect"
                                        Command="{Binding ReinspectImageCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"
                                        ToolTip="Inspect the last captured image, or the selected saved FOV. Does not move axes."/>
                                </WrapPanel>
                                <Border Grid.Row="1" Background="{StaticResource ImageBackgroundBrush}">
                                    <ui:ImageTeachingView Source="{Binding LiveImage}" ShowCrosshair="True"/>
                                </Border>
                                <TextBlock Grid.Row="2"
                                    Text="{Binding Preview.Result}"
                                    TextWrapping="Wrap" Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold"/>
                                <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                                    <TextBlock Text="Teaching Image / ROI" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                    <TextBlock Text="Resolution (mm/px)" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <TextBlock Text="{Binding MillimetersPerPixel, StringFormat={}{0:G8}}"
                                        VerticalAlignment="Center" Margin="0,0,8,6"/>
                                    <Button Content="Apply ROI"
                                        Command="{Binding TeachFovRegionCommand}"
                                        CommandParameter="{Binding FovRegion}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6"
                                        ToolTip="Save the centered square ROI for the selected bolt or Data Matrix. Captured XY does not change."/>
                                    <ToggleButton Content="Ruler" IsChecked="{Binding IsMeasuring}"
                                        Padding="10,6" Margin="6,0,0,6"
                                        ToolTip="Drag between two known points on the saved image to calibrate mm per pixel."/>
                                    <Button x:Name="ReadDataMatrixButton" Content="Read Data Matrix"
                                        Command="{Binding ReadDataMatrixCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,6"
                                        ToolTip="Read the ROI on the saved image. Does not move axes or stop live view."
                                        Visibility="{Binding IsDataMatrixSelected, Converter={StaticResource BoolToVis}}"/>
                                </WrapPanel>
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:ImageTeachingView x:Name="FovImageView"
                                        Source="{Binding SelectedFov.Image}"
                                        SourceRegion="{Binding FovRegion}"
                                        RegionCommand="{Binding DrawFovRegionCommand}"
                                        IsMeasuring="{Binding IsMeasuring}"
                                        Ruler="{Binding Ruler}" MeasureCommand="{Binding MeasureImageCommand}"
                                        ShowCrosshair="True" Cursor="Cross"
                                        ToolTip="Drag toward or away from the center to resize the square ROI. The center stays fixed. Ruler measures freely. Esc cancels the drag."/>
                                    <ScrollViewer Grid.Column="1" Width="200" Margin="10,0,0,0"
                                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                        Visibility="{Binding IsBoltSelected, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Selected bolt · binary check" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <StackPanel IsEnabled="{Binding IsTeachingEditAllowed}">
                                                <TextBlock Text="Threshold (0–255)" Margin="0,8,0,4"/>
                                                <TextBox x:Name="InspectionThresholdInput"
                                                    Text="{Binding Preview.BrightnessThreshold, BindingGroupName=RecipeInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                    ToolTip="Pixels at or above this brightness are white. Applies to this bolt's ROI immediately."/>
                                                <TextBlock Text="Minimum bright (%)" Margin="0,8,0,4"/>
                                                <TextBox x:Name="InspectionBrightRatioInput"
                                                    Text="{Binding Preview.MinimumBrightPercent, BindingGroupName=RecipeInputs, StringFormat={}{0:G6}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                    ToolTip="This bolt passes when its measured bright percentage is at least this value."/>
                                            </StackPanel>
                                            <TextBlock Text="Binary ROI preview" Margin="0,10,0,4"/>
                                            <Image Source="{Binding Preview.Overlay}" Height="100" Stretch="Uniform"
                                                RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            <TextBlock Text="{Binding Preview.Result}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="Settings apply to this bolt. Save Recipe to keep changes."
                                                TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                                <StackPanel Grid.Row="5" Margin="0,8,0,0">
                                    <StackPanel Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                        <TextBlock Text="Ruler · drag between two points at bolt height" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Ruler.PixelLength, StringFormat={}{0:0.###} px, TargetNullValue=Draw a line, FallbackValue=Draw a line}"
                                                VerticalAlignment="Center" Margin="0,0,12,6"/>
                                            <TextBlock Text="Actual distance (mm)" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                            <TextBox x:Name="RulerDistanceInput" Width="80" Margin="0,0,8,6"
                                                Text="{Binding RulerMillimeters, BindingGroupName={x:Null}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                            <TextBlock Text="{Binding RulerResolution, StringFormat={}{0:G8} mm/px, TargetNullValue=—}"
                                                VerticalAlignment="Center" Margin="0,0,8,6"/>
                                            <Button Content="Apply &amp; Save Resolution"
                                                Command="{Binding ApplyRulerResolutionCommand}"
                                                Margin="0,0,0,6">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=RulerDistanceInput, Path=(Validation.HasError)}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </WrapPanel>
                                        <TextBlock Text="Updates both heat sinks' saved bolt coordinates from their ROIs. Capture XY and ROIs stay fixed. Turn Ruler off to resize the ROI."
                                            TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsDataMatrixSelected, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,6">
                                        <TextBlock Text="Data Matrix · saved FOV / ROI" FontWeight="SemiBold"/>
                                        <TextBox x:Name="DataMatrixResultBox"
                                            Text="{Binding DataMatrixResult, Mode=OneWay}"
                                            IsReadOnly="True" TextWrapping="Wrap" FontSize="16" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FovRoiLabel}" TextWrapping="Wrap"/>
                                    <TextBlock
                                        Text="ROI: centered square, size only. Align the bolt or Data Matrix with the live crosshair before capturing."
                                        TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="Capture XY · "/><Run Text="{Binding SelectedFov.Metadata.Center.X, StringFormat={}{0:F3}}"/>
                                        <Run Text=", "/><Run Text="{Binding SelectedFov.Metadata.Center.Y, StringFormat={}{0:F3}}"/>
                                        <Run Text=" mm · Resizing saves when the selected target is ready"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Lighting">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="4">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Lighting" Style="{StaticResource PanelTitleStyle}" Margin="0,12,0,0"/>
                                    <Grid Margin="0,12,0,0" IsEnabled="{Binding IsTeachingEditAllowed}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="0.7*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="Margin" Value="0,0,8,8"/>
                                            </Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                            </Style>
                                        </Grid.Resources>
                                        <TextBlock Text="Light Level"/>
                                        <TextBox x:Name="InspectionLightInput" Grid.Column="1"
                                            Text="{Binding InspectionRecipe.LightLevel, BindingGroupName=RecipeInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                            ToolTip="0 to 255. Applies on the next capture or Live start."/>
                                    </Grid>
                                    <TextBlock
                                        Text="Light is on during Live or capture. Camera exposure, gain and frame rate use the camera settings. Save Recipe to keep the light level."
                                        TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                    <TextBlock Grid.Row="1"
                        Text="{Binding CameraError}"
                        TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}" Margin="4"/>
                </Grid>
            </Border>
            <Border Padding="12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Grid.Column" Value="2"/>
                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInspectionSelected}" Value="True">
                                <Setter Property="Grid.Column" Value="4"/>
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IoStatusTemplate}"/>
                    <StackPanel Grid.Row="1"
                        Visibility="{Binding BoltPresetEditorVisible, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding IsTeachingEditAllowed}">
                        <TextBlock Text="Bolt presets" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="PCB" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding BoltRecipe.PcbPreset, BindingGroupName=RecipeInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                FontSize="11" Width="36" Margin="4,0,10,0"/>
                            <TextBlock Text="IPM 1" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding BoltRecipe.IpmSeatingPreset, BindingGroupName=RecipeInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                FontSize="11" Width="36" Margin="4,0,10,0"/>
                            <TextBlock Text="IPM 2" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding BoltRecipe.IpmFinalPreset, BindingGroupName=RecipeInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                FontSize="11" Width="36" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
