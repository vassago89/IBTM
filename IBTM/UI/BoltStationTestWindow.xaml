<Window x:Class="IBTM.UI.BoltStationTestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:BoltStationTestViewModel, IsDesignTimeCreatable=False}"
    Title="{ui:Text 'Bolt Station · Selected Bolt Test'}" Width="1080" Height="800"
    MinWidth="940" MinHeight="600" WindowStartupLocation="CenterOwner"
    Background="{StaticResource AppBgBrush}">
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClosing}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <CollectionViewSource x:Key="BoltsByPcb" Source="{Binding Bolts}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Bolt.HeatSink"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="TestCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Border DockPanel.Dock="Right" Background="{StaticResource AccentAmberBrush}" Padding="14,6" CornerRadius="4">
                <TextBlock Text="{ui:Text 'MANUAL TEST'}" Foreground="#192025" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="{ui:Text 'Bolt Station'}" Style="{StaticResource TitleStyle}"/>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,8,0,18">
            <TextBlock Text="{ui:Text 'Axes and heads move. Keep clear.'}"
                Foreground="{StaticResource AccentAmberBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="2" Background="{StaticResource EquipBgBrush}" BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{ui:Text 'BOLT SUPPLY'}" Style="{StaticResource SectionHeaderStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Margin="0,0,30,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TestCell}">
                                <Setter Property="Text" Value="{ui:Text 'Shooting · supply bypassed / dry run'}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Units.ShootingBoltFeeder}" Value="True">
                                        <Setter Property="Text" Value="{ui:Text 'Shooting · feed and fasten'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TestCell}">
                                <Setter Property="Text" Value="{ui:Text 'Pickup · supply bypassed / dry run'}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Units.PickupBoltFeeder}" Value="True">
                                        <Setter Property="Text" Value="{ui:Text 'Pickup · feed and fasten'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{ui:Text 'Select all'}" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="{ui:Text 'Clear selection'}" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedCount, StringFormat={}{0} bolts selected}" Style="{StaticResource TestCell}" FontWeight="SemiBold"/>
                <Border Background="{StaticResource EquipBgBrush}" Padding="12,6" Margin="20,0,0,0" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{ui:Text 'TOTAL RUN'}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding TotalRunSeconds, StringFormat={}{0:0.000} s, TargetNullValue=—}"
                            Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Background="{StaticResource EquipBgBrush}" Margin="0,0,0,4" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/><ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{ui:Text 'BOLT'}" Style="{StaticResource TestCell}"/>
                <TextBlock Grid.Column="2" Text="{ui:Text 'HEAD'}" Style="{StaticResource TestCell}"/>
                <TextBlock Grid.Column="3" Text="{ui:Text 'RESULT'}" Style="{StaticResource TestCell}"/>
                <TextBlock Grid.Column="4" Text="{ui:Text 'TORQUE'}" Style="{StaticResource TestCell}"/>
                <TextBlock Grid.Column="5" Text="{ui:Text 'TARGET'}" Style="{StaticResource TestCell}"/>
                <TextBlock Grid.Column="6" Text="{ui:Text 'TIME (ms)'}" Style="{StaticResource TestCell}"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Source={StaticResource BoltsByPcb}}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RunCommand.IsRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource EquipBgBrush}" Padding="12,6" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}"
                                            Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:BoltTestRow}">
                            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                <StackPanel>
                                    <Grid MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/><ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding Label}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource TestCell}" FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Bolt.Head, Converter={StaticResource EnumDescriptionConverter}}" Style="{StaticResource TestCell}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Status}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TestCell}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Result.Success}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Result.Success}" Value="False"><Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Dry run"><Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running"><Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="4" Text="{Binding Result.Torque, StringFormat=0.##, TargetNullValue=—, FallbackValue=—}" Style="{StaticResource TestCell}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Result.Controller.TargetTorque, StringFormat=0.##, TargetNullValue=—, FallbackValue=—}" Style="{StaticResource TestCell}"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Result.Controller.FasteningTimeMilliseconds, TargetNullValue=—, FallbackValue=—}" Style="{StaticResource TestCell}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Result.Error}" Foreground="{StaticResource AccentRedBrush}"
                                        Style="{StaticResource StatusMessageStyle}" Margin="52,4,8,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <ScrollViewer Grid.Row="5" Margin="0,8,0,12" MaxHeight="80" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource StatusMessageStyle}"
                    Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Readiness}" Style="{StaticResource StatusMessageStyle}"
                    Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding Error}" Style="{StaticResource StatusMessageStyle}" Foreground="{StaticResource AccentRedBrush}"/>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{ui:Text 'Fasten Selected Bolts'}" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="170" Margin="0,0,12,0"/>
                <Button Content="{ui:Text 'STOP'}" Command="{Binding StopCommand}" Style="{StaticResource DangerButtonStyle}" MinWidth="120"/>
            </StackPanel>
            <TextBlock Text="{ui:Text 'Carrier stays at S2'}"
                Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
