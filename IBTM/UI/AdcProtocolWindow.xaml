<Window x:Class="IBTM.UI.AdcProtocolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:IBTM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ui:AdcProtocolWindow, IsDesignTimeCreatable=False}"
        Title="HANTAS ADC Protocol"
        Width="1120"
        Height="780"
        MinWidth="960"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="HANTAS ADC Protocol" Style="{StaticResource TitleStyle}"/>
                <TextBlock Text="RS422 / Modbus RTU communication test"
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <StackPanel x:Name="VirtualResultPanel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Next Virtual Result"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox x:Name="NextResultBox"
                          Width="155"
                          Margin="10,0"
                          ItemsSource="{Binding FasteningResults}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type device:AdcEventStatus}">
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Apply Once"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnQueueResult"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,18,0,12"
                Padding="16,14"
                Style="{StaticResource CardStyle}">
            <Grid x:Name="ConnectionControls">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="PORT"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionHeaderStyle}"/>
                <ComboBox x:Name="PortBox" Grid.Column="1" Margin="10,0,8,0"
                          ItemsSource="{Binding PortNames}"
                          SelectionChanged="OnPortSelectionChanged"/>
                <Button x:Name="RefreshPortsButton"
                        Grid.Column="2"
                        Content="Refresh"
                        Padding="12,5"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnRefreshPorts"/>

                <ComboBox x:Name="BaudBox"
                          Grid.Column="3"
                          Margin="16,0,0,0"
                          ItemsSource="{Binding BaudRates}"/>

                <TextBlock Grid.Column="4"
                           Margin="16,0,0,0"
                           Text="SLAVE"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionHeaderStyle}"/>
                <TextBox x:Name="SlaveBox"
                         Grid.Column="5"
                         Margin="10,0,0,0"/>

                <Button x:Name="ConnectButton"
                        Grid.Column="6"
                        Margin="16,0,0,0"
                        Content="{Binding ConnectionAction}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnToggleConnection"/>
                <TextBlock
                           Grid.Column="7"
                           Margin="16,0,0,0"
                           Text="{Binding ConnectionStatus}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Padding="18,16" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="CONTROLLER"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:HoldButton x:Name="ReverseButton" Content="Reverse (Hold)" Margin="0,0,8,0"
                                           PressCommand="{Binding ReverseCommand}" ReleaseCommand="{Binding ReleaseReverseCommand}"
                                           Style="{StaticResource SecondaryButtonStyle}"
                                           ToolTip="Loosen while held. Release or Stop ends rotation; no automatic loose-complete judgement."/>
                            <Button x:Name="StopButton" Content="Stop"
                                    Style="{StaticResource DangerButtonStyle}" Click="OnStop"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="OperationPanel" IsEnabled="False">

                    <Grid Margin="0,14,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Preset"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="PresetBox"
                                 Grid.Column="1"
                                 Text="1"/>
                        <Button Grid.Column="2"
                                Margin="10,0,0,0"
                                Content="Select"
                                Padding="14,5"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnSelectPreset"/>
                    </Grid>

                    <WrapPanel Margin="0,0,0,14">
                        <Button x:Name="StartButton"
                                Content="Start Fastening"
                                Margin="0,0,8,8"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnStart"/>
                        <Button Content="Alarm Reset"
                                Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnResetAlarm"/>
                        <Button Content="Read Result"
                                Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnReadResult"/>
                        <Button Content="Device Info"
                                Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnReadDeviceInformation"/>
                    </WrapPanel>

                    <TextBlock Text="CONTROLLER / LAST RESULT" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock
                               Margin="0,10,0,0"
                               Text="{Binding ResultMessage}"
                               TextWrapping="Wrap"
                               FontFamily="Cascadia Mono, Consolas"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Padding="18,16" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RegisterPanel" IsEnabled="False">
                    <TextBlock Text="REGISTER ACCESS" Style="{StaticResource SectionHeaderStyle}"/>

                    <ComboBox x:Name="AccessBox"
                              Margin="0,14,0,12"
                              ItemsSource="{Binding RegisterAccesses}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ADDRESS" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBox x:Name="AddressBox" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="COUNT" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBox x:Name="CountBox" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="VALUE" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBox x:Name="ValueBox" Margin="0,6,0,0" Text="0"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Execute"
                            Margin="0,14,0,14"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OnExecuteRegister"/>

                    <TextBlock Text="RESPONSE" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock
                               Margin="0,10,0,0"
                               Text="{Binding RegisterResult}"
                               TextWrapping="Wrap"
                               FontFamily="Cascadia Mono, Consolas"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="18,14" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox Content="Pause display" IsChecked="{Binding IsLogPaused}"
                                  VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="Copy" Click="OnCopyLog" Padding="12,4" Margin="0,0,8,0"
                                ToolTip="Copy selected text, or all displayed frames if nothing is selected."
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Copy all" Click="OnCopyAllLog" Padding="12,4" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Clear" Click="OnClearLog" Padding="12,4"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <TextBlock Text="FRAME LOG" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="Newest first. Drag across lines or use Ctrl+A / Ctrl+C. Selecting text pauses display only; communication continues."/>
                <TextBox x:Name="FrameLogBox" Grid.Row="2" Margin="0,8,0,0" Text="{Binding FrameLogText, Mode=OneWay}"
                         IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" IsInactiveSelectionHighlightEnabled="True"
                         SelectionChanged="OnLogSelectionChanged" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         TextWrapping="NoWrap" Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <TextBlock Grid.Row="3" Text="{Binding ClipboardError}" Foreground="{StaticResource AccentRedBrush}" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
