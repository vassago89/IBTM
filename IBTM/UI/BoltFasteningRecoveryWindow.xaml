<Window x:Class="IBTM.UI.BoltFasteningRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:IBTM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ui:BoltFasteningRecoveryViewModel, IsDesignTimeCreatable=False}"
        Title="Bolt Fastening Recovery"
        Width="660"
        Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Bolt Fastening Recovery"
                   Style="{StaticResource TitleStyle}"/>
        <TextBlock Grid.Row="1"
                   Margin="0,5,0,16"
                   Text="Check fastened bolts only. Unchecked bolts restart."
                   Style="{StaticResource PageSubtitleStyle}"/>

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="12,9"
                Style="{StaticResource CardStyle}">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <Ellipse Tag="{Binding HeatSink2Present}"
                             Style="{StaticResource PresenceLedStyle}"/>
                    <TextBlock Text="HEAT SINK 2"
                               Margin="7,0,0,0"
                               Style="{StaticResource IndicatorTextStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Tag="{Binding HeatSink1Present}"
                             Style="{StaticResource PresenceLedStyle}"/>
                    <TextBlock Text="HEAT SINK 1"
                               Margin="7,0,0,0"
                               Style="{StaticResource IndicatorTextStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HEAT SINK"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Grid.Column="1"
                               Text="BOLT"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Grid.Column="2"
                               Text="PASS"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Grid.Column="3"
                               Text="COMPLETED"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionHeaderStyle}"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:BoltFasteningRecoveryItem}">
                                <Border BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid Height="44" Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding HeatSink,
                                                    Converter={StaticResource EnumDescriptionConverter}}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Number}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Pass,
                                                    Converter={StaticResource EnumDescriptionConverter}}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <CheckBox Grid.Column="3"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Completed}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="Manual entries have no torque data."
                       VerticalAlignment="Center"
                       Style="{StaticResource PageSubtitleStyle}"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="78"
                        Margin="0,0,6,0"/>
                <Button Content="Apply"
                        IsDefault="True"
                        Click="OnApply"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="78"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
