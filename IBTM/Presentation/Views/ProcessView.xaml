<UserControl x:Class="IBTM.Presentation.Views.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:IBTM.Presentation.Views"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="StationCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="StationDetailStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Panel.ZIndex="999"
                Background="#C0180000"
                Visibility="{Binding NgStackAlarm, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="NG STACK FULL" FontSize="54"
                           Style="{StaticResource OverlayTextStyle}" Foreground="White"/>
                <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0"
                           FontSize="20" Foreground="#FFB0B0">
                    <Run Text="Loaded "/>
                    <Run Text="{Binding NgStackCount}"/>
                    <Run Text="/"/>
                    <Run Text="{Binding NgStackMaxCount}"/>
                    <Run Text="  ·  Cycle stops after the current transfer"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                    <Button Content="Stop" Command="{Binding StopCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" Margin="0,0,8,0"/>
                    <Button Content="NG Reset" Command="{Binding ResetNgStackCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" Margin="0,0,8,0"/>
                    <Button Content="E-STOP" Command="{Binding EStopCommand}"
                            Style="{StaticResource DangerButtonStyle}" MinWidth="120"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <v:StatsBarView Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource StationCardStyle}" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="ST.1" Style="{StaticResource StationTitleStyle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="PCB PLACEMENT" Margin="8,0,0,0"
                                           Style="{StaticResource StationSubtitleStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}" Margin="0,14"/>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PcbPlacementActivity}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Pick and place" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="{Binding PcbPlacementPosition}"
                                       Style="{StaticResource StationDetailStyle}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource StationCardStyle}" Margin="6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="ST.2" Style="{StaticResource StationTitleStyle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="BOLT FASTENING" Margin="8,0,0,0"
                                           Style="{StaticResource StationSubtitleStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}" Margin="0,14"/>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BoltFasteningActivity}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding BoltProgress}" Margin="0,8,0,0"
                                           Style="{StaticResource StationDetailStyle}"/>
                                <TextBlock Text="{Binding LastBoltResult}" Margin="0,4,0,0"
                                           Style="{StaticResource StationDetailStyle}"/>
                                <TextBlock Text="{Binding LastFiducialResult}" Margin="0,4,0,0"
                                           Style="{StaticResource StationDetailStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="{Binding BoltFasteningPosition}"
                                       Style="{StaticResource StationDetailStyle}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource StationCardStyle}" Margin="6,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="ST.3" Style="{StaticResource StationTitleStyle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="INSPECTION" Margin="8,0,0,0"
                                           Style="{StaticResource StationSubtitleStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}" Margin="0,14"/>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding InspectionActivity}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding LastRouteText}" Margin="0,8,0,0"
                                           Style="{StaticResource StationDetailStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="{Binding InspectionPosition}"
                                       Style="{StaticResource StationDetailStyle}"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Border Background="#60180000" IsHitTestVisible="False"
                        Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="E-STOP" FontSize="34"
                               Style="{StaticResource OverlayTextStyle}"
                               Foreground="{StaticResource AccentRedBrush}" Opacity="0.7"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <v:ResultPanelView Grid.Column="2"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TARGET TORQUE" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding TargetTorque, StringFormat='{}{0:F1}', UpdateSourceTrigger=LostFocus}"
                             VerticalAlignment="Center" FontSize="11" MinWidth="44" TextAlignment="Right"/>
                    <TextBlock Text="Nm" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="76" Margin="0,0,6,0"/>
                    <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="76" Margin="0,0,6,0"/>
                    <Button Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="70" Margin="0,0,6,0"/>
                    <Button Content="NG Reset" Command="{Binding ResetNgStackCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="76" Margin="0,0,6,0"
                            Visibility="{Binding NgStackAlarm, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="E-STOP" Command="{Binding EStopCommand}" Style="{StaticResource DangerButtonStyle}" MinWidth="84"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
