<UserControl x:Class="IBTM.UI.NgConveyorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
    xmlns:ng="clr-namespace:IBTM.NgConveyor;assembly=IBTM.NgConveyor"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
    Width="{x:Static ui:MachinePlan.InspectionWidth}"
    Height="{x:Static ui:MachinePlan.PlanHeight}">
    <UserControl.Resources>
        <Style x:Key="NgPositionStyle" TargetType="Border">
            <Setter Property="Width" Value="{StaticResource CarrierWidth}"/>
            <Setter Property="Height" Value="{StaticResource CarrierHeight}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>
        <Style x:Key="PositionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource EquipmentRoleLabelStyle}">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,5,12,0"/>
            <Setter Property="Panel.ZIndex" Value="5"/>
            <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="NgBeltDirectionStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="ToolTip" Value="NG conveyor drive direction"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Signals.Outputs[NgConveyorRun].IsOn}" Value="True"/>
                        <Condition Binding="{Binding Signals.Outputs[NgConveyorReverse].IsOn}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Data" Value="M 0,0 L 8,9 L 16,0 M 0,18 L 8,27 L 16,18 M 0,36 L 8,45 L 16,36"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Signals.Outputs[NgConveyorRun].IsOn}" Value="True"/>
                        <Condition Binding="{Binding Signals.Outputs[NgConveyorReverse].IsOn}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Data" Value="M 0,9 L 8,0 L 16,9 M 0,27 L 8,18 L 16,27 M 0,45 L 8,36 L 16,45"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Canvas>
        <StackPanel Canvas.Left="{x:Static ui:MachinePlan.NgStatusLeft}" Canvas.Top="{x:Static ui:MachinePlan.StatusTop}" Width="170">
            <TextBlock Text="NG Conveyor" TextAlignment="Left" Style="{StaticResource EquipmentRoleLabelStyle}"/>
            <TextBlock Text="{Binding NgConveyorState, Converter={StaticResource EnumDescriptionConverter}}"
                TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NgConveyorState}"
                                Value="{x:Static ng:NgConveyorState.WaitingForCarrier}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NgConveyorState}"
                                Value="{x:Static ng:NgConveyorState.ReadyToEject}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NgConveyorState}" Value="{x:Static ng:NgConveyorState.Full}">
                                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NgConveyor.AlarmRequired}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <Grid Canvas.Left="{x:Static ui:MachinePlan.NgConveyorLeft}" Canvas.Top="{x:Static ui:MachinePlan.NgConveyorTop}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="5" Width="{x:Static ui:MachinePlan.NgConveyorWidth}"
                Tag="{Binding Signals.Outputs[NgConveyorRun].IsOn}"
                Style="{StaticResource ConveyorBedStyle}"/>
            <Border Height="{x:Static ui:MachinePlan.PlatePadding}"/>
            <Border Grid.Row="4" Height="{x:Static ui:MachinePlan.PlatePadding}"/>
            <Grid Grid.Row="1" Height="{x:Static ui:MachinePlan.NgPositionHeight}">
                <Border Style="{StaticResource NgPositionStyle}"/>
                <ui:CarrierView>
                    <ui:CarrierView.Style>
                        <Style TargetType="{x:Type ui:CarrierView}" BasedOn="{StaticResource CarrierStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Signals.Inputs[NgShuttleCarrierDetected].IsOn}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:CarrierView.Style>
                </ui:CarrierView>
                <Border x:Name="NgShuttle">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource NgPositionStyle}">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NgShuttle.Lift}" Value="{x:Static ng:NgShuttleLiftState.Up}">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NgShuttle.Lift}" Value="{x:Static ng:NgShuttleLiftState.Down}">
                                    <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
            <TextBlock Grid.Row="1" Text="P3" Style="{StaticResource PositionLabelStyle}"/>
            <Grid Grid.Row="2" Height="{x:Static ui:MachinePlan.NgPositionHeight}">
                <Border Style="{StaticResource NgPositionStyle}"/>
                <ui:CarrierView
                    Visibility="{Binding Signals.Inputs[NgConveyorPosition2Occupied].IsOn, Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <TextBlock Grid.Row="2" Text="P2" Style="{StaticResource PositionLabelStyle}"/>
            <Grid Grid.Row="3" Height="{x:Static ui:MachinePlan.NgPositionHeight}">
                <Border Style="{StaticResource NgPositionStyle}"/>
                <ui:CarrierView
                    Visibility="{Binding Signals.Inputs[NgConveyorPosition1Occupied].IsOn, Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <TextBlock Grid.Row="3" Text="P1 / EJECT" Style="{StaticResource PositionLabelStyle}"/>
            <Border Grid.Row="3" Width="28" Height="10" VerticalAlignment="Bottom" Margin="0,0,0,-5">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StopperVisualStyle}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Signals.Inputs[NgConveyorStopperUp].IsOn}" Value="True"/>
                                    <Condition Binding="{Binding Signals.Inputs[NgConveyorStopperDown].IsOn}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Tag" Value="{x:Static device:StationCylinderState.Up}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Signals.Inputs[NgConveyorStopperUp].IsOn}" Value="False"/>
                                    <Condition Binding="{Binding Signals.Inputs[NgConveyorStopperDown].IsOn}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Tag" Value="{x:Static device:StationCylinderState.Down}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
        <StackPanel Canvas.Left="{x:Static ui:MachinePlan.NgStatusLeft}" Canvas.Top="160">
            <TextBlock Text="P3 LIFT" Style="{StaticResource EquipmentRoleLabelStyle}" Margin="0,0,0,12"/>
            <Viewbox Width="150">
                <Canvas Width="284" Height="48">
                    <Path Data="M 12,38 H 272 M 12,43 H 272" Stroke="{StaticResource MachineStructureBorderBrush}" StrokeThickness="2"/>
                    <Path>
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource PlateElevationStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NgShuttle.Lift}" Value="{x:Static ng:NgShuttleLiftState.Up}">
                                        <Setter Property="Tag" Value="{x:Static device:StationCylinderState.Up}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NgShuttle.Lift}" Value="{x:Static ng:NgShuttleLiftState.Down}">
                                        <Setter Property="Tag" Value="{x:Static device:StationCylinderState.Down}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Canvas>
            </Viewbox>
        </StackPanel>
        <Path Canvas.Left="{x:Static ui:MachinePlan.NgStatusLeft}" Canvas.Top="276" Style="{StaticResource NgBeltDirectionStyle}"/>
    </Canvas>
</UserControl>
