<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buffer="clr-namespace:IBTM.PcbBuffer;assembly=IBTM.PcbBuffer"
    xmlns:ui="clr-namespace:IBTM.UI">

    <SolidColorBrush x:Key="MaterialPcbBrush" Color="#63D58D"/>
    <SolidColorBrush x:Key="CarrierJigBrush" Color="#67A8D8"/>
    <SolidColorBrush x:Key="HousingBrush" Color="#D7AD61"/>

    <Style x:Key="MapLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="MapHintStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MapLabelStyle}">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="StateBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="Background" Value="#12171D"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:DisplayTone.Ready}">
                <Setter Property="Background" Value="#172A1E"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:DisplayTone.Waiting}">
                <Setter Property="Background" Value="#2A2416"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:DisplayTone.Active}">
                <Setter Property="Background" Value="#172238"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static ui:DisplayTone.Alarm}">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CellStyle" TargetType="Border">
        <Setter Property="Background" Value="#080B0F"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style x:Key="DeviceBodyStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Background" Value="#172238"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StageBodyStyle"
           TargetType="Border"
           BasedOn="{StaticResource DeviceBodyStyle}">
        <Setter Property="CornerRadius" Value="3"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Background" Value="#20394D"/>
                <Setter Property="BorderBrush" Value="{StaticResource CarrierJigBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HousingPocketStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Background" Value="#42351F"/>
                <Setter Property="BorderBrush" Value="{StaticResource HousingBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LeftGripperJawStyle" TargetType="Border">
        <Setter Property="Width" Value="4"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="Background" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Margin" Value="11,0,0,0"/>
                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RightGripperJawStyle"
           TargetType="Border"
           BasedOn="{StaticResource LeftGripperJawStyle}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Margin" Value="0,0,11,0"/>
                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BackupPlateVisualStyle" TargetType="Border">
        <Setter Property="Background" Value="#0D1116"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Opacity" Value="0.45"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Background" Value="#172A1E"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StopperVisualStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Fill" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="Stroke" Value="{StaticResource DividerBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Fill" Value="{StaticResource AccentAmberBrush}"/>
                <Setter Property="Stroke" Value="#FFF0C4"/>
                <Setter Property="StrokeThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LightVisualStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="Stroke" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Fill" Value="#20394D"/>
                <Setter Property="Stroke" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="StrokeThickness" Value="3"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConveyorBedStyle" TargetType="Border">
        <Setter Property="Background" Value="#0D1116"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ConveyorRunning}" Value="True">
                <Setter Property="Background" Value="#122019"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BufferStyle"
           TargetType="Border"
           BasedOn="{StaticResource StageBodyStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding BufferOwner}"
                         Value="{x:Static buffer:BufferOwner.Supply}">
                <Setter Property="Background" Value="#172238"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding BufferOwner}"
                         Value="{x:Static buffer:BufferOwner.Placement}">
                <Setter Property="Background" Value="#172238"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding PcbBufferPcbPresent}" Value="True">
                <Setter Property="Background" Value="#244C32"/>
                <Setter Property="BorderBrush" Value="{StaticResource MaterialPcbBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding BufferRecoveryRequired}" Value="True">
                <Setter Property="Background" Value="#332817"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding BufferConflict}" Value="True">
                <Setter Property="Background" Value="#32191B"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
