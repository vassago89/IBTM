                        <TextBlock Text="{Binding Signals.Inputs[PcbPlacementStopperDown].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Stopper down" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[PcbPlacementBackupPlateUp].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[PcbPlacementBackupPlateUp].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[PcbPlacementBackupPlateUp].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Plate up" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[PcbPlacementBackupPlateDown].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[PcbPlacementBackupPlateDown].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[PcbPlacementBackupPlateDown].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Plate down" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[PcbPlacementHeatSink1Present].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[PcbPlacementHeatSink1Present].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[PcbPlacementHeatSink1Present].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Heat sink 1" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[PcbPlacementHeatSink2Present].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[PcbPlacementHeatSink2Present].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[PcbPlacementHeatSink2Present].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Heat sink 2" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Canvas.Left="604" Canvas.Top="228" Width="284" Style="{StaticResource MapIoCardStyle}">
                <StackPanel>
                    <TextBlock Text="STATION 2 · FASTENING" Style="{StaticResource MapIoTitleStyle}"/>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[BoltFasteningCarrierPresent].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningCarrierPresent].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningCarrierPresent].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Carrier" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[BoltFasteningStopperUp].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningStopperUp].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningStopperUp].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Stopper up" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[BoltFasteningStopperDown].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningStopperDown].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningStopperDown].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Stopper down" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[BoltFasteningBackupPlateUp].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningBackupPlateUp].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningBackupPlateUp].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Plate up" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[BoltFasteningBackupPlateDown].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningBackupPlateDown].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningBackupPlateDown].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Plate down" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[BoltFasteningHeatSink1Present].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningHeatSink1Present].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningHeatSink1Present].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Heat sink 1" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[BoltFasteningHeatSink2Present].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningHeatSink2Present].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[BoltFasteningHeatSink2Present].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Heat sink 2" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Canvas.Left="1014" Canvas.Top="228" Width="284" Style="{StaticResource MapIoCardStyle}">
                <StackPanel>
                    <TextBlock Text="STATION 3 · INSPECTION" Style="{StaticResource MapIoTitleStyle}"/>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[InspectionCarrierPresent].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[InspectionCarrierPresent].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[InspectionCarrierPresent].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Carrier" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[InspectionStopperUp].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[InspectionStopperUp].IsOn, Converter={StaticResource SignalTextConverter}}"
                                   Style="{StaticResource MapIoInputStyle}"/>
                        <TextBlock Text="{Binding Signals.Inputs[InspectionStopperUp].Address}" Style="{StaticResource MapIoAddressStyle}"/>
                        <TextBlock Text="DI Stopper up" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[InspectionStopperDown].Signal, Converter={StaticResource EnumDescriptionConverter}}">
