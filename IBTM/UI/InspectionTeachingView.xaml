<UserControl x:Class="IBTM.UI.InspectionTeachingView" x:Name="EditorRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=ui:InspectionTeachingViewModel, IsDesignTimeCreatable=False}"
    Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource AppBgBrush}"
    Validation.ErrorTemplate="{x:Null}">
    <UserControl.BindingGroup><BindingGroup Name="InspectionInputs"/></UserControl.BindingGroup>
    <UserControl.Resources>
        <CollectionViewSource x:Key="InspectionPoints" Source="{Binding Points}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="HeatSink"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,0,10" IsEnabled="{Binding IsIdle}">
            <Button Command="{Binding SaveCommand}" MinWidth="100" ToolTip="{ui:Text 'Changes apply immediately. Save inspection settings to the current recipe.'}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Content" Value="{ui:Text 'Save inspection settings'}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SaveCommand.IsRunning}" Value="True">
                                <Setter Property="Content" Value="{ui:Text 'Saving...'}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoaded}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=EditorRoot, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <DockPanel>
                        <DockPanel.Style><Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding ImageMode}" Value="{x:Static ui:InspectionImageMode.Reference}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger></Style.Triggers>
                        </Style></DockPanel.Style>

                        <ListBox Style="{StaticResource FlatPanelListStyle}" ItemsSource="{Binding Source={StaticResource InspectionPoints}}" SelectedItem="{Binding SelectedPoint, BindingGroupName={x:Null}}"
                            IsEnabled="{Binding IsIdle}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate DataType="{x:Type data:CollectionViewGroup}">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource UiTextConverter}}"
                                                Foreground="{StaticResource TextMutedBrush}" Margin="8,10,8,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate><DataTemplate DataType="{x:Type ui:InspectionPoint}">
                                <StackPanel Margin="4,4"><TextBlock Text="{Binding Name}" Height="22" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Style="{StaticResource DetailTextStyle}" Text="{Binding PositionLabel}" Height="34" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding PositionLabel}" FontFamily="Consolas" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <Grid>
                        <Grid.Style><Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding ImageMode}" Value="{x:Static ui:InspectionImageMode.Recorded}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger></Style.Triggers>
                        </Style></Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Results.SelectedRecord.PcbBarcode, TargetNullValue=—}" FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" ToolTip="{Binding Results.SelectedRecord.PcbBarcode}"/>
                            <TextBlock Margin="0,4,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DetailTextStyle}">
                                    <Setter Property="Text" Value="{Binding Results.SelectedRecord.Number, StringFormat={ui:Text 'PCB {0}'}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LoadRecordCommand.IsRunning}" Value="True"><Setter Property="Text" Value="{ui:Text 'Loading…'}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <ListBox Style="{StaticResource FlatPanelListStyle}" ItemsSource="{Binding HistoryImages}" SelectedItem="{Binding SelectedHistoryImage, BindingGroupName={x:Null}}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate DataType="{x:Type ui:PcbInspectionImageItem}">
                                    <Grid Margin="6,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Image Source="{Binding Image}" Width="60" Height="50" Stretch="Uniform"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                            <TextBlock Style="{StaticResource DetailTextStyle}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Verdict}" Tag="{Binding Verdict}"
                                            Style="{StaticResource ResultValueStyle}" Margin="12,0,4,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Padding="10">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Style.Triggers>
                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding ImageMode}" Value="{x:Static ui:InspectionImageMode.Recorded}"/>
                            <Condition Binding="{Binding Preview.HasImage}" Value="False"/>
                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger>
                    </Style.Triggers>
                </Style></Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <WrapPanel IsEnabled="{Binding IsIdle}">
                            <Button Command="{Binding InspectCommand}" Margin="0,0,8,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="Content" Value="{ui:Text 'Inspect This Image'}"/>
                                        <Setter Property="IsEnabled" Value="{Binding IsInspectAllowed}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImageMode}" Value="{x:Static ui:InspectionImageMode.Recorded}">
                                                <Setter Property="Content" Value="{ui:Text 'Reinspect'}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=EditorRoot, Path=(Validation.HasError)}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding ImageSource}" Height="22" TextTrimming="CharacterEllipsis" ToolTip="{Binding ImageSource}"/>
                        <TextBlock Text="{Binding OriginalResult}" Height="22" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalResult}"
                            Tag="{Binding OriginalImage.Verdict}" Margin="0,3,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ResultValueStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding OriginalImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding HistoryImageError}" Foreground="{StaticResource AccentAmberBrush}"
                            TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding HistoryImageError}">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StatusMessageStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding ImageMode}" Value="{x:Static ui:InspectionImageMode.Reference}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <StackPanel IsEnabled="{Binding IsIdle}" Margin="0,8,0,0">
                            <TextBlock Text="{ui:Text 'Reference image unavailable'}" Height="22" Foreground="{StaticResource AccentAmberBrush}" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger><MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ImageMode}" Value="{x:Static ui:InspectionImageMode.Reference}"/>
                                                <Condition Binding="{Binding SelectedPoint.Metadata}" Value="{x:Null}"/>
                                            </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <WrapPanel Visibility="{Binding IsDataMatrixSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{ui:Text 'Data Matrix'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox Content="{ui:Text 'Extended search'}" IsChecked="{Binding DataMatrix.TryHarder, BindingGroupName={x:Null}, NotifyOnSourceUpdated=True}"
                                    SourceUpdated="OnDataMatrixSettingChanged"
                                    VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox Content="{ui:Text 'Inverted colors'}" IsChecked="{Binding DataMatrix.TryInverted, BindingGroupName={x:Null}, NotifyOnSourceUpdated=True}"
                                    SourceUpdated="OnDataMatrixSettingChanged"
                                    VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox Content="{ui:Text 'Rotation search'}" IsChecked="{Binding DataMatrix.AutoRotate, BindingGroupName={x:Null}, NotifyOnSourceUpdated=True}"
                                    SourceUpdated="OnDataMatrixSettingChanged"
                                    VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox Content="{ui:Text 'Pure barcode'}" IsChecked="{Binding DataMatrix.PureBarcode, BindingGroupName={x:Null}, NotifyOnSourceUpdated=True}"
                                    SourceUpdated="OnDataMatrixSettingChanged"
                                    VerticalAlignment="Center" Margin="0,0,16,6"/>
                            </WrapPanel>
                            <WrapPanel Visibility="{Binding IsDataMatrixSelected, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                    <TextBlock Text="{ui:Text 'Min. threshold'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="60" Text="{Binding Preview.DataMatrixThresholdMinimum, BindingGroupName=InspectionInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnSourceUpdated=True}"
                                        SourceUpdated="OnInspectionSettingChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                    <TextBlock Text="{ui:Text 'Max. threshold'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="60" Text="{Binding DataMatrix.ThresholdMaximum, BindingGroupName=InspectionInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnSourceUpdated=True}"
                                        SourceUpdated="OnDataMatrixSettingChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                    <TextBlock Text="{ui:Text 'Threshold step'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="60" Text="{Binding DataMatrix.ThresholdStep, BindingGroupName=InspectionInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnSourceUpdated=True}"
                                        SourceUpdated="OnDataMatrixSettingChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{ui:Text 'Dilation radius (px; 0 = off)'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="60" Text="{Binding DataMatrix.DilationRadius, BindingGroupName=InspectionInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnSourceUpdated=True}"
                                        SourceUpdated="OnDataMatrixSettingChanged"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPoint.Bolt, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                                    <TextBlock Text="{ui:Text 'Min. turns (0 = no check)'}" VerticalAlignment="Center" Margin="0,0,8,0"
                                        ToolTip="{ui:Text 'Total turns = sum of all fastening stages'}"/>
                                    <TextBox Width="70" Text="{Binding SelectedPoint.Bolt.MinimumTurns, Mode=TwoWay, BindingGroupName=InspectionInputs, TargetNullValue=0, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnSourceUpdated=True}"
                                        SourceUpdated="OnInspectionSettingChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                    <TextBlock Text="{ui:Text 'Max. turns (0 = no check)'}" VerticalAlignment="Center" Margin="0,0,8,0"
                                        ToolTip="{ui:Text 'Total turns = sum of all fastening stages'}"/>
                                    <TextBox Width="70" Text="{Binding SelectedPoint.Bolt.MaximumTurns, Mode=TwoWay, BindingGroupName=InspectionInputs, TargetNullValue=0, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnSourceUpdated=True}"
                                        SourceUpdated="OnInspectionSettingChanged"/>
                                </StackPanel>
                                <TextBlock Text="{ui:Text 'Bolt presence'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                    <TextBlock Text="{ui:Text 'Threshold (0–255)'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="70" Text="{Binding Preview.BrightnessThreshold, BindingGroupName=InspectionInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnSourceUpdated=True}"
                                        SourceUpdated="OnInspectionSettingChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{ui:Text 'Minimum bright (%)'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="70" Text="{Binding Preview.MinimumBrightPercent, BindingGroupName=InspectionInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnSourceUpdated=True}"
                                        SourceUpdated="OnInspectionSettingChanged"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{ui:Text 'Original · edit ROI'}" FontWeight="SemiBold" Margin="0,0,6,6"/>
                        <TextBlock Grid.Column="1" Text="{Binding Preview.BinaryDescription}" FontWeight="SemiBold" Height="20"
                            TextTrimming="CharacterEllipsis" ToolTip="{Binding Preview.BinaryDescription}" Margin="6,0,0,6"/>
                        <Border Grid.Row="1" Background="{StaticResource ImageBackgroundBrush}" Margin="0,0,6,0">
                            <ui:InspectionImageView x:Name="InspectionImage" Source="{Binding Preview.Image}"
                                SourceRegion="{Binding Preview.Region}" RegionCommand="{Binding DrawRegionCommand}"
                                IsEnabled="{Binding IsDrawRegionAllowed}" ShowCrosshair="True" Cursor="Cross"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource ImageBackgroundBrush}" Margin="6,0,0,0">
                            <ui:InspectionImageView Source="{Binding Preview.Image}" SourceRegion="{Binding Preview.Region}"
                                SourceOverlay="{Binding Preview.Overlay}" ShowCrosshair="False"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <TextBlock Margin="0,8,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DetailTextStyle}">
                                <Setter Property="Text" Value="{ui:Text 'Inspection result'}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding ImageMode}" Value="{x:Static ui:InspectionImageMode.Recorded}">
                                    <Setter Property="Text" Value="{ui:Text 'Reinspection result'}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock MinHeight="26" Margin="0,8,0,0" FontWeight="SemiBold" FontSize="17"
                            Tag="{Binding Preview.Success}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ResultValueStyle}">
                                    <Setter Property="Text" Value="{Binding Preview.Result}"/>
                                    <Setter Property="ToolTip" Value="{Binding Preview.Result}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDataMatrixSelected}" Value="True"/>
                                                <Condition Binding="{Binding Preview.HasImage}" Value="True"/>
                                                <Condition Binding="{Binding Preview.Success}" Value="{x:Null}"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="{ui:Text 'After changing settings, select Inspect This Image to check the result.'}"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding InspectCommand.IsRunning}" Value="True">
                                            <Setter Property="Text" Value="{ui:Text 'Inspecting'}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ElementName=EditorRoot, Path=(Validation.HasError)}" Value="True">
                                            <Setter Property="Text" Value="{ui:Text 'Check the highlighted input.'}"/>
                                            <Setter Property="ToolTip" Value="{ui:Text 'Check the highlighted input.'}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" TextWrapping="Wrap">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Text" Value="{Binding HistoryImageError, TargetNullValue={ui:Text 'Select an image'}}"/>
                    <Style.Triggers>
                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding ImageMode}" Value="{x:Static ui:InspectionImageMode.Recorded}"/>
                            <Condition Binding="{Binding Preview.HasImage}" Value="False"/>
                        </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                        <DataTrigger Binding="{Binding HistoryImages.Count}" Value="0"><Setter Property="Text" Value="{ui:Text 'No saved images for this PCB.'}"/></DataTrigger>
                        <DataTrigger Binding="{Binding LoadedRecord}" Value="{x:Null}"><Setter Property="Text" Value="{Binding Error}"/></DataTrigger>
                        <DataTrigger Binding="{Binding LoadRecordCommand.IsRunning}" Value="True"><Setter Property="Text" Value="{ui:Text 'Loading…'}"/></DataTrigger>
                    </Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource ErrorStatusMessageStyle}" Text="{ui:Text 'Check the highlighted input.'}"
                    Visibility="{Binding ElementName=EditorRoot, Path=(Validation.HasError), Converter={StaticResource BoolToVis}}"
                    TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource ErrorStatusMessageStyle}" Text="{Binding Error}"/>
                <TextBlock Text="{Binding Message}" Style="{StaticResource StatusMessageStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
