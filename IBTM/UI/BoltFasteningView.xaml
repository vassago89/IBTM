<UserControl x:Class="IBTM.UI.BoltFasteningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
             Width="408"
             Height="650">
    <UserControl.Resources>
        <Style x:Key="FeederDeviceStyle" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FeederLabelStyle" TargetType="TextBlock"
               BasedOn="{StaticResource EquipmentRoleLabelStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Canvas>
            <TextBlock Canvas.Left="{x:Static ui:MachinePlan.HeaderInset}" Canvas.Top="{x:Static ui:MachinePlan.HeaderTop}"
                       Text="Bolt Fastening"
                       Style="{StaticResource TitleStyle}"
                       FontWeight="Bold"/>
            <Button Canvas.Right="{x:Static ui:MachinePlan.HeaderInset}" Canvas.Top="{x:Static ui:MachinePlan.HeaderTop}"
                    Content="RESUME WORK"
                    Command="{Binding OpenBoltFasteningRecoveryCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="92"
                    Height="30"
                    Visibility="{Binding BoltFasteningRecoveryAvailable,
                                         Converter={StaticResource BoolToVis}}"/>
            <Border Canvas.Left="{x:Static ui:MachinePlan.HeaderInset}" Canvas.Top="{x:Static ui:MachinePlan.StatusTop}"
                    Tag="{Binding BoltDisplayState}"
                    Style="{StaticResource StationStateBadgeStyle}">
                <TextBlock Text="{Binding BoltDisplayState,
                                          Converter={StaticResource EnumDescriptionConverter}}"
                           Style="{StaticResource PrimaryStateTextStyle}"/>
            </Border>

            <TextBlock Canvas.Left="{x:Static ui:MachinePlan.HeaderInset}" Canvas.Top="{x:Static ui:MachinePlan.DetailTop}"
                       Width="340"
                       Text="{Binding FasteningState,
                                      Converter={StaticResource EnumDescriptionConverter}}"
                       TextAlignment="Left"
                       Style="{StaticResource MapLabelStyle}"
                       FontSize="14"
                       Visibility="{Binding FasteningStateVisible,
                                            Converter={StaticResource BoolToVis}}"/>

            <Grid Width="100" Height="86"
                  Tag="{Binding PickupFeederEnabled}"
                  Style="{StaticResource FeederDeviceStyle}"
                  Visibility="{Binding BoltFeederPositionKnown, Converter={StaticResource BoolToVis}}">
                <Grid.RenderTransform>
                    <TranslateTransform X="{Binding BoltPickupFeederMapLeft}"
                                        Y="{Binding BoltPickupFeederMapTop}"/>
                </Grid.RenderTransform>
                <Border Width="100" Height="68"
                        VerticalAlignment="Top"
                        Style="{StaticResource DeviceBodyStyle}">
                    <Grid Margin="10">
                        <Border Height="18"
                                VerticalAlignment="Center"
                                Background="{StaticResource EquipBgBrush}"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="1"/>
                        <Ellipse Width="18" Height="18"
                                 Tag="{Binding PickupFeederBoltDetected}"
                                 ToolTip="Pickup feeder bolt ready"
                                 Style="{StaticResource PresenceLedStyle}"/>
                    </Grid>
                </Border>
                <TextBlock Text="Pick Feeder"
                           Tag="{Binding PickupFeederBoltDetected}"
                           VerticalAlignment="Bottom"
                           Style="{StaticResource FeederLabelStyle}"/>
            </Grid>

            <Grid Width="126" Height="138"
                  Visibility="{Binding FasteningPositionKnown, Converter={StaticResource BoolToVis}}"
                  Panel.ZIndex="20">
                <Grid.RenderTransform>
                    <TranslateTransform X="{Binding BoltFasteningMapLeft}"
                                        Y="{Binding BoltFasteningMapTop}"/>
                </Grid.RenderTransform>
                <Canvas>
                    <Border Canvas.Top="58"
                            Width="126" Height="80"
                            Panel.ZIndex="1"
                            Tag="{Binding Fastening.Motion.IsMoving}"
                            Style="{StaticResource OverheadBodyStyle}"/>
                    <Border Canvas.Left="37.5" Canvas.Top="98"
                            Width="51" Height="6"
                            Panel.ZIndex="3"
                            Background="{StaticResource DividerBrush}"
                            CornerRadius="2"/>
                    <TextBlock Canvas.Left="20.5" Canvas.Top="65"
                               Width="28" Height="14"
                               Panel.ZIndex="4"
                               Text="Pick"
                               FontSize="11"
                               Style="{StaticResource EquipmentRoleLabelStyle}"/>
                    <TextBlock Canvas.Left="45" Canvas.Top="65"
                               Text="{Binding BoltFasteningActiveBolt.Number}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource ActiveToolNumberStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoltFasteningActiveBolt.Head}"
                                                 Value="{x:Static core:FasteningHead.Pickup}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Canvas.Left="71.5" Canvas.Top="65"
                               Width="34" Height="14"
                               Panel.ZIndex="4"
                               Text="Shoot"
                               Tag="{Binding ShootingFeederBoltDetected}"
                               ToolTip="Shooting feeder bolt ready"
                               FontSize="11"
                               Style="{StaticResource FeederLabelStyle}"/>
                    <TextBlock Canvas.Left="107" Canvas.Top="65"
                               Text="{Binding BoltFasteningActiveBolt.Number}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource ActiveToolNumberStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoltFasteningActiveBolt.Head}"
                                                 Value="{x:Static core:FasteningHead.Shooting}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Canvas.Left="20.5" Canvas.Top="84"
                          Width="34" Height="34"
                          Panel.ZIndex="5">
                        <Border Tag="{Binding PickupHeadDown}"
                                Style="{StaticResource ToolHeadFootprintStyle}"/>
                        <Border Width="14" Height="4"
                                Background="{StaticResource TextMutedBrush}"
                                CornerRadius="2"/>
                        <Ellipse Style="{StaticResource VacuumDetectedVisualStyle}"
                                 Visibility="{Binding Fastening.PickupBoltLoaded,
                                                      Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <Grid Canvas.Left="71.5" Canvas.Top="84"
                          Width="34" Height="34"
                          Panel.ZIndex="5">
                        <Border Tag="{Binding ShootingHeadDown}"
                                Style="{StaticResource ToolHeadFootprintStyle}"/>
                        <Ellipse Width="12" Height="12"
                                 Fill="{StaticResource EquipBgBrush}"
                                 Stroke="{StaticResource TextMutedBrush}"
                                 StrokeThickness="2"/>
                        <Ellipse Style="{StaticResource VacuumDetectedVisualStyle}"
                                 Visibility="{Binding Fastening.ShootingBoltLoaded,
                                                      Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Canvas>
            </Grid>

        </Canvas>
    </Grid>
</UserControl>
