<Window x:Class="IBTM.UI.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:IBTM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ui:InputWindow, IsDesignTimeCreatable=False}"
        Title="Digital Inputs"
        Width="720"
        Height="720"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Digital Inputs"
                       Style="{StaticResource TitleStyle}"/>
            <CheckBox Content="Auto Response"
                      ToolTip="Turn off to change sensors manually. Outputs and motion still run."
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      IsChecked="{Binding AutoResponseEnabled, Mode=TwoWay}"
                      Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="0,4,0,18">
            <TextBlock.Style>
                <Style TargetType="TextBlock"
                       BasedOn="{StaticResource PageSubtitleStyle}">
                    <Setter Property="Text" Value="Blue = energized raw input"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                            <Setter Property="Text"
                                    Value="Virtual mode · blue = energized · toggle inputs to simulate the machine"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="2"
              Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SEARCH" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBox Margin="0,6,0,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="UNIT" Style="{StaticResource SectionHeaderStyle}"/>
                <ComboBox Margin="0,6,0,0"
                          ItemsSource="{Binding Areas}"
                          ItemTemplate="{x:Null}"
                          DisplayMemberPath="Value"
                          SelectedItem="{Binding SelectedArea, Mode=TwoWay}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3"
              Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="INPUT" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="1"
                       Text="STATE"
                       Style="{StaticResource SectionHeaderStyle}"/>
        </Grid>

        <ListBox Grid.Row="4"
                 ItemsSource="{Binding FilteredRows}"
                 Style="{StaticResource IoListStyle}"
                 ItemContainerStyle="{StaticResource IoListItemStyle}">
            <ListBox.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}"
                            HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
                <GroupStyle ContainerStyle="{StaticResource IoSectionGroupItemStyle}"
                            HeaderTemplate="{StaticResource IoSectionGroupHeaderTemplate}"/>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Input,
                                                 Converter={StaticResource EnumDescriptionConverter}}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <ContentControl Grid.Column="1"
                                        Tag="{Binding IsOn}"
                                        Style="{StaticResource IoInputStateStyle}"/>
                        <Button Grid.Column="2"
                                Content="Toggle"
                                Style="{StaticResource IoToggleButtonStyle}"
                                Visibility="{Binding IsVirtual,
                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                     Converter={StaticResource BoolToVis}}"
                                Click="OnToggleInput"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
