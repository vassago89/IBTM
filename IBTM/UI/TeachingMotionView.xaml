<UserControl x:Class="IBTM.UI.TeachingMotionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="clr-namespace:IBTM.UI"
    Foreground="{StaticResource TextPrimaryBrush}"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:TeachingViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <x:Array x:Key="JogSpeeds" Type="{x:Type sys:Double}">
            <sys:Double>0.1</sys:Double>
            <sys:Double>1</sys:Double>
            <sys:Double>10</sys:Double>
            <sys:Double>50</sys:Double>
        </x:Array>
        <x:Array x:Key="StepDistances" Type="{x:Type sys:Double}">
            <sys:Double>0.01</sys:Double>
            <sys:Double>0.1</sys:Double>
            <sys:Double>1</sys:Double>
            <sys:Double>10</sys:Double>
            <sys:Double>50</sys:Double>
        </x:Array>
        <Style x:Key="JogDirectionStyle" TargetType="ui:HoldButton" BasedOn="{StaticResource JogButtonStyle}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MoveMode}" Value="{x:Static ui:TeachingMoveMode.Step}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepDirectionStyle" TargetType="Button" BasedOn="{StaticResource JogButtonStyle}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MoveMode}" Value="{x:Static ui:TeachingMoveMode.Step}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="mm" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="{ui:Text 'Current axis position'}" FontWeight="SemiBold"/>
        </DockPanel>
        <UniformGrid Columns="3" Margin="0,2,0,0">
            <StackPanel>
                <TextBlock Text="X" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding Motion.Position.X, StringFormat=F3, TargetNullValue=—, FallbackValue=—}"
                    FontFamily="Consolas" FontSize="15"/>
            </StackPanel>
            <StackPanel Visibility="{Binding Motion.Feedback.HasY, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Y" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding Motion.Position.Y, StringFormat=F3, TargetNullValue=—, FallbackValue=—}"
                    FontFamily="Consolas" FontSize="15"/>
            </StackPanel>
            <StackPanel Visibility="{Binding Motion.Feedback.HasZ, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Z" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding Motion.Position.Z, StringFormat=F3, TargetNullValue=—, FallbackValue=—}"
                    FontFamily="Consolas" FontSize="15"/>
            </StackPanel>
        </UniformGrid>

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="168"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{ui:Text 'Move mode'}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding MoveModes}"
                SelectedItem="{Binding MoveMode, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ManualSpeedLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox Grid.Column="1" ItemsSource="{StaticResource JogSpeeds}"
                SelectedItem="{Binding JogSpeed, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" Text="mm/s" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Margin="0,6,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MoveMode}" Value="{x:Static ui:TeachingMoveMode.Step}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{ui:Text 'Step distance'}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox Grid.Column="1" ItemsSource="{StaticResource StepDistances}"
                SelectedItem="{Binding StepDistance, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1" Margin="2"
                    Visibility="{Binding Motion.Feedback.HasY, Converter={StaticResource BoolToVis}}">
                    <ui:HoldButton Content="{ui:Text '↑ Y+'}" Style="{StaticResource JogDirectionStyle}"
                        PressCommand="{Binding JogCommand}"
                        ReleaseCommand="{Binding JogStopCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.YPlus}"/>
                    <Button Content="{ui:Text '↑ Y+'}" Style="{StaticResource StepDirectionStyle}"
                        Command="{Binding StepCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.YPlus}"/>
                </Grid>
                <Grid Grid.Row="1" Margin="2">
                    <ui:HoldButton Content="{ui:Text '← X−'}" Style="{StaticResource JogDirectionStyle}"
                        PressCommand="{Binding JogCommand}"
                        ReleaseCommand="{Binding JogStopCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.XMinus}"/>
                    <Button Content="{ui:Text '← X−'}" Style="{StaticResource StepDirectionStyle}"
                        Command="{Binding StepCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.XMinus}"/>
                </Grid>
                <Button Grid.Row="1" Grid.Column="1" Content="{ui:Text 'STOP'}" Margin="2" Height="40"
                    Command="{Binding JogStopCommand}" Style="{StaticResource JogStopButtonStyle}"/>
                <Grid Grid.Row="1" Grid.Column="2" Margin="2">
                    <ui:HoldButton Content="{ui:Text 'X+ →'}" Style="{StaticResource JogDirectionStyle}"
                        PressCommand="{Binding JogCommand}"
                        ReleaseCommand="{Binding JogStopCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.XPlus}"/>
                    <Button Content="{ui:Text 'X+ →'}" Style="{StaticResource StepDirectionStyle}"
                        Command="{Binding StepCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.XPlus}"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1" Margin="2"
                    Visibility="{Binding Motion.Feedback.HasY, Converter={StaticResource BoolToVis}}">
                    <ui:HoldButton Content="{ui:Text '↓ Y-'}" Style="{StaticResource JogDirectionStyle}"
                        PressCommand="{Binding JogCommand}"
                        ReleaseCommand="{Binding JogStopCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.YMinus}"/>
                    <Button Content="{ui:Text '↓ Y-'}" Style="{StaticResource StepDirectionStyle}"
                        Command="{Binding StepCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.YMinus}"/>
                </Grid>
            </Grid>
            <StackPanel Grid.Column="1" Width="68" Margin="12,0,0,0"
                Visibility="{Binding Motion.Feedback.HasZ, Converter={StaticResource BoolToVis}}">
                <Grid Margin="2">
                    <ui:HoldButton Content="{ui:Text '↑ Z−'}" Style="{StaticResource JogDirectionStyle}"
                        PressCommand="{Binding JogCommand}"
                        ReleaseCommand="{Binding JogStopCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.ZMinus}"/>
                    <Button Content="{ui:Text '↑ Z−'}" Style="{StaticResource StepDirectionStyle}"
                        Command="{Binding StepCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.ZMinus}"/>
                </Grid>
                <TextBlock Text="Z" Height="44" TextAlignment="Center" Padding="0,12,0,0"
                    FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                <Grid Margin="2">
                    <ui:HoldButton Content="{ui:Text '↓ Z+'}" Style="{StaticResource JogDirectionStyle}"
                        PressCommand="{Binding JogCommand}"
                        ReleaseCommand="{Binding JogStopCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.ZPlus}"/>
                    <Button Content="{ui:Text '↓ Z+'}" Style="{StaticResource StepDirectionStyle}"
                        Command="{Binding StepCommand}"
                        CommandParameter="{x:Static ui:TeachingDirection.ZPlus}"/>
                </Grid>
            </StackPanel>
        </Grid>
        <Button Content="{ui:Text 'Home Selected Unit'}" Command="{Binding HomeCommand}" Margin="0,8,0,0"
            Style="{StaticResource SecondaryButtonStyle}"/>
        <Button Content="{Binding MoveToHorizontalZLabel}"
            Command="{Binding MoveToHorizontalZCommand}" Margin="0,6,0,0"
            Style="{StaticResource SecondaryButtonStyle}"
            Visibility="{Binding Motion.Feedback.HasZ, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</UserControl>
