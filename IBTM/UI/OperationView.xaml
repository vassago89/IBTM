<UserControl x:Class="IBTM.UI.OperationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    xmlns:storage="clr-namespace:IBTM.Storage;assembly=IBTM.Storage"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
    Background="{StaticResource AppBgBrush}" Unloaded="OnViewUnloaded">
    <UserControl.Resources>
        <DataTemplate x:Key="PcbHistoryCard" DataType="{x:Type storage:PcbRecord}">
            <StackPanel MinWidth="94" Margin="8,4">
                <TextBlock Text="{Binding Number, StringFormat={ui:Text 'PCB {0}'}}" FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="ResultText" Margin="0,4,0,0"
                    Text="{Binding Result, Converter={StaticResource UiTextConverter}}"
                    Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Result}" Value="{x:Static core:AssemblyResult.Ok}">
                    <Setter TargetName="ResultText" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="{x:Static core:AssemblyResult.Ng}">
                    <Setter TargetName="ResultText" Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="DoorSensorTemplate" DataType="{x:Type ui:DoorSensorDisplay}">
            <Border x:Name="DoorCard" Margin="4,0" Padding="10,7" CornerRadius="3"
                Background="{StaticResource ControlBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock x:Name="DoorState" Grid.Column="1" Text="{ui:Text 'UNKNOWN'}"
                        Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Input.IsOn}" Value="True">
                    <Setter TargetName="DoorState" Property="Text" Value="{ui:Text 'CLOSED'}"/>
                    <Setter TargetName="DoorState" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Input.IsOn}" Value="False">
                    <Setter TargetName="DoorState" Property="Text" Value="{ui:Text 'OPEN'}"/>
                    <Setter TargetName="DoorState" Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                    <Setter TargetName="DoorCard" Property="Background" Value="{StaticResource AlarmStateBackgroundBrush}"/>
                    <Setter TargetName="DoorCard" Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,8,16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="316"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="12,8"
            Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{ui:Text 'DOORS'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding DoorSensors}" ItemTemplate="{StaticResource DoorSensorTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource EquipBgBrush}"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
            <Viewbox Margin="8" Stretch="Uniform">
                <Canvas Width="1600" Height="{x:Static ui:MachineDiagramLayout.PlanHeight}">
                    <ui:NgConveyorDiagram Canvas.Left="{x:Static ui:MachineDiagramLayout.InspectionLeft}" Canvas.Top="0" Panel.ZIndex="-10"/>
                    <ui:MainConveyorDiagram Canvas.Left="{x:Static ui:MachineDiagramLayout.MainLeft}" Canvas.Top="{x:Static ui:MachineDiagramLayout.MainTop}"
                        Panel.ZIndex="0"/>
                    <ui:PcbTransferDiagram Canvas.Left="{x:Static ui:MachineDiagramLayout.MainLeft}" Canvas.Top="0" Panel.ZIndex="10"/>
                    <ui:BoltFasteningDiagram Canvas.Left="{x:Static ui:MachineDiagramLayout.FasteningLeft}" Canvas.Top="0" Panel.ZIndex="10"/>
                    <ui:InspectionStationDiagram Canvas.Left="{x:Static ui:MachineDiagramLayout.InspectionLeft}" Canvas.Top="0" Panel.ZIndex="10"/>
                </Canvas>
            </Viewbox>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Padding="12"
            Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{ui:Text 'Inspection Image'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Grid.Row="1" Margin="0,4,0,10" Text="{Binding InspectionImageCaption, TargetNullValue={ui:Text 'Waiting for inspection'}}"
                    Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InspectionImageCaption}"/>
                <Border Grid.Row="2" Background="{StaticResource ImageBackgroundBrush}" ClipToBounds="True">
                    <Image Source="{Binding InspectionImage}" Stretch="Uniform"/>
                </Border>
                <Grid Grid.Row="3" Margin="0,14,0,8">
                    <TextBlock Text="{ui:Text 'Latest fastening'}" FontSize="16" FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="{Binding RecentFastening.Result.RecordedAt, StringFormat=HH:mm:ss, TargetNullValue=—, FallbackValue=—}"/>
                </Grid>
                <Border Grid.Row="4" Padding="10" Background="{StaticResource ControlBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <TextBlock Text="{ui:Text 'Waiting for a fastening result'}" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Foreground="{StaticResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentFastening}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentFastening}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RecentFastening.BoltName}" FontSize="14" FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding RecentFastening.BoltName}"
                                    Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="—"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentFastening.Result.Success}" Value="True">
                                                    <Setter Property="Text" Value="{ui:Text 'FASTEN OK'}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RecentFastening.Result.Success}" Value="False">
                                                    <Setter Property="Text" Value="{ui:Text 'FASTEN NG'}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RecentFastening.Result.Source}" Value="{x:Static core:BoltResultSource.DryRun}">
                                                    <Setter Property="Text" Value="{ui:Text 'DRY RUN'}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Margin="0,3,0,8" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding RecentFastening.HeatSink, Converter={StaticResource UiTextConverter}, Mode=OneWay}"/>
                                <Run Text=" · "/><Run Text="{Binding RecentFastening.Head, Converter={StaticResource UiTextConverter}, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{ui:Text 'TURNS · A3 / 360'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding RecentFastening.Result.TotalTurns, StringFormat=0.###, TargetNullValue=—, FallbackValue=—}"
                                FontSize="32" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentFastening.Result.TurnsResult}" Value="{x:Static core:AssemblyResult.Ng}">
                                                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{ui:Text 'Minimum '}"/><Run Text="{Binding RecentFastening.Result.MinimumTurns, Mode=OneWay, StringFormat=0.###, TargetNullValue=—, FallbackValue=—}"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{ui:Text 'Minimum not set'}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentFastening.Result.TurnsResult}" Value="{x:Static core:AssemblyResult.Ok}">
                                                    <Setter Property="Text" Value="{ui:Text 'TURNS OK'}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RecentFastening.Result.TurnsResult}" Value="{x:Static core:AssemblyResult.Ng}">
                                                    <Setter Property="Text" Value="{ui:Text 'TURNS NG'}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RecentFastening.Result.TurnsResult}" Value="{x:Static core:AssemblyResult.Pending}">
                                                    <Setter Property="Text" Value="{ui:Text 'No measurement'}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <UniformGrid Columns="2" Margin="0,10,0,6">
                                <StackPanel>
                                    <TextBlock Text="{ui:Text 'TORQUE / TARGET'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14">
                                        <Run Text="{Binding RecentFastening.Result.Torque, Mode=OneWay, StringFormat=0.##, TargetNullValue=—, FallbackValue=—}"/>
                                        <Run Text=" / "/><Run Text="{Binding RecentFastening.Result.Controller.TargetTorque, Mode=OneWay, StringFormat=0.##, TargetNullValue=—, FallbackValue=—}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{ui:Text 'FASTENING TIME (ms)'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                        Text="{Binding RecentFastening.Result.Controller.FasteningTimeMilliseconds, TargetNullValue=—, FallbackValue=—}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding RecentFastening.Result.Error}" ToolTip="{Binding RecentFastening.Result.Error}"
                                FontSize="11" MaxHeight="30" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                Foreground="{StaticResource AccentRedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="12,8" Height="108"
            Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1" CornerRadius="3">
            <ListBox ItemsSource="{Binding PcbRecords}" SelectedItem="{Binding PcbDetails.Record, Mode=TwoWay}"
                SelectionChanged="OnPcbSelectionChanged"
                ItemTemplate="{StaticResource PcbHistoryCard}" ItemContainerStyle="{StaticResource FlatListItemStyle}"
                Background="{StaticResource ControlBgBrush}" BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{ui:Text 'PCB Results'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Margin="20,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                    Foreground="{StaticResource AccentRedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Machine.PcbHistory.SaveError}"/>
                                            <Setter Property="ToolTip" Value="{Binding Machine.PcbHistory.SaveError}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Machine.PcbHistory.SaveError}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="{Binding PcbHistoryError}"/>
                                                    <Setter Property="ToolTip" Value="{Binding PcbHistoryError}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                        Text="{Binding Machine.PcbHistory.PendingCount, StringFormat={ui:Text 'Pending saves: {0}'}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Machine.PcbHistory.PendingCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="{ui:Text 'Retry save'}" Margin="0,0,8,0" Padding="12,2" MinHeight="24"
                                        Command="{Binding RetryPcbSaveCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Machine.PcbHistory.SaveError}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{ui:Text '← Newer'}" Padding="12,2" MinHeight="24" Margin="0,0,6,0"
                                        Command="{x:Static ScrollBar.PageLeftCommand}" CommandTarget="{Binding ElementName=PcbHistoryScroll}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=PcbHistoryScroll, Path=HorizontalOffset}" Value="0">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{ui:Text 'Older →'}" Padding="12,2" MinHeight="24" Margin="0,0,12,0"
                                        Command="{x:Static ScrollBar.PageRightCommand}" CommandTarget="{Binding ElementName=PcbHistoryScroll}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=PcbHistoryScroll, Path=ScrollableWidth}" Value="0">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Padding="12,2" MinHeight="24" Command="{Binding LoadOlderPcbsCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Content" Value="{ui:Text 'Retry loading'}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PcbHistoryError}" Value="{x:Null}">
                                                        <Setter Property="Content" Value="{ui:Text 'Load older'}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LoadOlderPcbsCommand.IsRunning}" Value="True">
                                                        <Setter Property="Content" Value="{ui:Text 'Loading...'}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="PcbHistoryScroll" Grid.Row="1" Margin="0,4,0,0"
                                Background="{TemplateBinding Background}" Focusable="False" CanContentScroll="True"
                                HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Text" Value="{ui:Text 'PCB history unavailable'}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PcbRecords.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PcbHistoryError}" Value="{x:Null}">
                                                <Setter Property="Text" Value="{ui:Text 'No PCB results'}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LoadOlderPcbsCommand.IsRunning}" Value="True">
                                                <Setter Property="Text" Value="{ui:Text 'Loading PCB results...'}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
