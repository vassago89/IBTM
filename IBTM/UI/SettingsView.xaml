<UserControl x:Class="IBTM.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:SettingsViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource AppBgBrush}">

    <UserControl.Resources>
        <Style x:Key="SettingFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox"
               BasedOn="{StaticResource FieldTextBoxStyle}">
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="SettingSectionTitle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PanelTitleStyle}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="ComboBox"
               BasedOn="{StaticResource FieldComboBoxStyle}">
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <Style TargetType="CheckBox"
               BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,12,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HardwareListItem"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource FlatListItemStyle}">
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="HardwareSignalText" TargetType="TextBlock">
            <Setter Property="Text"
                    Value="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip"
                    Value="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SettingTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True"/>
                            <ContentPresenter Grid.Row="1"
                                               Margin="0,8,0,0"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,-1,-1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                Padding="18,8"
                                Background="{StaticResource ControlBgBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource CardBgBrush}"/>
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{StaticResource ControlFocusBorderBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{StaticResource ControlHoverBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Settings" Style="{StaticResource TitleStyle}"/>
        </StackPanel>

        <TabControl Grid.Row="1"
                    Style="{StaticResource SettingTabControl}"
                    ItemContainerStyle="{StaticResource SettingTabItem}">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1480"
                                HorizontalAlignment="Center"
                                Margin="0,0,8,0">
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Enabled Units" Style="{StaticResource SettingSectionTitle}"/>
                        <UniformGrid Columns="5">
                            <CheckBox Content="Main Conveyor"
                                      IsChecked="{Binding Settings.Units.MainConveyor}"/>
                            <CheckBox Content="PCB Supply"
                                      IsChecked="{Binding Settings.Units.PcbSupply}"/>
                            <CheckBox Content="PCB Placement"
                                      IsChecked="{Binding Settings.Units.PcbPlacement}"/>
                            <CheckBox Content="Pickup Feeder"
                                      IsChecked="{Binding Settings.Units.PickupBoltFeeder}"/>
                            <CheckBox Content="Shooting Bolt Feeder"
                                      IsChecked="{Binding Settings.Units.ShootingBoltFeeder}"/>
                            <CheckBox Content="Bolt Fastening"
                                      IsChecked="{Binding Settings.Units.BoltFastening}"/>
                            <CheckBox Content="Inspection"
                                      IsChecked="{Binding Settings.Units.Inspection}"/>
                            <CheckBox Content="NG Carrier Transfer"
                                      IsChecked="{Binding Settings.Units.NgCarrierTransfer}"/>
                            <CheckBox Content="NG Shuttle"
                                      IsChecked="{Binding Settings.Units.NgShuttle}"/>
                            <CheckBox Content="NG Conveyor"
                                      IsChecked="{Binding Settings.Units.NgConveyor}"/>
                        </UniformGrid>
                        <TextBlock Text="Disabled units skip startup, homing, automatic operation, and teaching."
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="NG Handling" Style="{StaticResource SettingSectionTitle}"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Alarm Count" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.NgConveyor.AlarmCarrierCount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Transfer Speed (mm/s)"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.NgCarrierTransfer.Speed, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Motion" Style="{StaticResource SettingSectionTitle}"/>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Motion Group" Style="{StaticResource SettingFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding MotionGroups}"
                                          SelectedItem="{Binding SelectedMotionGroup, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Horizontal Speed (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding CurrentMotionSettings.HorizontalSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0"
                                        Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Z Speed (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding CurrentMotionSettings.ZSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Hardware">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1480"
                                HorizontalAlignment="Center"
                                Margin="0,0,8,0">
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Actuator Feedback"
                                       Style="{StaticResource SettingSectionTitle}"
                                       Margin="0"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Input Wait Timeout (ms)"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,8,0"/>
                                <TextBox Text="{Binding Settings.Options.TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="6,0,6,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OUTPUT" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="ON INPUT"
                                       Style="{StaticResource SettingFieldLabel}"/>
                            <TextBlock Grid.Column="2" Text="OFF INPUT"
                                       Style="{StaticResource SettingFieldLabel}"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding FeedbackMappings}"
                                 Style="{StaticResource PanelListStyle}"
                                 MaxHeight="240"
                                 ItemContainerStyle="{StaticResource HardwareListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key, Converter={StaticResource EnumDescriptionConverter}}"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.InputSignals, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Value.OnInput, Mode=TwoWay}"
                                                  MinWidth="0"
                                                  Padding="5,3"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding DataContext.InputSignals, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Value.OffInput, Mode=TwoWay}"
                                                  MinWidth="0"
                                                  Padding="5,3"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Hardware Mapping"
                                   Style="{StaticResource SettingSectionTitle}"
                                   Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Motion / IO Driver" Style="{StaticResource SettingFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ControlDrivers}"
                                          SelectedItem="{Binding Settings.Drivers.Control, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Home Horizontal (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Home.HorizontalSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="Home Z (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Home.ZSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,16,0">
                                <TextBlock Text="Pulse Length (mm/pulse)"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding CurrentMotionHardwareSettings.MillimetersPerPulse, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="INPUTS" Style="{StaticResource SettingFieldLabel}"/>
                                <ListBox ItemsSource="{Binding InputMappingView}" Height="420"
                                         Style="{StaticResource PanelListStyle}"
                                         ItemContainerStyle="{StaticResource HardwareListItem}">
                                    <ListBox.GroupStyle>
                                        <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}"
                                                    HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                               <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="58"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource HardwareSignalText}"/>
                                                <TextBox Grid.Column="1" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="0" Padding="5,3" Margin="4,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="OUTPUTS" Style="{StaticResource SettingFieldLabel}"/>
                                <ListBox ItemsSource="{Binding OutputMappingView}" Height="420"
                                         Style="{StaticResource PanelListStyle}"
                                         ItemContainerStyle="{StaticResource HardwareListItem}">
                                    <ListBox.GroupStyle>
                                        <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}"
                                                    HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="58"/>
                                                    <ColumnDefinition Width="58"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource HardwareSignalText}"/>
                                                <TextBox Grid.Column="1" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="0" Padding="5,3" Margin="4,0"/>
                                                <TextBox Grid.Column="2" Text="{Binding OffNumber, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Reverse output channel"
                                                         MinWidth="0" Padding="5,3" Margin="4,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="AXIS  NUMBER  MIN  MAX"
                                           Style="{StaticResource SettingFieldLabel}"/>
                                <ListBox ItemsSource="{Binding AxisMappingView}" Height="420"
                                         Style="{StaticResource PanelListStyle}"
                                         ItemContainerStyle="{StaticResource HardwareListItem}">
                                    <ListBox.GroupStyle>
                                        <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}"
                                                    HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="48"/>
                                                     <ColumnDefinition Width="54"/>
                                                     <ColumnDefinition Width="54"/>
                                                 </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource HardwareSignalText}"/>
                                                 <TextBox Grid.Column="1" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                                          MinWidth="0" Padding="5,3" Margin="4,0"/>
                                                 <TextBox Grid.Column="2"
                                                           Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}"
                                                           MinWidth="0" Padding="4,3" Margin="2,0"/>
                                                 <TextBox Grid.Column="3"
                                                           Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}"
                                                          MinWidth="0" Padding="4,3" Margin="2,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Devices &amp; Safety">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1480"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="AJIN Controller" Style="{StaticResource SettingSectionTitle}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,4,10">
                                        <TextBlock Text="Interrupt Number" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Ajin.InterruptNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,10">
                                        <TextBlock Text="Motion Parameter File" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Ajin.MotionParameterFile, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Acceleration Multiplier" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Ajin.AccelerationMultiplier, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Home Speed 2 Ratio" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Ajin.HomeSecondVelocityRatio, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,10,4,0">
                                        <TextBlock Text="Home Speed 3 Ratio" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Ajin.HomeThirdVelocityRatio, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,10,0,0">
                                        <TextBlock Text="Home Final Speed Ratio" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Ajin.HomeLastVelocityRatio, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,10,4,0">
                                        <TextBlock Text="Home Acceleration 2 Ratio" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Ajin.HomeSecondAccelerationRatio, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Inspection Camera" Style="{StaticResource SettingSectionTitle}"/>
                                <TextBlock Text="Device ID / Serial Number" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.InspectionCamera.DeviceId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <TextBlock Text="Exposure (us)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.InspectionCamera.ExposureMicroseconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <TextBlock Text="Gain" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.InspectionCamera.Gain, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Frame Timeout (ms)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.InspectionCamera.FrameTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Live Preview (fps)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.InspectionCamera.LiveViewFramesPerSecond, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="FOV Width (mm)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.InspectionCamera.FieldOfViewWidthMillimeters, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="FOV Height (mm)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.InspectionCamera.FieldOfViewHeightMillimeters, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Bolt Recess Model" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.BoltInspection.ModelFile, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Mask Threshold" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.BoltInspection.MaskThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Minimum Mask Ratio" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.BoltInspection.MinimumMaskRatio, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="HANTAS ADC"
                                           Style="{StaticResource SettingSectionTitle}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,4,10">
                                        <TextBlock Text="COM Port" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Hantas.PortName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,10">
                                        <TextBlock Text="Baud Rate" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Hantas.BaudRate, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Pickup Address" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Hantas.PickupSlaveAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Shooting Address" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Hantas.ShootingSlaveAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,10,4,0">
                                        <TextBlock Text="Response Timeout (ms)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Hantas.ResponseTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,10,0,0">
                                        <TextBlock Text="Fastening Timeout (ms)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Hantas.FasteningTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="AlphaMotion Controller" Style="{StaticResource SettingSectionTitle}"/>
                                <TextBlock Text="Controller Number" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.AlphaMotion.ControllerNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <TextBlock Text="Station Number" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.AlphaMotion.StationNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <TextBlock Text="Communication Speed" Style="{StaticResource SettingFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding AlphaMotionCommunicationSpeeds}"
                                          SelectedItem="{Binding Settings.AlphaMotion.CommunicationSpeed, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Controllers" Style="{StaticResource SettingSectionTitle}"/>
                                <TextBlock Text="Camera Driver" Style="{StaticResource SettingFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CameraDrivers}"
                                          SelectedItem="{Binding Settings.Drivers.Camera, Mode=TwoWay}"
                                          Margin="0,0,0,10"/>
                                <TextBlock Text="Inspection Algorithm" Style="{StaticResource SettingFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding InspectionAlgorithms}"
                                          SelectedItem="{Binding Settings.Drivers.Inspection, Mode=TwoWay}"
                                          Margin="0,0,0,10"/>
                                <StackPanel Margin="0,0,0,12"
                                            Visibility="{Binding IsVirtualCamera, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Virtual Camera Image" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBlock Text="{Binding VirtualImageName, TargetNullValue=Generated image}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LoadVirtualImageCommand.IsRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Content="Open Image" Command="{Binding LoadVirtualImageCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Use Generated" Command="{Binding ClearVirtualImageCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="One fixed image for every capture. Select Tiny U-Net and restart to use the trained model."
                                               TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding VirtualImageError}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Bolt Head Driver" Style="{StaticResource SettingFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding BoltDrivers}"
                                          SelectedItem="{Binding Settings.Drivers.Bolt, Mode=TwoWay}"
                                          Margin="0,0,0,10"/>
                                <TextBlock Text="Light Controller Connection" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding Settings.Lighting.Connection, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Light Channel" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Lighting.InspectionChannel, UpdateSourceTrigger=PropertyChanged}" MinWidth="0"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Light Level" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.Lighting.InspectionLevel, UpdateSourceTrigger=PropertyChanged}" MinWidth="0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Bolt Supply"
                                           Style="{StaticResource SettingSectionTitle}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Pickup Timeout (ms)"
                                                   Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.BoltFeeder.PickupTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Shooting Feeder Timeout (ms)"
                                                   Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox Text="{Binding Settings.BoltFeeder.ShootingTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Interlocks" Style="{StaticResource SettingSectionTitle}"/>
                        <UniformGrid Columns="2">
                            <CheckBox Content="Emergency Stop"
                                      IsChecked="{Binding Settings.Options.UseEmergencyStop}"/>
                            <CheckBox Content="Reset Button"
                                      IsChecked="{Binding Settings.Options.UseResetButton}"/>
                            <CheckBox Content="Door Interlock"
                                      IsChecked="{Binding Settings.Options.UseDoorInterlock}"/>
                            <CheckBox Content="Air Pressure Interlock"
                                      IsChecked="{Binding Settings.Options.UseAirPressureInterlock}"/>
                        </UniformGrid>
                        <TextBlock Text="Enable only after I/O mapping and electrical behavior are verified."
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,10,0,0">
            <Grid>
                <TextBlock Text="Driver, unit, connection, I/O and axis changes apply after restart."
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <Button Content="Save Settings"
                        Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right"
                        MinWidth="132"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
