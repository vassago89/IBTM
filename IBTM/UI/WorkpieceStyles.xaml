<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:IBTM.UI"
                    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core">

    <Style x:Key="PcbFootprintStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource PcbWidth}"/>
        <Setter Property="Height" Value="{StaticResource PcbHeight}"/>
        <Setter Property="Background" Value="{StaticResource MaterialPcbBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MaterialPcbBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <Style x:Key="UnknownPcbFootprintStyle"
           TargetType="Border"
           BasedOn="{StaticResource PcbFootprintStyle}">
        <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
    </Style>

    <Style x:Key="PcbSlotStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource PcbSlotWidth}"/>
        <Setter Property="Height" Value="{StaticResource PcbSlotHeight}"/>
        <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeatSinkPocketStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="True">
                <Setter Property="Background" Value="{StaticResource HeatSinkBodyBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource HeatSinkBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeatSinkPocketLabelStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MapHintStyle}">
        <Setter Property="Margin" Value="4,3,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Panel.ZIndex" Value="3"/>
    </Style>

    <Style x:Key="CarrierPcbSlotStyle" TargetType="ContentControl">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2" CornerRadius="3">
                        <Grid>
                            <Border Style="{StaticResource PcbSlotStyle}"/>
                            <Border Style="{StaticResource PcbFootprintStyle}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CarrierStyle" TargetType="{x:Type ui:CarrierView}">
        <Setter Property="Width" Value="{StaticResource CarrierWidth}"/>
        <Setter Property="Height" Value="{StaticResource CarrierHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:CarrierView}">
                    <Border Background="{StaticResource CarrierBodyBrush}" BorderBrush="{StaticResource CarrierBrush}"
                            BorderThickness="2" CornerRadius="4">
                        <Grid Margin="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="9"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Tag="{TemplateBinding HeatSink1Present}" Style="{StaticResource HeatSinkPocketStyle}">
                                <Grid>
                                    <TextBlock Text="HS1" Style="{StaticResource HeatSinkPocketLabelStyle}"
                                               Visibility="{Binding HeatSink1Present, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                                    <ContentControl x:Name="Pcb1" Content="{TemplateBinding Pcb1Placed}"
                                                    Style="{StaticResource CarrierPcbSlotStyle}"/>
                                    <TextBlock Text="{Binding HeatSink1Result, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EnumDescriptionConverter}}"
                                               Tag="{Binding HeatSink1Result, RelativeSource={RelativeSource TemplatedParent}}"
                                               Style="{StaticResource ResultTextStyle}"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Tag="{TemplateBinding HeatSink2Present}" Style="{StaticResource HeatSinkPocketStyle}">
                                <Grid>
                                    <TextBlock Text="HS2" Style="{StaticResource HeatSinkPocketLabelStyle}"
                                               Visibility="{Binding HeatSink2Present, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                                    <ContentControl x:Name="Pcb2" Content="{TemplateBinding Pcb2Placed}"
                                                    Style="{StaticResource CarrierPcbSlotStyle}"/>
                                    <TextBlock Text="{Binding HeatSink2Result, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EnumDescriptionConverter}}"
                                               Tag="{Binding HeatSink2Result, RelativeSource={RelativeSource TemplatedParent}}"
                                               Style="{StaticResource ResultTextStyle}"/>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.ColumnSpan="3"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowPcbSlots" Value="True"/>
                                <Condition Property="HeatSink1Present" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Pcb1" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowPcbSlots" Value="True"/>
                                <Condition Property="HeatSink2Present" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Pcb2" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="ActiveHeatSink" Value="{x:Static core:HeatSinkSlot.HeatSink1}">
                            <Setter TargetName="Pcb1" Property="Background" Value="{StaticResource MapActiveBackgroundBrush}"/>
                            <Setter TargetName="Pcb1" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                        </Trigger>
                        <Trigger Property="ActiveHeatSink" Value="{x:Static core:HeatSinkSlot.HeatSink2}">
                            <Setter TargetName="Pcb2" Property="Background" Value="{StaticResource MapActiveBackgroundBrush}"/>
                            <Setter TargetName="Pcb2" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ui:CarrierView}" BasedOn="{StaticResource CarrierStyle}"/>
</ResourceDictionary>
