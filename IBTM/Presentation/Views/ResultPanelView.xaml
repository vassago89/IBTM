<UserControl x:Class="IBTM.Presentation.Views.ResultPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IBTM.Presentation.Converters">

    <UserControl.Resources>
        <conv:NgSlotFillConverter       x:Key="NgSlotFill"/>
    </UserControl.Resources>

    <StackPanel Margin="8,4">
        <!-- 검사 이미지 썸네일 -->
        <Border CornerRadius="4" BorderThickness="1" BorderBrush="#404040"
                Background="#252525" Height="120" Margin="0,0,0,6"
                HorizontalAlignment="Stretch" ClipToBounds="True">
            <Grid>
                <Image Source="{Binding State.InspectionImage}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <!-- 이미지 없을 때 플레이스홀더 -->
                <TextBlock Text="INSPECT" FontSize="11"
                           Foreground="#505050" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.InspectionImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 결과 오버레이 배지 -->
                <Border Width="68" Height="28" CornerRadius="6" Margin="0,0,6,6"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsGoodPath}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Background" Value="#DD102A10"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#3FB950" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State.IsNgPath}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Background" Value="#DD2A1010"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#F85149" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding State.LastRouteText}" FontSize="14" FontWeight="Bold" FontFamily="Consolas"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State.IsGoodPath}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State.IsNgPath}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- NG 적재 -->
        <TextBlock Text="NG STACK" Style="{StaticResource SectionHeaderStyle}"
                   Foreground="{StaticResource AccentRedBrush}" Margin="0,6,0,4" Opacity="0.8"/>
        <ItemsControl ItemsSource="{Binding State.NgStackSlots}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Rectangle Width="22" Height="22" Margin="0,0,3,0"
                               Stroke="#4A3030" StrokeThickness="1" RadiusX="3" RadiusY="3"
                               Fill="{Binding IsFilled, Converter={StaticResource NgSlotFill}}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock FontFamily="Consolas" FontSize="10" FontWeight="Bold" Margin="0,3,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#606060"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.NgStackAlarm}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            <Run Text="{Binding State.NgStackCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding State.NgStackMaxCount, Mode=OneWay}"/>
        </TextBlock>

        <!-- SMEMA -->
        <TextBlock FontSize="9" FontWeight="SemiBold" Margin="0,14,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="SMEMA  OUT"/>
                    <Setter Property="Foreground" Value="#606060"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.SmemaWaiting}" Value="True">
                            <Setter Property="Text" Value="SMEMA  WAIT"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State.SmemaReady}" Value="True">
                            <Setter Property="Text" Value="SMEMA  OK"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

    </StackPanel>
</UserControl>
