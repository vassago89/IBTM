<Window x:Class="IBTM.UI.StartConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI" xmlns:app="clr-namespace:IBTM"
    mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
    Title="{ui:Text 'Start confirmation'}" Width="1600" Height="860" MinWidth="1100" MinHeight="660"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource PanelBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
    Loaded="OnLoaded" Closed="OnClosed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16" MinHeight="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{ui:Text 'Start confirmation'}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{ui:Text 'Recipe'}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Recipes.Current.Name, Mode=OneTime}" FontWeight="SemiBold" MaxWidth="400"
                    TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border Background="{StaticResource ControlBgBrush}" Padding="12,8" Margin="20,0,0,0">
                    <TextBlock Text="{Binding ModeText}"/>
                </Border>
                <Border Background="{StaticResource AttentionBackgroundBrush}" Padding="12,8" Margin="8,0,0,0"
                    Visibility="{Binding State.RepeatEnabled, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{ui:Text 'REPEAT'}" Foreground="{StaticResource AccentAmberBrush}"/>
                </Border>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="324"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource EquipBgBrush}" Padding="12" Margin="0,0,16,0" ClipToBounds="True">
                <ui:MachineDiagramView ShowStartCheck="True" IsEnabled="False" KeyboardNavigation.TabNavigation="None"/>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="108"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Padding="12" Margin="0,0,0,12" Background="{StaticResource ControlBgBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="17"
                            FontWeight="SemiBold" MinHeight="24" MaxHeight="48">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding StartBlock, Converter={StaticResource UiTextConverter}}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStartReviewAllowed}" Value="True">
                                            <Setter Property="Text" Value="{ui:Text 'Ready to start'}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CheckStartCommand.IsRunning}" Value="True">
                                            <Setter Property="Text" Value="{ui:Text 'Checking...'}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Text="{Binding AlarmMessage}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                            Margin="0,8,0,0" Foreground="{StaticResource AccentRedBrush}"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{ui:Text 'Material check'}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Machine.StartChecks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CheckRow" Padding="12,9" Margin="0,0,0,6" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource DividerBrush}" Background="{StaticResource ControlBgBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Key, Converter={StaticResource UiTextConverter}}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CheckState" Text="{Binding Value, Converter={StaticResource UiTextConverter}}"
                                        Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static app:StartCheckState.Empty}">
                                    <Setter TargetName="CheckRow" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                    <Setter TargetName="CheckState" Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static app:StartCheckState.MaterialRemaining}">
                                    <Setter TargetName="CheckRow" Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                                    <Setter TargetName="CheckState" Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static app:StartCheckState.UnfinishedCarrier}">
                                    <Setter TargetName="CheckRow" Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                                    <Setter TargetName="CheckState" Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static app:StartCheckState.Unknown}">
                                    <Setter TargetName="CheckRow" Property="BorderBrush" Value="{StaticResource AccentAmberBrush}"/>
                                    <Setter TargetName="CheckState" Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static app:StartCheckState.Completed}">
                                    <Setter TargetName="CheckRow" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                    <Setter TargetName="CheckState" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static app:StartCheckState.HandoffReady}">
                                    <Setter TargetName="CheckRow" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                    <Setter TargetName="CheckState" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Content="{ui:Text 'Cancel · Esc'}" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Left" MinWidth="130" Height="44" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Grid.Column="1" Content="{ui:Text 'Check again'}" Command="{Binding CheckStartCommand}"
                MinWidth="150" Height="44" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button x:Name="ConfirmButton" Grid.Column="2" Content="{ui:Text 'Confirm and START'}" Click="OnConfirmClick" MinWidth="190" Height="44">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsStartReviewAllowed}" Value="True"/>
                                    <Condition Binding="{Binding CheckStartCommand.IsRunning}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True"/>
                                <Setter Property="Background" Value="{StaticResource PrimaryButtonBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
