<UserControl x:Class="IBTM.UI.InspectionTeachingView" x:Name="EditorRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
    xmlns:storage="clr-namespace:IBTM.Storage;assembly=IBTM.Storage"
    mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=ui:InspectionTeachingViewModel, IsDesignTimeCreatable=False}"
    Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource AppBgBrush}"
    Validation.ErrorTemplate="{x:Null}">
    <UserControl.BindingGroup><BindingGroup Name="InspectionInputs"/></UserControl.BindingGroup>
    <UserControl.Resources>
        <CollectionViewSource x:Key="InspectionPoints" Source="{Binding Points}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="HeatSink"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" IsEnabled="{Binding IsIdle}">
                <TextBlock Text="{ui:Text 'Recipe'}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding RecipeNames}"
                    SelectedItem="{Binding SelectedRecipeName, Mode=TwoWay, BindingGroupName={x:Null}}"
                    AutomationProperties.Name="{ui:Text 'Recipe'}" Width="180" Margin="0,0,6,0"/>
                <Button Content="{ui:Text 'Load'}" Command="{Binding LoadRecipeCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" Margin="0,0,6,0"/>
                <Button Command="{Binding SaveCommand}" MinWidth="100">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Content" Value="{ui:Text 'Save'}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveCommand.IsRunning}" Value="True">
                                    <Setter Property="Content" Value="{ui:Text 'Saving...'}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoaded}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=EditorRoot, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <TextBlock Text="{ui:Text 'Inspection Setup'}" Style="{StaticResource TitleStyle}"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,10,0">
                <TabControl Style="{StaticResource SectionTabs}" ItemContainerStyle="{StaticResource SectionTab}">
                    <TabItem Header="{ui:Text 'Taught points'}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Preview.Recipe.Name}" Style="{StaticResource PanelTitleStyle}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Source={StaticResource InspectionPoints}}" SelectedItem="{Binding SelectedPoint, BindingGroupName={x:Null}}"
                                IsEnabled="{Binding IsIdle}" ItemContainerStyle="{StaticResource FlatListItemStyle}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                Background="{StaticResource EquipBgBrush}" BorderThickness="0">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate DataType="{x:Type data:CollectionViewGroup}">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource UiTextConverter}}"
                                                    Foreground="{StaticResource TextMutedBrush}" Margin="8,10,8,4"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate><DataTemplate DataType="{x:Type ui:InspectionPoint}">
                                    <StackPanel Margin="4,4"><TextBlock Text="{Binding Name}" Height="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding PositionLabel}" Height="30" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding PositionLabel}"
                                            Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{ui:Text 'Saved results'}">
                        <Grid IsEnabled="{Binding IsIdle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1.2*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button Content="{ui:Text 'Refresh List'}" Command="{Binding RefreshHistoryCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" Margin="0,0,3,0"/>
                                <Button Content="{ui:Text 'Load Older'}" Command="{Binding LoadOlderCommand}" IsEnabled="{Binding HasOlder}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="8,5" Margin="3,0,0,0"/>
                            </UniformGrid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Records}"
                                SelectedItem="{Binding SelectedRecord, BindingGroupName={x:Null}}"
                                ItemContainerStyle="{StaticResource FlatListItemStyle}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                Background="{StaticResource EquipBgBrush}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type storage:PcbRecord}">
                                        <StackPanel Margin="4,5">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding InspectionResult, Converter={StaticResource UiTextConverter}}" FontSize="12" Margin="6,0,0,0"/>
                                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                    <Run Text="PCB "/><Run Text="{Binding Number, Mode=OneWay}"/>
                                                    <Run Text=" · "/><Run Text="{Binding HeatSink, Mode=OneWay, Converter={StaticResource UiTextConverter}}"/>
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding RecipeName}"
                                                Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0">
                                                <Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}}"/>
                                                <Run Text=" · "/><Run Text="{Binding RecipeName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="0,10,0,10">
                                <Button Content="{ui:Text 'Load PCB Images'}" Command="{Binding LoadRecordCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="8,5"/>
                                <TextBlock Text="{Binding LoadedRecord.Number, StringFormat={ui:Text 'PCB {0} · images'}, TargetNullValue={ui:Text 'No PCB loaded'}, FallbackValue={ui:Text 'No PCB loaded'}}"
                                    FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                            </StackPanel>
                            <ListBox Grid.Row="3" ItemsSource="{Binding HistoryImages}"
                                SelectedItem="{Binding SelectedHistoryImage, BindingGroupName={x:Null}}"
                                ItemContainerStyle="{StaticResource FlatListItemStyle}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                Background="{StaticResource EquipBgBrush}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:PcbInspectionImageItem}">
                                        <Grid Margin="8,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Image Source="{Binding Image}" Width="48" Height="40" Stretch="Uniform"/>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Verdict}" FontWeight="SemiBold" Margin="8,0,4,0"/>
                                                    <TextBlock Text="{Binding Title}" Height="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Details}" Height="30" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"
                                                    FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Error}" Height="16" TextTrimming="CharacterEllipsis" ToolTip="{Binding Error}" FontSize="11" Foreground="{StaticResource AccentAmberBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="4" Content="{ui:Text 'Load for Reinspection'}" Command="{Binding UseHistoryImageCommand}"
                                Padding="8,6" Margin="0,8,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HistoryImageTarget}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <WrapPanel IsEnabled="{Binding IsIdle}">
                            <Button Content="{ui:Text 'Inspect This Image'}" Command="{Binding InspectCommand}" Margin="0,0,8,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="IsEnabled" Value="{Binding IsInspectAllowed}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=EditorRoot, Path=(Validation.HasError)}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{ui:Text 'Show Reference Image'}" Command="{Binding ShowRecipeImageCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ImageSource}" Height="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding ImageSource}"/>
                        <TextBlock Text="{Binding OriginalResult}" Height="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalResult}"
                            Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                        <StackPanel IsEnabled="{Binding IsIdle}" Margin="0,8,0,0">
                            <TextBlock Text="{ui:Text 'Reference image unavailable'}" Height="18" Foreground="{StaticResource AccentAmberBrush}" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPoint.Metadata}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <WrapPanel Visibility="{Binding IsDataMatrixSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{ui:Text 'Data Matrix'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox Content="{ui:Text 'Extended search'}" IsChecked="{Binding DataMatrix.TryHarder, BindingGroupName={x:Null}}"
                                    VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox Content="{ui:Text 'Inverted colors'}" IsChecked="{Binding DataMatrix.TryInverted, BindingGroupName={x:Null}}"
                                    VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox Content="{ui:Text 'Rotation'}" IsChecked="{Binding DataMatrix.AutoRotate, BindingGroupName={x:Null}}"
                                    VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox Content="{ui:Text 'Pure barcode'}" IsChecked="{Binding DataMatrix.PureBarcode, BindingGroupName={x:Null}}"
                                    VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{ui:Text 'Binary (0–255; blank = auto)'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="70" Text="{Binding Preview.DataMatrixThreshold, BindingGroupName=InspectionInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPoint.Bolt, FallbackValue={x:Null}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                                    <TextBlock Text="{ui:Text 'Min. turns (0 = no check)'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="70" Text="{Binding SelectedPoint.Bolt.MinimumTurns, Mode=TwoWay, BindingGroupName=InspectionInputs, TargetNullValue=0, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                                <TextBlock Text="{ui:Text 'Bolt presence'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                    <TextBlock Text="{ui:Text 'Threshold (0–255)'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="70" Text="{Binding Preview.BrightnessThreshold, BindingGroupName=InspectionInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{ui:Text 'Minimum bright (%)'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="70" Text="{Binding Preview.MinimumBrightPercent, BindingGroupName=InspectionInputs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{ui:Text 'Original · edit ROI'}" FontWeight="SemiBold" Margin="0,0,6,6"/>
                        <TextBlock Grid.Column="1" Text="{Binding Preview.BinaryDescription}" FontWeight="SemiBold" Height="20"
                            TextTrimming="CharacterEllipsis" ToolTip="{Binding Preview.BinaryDescription}" Margin="6,0,0,6"/>
                        <Border Grid.Row="1" Background="{StaticResource ImageBackgroundBrush}" Margin="0,0,6,0">
                            <ui:InspectionImageView x:Name="InspectionImage" Source="{Binding Preview.Image}"
                                SourceRegion="{Binding Preview.Region}" RegionCommand="{Binding DrawRegionCommand}"
                                IsEnabled="{Binding IsDrawRegionAllowed}" ShowCrosshair="True" Cursor="Cross"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource ImageBackgroundBrush}" Margin="6,0,0,0">
                            <ui:InspectionImageView Source="{Binding Preview.Image}" SourceRegion="{Binding Preview.Region}"
                                SourceOverlay="{Binding Preview.Overlay}" ShowCrosshair="False"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Height="26" Margin="0,8,0,0" Text="{Binding Preview.Result}" FontWeight="SemiBold" FontSize="17"
                        TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Preview.Result}"/>
                </Grid>
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{ui:Text 'Check the highlighted input.'}"
                    Style="{StaticResource StatusMessageStyle}"
                    Visibility="{Binding ElementName=EditorRoot, Path=(Validation.HasError), Converter={StaticResource BoolToVis}}"
                    TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}"/>
                <TextBlock Text="{Binding Error}" Style="{StaticResource StatusMessageStyle}" Foreground="{StaticResource AccentRedBrush}"/>
                <TextBlock Text="{Binding Message}" Style="{StaticResource StatusMessageStyle}" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
