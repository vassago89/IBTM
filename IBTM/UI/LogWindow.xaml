<Window x:Class="IBTM.UI.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:IBTM.UI"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ui:LogWindowViewModel, IsDesignTimeCreatable=False}"
        Title="Logs" Width="1100" Height="720" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBgBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox Content="Pause display" IsChecked="{Binding IsPaused}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Copy" Click="OnCopy" ToolTip="Copy selected text, or all displayed logs if nothing is selected."
                        Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" Margin="0,0,8,0"/>
                <Button Content="Copy all" Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" Click="OnCopyAll" Margin="0,0,8,0"/>
                <Button Content="Clear view" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="16,6"/>
            </StackPanel>
            <TextBlock Text="Logs" Style="{StaticResource TitleStyle}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Grid.Row="1" Margin="0,8,0,16" Style="{StaticResource PageSubtitleStyle}"
                   Text="Newest messages first. Drag across lines to select, or use Ctrl+A / Ctrl+C. Selecting text pauses the display; file logging continues." TextWrapping="Wrap"/>
        <TextBox x:Name="LogText" Grid.Row="2" Text="{Binding Text, Mode=OneWay}"
                 IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True"
                 IsInactiveSelectionHighlightEnabled="True" SelectionChanged="OnTextSelectionChanged"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" Padding="8"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     Foreground="{StaticResource TextSecondaryBrush}" Padding="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>
