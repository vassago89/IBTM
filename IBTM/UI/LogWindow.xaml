<Window x:Class="IBTM.UI.LogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:LogViewModel, IsDesignTimeCreatable=False}"
    Title="{ui:Text 'Logs'}"
    Width="1400"
    Height="860"
    MinWidth="680"
    MinHeight="420"
    FontSize="14" WindowStartupLocation="CenterOwner"
    Background="{StaticResource AppBgBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox Content="{ui:Text 'Pause display'}" IsChecked="{Binding IsPaused}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="{ui:Text 'Copy'}" Command="{Binding CopyCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" Margin="0,0,8,0"/>
                <Button Content="{ui:Text 'Copy all'}" Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" Command="{Binding CopyAllCommand}" Margin="0,0,8,0"/>
                <Button Content="{ui:Text 'Clear Display'}" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="16,6"/>
            </StackPanel>
            <TextBlock Text="{ui:Text 'Logs'}" Style="{StaticResource TitleStyle}" VerticalAlignment="Center"/>
        </DockPanel>
        <ui:LogTextBox x:Name="LogText" Style="{StaticResource FieldTextBoxStyle}" Grid.Row="2" Margin="0,12,0,0"
            Text="{Binding Text, Mode=OneWay}"
            IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" IsInactiveSelectionHighlightEnabled="True"
            SelectionText="{Binding SelectedText, Mode=TwoWay}" IsPaused="{Binding IsPaused, Mode=TwoWay}" FontFamily="Consolas" FontSize="14" TextWrapping="NoWrap" Padding="8"
            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ScrollViewer Height="36" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding ClipboardError}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ClipboardError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Log.FileError, StringFormat={ui:Text 'FILE ERROR: {0}'}}"
                        Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Log.FileError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="{ui:Text 'Machine log'}" Width="164" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Log.FilePath, Mode=OneWay, TargetNullValue={ui:Text 'File logging disabled'}}"
                    IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,4"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="{ui:Text 'ADC communication log'}" Width="164" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Log.CommunicationFilePath, Mode=OneWay, TargetNullValue={ui:Text 'Communication logging disabled'}}"
                    IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" Padding="0,4"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
