<UserControl x:Class="IBTM.UI.BoltFasteningDiagram"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
    Width="408"
    Height="650">
    <UserControl.Resources>
        <Style x:Key="FeederSensorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                    <Setter Property="Stroke" Value="{StaticResource AccentGreenBrush}"/>
                </Trigger>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>False</sys:Boolean></Trigger.Value>
                    <Setter Property="Fill" Value="{StaticResource EquipBgBrush}"/>
                    <Setter Property="Stroke" Value="{StaticResource MachineStructureBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AdcSignalStateStyle" TargetType="TextBlock" BasedOn="{StaticResource SmemaSignalStateStyle}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="AdcAlarmStateStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="Tag"><Trigger.Value><sys:UInt16>0</sys:UInt16></Trigger.Value>
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FeederCommandLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource EquipmentRoleLabelStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Canvas>
            <Grid Canvas.Left="{x:Static ui:MachineDiagramLayout.HeaderInset}"
                Canvas.Top="{x:Static ui:MachineDiagramLayout.HeaderTop}"
                Width="388">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{ui:Text 'Bolt Fastening'}" Style="{StaticResource TitleStyle}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CycleTime" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                    FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding Fastening.Station.LastCycleSeconds, StringFormat='CT · {0:0.0} s',
                        TargetNullValue='CT · —', FallbackValue='CT · —'}"/>
                <Button Grid.Column="2" Margin="10,0,0,0" Content="{ui:Text 'Test bolts'}" Command="{Binding OpenBoltStationTestCommand}"
                    Visibility="{Binding State.ManualMode, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="13"/>
            </Grid>
            <Border Canvas.Left="{x:Static ui:MachineDiagramLayout.HeaderInset}"
                Canvas.Top="{x:Static ui:MachineDiagramLayout.StatusTop}"
                Width="{x:Static ui:MachineDiagramLayout.PlateWidth}" Height="54" Tag="{Binding BoltDisplayState}"
                Style="{StaticResource StationStateBadgeStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryStateTextStyle}">
                                <Setter Property="Text" Value="{Binding BoltDisplayState, Converter={StaticResource UiTextConverter}}"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding BoltDisplayState}" Value="{x:Static ui:StationDisplayState.Working}"/>
                                            <Condition Binding="{Binding FasteningStateVisible}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="{Binding FasteningState, Converter={StaticResource UiTextConverter}}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel Margin="0,2,0,0" TextBlock.FontSize="13" TextBlock.Foreground="{StaticResource TextSecondaryBrush}">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoltFasteningActiveBolt}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Left" Margin="0,0,6,0"
                            Text="{Binding BoltFasteningActiveBolt.HeatSink, Converter={StaticResource UiTextConverter}, StringFormat='{}{0} ·'}"/>
                        <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding BoltFasteningActiveBolt.Name}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding BoltFasteningActiveBolt.Name}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BoltFasteningActiveBolt.Name}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{Binding BoltFasteningActiveOrdinal, StringFormat={ui:Text 'Bolt {0}'}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BoltFasteningActiveBolt.Name}" Value="">
                                            <Setter Property="Text" Value="{Binding BoltFasteningActiveOrdinal, StringFormat={ui:Text 'Bolt {0}'}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Grid Canvas.Left="{x:Static ui:MachineDiagramLayout.HeaderInset}"
                Canvas.Top="{x:Static ui:MachineDiagramLayout.DetailTop}"
                Width="{x:Static ui:MachineDiagramLayout.PlateWidth}" Height="54">
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextAlignment" Value="Center"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="98"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="18"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{ui:Text 'Controller'}" TextAlignment="Left" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="{ui:Text 'READY'}" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="2" Text="{ui:Text 'RUN'}" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="{ui:Text 'ALARM'}" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Row="1" Text="{ui:Text 'Pickup'}" TextAlignment="Left" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Tag="{Binding Fastening.PickupHead.Monitor.Sample.Status.Ready}" Style="{StaticResource AdcSignalStateStyle}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Tag="{Binding Fastening.PickupHead.Monitor.Sample.Status.Running}" Style="{StaticResource AdcSignalStateStyle}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Fastening.PickupHead.Monitor.Sample.Status.Alarm, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                    Tag="{Binding Fastening.PickupHead.Monitor.Sample.Status.Alarm}" Style="{StaticResource AdcAlarmStateStyle}"/>
                <TextBlock Grid.Row="2" Text="{ui:Text 'Shooting'}" TextAlignment="Left" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Tag="{Binding Fastening.ShootingHead.Monitor.Sample.Status.Ready}" Style="{StaticResource AdcSignalStateStyle}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Tag="{Binding Fastening.ShootingHead.Monitor.Sample.Status.Running}" Style="{StaticResource AdcSignalStateStyle}"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Fastening.ShootingHead.Monitor.Sample.Status.Alarm, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                    Tag="{Binding Fastening.ShootingHead.Monitor.Sample.Status.Alarm}" Style="{StaticResource AdcAlarmStateStyle}"/>
            </Grid>

            <Grid Canvas.Left="{x:Static ui:MachineDiagramLayout.HeaderInset}" Canvas.Top="314"
                Width="{x:Static ui:MachineDiagramLayout.PlateWidth}" Height="{x:Static ui:MachineDiagramLayout.PickupFeederHeight}">
                <Border Style="{StaticResource DeviceBodyStyle}"/>
                <Grid Width="{x:Static ui:MachineDiagramLayout.PickupFeederWidth}" HorizontalAlignment="Left">
                    <Border Height="26" Margin="12,0" VerticalAlignment="Center"
                        Background="{StaticResource EquipBgBrush}" BorderBrush="{StaticResource MachineStructureBorderBrush}"
                        BorderThickness="1" CornerRadius="3"/>
                    <Path Data="M 18,26 L 26,34 L 18,42 M 30,26 L 38,34 L 30,42 M 64,34 H 80 M 80,25 V 43"
                        Stroke="{StaticResource MachineStructureBorderBrush}" StrokeThickness="2"/>
                    <Ellipse Width="20" Height="20" Tag="{Binding Signals.Inputs[PickupFeederBoltDetected].IsOn}"
                        Style="{StaticResource FeederSensorStyle}"/>
                </Grid>
                <StackPanel Margin="100,6,10,6" VerticalAlignment="Center">
                    <TextBlock Text="{ui:Text 'Pickup feeder'}" FontSize="15" FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,1,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{ui:Text 'Supply unknown'}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signals.Inputs[PickupFeederBoltDetected].IsOn}" Value="True">
                                        <Setter Property="Text" Value="{ui:Text 'Bolt ready'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Signals.Inputs[PickupFeederBoltDetected].IsOn}" Value="False">
                                        <Setter Property="Text" Value="{ui:Text 'Waiting for supply'}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{ui:Text 'Supply bypassed'}" FontSize="12" Foreground="{StaticResource AccentAmberBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Units.PickupBoltFeeder}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Canvas Visibility="{Binding FasteningPositionKnown, Converter={StaticResource BoolToVis}}" Panel.ZIndex="20">
                <Grid Width="126" Height="138">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PickupHeadMapPosition}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RenderTransform>
                        <TranslateTransform X="{Binding PickupHeadMapPosition.X, TargetNullValue=0, FallbackValue=0}"
                            Y="{Binding PickupHeadMapPosition.Y, TargetNullValue=0, FallbackValue=0}"/>
                    </Grid.RenderTransform>
                    <Canvas>
                        <TextBlock Canvas.Left="{x:Static ui:MachineDiagramLayout.PickupHeadLeft}" Canvas.Top="125"
                            Text="{ui:Text 'Pickup'}" FontSize="11" Style="{StaticResource EquipmentRoleLabelStyle}"/>
                        <Grid Canvas.Left="{x:Static ui:MachineDiagramLayout.PickupHeadLeft}" Canvas.Top="{x:Static ui:MachineDiagramLayout.HeadTop}"
                            Width="{x:Static ui:MachineDiagramLayout.HeadSize}" Height="{x:Static ui:MachineDiagramLayout.HeadSize}">
                            <Border Margin="-6" Tag="{Binding Fastening.Motion.IsMoving}" Style="{StaticResource OverheadBodyStyle}"/>
                            <Border Tag="{Binding Fastening.PickupHeadPosition}" Style="{StaticResource ToolHeadFootprintStyle}"/>
                            <Border Width="14" Height="4" Background="{StaticResource TextMutedBrush}" CornerRadius="2"/>
                            <Ellipse Style="{StaticResource VacuumDetectedVisualStyle}"
                                Visibility="{Binding Signals.Inputs[PickupHeadVacuumDetected].IsOn, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Canvas>
                </Grid>
                <Grid Width="126" Height="138">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShootingHeadMapPosition}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RenderTransform>
                        <TranslateTransform X="{Binding ShootingHeadMapPosition.X, TargetNullValue=0, FallbackValue=0}"
                            Y="{Binding ShootingHeadMapPosition.Y, TargetNullValue=0, FallbackValue=0}"/>
                    </Grid.RenderTransform>
                    <Canvas>
                        <TextBlock Canvas.Left="{x:Static ui:MachineDiagramLayout.ShootingHeadLeft}" Canvas.Top="65" Text="{ui:Text 'Shooting'}"
                            FontSize="11" Style="{StaticResource EquipmentRoleLabelStyle}"/>
                        <Grid Canvas.Left="{x:Static ui:MachineDiagramLayout.ShootingHeadLeft}" Canvas.Top="{x:Static ui:MachineDiagramLayout.HeadTop}"
                            Width="{x:Static ui:MachineDiagramLayout.HeadSize}" Height="{x:Static ui:MachineDiagramLayout.HeadSize}">
                            <Border Margin="-6" Tag="{Binding Fastening.Motion.IsMoving}" Style="{StaticResource OverheadBodyStyle}"/>
                            <Border Tag="{Binding Fastening.ShootingHeadPosition}" Style="{StaticResource ToolHeadFootprintStyle}"/>
                            <Ellipse Width="12" Height="12" Fill="{StaticResource EquipBgBrush}"
                                Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"/>
                            <Ellipse Style="{StaticResource VacuumDetectedVisualStyle}"
                                ToolTip="{ui:Text 'Shooting vacuum'}"
                                Visibility="{Binding Signals.Inputs[ShootingHeadVacuumDetected].IsOn, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Canvas>
                </Grid>
            </Canvas>
        </Canvas>
        <Grid Width="{x:Static ui:MachineDiagramLayout.PlateWidth}" Height="138" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,164,0,0">
            <Grid.RenderTransform>
                <TranslateTransform X="{x:Static ui:MachineDiagramLayout.HeaderInset}"/>
            </Grid.RenderTransform>
            <Border Height="138" VerticalAlignment="Top" Style="{StaticResource DeviceBodyStyle}">
                <Canvas Width="280" Height="134">
                    <TextBlock Canvas.Left="12" Canvas.Top="30" Width="78"
                        ToolTip="{ui:Text 'Bolt supply command'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FeederCommandLabelStyle}">
                                <Setter Property="Text" Value="{ui:Text 'SUPPLY · ?'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootingFeederOff].IsOn}" Value="False">
                                        <Setter Property="Text" Value="{ui:Text 'RUN'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootingFeederOff].IsOn}" Value="True">
                                        <Setter Property="Text" Value="{ui:Text 'WAIT'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Canvas.Left="94" Canvas.Top="30" Width="94">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FeederCommandLabelStyle}">
                                <Setter Property="Text" Value="{ui:Text 'CMD · ?'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootingEscapeForward].IsOn}" Value="False">
                                        <Setter Property="Text" Value="{ui:Text 'CMD ←'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootingEscapeForward].IsOn}" Value="True">
                                        <Setter Property="Text" Value="{ui:Text 'CMD →'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Canvas.Left="211" Canvas.Top="30" Width="68">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FeederCommandLabelStyle}">
                                <Setter Property="Text" Value="{ui:Text 'SHOOT · ?'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootBolt].IsOn}" Value="True">
                                        <Setter Property="Text" Value="{ui:Text 'SHOOT ON'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootBolt].IsOn}" Value="False">
                                        <Setter Property="Text" Value="{ui:Text 'SHOOT OFF'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Linear feeder, escape slide, then the shooting tube. -->
                    <Border Canvas.Left="12" Canvas.Top="52" Width="78" Height="30"
                        Background="{StaticResource EquipBgBrush}" BorderBrush="{StaticResource MachineStructureBorderBrush}"
                        BorderThickness="1" CornerRadius="3"/>
                    <Path Data="M 23,59 L 31,67 L 23,75 M 39,59 L 47,67 L 39,75 M 55,59 L 63,67 L 55,75"
                        StrokeThickness="2">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{StaticResource AccentAmberBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootingFeederOff].IsOn}" Value="False">
                                        <Setter Property="Stroke" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootingFeederOff].IsOn}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource MachineStructureBorderBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Path Data="M 90,67 H 108 M 108,55 H 174 V 79 H 108 Z" StrokeThickness="2"
                        Stroke="{StaticResource MachineStructureBorderBrush}"/>
                    <Rectangle Canvas.Top="58" Width="18" Height="18" Fill="{StaticResource AccentGreenBrush}">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="True"/>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Canvas.Left" Value="111"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="False"/>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Canvas.Left" Value="153"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <Path Data="M 174,67 H 226 Q 245,67 245,86 V 106 M 239,99 L 245,106 L 251,99" StrokeThickness="3">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{StaticResource AccentAmberBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootBolt].IsOn}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Signals.Outputs[ShootBolt].IsOn}" Value="False">
                                        <Setter Property="Stroke" Value="{StaticResource MachineStructureBorderBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <Ellipse Canvas.Left="68" Canvas.Top="60" Tag="{Binding Signals.Inputs[ShootingFeederBoltDetected].IsOn}"
                        Style="{StaticResource FeederSensorStyle}"/>
                    <TextBlock Canvas.Left="8" Canvas.Top="114" Width="86">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FeederCommandLabelStyle}">
                                <Setter Property="Text" Value="{ui:Text 'BOLT · ?'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Signals.Inputs[ShootingFeederBoltDetected].IsOn}" Value="True">
                                        <Setter Property="Text" Value="{ui:Text 'BOLT READY'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Signals.Inputs[ShootingFeederBoltDetected].IsOn}" Value="False">
                                        <Setter Property="Text" Value="{ui:Text 'WAIT SUPPLY'}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Canvas.Left="92" Canvas.Top="90" Width="112">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FeederCommandLabelStyle}">
                                <Setter Property="Text" Value="{ui:Text 'ESC · ?'}"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="True"/>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="{ui:Text 'ESC · BACK'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="False"/>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="{ui:Text 'ESC · FWD'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="False"/>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="{ui:Text 'ESC · NO LIMIT'}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeBackward].IsOn}" Value="True"/>
                                            <Condition Binding="{Binding Signals.Inputs[ShootingEscapeForward].IsOn}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="{ui:Text 'ESC · CONFLICT'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Ellipse Canvas.Left="238" Canvas.Top="88" Tag="{Binding Signals.Inputs[ShootingTubeBoltDetected].IsOn}"
                        Style="{StaticResource FeederSensorStyle}"/>
                    <TextBlock Canvas.Left="211" Canvas.Top="114" Width="68" Text="{ui:Text 'TUBE'}" Style="{StaticResource EquipmentRoleLabelStyle}"/>
                    <TextBlock Canvas.Left="12" Canvas.Top="6" Width="256" FontSize="15" TextAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EquipmentRoleLabelStyle}">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Text" Value="{ui:Text 'Shooting feeder'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Units.ShootingBoltFeeder}" Value="False">
                                        <Setter Property="Text" Value="{ui:Text 'Shooting feeder · supply bypassed'}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Canvas>
            </Border>
        </Grid>
    </Grid>
</UserControl>
