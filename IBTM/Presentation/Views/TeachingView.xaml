<UserControl x:Class="IBTM.Presentation.Views.TeachingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IBTM.Presentation.Localization"
             xmlns:conv="clr-namespace:IBTM.Presentation.Converters"
             Background="{StaticResource AppBgBrush}"
             Loaded="OnLoaded" Unloaded="OnUnloaded">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding [Teach_Title], Source={x:Static loc:Loc.Instance}}"
                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        </StackPanel>

        <!-- 메인 3컬럼 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 카메라 라이브뷰 -->
            <Border Grid.Column="0" Background="{StaticResource EquipBgBrush}"
                    CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding LiveImage}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           MouseLeftButtonDown="CameraImage_Click"/>
                    <!-- 십자선 오버레이 -->
                    <Line X1="0" Y1="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}, Converter={x:Static conv:HalfConverter.Instance}}"
                          X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                          Y2="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}, Converter={x:Static conv:HalfConverter.Instance}}"
                          Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="0.5" StrokeDashArray="4 2"
                          IsHitTestVisible="False" Opacity="0.6"/>
                    <Line X1="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={x:Static conv:HalfConverter.Instance}}"
                          Y1="0"
                          X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={x:Static conv:HalfConverter.Instance}}"
                          Y2="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"
                          Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="0.5" StrokeDashArray="4 2"
                          IsHitTestVisible="False" Opacity="0.6"/>
                    <!-- 라이브뷰 OFF 플레이스홀더 -->
                    <TextBlock Text="CAMERA" FontSize="16" FontFamily="Consolas"
                               Foreground="#202040" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCameraLive}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- 라이브 ON/OFF 버튼 -->
                    <Button Command="{Binding ToggleLiveViewCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"
                            Style="{StaticResource SecondaryButtonStyle}" MinWidth="70" Opacity="0.8">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Live ON"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCameraLive}" Value="True">
                                                <Setter Property="Text" Value="Live OFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                </Grid>
            </Border>

            <!-- 중앙: 조그 + 좌표 + 레이저 -->
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <!-- Zone 선택 -->
                <Border Background="{StaticResource PanelBgBrush}" CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding [Teach_Zone], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <UniformGrid Columns="3">
                            <RadioButton Content="Zone 1" GroupName="TeachZone"
                                         Style="{StaticResource NavButtonStyle}" Checked="Zone1_Checked"/>
                            <RadioButton Content="Zone 2" GroupName="TeachZone"
                                         Style="{StaticResource NavButtonStyle}" Checked="Zone2_Checked"/>
                            <RadioButton Content="Zone 3" GroupName="TeachZone" IsChecked="True"
                                         Style="{StaticResource NavButtonStyle}" Checked="Zone3_Checked"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 현재 좌표 -->
                <Border Background="{StaticResource PanelBgBrush}" CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding [Teach_CurrentPos], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <TextBlock FontFamily="Consolas" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="X: "/><Run Text="{Binding CurrentX, StringFormat=F3}"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="Y: "/><Run Text="{Binding CurrentY, StringFormat=F3}"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="Z: "/><Run Text="{Binding CurrentZ, StringFormat=F3}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 조그 패드 -->
                <Border Background="{StaticResource PanelBgBrush}" CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="JOG" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="1" Content="Y+" Style="{StaticResource SecondaryButtonStyle}"
                                    PreviewMouseLeftButtonDown="JogYPlus_Down" PreviewMouseLeftButtonUp="Jog_Up"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="X-" Style="{StaticResource SecondaryButtonStyle}"
                                    PreviewMouseLeftButtonDown="JogXMinus_Down" PreviewMouseLeftButtonUp="Jog_Up"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="■" Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding JogStopCommand}" FontSize="14"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="X+" Style="{StaticResource SecondaryButtonStyle}"
                                    PreviewMouseLeftButtonDown="JogXPlus_Down" PreviewMouseLeftButtonUp="Jog_Up"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="Y-" Style="{StaticResource SecondaryButtonStyle}"
                                    PreviewMouseLeftButtonDown="JogYMinus_Down" PreviewMouseLeftButtonUp="Jog_Up"/>

                            <Button Grid.Row="0" Grid.Column="4" Content="Z+" Style="{StaticResource SecondaryButtonStyle}"
                                    PreviewMouseLeftButtonDown="JogZPlus_Down" PreviewMouseLeftButtonUp="Jog_Up"/>
                            <Button Grid.Row="2" Grid.Column="4" Content="Z-" Style="{StaticResource SecondaryButtonStyle}"
                                    PreviewMouseLeftButtonDown="JogZMinus_Down" PreviewMouseLeftButtonUp="Jog_Up"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <RadioButton Content="1" GroupName="TeachJogSpeed" Style="{StaticResource NavButtonStyle}"
                                         Checked="SpeedSlow_Checked" MinWidth="40"/>
                            <RadioButton Content="10" GroupName="TeachJogSpeed" Style="{StaticResource NavButtonStyle}"
                                         IsChecked="True" Checked="SpeedMed_Checked" MinWidth="40"/>
                            <RadioButton Content="50" GroupName="TeachJogSpeed" Style="{StaticResource NavButtonStyle}"
                                         Checked="SpeedFast_Checked" MinWidth="40"/>
                            <TextBlock Text="mm/s" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 레이저 -->
                <Border Background="{StaticResource PanelBgBrush}" CornerRadius="6" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#401818"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LaserOn}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#F85149" BlurRadius="8" ShadowDepth="0"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Button Content="{Binding [Teach_Laser], Source={x:Static loc:Loc.Instance}}"
                                Command="{Binding ToggleLaserCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="80"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 우측: 티칭 포인트 목록 -->
            <Border Grid.Column="2" Background="{StaticResource PanelBgBrush}" CornerRadius="6" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding [Teach_Points], Source={x:Static loc:Loc.Instance}}"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                    <ListView Grid.Row="1" ItemsSource="{Binding FilteredPoints}"
                              SelectedItem="{Binding SelectedPoint}"
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#383850"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTaught}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <!-- TeachMode 배지 -->
                                    <Border Background="#282840" CornerRadius="2" Padding="3,1" Margin="0,0,4,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ModeLabel}" FontFamily="Consolas" FontSize="8"
                                                   Foreground="{StaticResource AccentCyanBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource TextPrimaryBrush}" Width="70"/>
                                    <TextBlock FontFamily="Consolas" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding X, StringFormat=F1}"/><Run Text=","/>
                                        <Run Text="{Binding Y, StringFormat=F1}"/><Run Text=","/>
                                        <Run Text="{Binding Z, StringFormat=F1}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="{Binding [Teach_Record], Source={x:Static loc:Loc.Instance}}"
                                    Command="{Binding TeachCurrentPositionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="70" Margin="0,0,6,0"/>
                            <Button Content="{Binding [Teach_MoveTo], Source={x:Static loc:Loc.Instance}}"
                                    Command="{Binding MoveToPointCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="70"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding [Teach_AddBolt], Source={x:Static loc:Loc.Instance}}"
                                    Command="{Binding AddBoltPointCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="70" Margin="0,0,6,0"/>
                            <Button Content="{Binding [Teach_RemoveBolt], Source={x:Static loc:Loc.Instance}}"
                                    Command="{Binding RemoveBoltPointCommand}"
                                    Style="{StaticResource DangerButtonStyle}" MinWidth="70"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 하단: 레시피 저장/로드 + 상태 -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding [Teach_Recipe], Source={x:Static loc:Loc.Instance}}"
                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="120" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="{Binding [Teach_New], Source={x:Static loc:Loc.Instance}}"
                        Command="{Binding NewRecipeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="60" Margin="0,0,4,0"/>
                <Button Content="{Binding [Teach_Save], Source={x:Static loc:Loc.Instance}}"
                        Command="{Binding SaveRecipeCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="60" Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding RecipeFiles}" MinWidth="180" Margin="0,0,8,0"
                          FontSize="10" VerticalAlignment="Center"
                          SelectionChanged="RecipeFile_Selected"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
