<Window x:Class="IBTM.UI.WarningDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:WarningDialog, IsDesignTimeCreatable=False}"
    Title="Warning · Confirm action" Width="600" SizeToContent="Height"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource AppBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
    Loaded="OnDialogLoaded">
    <Border BorderBrush="{StaticResource AccentAmberBrush}" BorderThickness="1,6,1,1">
        <StackPanel Margin="26,24">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Path Data="M 24,3 L 47,44 L 1,44 Z" Fill="{StaticResource AccentAmberBrush}" StrokeLineJoin="Round"/>
                    <Path Data="M 24,16 L 24,29 M 24,35 L 24,36" Stroke="{StaticResource AppBgBrush}"
                        StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="WARNING" Foreground="{StaticResource AccentAmberBrush}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Heading}" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Message}" FontSize="14" LineHeight="22" TextWrapping="Wrap" Margin="0,0,0,18"/>
            <Border Background="{StaticResource EquipBgBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,22">
                <TextBlock Text="{Binding Details}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                    LineHeight="24" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton" Content="Cancel · Esc" IsCancel="True" IsDefault="True"
                        HorizontalAlignment="Left" MinWidth="126" Height="42" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Grid.Column="1" Content="{Binding ActionLabel}" Click="OnConfirmClick"
                        MinWidth="178" Height="42" Margin="14,0,0,0" Style="{StaticResource DangerButtonStyle}"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
