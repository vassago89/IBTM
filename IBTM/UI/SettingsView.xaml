                    <Border Style="{StaticResource SettingCard}" Margin="0" Grid.Column="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Digital outputs" Style="{StaticResource SettingSectionTitle}"/>
                            <Grid Grid.Row="1" Margin="9,0,26,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Output signal" Style="{StaticResource SettingFieldLabel}" Grid.Column="0" Margin="0,0,4,0"/>
                                <TextBlock Text="ON (dec)" Style="{StaticResource SettingFieldLabel}" Grid.Column="1" Margin="4,0,4,0"/>
                                <TextBlock Text="OFF (dec)" Style="{StaticResource SettingFieldLabel}" Grid.Column="2" Margin="4,0,4,0"/>
                            </Grid>
                            <ListBox IsEnabled="{Binding IsSettingsEditAllowed}" ItemsSource="{Binding OutputMappingView}"
                                Style="{StaticResource PanelListStyle}" ItemContainerStyle="{StaticResource HardwareListItem}" Grid.Row="2"
                                Padding="0" ScrollViewer.VerticalScrollBarVisibility="Visible"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}"
                                        HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
                                    <GroupStyle ContainerStyle="{StaticResource IoSectionGroupItemStyle}"
                                        HeaderTemplate="{StaticResource IoSectionGroupHeaderTemplate}"/>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ui:HardwareMappingRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="76"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                ToolTip="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                Style="{StaticResource HardwareSignalText}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Output.Number, UpdateSourceTrigger=PropertyChanged}"
                                                MinWidth="0" Padding="5,3" Margin="4,0"/>
                                            <TextBox Grid.Column="2" Text="{Binding Output.OffNumber, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Padding="5,3" Margin="4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Hardware / logs: Save + restart"
                    Style="{StaticResource SettingHelpText}" Margin="0"/>
                <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding DatabaseMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                        Style="{StaticResource StatusMessageStyle}"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
