                        <TextBlock Text="DI Carrier" Style="{StaticResource MapIoLabelStyle}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" ToolTip="{Binding Signals.Inputs[PcbPlacementStopperUp].Signal, Converter={StaticResource EnumDescriptionConverter}}">
                        <TextBlock Text="{Binding Signals.Inputs[PcbPlacementStopperUp].IsOn, Converter={StaticResource SignalTextConverter}}"
