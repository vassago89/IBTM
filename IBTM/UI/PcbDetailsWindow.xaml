<Window x:Class="IBTM.UI.PcbDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:PcbDetailsViewModel, IsDesignTimeCreatable=False}"
    Title="{Binding Record.Number, StringFormat='PCB {0} · Results'}"
    Width="1360" Height="860" MinWidth="1000" MinHeight="740"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource AppBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
    KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style x:Key="ResultBadge" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static core:AssemblyResult.Ok}">
                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static core:AssemblyResult.Ng}">
                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="OK"><Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/></Trigger>
                <Trigger Property="Tag" Value="NG"><Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Metric" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,15"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
            <Setter Property="MinHeight" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource ControlSelectedBackgroundBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Content="Close · Esc" Click="OnCloseClick" VerticalAlignment="Top" Style="{StaticResource SecondaryButtonStyle}"/>
            <StackPanel>
                <TextBlock Text="PRODUCTION RECORD" FontSize="11" Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Text="{Binding Record.Number, StringFormat='PCB {0}'}" FontSize="28" FontWeight="SemiBold"/>
                    <Border Background="{StaticResource ControlBgBrush}" CornerRadius="4" Margin="16,2,0,0" Padding="12,5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Record.Result, Converter={StaticResource EnumDescriptionConverter}}" Tag="{Binding Record.Result}" Style="{StaticResource ResultBadge}"/>
                    </Border>
                </StackPanel>
                <WrapPanel TextBlock.Foreground="{StaticResource TextSecondaryBrush}" TextBlock.FontSize="12">
                    <TextBlock Text="{Binding Record.RecipeName}" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding Record.HeatSink, Converter={StaticResource EnumDescriptionConverter}}" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding Record.CreatedAt, StringFormat='Created {0:yyyy-MM-dd HH:mm:ss}'}" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding Record.UpdatedAt, StringFormat='Updated {0:HH:mm:ss}'}"/>
                </WrapPanel>
            </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,10">
                <StackPanel><TextBlock Text="DATA MATRIX" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Record.PcbBarcode, TargetNullValue='Not read', FallbackValue='Not read'}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Record.PcbBarcode}" Margin="0,5,0,0"
                        Tag="{Binding Record.PcbBarcodeResult}" Style="{StaticResource ResultBadge}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,10">
                <DockPanel><StackPanel><TextBlock Text="FASTENING" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Record.FasteningResult, Converter={StaticResource EnumDescriptionConverter}}" Tag="{Binding Record.FasteningResult}" Style="{StaticResource ResultBadge}" Margin="0,5,0,0"/>
                </StackPanel><TextBlock Text="{Binding BoltResults.Count, StringFormat='{}{0} results'}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/></DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,10">
                <DockPanel><StackPanel><TextBlock Text="VISION INSPECTION" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Record.InspectionResult, Converter={StaticResource EnumDescriptionConverter}}" Tag="{Binding Record.InspectionResult}" Style="{StaticResource ResultBadge}" Margin="0,5,0,0"/>
                </StackPanel><TextBlock Text="{Binding Images.Count, StringFormat='{}{0} images'}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/></DockPanel>
            </Border>
        </UniformGrid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12"><TextBlock Text="Inspection images" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="ROI outlined in green" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="{StaticResource ImageBackgroundBrush}" CornerRadius="4" MinHeight="160">
                        <Grid>
                            <ui:ImageTeachingView Source="{Binding SelectedImage.Image}" SourceRegion="{Binding SelectedImage.Region}" ShowCrosshair="False" IsHitTestVisible="False"/>
                            <TextBlock Text="No saved image for this point" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,12,0,12">
                        <DockPanel><TextBlock Text="{Binding SelectedImage.Title, TargetNullValue='Inspection capture', FallbackValue='Inspection capture'}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedImage.Verdict}" Tag="{Binding SelectedImage.Verdict}" Style="{StaticResource ResultBadge}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedImage.Details}" TextWrapping="Wrap" Margin="0,6,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DockPanel TextBlock.FontSize="11" TextBlock.Foreground="{StaticResource TextMutedBrush}">
                            <TextBlock Text="{Binding SelectedImage.Record.CapturedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}"/>
                            <TextBlock Text="{Binding SelectedImage.Resolution}" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                    <ListBox Grid.Row="3" ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage, Mode=TwoWay}" Height="106"
                        BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource FlatListItemStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate DataType="{x:Type ui:PcbInspectionImageView}">
                            <StackPanel Width="88" Margin="0,0,5,0"><Image Source="{Binding Image}" Height="56" Stretch="Uniform"/>
                                <DockPanel Margin="0,5,0,0"><TextBlock Text="{Binding Title}" FontSize="11"/>
                                    <TextBlock Text="{Binding Verdict}" Tag="{Binding Verdict}" Style="{StaticResource ResultBadge}" HorizontalAlignment="Right" FontSize="10"/>
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                        <TextBlock Text="Loading images…" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding LoadImagesCommand.IsRunning, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ImageError}" TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}"/>
                        <ItemsControl ItemsSource="{Binding Record.BoltPresenceResults}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3,12,0"><TextBlock Text="{Binding Key, StringFormat='Bolt {0}: '}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="Presence" Text="NG" Foreground="{StaticResource AccentRedBrush}" FontSize="11"/>
                                </StackPanel>
                                <DataTemplate.Triggers><DataTrigger Binding="{Binding Value}" Value="True">
                                    <Setter TargetName="Presence" Property="Text" Value="OK"/><Setter TargetName="Presence" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                </DataTrigger></DataTemplate.Triggers>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12"><TextBlock Text="Bolt fastening results" Style="{StaticResource PanelTitleStyle}"/>
                            <TextBlock Text="Select a row for full detail" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding BoltResults}" SelectedItem="{Binding SelectedBolt, Mode=TwoWay}" AutoGenerateColumns="False"
                            IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False"
                            CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                            BorderThickness="0" Background="{StaticResource ControlBgBrush}" MaxHeight="225" MinHeight="88">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="BOLT" Binding="{Binding Number}" Width="48"/>
                                <DataGridTextColumn Header="HEAD" Binding="{Binding HeadLabel}" Width="112"/>
                                <DataGridTemplateColumn Header="RESULT" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding Verdict}" Tag="{Binding Verdict}" Style="{StaticResource ResultBadge}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="TORQUE" Binding="{Binding Result.Torque, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Width="*"/>
                                <DataGridTextColumn Header="TARGET" Binding="{Binding Result.Controller.TargetTorque, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Width="*"/>
                                <DataGridTextColumn Header="TIME (ms)" Binding="{Binding Result.Controller.FasteningTimeMilliseconds, TargetNullValue='—', FallbackValue='—'}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No fastening results recorded" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                <DataTrigger Binding="{Binding BoltResults.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedBolt.Title, TargetNullValue='Controller details', FallbackValue='Controller details'}" FontWeight="SemiBold" FontSize="16"/>
                                <WrapPanel Margin="0,5,0,16" TextBlock.FontSize="11" TextBlock.Foreground="{StaticResource TextMutedBrush}">
                                    <TextBlock Text="{Binding SelectedBolt.Result.Source, Converter={StaticResource EnumDescriptionConverter}}" Margin="0,0,14,0"/>
                                    <TextBlock Text="{Binding SelectedBolt.Result.RecordedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}', TargetNullValue='Time not recorded', FallbackValue='Time not recorded'}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding SelectedBolt.Result.Error}" Foreground="{StaticResource AccentRedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="RESULT TORQUE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Torque, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="TARGET TORQUE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.TargetTorque, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="TARGET SPEED (rpm)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.TargetSpeedRpm, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="ANGLE A1 (°)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.Angle1, StringFormat=0.##, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="ANGLE A2 (°)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.Angle2, StringFormat=0.##, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="ANGLE A3 (°)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.Angle3, StringFormat=0.##, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="SNUG ANGLE (°)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.SnugAngle, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="FASTENING TIME (ms)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.FasteningTimeMilliseconds, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="PRESET" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.Preset, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="EVENT COUNT" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.EventCount, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="SCREW COUNT" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.ScrewCount, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}" ToolTip="{Binding SelectedBolt.ControllerErrorDescription}"><TextBlock Text="ERROR CODE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Result.Controller.ErrorCode, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="STATUS / CODE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.ControllerStatus, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="DIRECTION / CODE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.Direction, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Style="{StaticResource Metric}"><TextBlock Text="PORT / ADDRESS" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding SelectedBolt.Result.Controller.Port, TargetNullValue='—', FallbackValue='—'}"/><Run Text=" / "/><Run Text="{Binding SelectedBolt.Result.Controller.SlaveAddress, TargetNullValue='—', FallbackValue='—'}"/></TextBlock>
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Style="{StaticResource Metric}"><TextBlock Text="TOTAL TURNS (A3 / 360)" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding SelectedBolt.TotalTurns, StringFormat=0.###, TargetNullValue='—', FallbackValue='—'}" Style="{StaticResource MetricValue}"/></StackPanel>
                                <TextBlock Text="ORIGINAL ADC REGISTERS · ADDRESS : HEX" Style="{StaticResource MetricLabel}" Margin="0,0,0,7"/>
                                <TextBox Text="{Binding SelectedBolt.RegisterText, Mode=OneWay, TargetNullValue='Not recorded', FallbackValue='Not recorded'}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Padding="10"
                                    Background="{StaticResource ControlBgBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Margin="0,12,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
            Text="Torque uses the controller's configured unit. RPM is the target speed. — = not recorded. Older records may not contain images or controller details." TextWrapping="Wrap"/>
    </Grid>
</Window>
