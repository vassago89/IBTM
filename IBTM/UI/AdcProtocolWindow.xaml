<Window x:Class="IBTM.UI.AdcProtocolWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    xmlns:hantas="clr-namespace:IBTM.Hantas;assembly=IBTM.Hantas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:AdcProtocolViewModel, IsDesignTimeCreatable=False}"
    Title="HANTAS ADC Protocol"
    Width="1120"
    Height="780"
    MinWidth="960"
    MinHeight="680"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource AppBgBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="HANTAS ADC Protocol" Style="{StaticResource TitleStyle}"/>
                <TextBlock Text="Separate serial connection for each fastening head" Style="{StaticResource PageSubtitleStyle}"/>
                <ComboBox x:Name="HeadBox" Margin="0,10,0,0" Width="220" HorizontalAlignment="Left"
                    ItemsSource="{Binding Heads}" SelectedItem="{Binding SelectedHead, Mode=TwoWay}"
                    IsEnabled="{Binding ConnectionControlsEnabled}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:FasteningHead}">
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="VirtualResultPanel" IsEnabled="{Binding VirtualResultEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"
                Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Next Virtual Result" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox x:Name="NextResultBox" SelectedItem="{Binding NextResult, Mode=TwoWay}" Width="155" Margin="10,0" ItemsSource="{Binding FasteningResults}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type device:AdcEventStatus}">
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Apply Once" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding QueueResultCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,12" Padding="16,14" Style="{StaticResource CardStyle}">
            <Grid x:Name="ConnectionControls" IsEnabled="{Binding ConnectionControlsEnabled}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="PORT" VerticalAlignment="Center" Style="{StaticResource SectionHeaderStyle}"/>
                <ComboBox x:Name="PortBox" Grid.Column="1" Margin="10,0,8,0"
                    ItemsSource="{Binding PortNames}"
                    SelectedItem="{Binding SelectedPort, Mode=TwoWay}" IsEnabled="{Binding PortSelectionEnabled}"/>
                <Button x:Name="RefreshPortsButton" Grid.Column="2" Content="Refresh" Padding="12,5"
                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshPortsCommand}"/>

                <ComboBox IsEnabled="{Binding PortSelectionEnabled}" x:Name="BaudBox" SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}" Grid.Column="3" Margin="16,0,0,0" ItemsSource="{Binding BaudRates}"/>

                <TextBlock Grid.Column="4" Margin="16,0,0,0" Text="SLAVE" VerticalAlignment="Center"
                    Style="{StaticResource SectionHeaderStyle}"/>
                <TextBox IsEnabled="{Binding SlaveSelectionEnabled}" x:Name="SlaveBox" Grid.Column="5" Margin="10,0,0,0" Text="{Binding SlaveText, UpdateSourceTrigger=PropertyChanged}"/>

                <Button x:Name="ConnectButton" Grid.Column="6" Margin="16,0,0,0"
                    Content="{Binding ConnectionAction}"
                    Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ToggleConnectionCommand}"/>
                <TextBlock Grid.Column="7" Margin="16,0,0,0"
                    Text="{Binding ConnectionStatus}"
                    VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Padding="18,16" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="CONTROLLER" VerticalAlignment="Center" Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:HoldButton x:Name="ReverseButton" Content="Reverse (Hold)" Margin="0,0,8,0"
                                PressCommand="{Binding ReverseCommand}"
                                ReleaseCommand="{Binding ReleaseReverseCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Loosen while held. Release or Stop ends rotation; no automatic loose-complete judgement. Clear interrupted work manually and press RESET first."/>
                            <Button x:Name="StopButton" Content="Stop" Style="{StaticResource DangerButtonStyle}" Command="{Binding StopCommand}"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="OperationPanel" IsEnabled="{Binding ProtocolEnabled}">
                            <Button x:Name="SelectPresetButton" Content="Select Preset 1"
                                Margin="0,14,0,12" HorizontalAlignment="Left" Padding="14,5"
                                Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectPresetCommand}"/>

                            <WrapPanel Margin="0,0,0,14">
                                <Button x:Name="StartButton" Content="Start Fastening" Margin="0,0,8,8"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Clear interrupted work manually and press RESET before starting a manual test."
                                    Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartCommand}"/>
                                <Button Content="Alarm Reset" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ResetAlarmCommand}"/>
                                <Button Content="Read Result" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ReadResultCommand}"/>
                                <Button Content="Device Info" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ReadDeviceInformationCommand}"/>
                                <Button Content="Capture RX (3s)" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Send Device Info once, then capture all received bytes for 3 seconds without parsing or removing echoes. Stop cancels capture."
                                    Command="{Binding CaptureDeviceInformationCommand}"/>
                            </WrapPanel>

                            <TextBlock Text="CONTROLLER / LAST RESULT" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas">
                                <Run Text="Ready "/><Run Text="{Binding Monitor.Sample.Status.Ready, Mode=OneWay, TargetNullValue=—}"/>
                                <Run Text="  Run "/><Run Text="{Binding Monitor.Sample.Status.Running, Mode=OneWay, TargetNullValue=—}"/>
                                <Run Text="  Preset "/><Run Text="{Binding Monitor.Sample.Status.Preset, Mode=OneWay, TargetNullValue=—}"/>
                                <LineBreak/><Run Text="Alarm "/><Run Text="{Binding Monitor.Sample.Status.Alarm, Mode=OneWay, TargetNullValue=—}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Monitor.Sample.Error.Message}" TextWrapping="Wrap" Foreground="{StaticResource AccentRedBrush}"/>
                            <TextBlock Margin="0,10,0,0"
                                Text="{Binding ResultMessage}"
                                TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Padding="18,16" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RegisterPanel" IsEnabled="{Binding ProtocolEnabled}">
                        <TextBlock Text="REGISTER ACCESS" Style="{StaticResource SectionHeaderStyle}"/>

                        <ComboBox x:Name="AccessBox" SelectedItem="{Binding RegisterAccess, Mode=TwoWay}" Margin="0,14,0,12" ItemsSource="{Binding RegisterAccesses}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ADDRESS" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBox x:Name="AddressBox" Margin="0,6,0,0" Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COUNT" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBox x:Name="CountBox" Margin="0,6,0,0" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="VALUE" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBox x:Name="ValueBox" Margin="0,6,0,0" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Execute" Margin="0,14,0,14" HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExecuteRegisterCommand}"/>

                        <TextBlock Text="RESPONSE" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Margin="0,10,0,0"
                            Text="{Binding RegisterResult}"
                            TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TabControl Grid.Row="3" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}">
        <TabItem Header="Frame Log">
        <Border Padding="18,14" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox Content="Pause display" IsChecked="{Binding IsLogPaused}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="Copy" Command="{Binding CopyLogCommand}" Padding="12,4" Margin="0,0,8,0"
                            ToolTip="Copy selected text, or all displayed frames if nothing is selected."
                            Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Copy all" Command="{Binding CopyAllLogCommand}" Padding="12,4" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" Padding="12,4" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <TextBlock Text="FRAME LOG" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                    Text="Newest first. Drag across lines or use Ctrl+A / Ctrl+C. Selecting text pauses display only; communication continues."/>
                <ui:LogTextBox x:Name="FrameLogBox" Style="{StaticResource FieldTextBoxStyle}" Grid.Row="2" Margin="0,8,0,0"
                    Text="{Binding FrameLogText, Mode=OneWay}"
                    IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" IsInactiveSelectionHighlightEnabled="True"
                    SelectionText="{Binding SelectedLogText, Mode=TwoWay}" IsPaused="{Binding IsLogPaused, Mode=TwoWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                    Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <TextBlock Grid.Row="3" Text="{Binding ClipboardError}" Foreground="{StaticResource AccentRedBrush}" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        </TabItem>
        <TabItem Header="오류 코드 / 조치">
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static hantas:AdcControllerError.ReferenceNote}" TextWrapping="Wrap"
                    Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                <TextBlock Grid.Row="1" Text="{x:Static hantas:AdcControllerError.OperationNote}" TextWrapping="Wrap"
                    Foreground="{StaticResource AccentAmberBrush}" FontSize="12" Margin="0,4,0,8"/>
                <DataGrid Grid.Row="2" ItemsSource="{x:Static hantas:AdcControllerError.All}" IsReadOnly="True"
                    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                    Background="{StaticResource ControlBgBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="코드 · 10진수 (16진수)" Binding="{Binding CodeText}" Width="155"/>
                        <DataGridTextColumn Header="분류" Binding="{Binding Group}" Width="115"/>
                        <DataGridTextColumn Header="의미" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="확인 / 조치" Binding="{Binding Action}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        </TabControl>
    </Grid>
</Window>
