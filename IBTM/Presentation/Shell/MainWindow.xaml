<Window x:Class="IBTM.Presentation.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IBTM.Presentation.ViewModels"
        xmlns:views="clr-namespace:IBTM.Presentation.Views"
        Title="IBTM — SMT Inline Control System"
        WindowState="Maximized"
        MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource AppBgBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ProcessViewModel}">
            <views:ProcessView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TeachingViewModel}">
            <views:TeachingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBgBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="18,22,18,18">
                    <StackPanel>
                        <TextBlock Text="IBTM"
                                   FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="CONTROL SYSTEM"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,8">
                    <TextBlock Text="WORKSPACE" Style="{StaticResource SectionHeaderStyle}"
                               Margin="18,0,18,8"/>
                    <RadioButton Content="Process Monitor"
                                 GroupName="Navigation"
                                 IsChecked="True"
                                 Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Process"/>

                    <RadioButton Content="Teaching"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Teaching"/>

                    <RadioButton Content="Settings"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Settings"/>
                </StackPanel>

                <Border Grid.Row="2" Margin="12" Padding="12,10"
                        Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="SIMULATION" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Motion · IO · Vision" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding CurrentPage}"/>
    </Grid>
</Window>
