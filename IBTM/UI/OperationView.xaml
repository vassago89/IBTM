<UserControl x:Class="IBTM.UI.OperationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
    xmlns:storage="clr-namespace:IBTM.Storage;assembly=IBTM.Storage"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
    Background="{StaticResource AppBgBrush}">
    <UserControl.Resources>
        <DataTemplate x:Key="PcbHistoryCard" DataType="{x:Type storage:PcbRecord}">
            <StackPanel MinWidth="94" Margin="8,4">
                <TextBlock Text="{Binding Number, StringFormat='PCB {0}'}" FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="ResultText" Margin="0,4,0,0"
                    Text="{Binding Result, Converter={StaticResource EnumDescriptionConverter}}"
                    Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Result}" Value="{x:Static core:AssemblyResult.Ok}">
                    <Setter TargetName="ResultText" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="{x:Static core:AssemblyResult.Ng}">
                    <Setter TargetName="ResultText" Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="PcbFasteningResult">
            <StackPanel Margin="0,4,12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Key, StringFormat='Bolt {0} · '}"/>
                    <TextBlock x:Name="Verdict" Text="NG" Foreground="{StaticResource AccentRedBrush}"/>
                    <TextBlock Margin="8,0,0,0" Text="{Binding Value.Torque, StringFormat='Torque {0:0.###}', TargetNullValue='Torque —'}"/>
                </StackPanel>
                <TextBlock Text="{Binding Value.Source, Converter={StaticResource EnumDescriptionConverter}}"
                    Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                <TextBlock Text="{Binding Value.Error}" Foreground="{StaticResource AccentRedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Value.Success}" Value="True">
                    <Setter TargetName="Verdict" Property="Text" Value="OK"/>
                    <Setter TargetName="Verdict" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="DoorSensorTemplate" DataType="{x:Type ui:DoorSensorDisplay}">
            <Border x:Name="DoorCard" Margin="4,0" Padding="10,7" CornerRadius="3"
                Background="{StaticResource ControlBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DoorState" Grid.Row="1" Text="UNKNOWN"
                        Foreground="{StaticResource TextMutedBrush}" FontSize="15" FontWeight="SemiBold"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Input.IsOn}" Value="True">
                    <Setter TargetName="DoorState" Property="Text" Value="CLOSED"/>
                    <Setter TargetName="DoorState" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Input.IsOn}" Value="False">
                    <Setter TargetName="DoorState" Property="Text" Value="OPEN"/>
                    <Setter TargetName="DoorState" Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                    <Setter TargetName="DoorCard" Property="Background" Value="{StaticResource AlarmStateBackgroundBrush}"/>
                    <Setter TargetName="DoorCard" Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="SideLaneStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value>
                        <sys:Boolean>False</sys:Boolean>
                    </Trigger.Value>
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SideCarriageStyle" TargetType="Border">
            <Setter Property="Height" Value="9"/>
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value>
                        <sys:Boolean>True</sys:Boolean>
                    </Trigger.Value>
                    <Setter Property="Background" Value="{StaticResource MapActiveBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SideAxisLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource EquipmentRoleLabelStyle}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
        <DataTemplate x:Key="ZAxisIconTemplate" DataType="{x:Type device:MotionStatus}">
            <Grid Height="62">
                <Border Height="3" Margin="18,5,18,0" VerticalAlignment="Top" Background="{StaticResource CardBorderBrush}"/>
                <Border Width="2" Height="51" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="{StaticResource DividerBrush}"/>
                <Border Height="3" Margin="12,56,12,0" VerticalAlignment="Top" Background="{StaticResource CardBorderBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18,8,18,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2" Margin="0,0,0,8" Padding="10,8" MaxWidth="1602" HorizontalAlignment="Stretch"
            Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DOORS" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding DoorSensors}" ItemTemplate="{StaticResource DoorSensorTemplate}"
                    ToolTip="Live door positions. UNKNOWN means feedback is unavailable.">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
        <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Border Background="{StaticResource EquipBgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="3"
            ClipToBounds="True">
            <Grid Width="1600">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid Width="1552" Margin="0,3" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="283"/>
                            <ColumnDefinition Width="283"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="408"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Tag="{Binding Units.PcbSupply}" Style="{StaticResource SideLaneStyle}">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Source={x:Static core:MotionGroup.PcbSupply},
                                                              Converter={StaticResource EnumDescriptionConverter}}"
                                        Style="{StaticResource SideAxisLabelStyle}"/>
                                    <TextBlock Visibility="{Binding SupplyPositionKnown, Converter={StaticResource BoolToVis}}"
                                        Text="{Binding Supply.Motion.Position.Z,
                                                              StringFormat='Z {0:F2} mm'}"
                                        Style="{StaticResource PrimaryStateTextStyle}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="155" Height="62">
                                    <ContentPresenter Content="{Binding Supply.Motion}"
                                        ContentTemplate="{StaticResource ZAxisIconTemplate}"/>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding SupplyPositionKnown, Converter={StaticResource BoolToVis}}"
                                        Width="42" Height="18">
                                        <Border Width="42"
                                            Tag="{Binding Supply.Motion.IsMoving}"
                                            Style="{StaticResource SideCarriageStyle}"/>
                                        <Border Width="3" Height="7" VerticalAlignment="Top" Margin="0,8,0,0"
                                            Background="{StaticResource TextMutedBrush}"/>
                                        <Border Width="26" Height="3" VerticalAlignment="Bottom"
                                            Background="{StaticResource MaterialPcbBrush}" CornerRadius="1"
                                            Visibility="{Binding PcbSupplyPcbSecured,
                                                                     Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Tag="{Binding Units.PcbPlacement}" Style="{StaticResource SideLaneStyle}">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Source={x:Static core:MotionGroup.PcbPlacementHandler},
                                                              Converter={StaticResource EnumDescriptionConverter}}"
                                        Style="{StaticResource SideAxisLabelStyle}"/>
                                    <TextBlock Visibility="{Binding PlacementPositionKnown, Converter={StaticResource BoolToVis}}"
                                        Text="{Binding Placement.Motion.Position.Z,
                                                              StringFormat='Z {0:F2} mm'}"
                                        Style="{StaticResource PrimaryStateTextStyle}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="155" Height="62">
                                    <ContentPresenter Content="{Binding Placement.Motion}"
                                        ContentTemplate="{StaticResource ZAxisIconTemplate}"/>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding PlacementPositionKnown, Converter={StaticResource BoolToVis}}"
                                        Width="42" Height="18">
                                        <Border Width="42"
                                            Tag="{Binding Placement.Motion.IsMoving}"
                                            Style="{StaticResource SideCarriageStyle}"/>
                                        <Border Width="7" Height="7" VerticalAlignment="Top" Margin="0,8,0,0"
                                            Background="{StaticResource TextMutedBrush}" CornerRadius="1"/>
                                        <Border Width="26" Height="3" VerticalAlignment="Bottom"
                                            Background="{StaticResource MaterialPcbBrush}" CornerRadius="1"
                                            Visibility="{Binding Placement.PcbSecured,
                                                                     Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Tag="{Binding Units.BoltFastening}" Style="{StaticResource SideLaneStyle}">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Source={x:Static core:MotionGroup.BoltFastening},
                                                              Converter={StaticResource EnumDescriptionConverter}}"
                                        Style="{StaticResource SideAxisLabelStyle}"/>
                                    <TextBlock Visibility="{Binding FasteningPositionKnown, Converter={StaticResource BoolToVis}}"
                                        Text="{Binding Fastening.Motion.Position.Z,
                                                              StringFormat='Z {0:F2} mm'}"
                                        Style="{StaticResource PrimaryStateTextStyle}"/>
                                </StackPanel>
                                <Grid Grid.Column="1" Width="240" Height="62">
                                    <ContentPresenter Content="{Binding Fastening.Motion}"
                                        ContentTemplate="{StaticResource ZAxisIconTemplate}"/>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding FasteningPositionKnown, Converter={StaticResource BoolToVis}}"
                                        Width="68" Height="18">
                                        <Border Width="68"
                                            Tag="{Binding Fastening.Motion.IsMoving}"
                                            Style="{StaticResource SideCarriageStyle}"/>
                                        <Border Width="3" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,8,0,0"
                                            Background="{StaticResource TextMutedBrush}"/>
                                        <Border Width="3" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,18,0"
                                            Background="{StaticResource TextMutedBrush}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Canvas Grid.Row="1" Width="1600" Height="{x:Static ui:MachinePlan.PlanHeight}" HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                    <ui:NgConveyorView Canvas.Left="{x:Static ui:MachinePlan.InspectionLeft}" Canvas.Top="0" Panel.ZIndex="-10"/>
                    <ui:ConveyorView Canvas.Left="{x:Static ui:MachinePlan.MainLeft}" Canvas.Top="{x:Static ui:MachinePlan.MainTop}"
                        Panel.ZIndex="0"/>
                    <ui:PcbPlacementView Canvas.Left="{x:Static ui:MachinePlan.MainLeft}" Canvas.Top="0" Panel.ZIndex="10"/>
                    <ui:BoltFasteningView Canvas.Left="{x:Static ui:MachinePlan.FasteningLeft}" Canvas.Top="0" Panel.ZIndex="10"/>
                    <ui:InspectionView Canvas.Left="{x:Static ui:MachinePlan.InspectionLeft}" Canvas.Top="0" Panel.ZIndex="10"/>
                </Canvas>
            </Grid>
        </Border>
        </Viewbox>
        <Border Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Padding="12" VerticalAlignment="Top"
            Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1" CornerRadius="3">
            <StackPanel>
                <TextBlock Text="Inspection Image" Style="{StaticResource TitleStyle}"/>
                <TextBlock Margin="0,4,0,10" Text="{Binding InspectionImageCaption, TargetNullValue='Waiting for inspection'}"
                    Foreground="{StaticResource TextSecondaryBrush}"/>
                <Border Height="240" Background="{StaticResource ControlBgBrush}">
                    <Image Source="{Binding InspectionImage}" Stretch="Uniform"/>
                </Border>
                <TextBlock Margin="0,8,0,0" Text="Last captured inspection image"
                    Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="12,8"
            Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1" CornerRadius="3">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="PCB History" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="New → Old" Margin="14,0,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Older" Margin="8,0,0,0" VerticalAlignment="Center"
                        Command="{Binding LoadOlderPcbsCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    <ListBox ItemsSource="{Binding PcbRecords}" SelectedItem="{Binding SelectedPcb, Mode=TwoWay}"
                        ItemTemplate="{StaticResource PcbHistoryCard}" ItemContainerStyle="{StaticResource FlatListItemStyle}"
                        Background="{StaticResource ControlBgBrush}" BorderThickness="0" Height="88"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </DockPanel>
                <TextBlock Text="{Binding PcbHistoryError}" Foreground="{StaticResource AccentRedBrush}" TextWrapping="Wrap"/>
                <Grid Margin="0,10,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPcb}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Close" Command="{Binding ClosePcbDetailsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBlock Text="{Binding SelectedPcb.Number, StringFormat='PCB {0}'}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedPcb.CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Margin="16,3,0,0"/>
                        <TextBlock Text="{Binding SelectedPcb.RecipeName, StringFormat='Recipe: {0}'}" Margin="16,3,0,0"/>
                        <TextBlock Text="{Binding SelectedPcb.HeatSink, Converter={StaticResource EnumDescriptionConverter}}" Margin="16,3,0,0"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <Grid TextBlock.Foreground="{StaticResource TextSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Data Matrix" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedPcb.PcbBarcodeResult, Converter={StaticResource EnumDescriptionConverter}}" Margin="0,6,0,4"/>
                                <TextBlock Text="{Binding SelectedPcb.PcbBarcode, TargetNullValue='—'}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Shooting · Head 2" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedPcb.FasteningResult, Converter={StaticResource EnumDescriptionConverter}, StringFormat='Fastening: {0}'}"
                                    Margin="0,4,0,4" Foreground="{StaticResource TextMutedBrush}"/>
                                <ItemsControl ItemsSource="{Binding SelectedPcb.PcbBoltResults}" ItemTemplate="{StaticResource PcbFasteningResult}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pickup · Head 1" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding SelectedPcb.PickupBoltResults}" ItemTemplate="{StaticResource PcbFasteningResult}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Inspection" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedPcb.InspectionResult, Converter={StaticResource EnumDescriptionConverter}}" Margin="0,4,0,4"/>
                                <ItemsControl ItemsSource="{Binding SelectedPcb.BoltPresenceResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <TextBlock Text="{Binding Key, StringFormat='Bolt {0} · '}"/>
                                                <TextBlock x:Name="Presence" Text="NG · Missing" Foreground="{StaticResource AccentRedBrush}"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Value}" Value="True">
                                                    <Setter TargetName="Presence" Property="Text" Value="OK · Present"/>
                                                    <Setter TargetName="Presence" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
