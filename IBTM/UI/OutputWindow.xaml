<Window x:Class="IBTM.UI.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:IBTM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ui:OutputWindow, IsDesignTimeCreatable=False}"
        Title="Digital Outputs"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Digital Outputs"
                       Style="{StaticResource TitleStyle}"/>
            <Button Content="Refresh"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,5"
                    Click="OnRefresh"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,4,0,18">
            <TextBlock Text="Amber = output ON · blue = input ON · paired numbers = ON / OFF channels"
                       Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
            <TextBlock Text="MANUAL · Direct I/O · No sequence, position or feedback checks · E-STOP remains active"
                       Foreground="{StaticResource AccentAmberBrush}"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SEARCH" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBox Margin="0,6,0,0"
                         ToolTip="Search by signal name or configured I/O number."
                         Text="{Binding Filter.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="UNIT" Style="{StaticResource SectionHeaderStyle}"/>
                <ComboBox Margin="0,6,0,0" ItemsSource="{Binding Filter.Areas}"
                          ItemTemplate="{x:Null}" DisplayMemberPath="Value"
                          SelectedItem="{Binding Filter.SelectedArea, Mode=TwoWay}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3"
              Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="NO. (ON/OFF)" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="1" Text="OUTPUT" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="2" Text="DO" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="3" Text="FEEDBACK INPUTS" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="4" Text="MATCH" Style="{StaticResource SectionHeaderStyle}"/>
        </Grid>

        <ListBox Grid.Row="4"
                 ItemsSource="{Binding Filter.FilteredRows}"
                 Style="{StaticResource IoListStyle}"
                 ItemContainerStyle="{StaticResource IoOutputListItemStyle}">
            <ListBox.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}"
                            HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
                <GroupStyle ContainerStyle="{StaticResource IoSectionGroupItemStyle}"
                            HeaderTemplate="{StaticResource IoSectionGroupHeaderTemplate}"/>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type ui:OutputWindowRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Io.Address}" Style="{StaticResource IoAddressStyle}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Io.Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap"
                                       Foreground="{StaticResource AccentAmberBrush}" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                        Text="{Binding Io.IsOn, Converter={StaticResource SignalTextConverter}}"
                                        Style="{StaticResource IoOutputStateStyle}"/>
                        <ItemsControl Grid.Column="3" Margin="0,0,12,0"
                                      ItemsSource="{Binding Io.Feedback}"
                                      ItemTemplate="{StaticResource IoSignalReadoutTemplate}"/>
                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Io.HasFeedback, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource OutputFeedbackTextStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="5" Command="{Binding ToggleCommand}"
                                ToolTip="Switch this output only. Paired ON/OFF channels remain mutually exclusive."
                                Style="{StaticResource OutputToggleButtonStyle}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Window>
