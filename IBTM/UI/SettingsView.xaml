<UserControl x:Class="IBTM.UI.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:SettingsViewModel, IsDesignTimeCreatable=False}"
    Background="{StaticResource AppBgBrush}">
    <UserControl.Resources>
        <ui:MillisecondsToSecondsConverter x:Key="MillisecondsToSecondsConverter"/>
        <Style x:Key="SettingFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingHelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="SettingSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleStyle}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource FieldComboBoxStyle}">
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style x:Key="HardwareListItem" TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItemStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="HardwareSignalText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <x:Array x:Key="HomeDirections" Type="{x:Type device:HomeDirection}">
            <x:Static Member="device:HomeDirection.Negative"/>
            <x:Static Member="device:HomeDirection.Positive"/>
        </x:Array>
        <x:Array x:Key="HomeSignals" Type="{x:Type device:HomeSignal}">
            <x:Static Member="device:HomeSignal.ControllerSetting"/>
            <x:Static Member="device:HomeSignal.HomeSensor"/>
            <x:Static Member="device:HomeSignal.NegativeLimit"/>
            <x:Static Member="device:HomeSignal.PositiveLimit"/>
        </x:Array>
        <DataTemplate x:Key="AxisMappingTemplate" DataType="{x:Type ui:HardwareMappingRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                    ToolTip="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}" Style="{StaticResource HardwareSignalText}"/>
                <TextBox Grid.Column="1" Text="{Binding Axis.Number, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" MinWidth="0"/>
                <TextBox Grid.Column="2" Text="{Binding Axis.MoveUnit, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="4,0"
                    MinWidth="0"/>
                <TextBox Grid.Column="3" Text="{Binding Axis.MovePulse, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="4,0"
                    MinWidth="0"/>
                <ComboBox Grid.Column="4" ItemsSource="{StaticResource HomeDirections}" SelectedItem="{Binding Axis.HomeDirection, Mode=TwoWay}"
                    Margin="4,0" MinWidth="0"/>
                <ComboBox Grid.Column="5" ItemsSource="{StaticResource HomeSignals}" SelectedItem="{Binding Axis.HomeSignal, Mode=TwoWay}"
                    Margin="4,0" MinWidth="0"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Command="{Binding SaveSettingsCommand}" MinWidth="140" HorizontalAlignment="Right">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Content" Value="Save Settings"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SaveSettingsCommand.IsRunning}" Value="True">
                                <Setter Property="Content" Value="Saving..."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Text="Settings" Style="{StaticResource TitleStyle}"/>
        </DockPanel>
        <TabControl Grid.Row="1" Style="{StaticResource SectionTabs}" ItemContainerStyle="{StaticResource SectionTab}">
            <TabItem Header="Operation &amp; safety">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="Enabled units" Style="{StaticResource SettingSectionTitle}"/>
                                    <TextBlock Text="Conveyor / PCB" Style="{StaticResource SettingFieldLabel}" Margin="0,0,0,6"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}" Content="Main conveyor"
                                        IsChecked="{Binding Settings.Units.MainConveyor}" VerticalAlignment="Center"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}" Content="PCB supply"
                                        IsChecked="{Binding Settings.Units.PcbSupply}" VerticalAlignment="Center"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}" Content="PCB placement"
                                        IsChecked="{Binding Settings.Units.PcbPlacement}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Bolt station" Style="{StaticResource SettingFieldLabel}" Margin="0,12,0,6"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}" Content="Bolt fastening"
                                        IsChecked="{Binding Settings.Units.BoltFastening}" VerticalAlignment="Center"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}" Content="Pickup feeder"
                                        IsChecked="{Binding Settings.Units.PickupBoltFeeder}" VerticalAlignment="Center"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}" Content="Shooting feeder"
                                        IsChecked="{Binding Settings.Units.ShootingBoltFeeder}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Inspection / NG" Style="{StaticResource SettingFieldLabel}" Margin="0,12,0,6"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}" Content="Inspection + NG transfer"
                                        IsChecked="{Binding Settings.Units.Inspection}" VerticalAlignment="Center"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}" Content="NG shuttle + conveyor"
                                        IsChecked="{Binding Settings.Units.NgConveyor}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="Language / 언어" Style="{StaticResource SettingSectionTitle}"/>
                                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Settings.Options.Language}"
                                        IsEnabled="{Binding IsSettingsEditAllowed}"/>
                                    <TextBlock Text="Save + restart" Style="{StaticResource SettingHelpText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="Interlocks &amp; reset input" Style="{StaticResource SettingSectionTitle}"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}" Content="Emergency stop"
                                        IsChecked="{Binding Settings.Options.UseEmergencyStop}" VerticalAlignment="Center"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}" Content="Door interlock"
                                        IsChecked="{Binding Settings.Options.UseDoorInterlock}" VerticalAlignment="Center"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}" Content="Air pressure interlock"
                                        IsChecked="{Binding Settings.Options.UseAirPressureInterlock}" VerticalAlignment="Center"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}" Content="Hardware reset button"
                                        IsChecked="{Binding Settings.Options.UseResetButton}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="Common feedback wait" Style="{StaticResource SettingSectionTitle}"/>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Cylinder / stop timeout (s)" Style="{StaticResource SettingFieldLabel}"
                                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.Options.TimeoutMilliseconds, Converter={StaticResource MillisecondsToSecondsConverter}, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Conveyors">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="Main conveyor" Style="{StaticResource SettingSectionTitle}"/>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Transfer timeout (s)" Style="{StaticResource SettingFieldLabel}" Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.Conveyor.TransferTimeoutSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="After arrival sensor (s)" Style="{StaticResource SettingFieldLabel}" Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.Conveyor.CarrierStopDelaySeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Rear Ready OFF extra run (s)" Style="{StaticResource SettingFieldLabel}"
                                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.Conveyor.RearSmemaOffDelaySeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="NG conveyor" Style="{StaticResource SettingSectionTitle}"/>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Carrier count for alarm" Style="{StaticResource SettingFieldLabel}" Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.NgConveyor.AlarmCarrierCount, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Eject run after S1 (s)" Style="{StaticResource SettingFieldLabel}" Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.NgConveyor.EjectRunSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Bolts &amp; feeders">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="Pickup feeder / head" Style="{StaticResource SettingSectionTitle}"/>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Feeder detection timeout (s)" Style="{StaticResource SettingFieldLabel}"
                                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.BoltFeeder.PickupTimeoutMilliseconds, Converter={StaticResource MillisecondsToSecondsConverter}, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pickup retries (0 = off)" Style="{StaticResource SettingFieldLabel}" Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.BoltFastening.PickupRetryCount, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="Fastening / dry run" Style="{StaticResource SettingSectionTitle}"/>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Fastening result timeout (s)" Style="{StaticResource SettingFieldLabel}"
                                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.Hantas.FasteningTimeoutMilliseconds, Converter={StaticResource MillisecondsToSecondsConverter}, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dry run motor duration (s)" Style="{StaticResource SettingFieldLabel}" Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.BoltFastening.DryRunMilliseconds, Converter={StaticResource MillisecondsToSecondsConverter}, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="Shooting feeder / tube" Style="{StaticResource SettingSectionTitle}"/>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Feeder detection timeout (s)" Style="{StaticResource SettingFieldLabel}"
                                            Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.BoltFeeder.ShootingTimeoutMilliseconds, Converter={StaticResource MillisecondsToSecondsConverter}, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="After bolt detection (s)" Style="{StaticResource SettingFieldLabel}" Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.BoltFeeder.ShootingRunOnMilliseconds, Converter={StaticResource MillisecondsToSecondsConverter}, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tube ON / OFF timeout (s)" Style="{StaticResource SettingFieldLabel}" Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.BoltFastening.ShootingDetectionTimeoutMilliseconds, Converter={StaticResource MillisecondsToSecondsConverter}, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tube detection → head arrival (s)" Style="{StaticResource SettingFieldLabel}" Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.BoltFastening.ShootingArrivalDelaySeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            VerticalAlignment="Center" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Motion">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1200"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Motion group" Style="{StaticResource SettingFieldLabel}" DockPanel.Dock="Left"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding MotionGroups}" SelectedItem="{Binding SelectedMotionGroup, Mode=TwoWay}"
                            VerticalAlignment="Center" Width="280" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Style="{StaticResource SettingCard}">
                                        <StackPanel>
                                            <TextBlock Text="Travel" Style="{StaticResource SettingSectionTitle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition>
                                                        <ColumnDefinition.Style>
                                                            <Style TargetType="ColumnDefinition">
                                                                <Setter Property="Width" Value="110"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CurrentMotionHasZ}" Value="False">
                                                                        <Setter Property="Width" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ColumnDefinition.Style>
                                                    </ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="X / Y" Style="{StaticResource SettingFieldLabel}" Grid.Column="1"
                                                    Margin="4,0,4,8"/>
                                                <TextBlock Text="Z" Style="{StaticResource SettingFieldLabel}" Grid.Column="2" Margin="4,0,4,8"
                                                    Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="Speed (mm/s)" Style="{StaticResource SettingFieldLabel}" Grid.Row="1"
                                                    Margin="0,0,12,8" VerticalAlignment="Center"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding CurrentMotionSettings.HorizontalSpeed, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                                    VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" Margin="4,0,4,8" MinWidth="0"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding CurrentMotionSettings.ZSpeed, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                                    VerticalAlignment="Center" Grid.Row="1" Grid.Column="2" Margin="4,0,4,8" MinWidth="0"
                                                    Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="Acceleration (s)" Style="{StaticResource SettingFieldLabel}" Grid.Row="2"
                                                    Margin="0,0,12,8" VerticalAlignment="Center"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding CurrentMotionSettings.AccelerationSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                                    VerticalAlignment="Center" Grid.Row="2" Grid.Column="1" Margin="4,0,4,8" MinWidth="0"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding CurrentMotionSettings.ZAccelerationSeconds, TargetNullValue='', UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                                    VerticalAlignment="Center" Grid.Row="2" Grid.Column="2" Margin="4,0,4,8" MinWidth="0"
                                                    Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="Deceleration (s)" Style="{StaticResource SettingFieldLabel}" Grid.Row="3"
                                                    Margin="0,0,12,8" VerticalAlignment="Center"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding CurrentMotionSettings.DecelerationSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                                    VerticalAlignment="Center" Grid.Row="3" Grid.Column="1" Margin="4,0,4,8" MinWidth="0"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding CurrentMotionSettings.ZDecelerationSeconds, TargetNullValue='', UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
                                                    VerticalAlignment="Center" Grid.Row="3" Grid.Column="2" Margin="4,0,4,8" MinWidth="0"
                                                    Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                            <TextBlock
                                                Text="Z accel / decel: blank = X / Y"
                                                Style="{StaticResource SettingHelpText}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource SettingCard}">
                                        <StackPanel>
                                            <TextBlock Text="Homing" Style="{StaticResource SettingSectionTitle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition>
                                                        <ColumnDefinition.Style>
                                                            <Style TargetType="ColumnDefinition">
                                                                <Setter Property="Width" Value="110"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CurrentMotionHasZ}" Value="False">
                                                                        <Setter Property="Width" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ColumnDefinition.Style>
                                                    </ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="X / Y" Style="{StaticResource SettingFieldLabel}" Grid.Column="1"
                                                    Margin="4,0,4,8"/>
                                                <TextBlock Text="Z" Style="{StaticResource SettingFieldLabel}" Grid.Column="2" Margin="4,0,4,8"
                                                    Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="Search speed (mm/s)" Style="{StaticResource SettingFieldLabel}" Grid.Row="1"
                                                    Margin="0,0,12,8" VerticalAlignment="Center"/>
                                                <TextBox
                                                    Text="{Binding CurrentMotionSettings.HorizontalHome.SearchSpeed, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True}"
