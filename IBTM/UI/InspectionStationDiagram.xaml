<UserControl x:Class="IBTM.UI.InspectionStationDiagram"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
    Width="{x:Static ui:MachineDiagramLayout.InspectionWidth}"
    Height="{x:Static ui:MachineDiagramLayout.PlanHeight}">
    <UserControl.Resources>
        <Style x:Key="BarcodeResultStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="{ui:Text 'NG · Not Read'}">
                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Canvas>
            <Grid Canvas.Left="{x:Static ui:MachineDiagramLayout.HeaderInset}" Canvas.Top="{x:Static ui:MachineDiagramLayout.HeaderTop}"
                Width="458">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource DiagramTitleStyle}" Text="{ui:Text 'Inspection Station'}"/>
                <TextBlock Style="{StaticResource TitleStyle}" x:Name="CycleTime" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                    Text="{Binding Inspection.Station.LastCycleSeconds, StringFormat='CT · {0:0.0} s',
                        TargetNullValue='CT · —', FallbackValue='CT · —'}"/>
            </Grid>
            <Border Canvas.Left="{x:Static ui:MachineDiagramLayout.HeaderInset}" Canvas.Top="{x:Static ui:MachineDiagramLayout.StatusTop}"
                Width="{x:Static ui:MachineDiagramLayout.PlateWidth}" Height="54"
                Tag="{Binding InspectionDisplayState}"
                Style="{StaticResource StationStateBadgeStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding InspectionStatus, Converter={StaticResource UiTextConverter}}"
                        Style="{StaticResource PrimaryStateTextStyle}" TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding InspectionStatus, Converter={StaticResource UiTextConverter}}"/>
                    <TextBlock Margin="0,3,0,0" FontSize="14" TextTrimming="CharacterEllipsis"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        ToolTip="{Binding InspectionActiveBarcode}">
                        <Run Text="{ui:Text 'ID · '}"/><Run Text="{Binding InspectionActiveBarcode, Mode=OneWay, TargetNullValue={ui:Text 'Not Read'}}"/>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InspectionActivePcb}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Canvas.Left="{x:Static ui:MachineDiagramLayout.HeaderInset}" Canvas.Top="{x:Static ui:MachineDiagramLayout.DetailTop}"
                Orientation="Horizontal">
                <TextBlock x:Name="ActivePcb" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding InspectionActivePcb, Converter={StaticResource UiTextConverter}}"/>
                <TextBlock FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding InspectionActiveOrdinal, StringFormat={ui:Text ' · Bolt {0}'}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InspectionActiveBolt}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Canvas.Left="{x:Static ui:MachineDiagramLayout.InspectionResultsLeft}"
                Canvas.Top="{x:Static ui:MachineDiagramLayout.InspectionResultsTop}" Width="214">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Units.Inspection}" Value="True"/>
                                        <Condition Binding="{Binding Inspection.Station.CarrierPresent}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid Margin="0,0,0,8"
                        Visibility="{Binding Signals.Inputs[InspectionHeatSink1Present].IsOn, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{ui:Text 'PCB 1'}" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" FontSize="14" TextTrimming="CharacterEllipsis"
                            Style="{StaticResource BarcodeResultStyle}"
                            Text="{Binding InspectionPcb1Barcode, TargetNullValue={ui:Text 'Not Read'}}"
                            ToolTip="{Binding InspectionPcb1Barcode}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"
                        Visibility="{Binding Signals.Inputs[InspectionHeatSink2Present].IsOn, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{ui:Text 'PCB 2'}" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" FontSize="14" TextTrimming="CharacterEllipsis"
                            Style="{StaticResource BarcodeResultStyle}"
                            Text="{Binding InspectionPcb2Barcode, TargetNullValue={ui:Text 'Not Read'}}"
                            ToolTip="{Binding InspectionPcb2Barcode}"/>
                    </Grid>
                </StackPanel>
                <TextBlock
                    Text="{Binding AlarmMessage}"
                    ToolTip="{Binding AlarmDetail}"
                    TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource AccentRedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InspectionDisplayState}" Value="{x:Static ui:StationDisplayState.IoAlarm}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Canvas Width="{StaticResource CarrierWidth}"
                Visibility="{Binding InspectionPositionKnown, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="20">
                <Canvas.RenderTransform>
                    <TranslateTransform X="{Binding NgPickupMapPosition.X, TargetNullValue=0, FallbackValue=0}"
                        Y="{Binding NgPickupMapPosition.Y, TargetNullValue=0, FallbackValue=0}"/>
                </Canvas.RenderTransform>
                <Grid Width="{StaticResource CarrierWidth}" Height="{StaticResource CarrierHeight}"
                    VerticalAlignment="Top">
                    <ui:CarrierView Visibility="{Binding Signals.Inputs[NgCarrierDetected].IsOn, Converter={StaticResource BoolToVis}}"
                        ToolTip="{ui:Text 'Carrier presence sensor · not grip feedback'}" Opacity="0.5"/>
                    <Grid Width="{x:Static ui:MachineDiagramLayout.NgPickerWidth}" HorizontalAlignment="Center" Opacity="0.6">
                        <Border Margin="-8,-6" Background="{StaticResource MachineGhostBrush}"
                            Tag="{Binding Inspection.Motion.IsMoving}"
                            Style="{StaticResource OverheadBodyStyle}"/>
                        <Border Tag="{Binding Inspection.Lift}" Style="{StaticResource DownFootprintStyle}"/>
                        <Border Tag="{Binding Inspection.Gripper}" Style="{StaticResource CarrierPickerTopJawStyle}"/>
                        <Border Tag="{Binding Inspection.Gripper}" Style="{StaticResource CarrierPickerBottomJawStyle}"/>
                    </Grid>
                    <TextBlock Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Text="{ui:Text 'NG Pick'}" Style="{StaticResource EquipmentRoleLabelStyle}"/>
                </Grid>
            </Canvas>
            <Canvas Visibility="{Binding InspectionPositionKnown, Converter={StaticResource BoolToVis}}" Panel.ZIndex="20">
                <Canvas.RenderTransform>
                    <TranslateTransform X="{Binding InspectionCameraMapPosition.X, TargetNullValue=0, FallbackValue=0}"
                        Y="{Binding InspectionCameraMapPosition.Y, TargetNullValue=0, FallbackValue=0}"/>
                </Canvas.RenderTransform>
                <StackPanel Canvas.Left="{x:Static ui:MachineDiagramLayout.CameraLeft}" Canvas.Top="{x:Static ui:MachineDiagramLayout.CameraTop}"
                    Orientation="Horizontal">
                    <Grid x:Name="InspectionCamera" Width="{x:Static ui:MachineDiagramLayout.CameraSize}" Height="{x:Static ui:MachineDiagramLayout.CameraSize}" Opacity="0.6">
                        <Ellipse Width="42" Height="42" Fill="{StaticResource MachineGhostBrush}" Stroke="{StaticResource AccentBlueBrush}"
                            StrokeThickness="2"/>
                        <Ellipse Width="16" Height="16" Fill="Transparent" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1"/>
                    </Grid>
                    <TextBlock Margin="8,0,0,0" Text="{ui:Text 'Camera'}" VerticalAlignment="Center" Style="{StaticResource EquipmentRoleLabelStyle}"/>
                </StackPanel>
            </Canvas>
        </Canvas>
    </Grid>
</UserControl>
