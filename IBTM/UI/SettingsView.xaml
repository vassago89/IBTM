<UserControl x:Class="IBTM.UI.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:SettingsViewModel, IsDesignTimeCreatable=False}"
    Background="{StaticResource AppBgBrush}">
    <UserControl.Resources>
        <Style x:Key="SettingFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingHelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="SettingSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleStyle}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource FieldComboBoxStyle}">
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,12,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HardwareListItem" TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItemStyle}">
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="HardwareSignalText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SettingTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True"/>
                            <ContentPresenter Grid.Row="1" Margin="0,8,0,0" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,-1,-1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Padding="18,8" Background="{StaticResource ControlBgBrush}"
                            BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="2">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource CardBgBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlFocusBorderBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ControlHoverBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HomeSettingsTemplate" DataType="{x:Type device:HomeSettings}">
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,8,10">
                    <TextBlock Text="Search (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                    <TextBox Text="{Binding SearchSpeed, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="After Detection (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                    <TextBox Text="{Binding DetectionSpeed, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,10">
                    <TextBlock Text="Approach (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                    <TextBox Text="{Binding ApproachSpeed, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Fine / Index (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                    <TextBox Text="{Binding FineSpeed, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Search Acceleration (s)" Style="{StaticResource SettingFieldLabel}"/>
                    <TextBox Text="{Binding SearchAccelerationSeconds, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Detection Acceleration (s)" Style="{StaticResource SettingFieldLabel}"/>
                    <TextBox Text="{Binding DetectionAccelerationSeconds, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
            </UniformGrid>
        </DataTemplate>
        <x:Array x:Key="HomeDirections" Type="{x:Type device:HomeDirection}">
            <x:Static Member="device:HomeDirection.Negative"/>
            <x:Static Member="device:HomeDirection.Positive"/>
        </x:Array>
        <DataTemplate x:Key="AxisMappingTemplate" DataType="{x:Type ui:HardwareMappingRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                    ToolTip="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                    Style="{StaticResource HardwareSignalText}"/>
                <TextBox Grid.Column="1" Text="{Binding Axis.Number, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"/>
                <TextBox Grid.Column="2"
                    Text="{Binding Axis.MoveUnit, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                    Margin="4,0"/>
                <TextBox Grid.Column="3"
                    Text="{Binding Axis.MovePulse, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="4,0"/>
                <ComboBox Grid.Column="4" ItemsSource="{StaticResource HomeDirections}"
                    SelectedItem="{Binding Axis.HomeDirection, Mode=TwoWay}" Margin="4,0"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Settings" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="{Binding DatabaseMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource SettingTabControl}" ItemContainerStyle="{StaticResource SettingTabItem}">
            <TabItem Header="Operation &amp; Timing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1480" Margin="0,0,8,0">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="PCB Results" Style="{StaticResource SettingSectionTitle}"/>
                                <TextBlock Text="Database folder" Style="{StaticResource SettingFieldLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"
                                        Command="{Binding BrowsePcbResultsFolderCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                        Text="{Binding PcbResultsDirectory, UpdateSourceTrigger=LostFocus}"/>
                                </DockPanel>
                                <TextBlock Text="Monthly files: PCB-yyyy-MM.db. PCB numbers continue across months. Save settings to keep this folder."
                                    Style="{StaticResource SettingHelpText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Main Conveyor" Style="{StaticResource SettingSectionTitle}"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Transfer Timeout (s)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.Conveyor.TransferTimeoutSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                                        <TextBlock Text="Wait limit for entry, destination HS2 and exit signals. Default: 5 s. Stops the belt and raises an alarm on timeout."
                                            Style="{StaticResource SettingHelpText}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Extra Run (s)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.Conveyor.CarrierStopDelaySeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                                        <TextBlock Text="Seating push after destination HS2 detection. Applies to S1, S2 and S3. Set to 0 to disable the extra run."
                                            Style="{StaticResource SettingHelpText}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,0">
                                        <TextBlock Text="Exit Clear Delay (s)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.Conveyor.ExitSensorClearDelaySeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
                                        <TextBlock Text="Filters carrier holes after exit detection. Starts at the first OFF signal; discharge completes when the delay has elapsed and the sensor is OFF."
                                            Style="{StaticResource SettingHelpText}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Waiting for station work or upstream/downstream readiness does not count toward the transfer timeout."
                                    Style="{StaticResource SettingHelpText}"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Common · Feedback / Stop" Style="{StaticResource SettingSectionTitle}"/>
                                        <TextBlock Text="Feedback / Stop Timeout (ms)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.Options.TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                            Width="180" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Maximum wait for cylinder position feedback or stop confirmation. 1,000 ms = 1 s."
                                            Style="{StaticResource SettingHelpText}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Bolt Supply · Detection Timeout" Style="{StaticResource SettingSectionTitle}"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Pickup Feeder (ms)" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.BoltFeeder.PickupTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Shooting Feeder (ms)" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.BoltFeeder.ShootingTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="Maximum wait for bolt detection at each feeder."
                                            Style="{StaticResource SettingHelpText}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Bolt Shooting · Arrival Timing" Style="{StaticResource SettingSectionTitle}"/>
                                        <TextBlock Text="Head Arrival Delay (s)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.BoltFastening.ShootingArrivalDelaySeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            Width="180" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Wait after tube passage before finishing the shot. Head vacuum ON is not required. Default: 3 s."
                                            Style="{StaticResource SettingHelpText}"/>
                                        <TextBlock Text="Tube Detection Timeout (ms)" Style="{StaticResource SettingFieldLabel}" Margin="0,10,0,0"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.BoltFastening.ShootingDetectionTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                            Width="180" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Applies separately to tube passage and tube clearance. Default: 3,000 ms."
                                            Style="{StaticResource SettingHelpText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Bolt Fastening · Timing" Style="{StaticResource SettingSectionTitle}"/>
                                        <TextBlock Text="Dry Run Motor Duration (ms)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.BoltFastening.DryRunMilliseconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            Width="180" HorizontalAlignment="Left"/>
                                        <TextBlock Text="Feeder OFF or Repeat: run after head DOWN, then STOP without waiting for a fastening result. Default: 2,000 ms."
                                            Style="{StaticResource SettingHelpText}"/>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedBoltDriver}" Value="{x:Static device:BoltDriver.Io}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="IO · FASTEN ON → OFF Timeout (ms)" Style="{StaticResource SettingFieldLabel}"/>
                                            <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                Text="{Binding Settings.IoBoltHardware.FasteningTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                Width="180" HorizontalAlignment="Left"/>
                                            <TextBlock Text="Maximum wait for the FASTEN ON → OFF cycle after START."
                                                Style="{StaticResource SettingHelpText}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedBoltDriver}" Value="{x:Static device:BoltDriver.Io}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="ADC · Fastening Result Timeout (ms)" Style="{StaticResource SettingFieldLabel}"/>
                                            <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                Text="{Binding Settings.Hantas.FasteningTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                                Width="180" HorizontalAlignment="Left"/>
                                            <TextBlock Text="Maximum wait for the controller result after fastening starts."
                                                Style="{StaticResource SettingHelpText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="NG Handling" Style="{StaticResource SettingSectionTitle}"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Carrier Count for Alarm" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.NgConveyor.AlarmCarrierCount, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Transfer Speed (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.NgCarrierTransfer.Speed, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Units &amp; Safety">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1480" Margin="0,0,8,0">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Enabled Units" Style="{StaticResource SettingSectionTitle}"/>
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="Conveyor / PCB" Style="{StaticResource SettingFieldLabel}" Margin="0,0,0,8"/>
                                        <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Content="Main Conveyor"
                                            IsChecked="{Binding Settings.Units.MainConveyor}"/>
                                        <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Content="PCB Supply"
                                            IsChecked="{Binding Settings.Units.PcbSupply}"/>
                                        <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Content="PCB Placement"
                                            IsChecked="{Binding Settings.Units.PcbPlacement}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Bolt Fastening" Style="{StaticResource SettingFieldLabel}" Margin="0,0,0,8"/>
                                        <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Content="Bolt Fastening"
                                            IsChecked="{Binding Settings.Units.BoltFastening}"/>
                                        <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Content="Pickup Feeder"
                                            IsChecked="{Binding Settings.Units.PickupBoltFeeder}"/>
                                        <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Content="Shooting Bolt Feeder"
                                            IsChecked="{Binding Settings.Units.ShootingBoltFeeder}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Inspection / NG" Style="{StaticResource SettingFieldLabel}" Margin="0,0,0,8"/>
                                        <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Content="Inspection"
                                            IsChecked="{Binding Settings.Units.Inspection}"/>
                                        <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Content="NG Carrier Transfer"
                                            IsChecked="{Binding Settings.Units.NgCarrierTransfer}"/>
                                        <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Content="NG Shuttle"
                                            IsChecked="{Binding Settings.Units.NgShuttle}"/>
                                        <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Content="NG Conveyor"
                                            IsChecked="{Binding Settings.Units.NgConveyor}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Interlocks &amp; Reset Input" Style="{StaticResource SettingSectionTitle}"/>
                                <UniformGrid Columns="2">
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                        Content="Emergency Stop"
                                        IsChecked="{Binding Settings.Options.UseEmergencyStop}"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                        Content="Hardware Reset Button"
                                        IsChecked="{Binding Settings.Options.UseResetButton}"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                        Content="Door Interlock"
                                        IsChecked="{Binding Settings.Options.UseDoorInterlock}"/>
                                    <CheckBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                        Content="Air Pressure Interlock"
                                        IsChecked="{Binding Settings.Options.UseAirPressureInterlock}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Motion">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1480" Margin="0,0,8,0">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Motion Group" Style="{StaticResource SettingFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding MotionGroups}"
                                    SelectedItem="{Binding SelectedMotionGroup, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Travel" Style="{StaticResource SettingSectionTitle}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="X / Y Speed (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding CurrentMotionSettings.HorizontalSpeed, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0"
                                        Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Z Speed (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding CurrentMotionSettings.ZSpeed, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Acceleration (s)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding CurrentMotionSettings.AccelerationSeconds, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Deceleration (s)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding CurrentMotionSettings.DecelerationSeconds, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <UniformGrid Rows="1">
                            <Border Style="{StaticResource SettingCard}" Margin="0,0,4,8">
                                <StackPanel>
                                    <TextBlock Text="X / Y Home" Style="{StaticResource SettingSectionTitle}"/>
                                    <Grid IsEnabled="{Binding IsSettingsEditAllowed}">
                                        <ContentPresenter Content="{Binding CurrentMotionSettings.HorizontalHome}"
                                            ContentTemplate="{StaticResource HomeSettingsTemplate}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingCard}" Margin="4,0,0,8"
                                Visibility="{Binding CurrentMotionHasZ, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Z Home" Style="{StaticResource SettingSectionTitle}"/>
                                    <Grid IsEnabled="{Binding IsSettingsEditAllowed}">
                                        <ContentPresenter Content="{Binding CurrentMotionSettings.ZHome}"
                                            ContentTemplate="{StaticResource HomeSettingsTemplate}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="Axes" Style="{StaticResource SettingSectionTitle}"/>
                                <Grid Margin="6,0,6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Axis" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBlock Grid.Column="1" Text="Axis Number" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBlock Grid.Column="2" Text="SDK Unit" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBlock Grid.Column="3" Text="SDK Pulse" Style="{StaticResource SettingFieldLabel}"/>
                                    <TextBlock Grid.Column="4" Text="HOME Direction" Style="{StaticResource SettingFieldLabel}"/>
                                </Grid>
                                <ListBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                    ItemsSource="{Binding CurrentAxisMappings}"
                                    Style="{StaticResource PanelListStyle}" ItemContainerStyle="{StaticResource HardwareListItem}"
                                    ItemTemplate="{StaticResource AxisMappingTemplate}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Device Connections">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1480" Margin="0,0,8,0">
                        <TextBlock Text="Virtual build" Visibility="{Binding IsVirtualDevelopment, Converter={StaticResource BoolToVis}}"
                            Foreground="{StaticResource AccentAmberBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Motion / I/O Driver" Style="{StaticResource SettingSectionTitle}"/>
                                        <ComboBox ItemsSource="{Binding ControlDrivers}"
                                            IsEnabled="{Binding IsDriverChangeAllowed}"
                                            SelectedItem="{Binding Settings.Drivers.Control, Mode=TwoWay}"/>
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                                            <Run Text="Active: "/><Run Text="{Binding ActiveControlDriver, Converter={StaticResource EnumDescriptionConverter}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="AJIN Controller" Style="{StaticResource SettingSectionTitle}"/>
                                        <StackPanel Width="180" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock Text="Interrupt Number" Style="{StaticResource SettingFieldLabel}"/>
                                            <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                Text="{Binding Settings.Ajin.InterruptNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="AlphaMotion · TMC-AE16DIOe" Style="{StaticResource SettingSectionTitle}"/>
                                        <TextBlock Text="Card No." Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            x:Name="AlphaMotionCardNumberInput"
                                            Text="{Binding Settings.AlphaMotion.ControllerNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Bolt Driver" Style="{StaticResource SettingSectionTitle}"/>
                                        <ComboBox ItemsSource="{Binding BoltDrivers}"
                                            IsEnabled="{Binding IsDriverChangeAllowed}"
                                            SelectedItem="{Binding SelectedBoltDriver, Mode=TwoWay}"/>
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                                            <Run Text="Active: "/><Run Text="{Binding ActiveBoltDriver, Converter={StaticResource EnumDescriptionConverter}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,0,12">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource SettingCard}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedBoltDriver}" Value="{x:Static device:BoltDriver.Io}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Bolt Controller · ADC Communication" Style="{StaticResource SettingSectionTitle}"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,4,10">
                                                <TextBlock Text="Pickup COM Port" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.Hantas.PickupPortName, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,10">
                                                <TextBlock Text="Shooting COM Port" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.Hantas.ShootingPortName, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,4,10">
                                                <TextBlock Text="Pickup Baud Rate" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.Hantas.PickupBaudRate, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,10">
                                                <TextBlock Text="Shooting Baud Rate" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.Hantas.ShootingBaudRate, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="Pickup Slave ID" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.Hantas.PickupSlaveAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="Shooting Slave ID" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.Hantas.ShootingSlaveAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,10,4,0">
                                                <TextBlock Text="Response Timeout (ms)" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.Hantas.ResponseTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Camera &amp; Lighting">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1480" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Inspection Camera" Style="{StaticResource SettingSectionTitle}"/>
                                        <TextBlock Text="Camera Driver" Style="{StaticResource SettingFieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding CameraDrivers}"
                                            IsEnabled="{Binding IsDriverChangeAllowed}"
                                            SelectedItem="{Binding Settings.Drivers.Camera, Mode=TwoWay}"/>
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,12">
                                            <Run Text="Active: "/><Run Text="{Binding ActiveCameraDriver, Converter={StaticResource EnumDescriptionConverter}, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="Device ID / Serial Number" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.InspectionCamera.DeviceId, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,0,0,10"/>
                                        <TextBlock Text="Frame Timeout (ms)" Style="{StaticResource SettingFieldLabel}"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.InspectionCamera.FrameTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12"
                                    Visibility="{Binding IsVirtualCamera, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Virtual Camera Image" Style="{StaticResource SettingSectionTitle}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding VirtualImageName, TargetNullValue=Generated image}"
                                                TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LoadVirtualImageCommand.IsRunning}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="Open Image" Command="{Binding LoadVirtualImageCommand}" Margin="0,0,8,0"/>
                                                <Button Content="Use Generated" Command="{Binding ClearVirtualImageCommand}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding VirtualImageError}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Lighting" Style="{StaticResource SettingSectionTitle}"/>
                                        <TextBlock Text="Light Driver" Style="{StaticResource SettingFieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding LightDrivers}"
                                            IsEnabled="{Binding IsDriverChangeAllowed}"
                                            SelectedItem="{Binding Settings.Drivers.Light, Mode=TwoWay}"/>
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,12">
                                            <Run Text="Active: "/><Run Text="{Binding ActiveLightDriver, Converter={StaticResource EnumDescriptionConverter}, Mode=OneWay}"/>
                                        </TextBlock>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Text="COM Port" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.Lighting.Connection, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="4,0,0,0">
                                                <TextBlock Text="Inspection Channel" Style="{StaticResource SettingFieldLabel}"/>
                                                <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                    Text="{Binding Settings.Lighting.InspectionChannel, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="Stabilization Delay (ms)" Style="{StaticResource SettingFieldLabel}" Margin="0,12,0,4"/>
                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            Text="{Binding Settings.Lighting.StabilizationDelayMilliseconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                            ToolTip="Delay from light ON to image capture. 0 disables the delay."/>
                                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0"
                                            Padding="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Light Test" Style="{StaticResource SettingSectionTitle}"/>
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"
                                                    TextWrapping="Wrap">
                                                    <Run Text="Active connection: "/><Run Text="{Binding ActiveLightConnection, Mode=OneWay}"/>
                                                </TextBlock>
                                                <UniformGrid Columns="2">
                                                    <StackPanel Margin="0,0,4,10">
                                                        <TextBlock Text="Test Channel (1–9)" Style="{StaticResource SettingFieldLabel}"/>
                                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                            Text="{Binding LightTestChannel, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,10">
                                                        <TextBlock Text="Brightness (0–255)" Style="{StaticResource SettingFieldLabel}"/>
                                                        <TextBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                                            Text="{Binding LightTestLevel, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="ON / Test"
                                                        Command="{Binding TestLightCommand}"
                                                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="100" Margin="0,0,8,0"/>
                                                    <Button Content="OFF"
                                                        Command="{Binding OffTestLightCommand}"
                                                        Style="{StaticResource DangerButtonStyle}" MinWidth="100"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding LightTestMessage}"
                                                    Foreground="{StaticResource AccentAmberBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="I/O Mapping">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1480" Margin="0,0,8,0">
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="I/O Channel Mapping" Style="{StaticResource SettingSectionTitle}" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <Grid Margin="6,0,6,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Input Signal" Style="{StaticResource SettingFieldLabel}"/>
                                            <TextBlock Grid.Column="1" Text="Channel (dec)" Style="{StaticResource SettingFieldLabel}"/>
                                        </Grid>
                                        <ListBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            ItemsSource="{Binding InputMappingView}"
                                            Height="420" Style="{StaticResource PanelListStyle}"
                                            ItemContainerStyle="{StaticResource HardwareListItem}">
                                            <ListBox.GroupStyle>
                                                <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}"
                                                    HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
                                                <GroupStyle ContainerStyle="{StaticResource IoSectionGroupItemStyle}"
                                                    HeaderTemplate="{StaticResource IoSectionGroupHeaderTemplate}"/>
                                            </ListBox.GroupStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ui:HardwareMappingRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Text="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                            ToolTip="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                            Style="{StaticResource HardwareSignalText}"/>
                                                        <TextBox Grid.Column="1"
                                                            Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                                            MinWidth="0" Padding="5,3" Margin="4,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <Grid Margin="6,0,6,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Output Signal" Style="{StaticResource SettingFieldLabel}"/>
                                            <TextBlock Grid.Column="1" Text="ON Ch. (dec)" Style="{StaticResource SettingFieldLabel}"/>
                                            <TextBlock Grid.Column="2" Text="OFF Ch. (dec)" Style="{StaticResource SettingFieldLabel}"/>
                                        </Grid>
                                        <ListBox IsEnabled="{Binding IsSettingsEditAllowed}"
                                            ItemsSource="{Binding OutputMappingView}"
                                            Height="420" Style="{StaticResource PanelListStyle}"
                                            ItemContainerStyle="{StaticResource HardwareListItem}">
                                            <ListBox.GroupStyle>
                                                <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}"
                                                    HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
                                                <GroupStyle ContainerStyle="{StaticResource IoSectionGroupItemStyle}"
                                                    HeaderTemplate="{StaticResource IoSectionGroupHeaderTemplate}"/>
                                            </ListBox.GroupStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type ui:HardwareMappingRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="58"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Text="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                            ToolTip="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                            Style="{StaticResource HardwareSignalText}"/>
                                                        <TextBox Grid.Column="1"
                                                            Text="{Binding Output.Number, UpdateSourceTrigger=PropertyChanged}"
                                                            MinWidth="0" Padding="5,3" Margin="4,0"/>
                                                        <TextBox Grid.Column="2"
                                                            Text="{Binding Output.OffNumber, UpdateSourceTrigger=PropertyChanged}"
                                                            ToolTip="Reverse output channel" MinWidth="0" Padding="5,3" Margin="4,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Click Save Settings to save changes. Restart after saving I/O address or device connection changes."
                    Style="{StaticResource SettingHelpText}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <Button
                    Grid.Column="1"
                    Command="{Binding SaveSettingsCommand}"
                    HorizontalAlignment="Right" MinWidth="132">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Content" Value="Save Settings"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveSettingsCommand.IsRunning}" Value="True">
                                    <Setter Property="Content" Value="Saving..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
