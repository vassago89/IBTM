<UserControl x:Class="IBTM.UI.ConveyorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             xmlns:conveyor="clr-namespace:IBTM.Conveyor;assembly=IBTM.Conveyor"
             xmlns:core="clr-namespace:IBTM.Core;assembly=IBTM.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
             Width="1552"
             Height="244">
    <UserControl.Resources>
        <Style x:Key="MainConveyorSensorStyle"
               TargetType="Ellipse"
               BasedOn="{StaticResource IoInputLedStyle}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Panel.ZIndex" Value="3"/>
        </Style>
        <Style x:Key="HeatSink1LandingTargetStyle"
               TargetType="Border"
               BasedOn="{StaticResource PcbLandingTargetStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PcbPlacementTargetHeatSink}"
                             Value="{x:Static core:HeatSinkSlot.HeatSink1}">
                    <Setter Property="Background"
                            Value="{StaticResource MapActiveBackgroundBrush}"/>
                    <Setter Property="BorderBrush"
                            Value="{StaticResource AccentBlueBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeatSink2LandingTargetStyle"
               TargetType="Border"
               BasedOn="{StaticResource PcbLandingTargetStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PcbPlacementTargetHeatSink}"
                             Value="{x:Static core:HeatSinkSlot.HeatSink2}">
                    <Setter Property="Background"
                            Value="{StaticResource MapActiveBackgroundBrush}"/>
                    <Setter Property="BorderBrush"
                            Value="{StaticResource AccentBlueBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="BoltTargetTemplate">
            <Border Tag="{Binding State}"
                    Style="{StaticResource BoltTargetStyle}"
                    ToolTip="{Binding Head, Converter={StaticResource EnumDescriptionConverter}}">
                <TextBlock Text="{Binding Number}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>
        <Style x:Key="BoltTargetItemsStyle" TargetType="ItemsControl">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Panel.ZIndex" Value="2"/>
            <Setter Property="Grid.ColumnSpan" Value="3"/>
            <Setter Property="ItemTemplate" Value="{StaticResource BoltTargetTemplate}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Canvas>
            <Grid Canvas.Left="0" Canvas.Top="197" Width="1552">
                <Border HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border"
                               BasedOn="{StaticResource StateBadgeStyle}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding MainConveyorState}"
                                                   Value="{x:Static conveyor:MainConveyorState.Idle}"/>
                                        <Condition Binding="{Binding MainConveyorEnabled}"
                                                   Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CONVEYOR"
                                   Margin="0,0,9,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource EquipmentRoleLabelStyle}"/>
                        <TextBlock FontSize="15" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource MapHintStyle}">
                                    <Setter Property="Text"
                                            Value="{Binding MainConveyorState,
                                                            Converter={StaticResource EnumDescriptionConverter}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MainConveyorEnabled}" Value="False">
                                            <Setter Property="Text" Value="Disabled"/>
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConveyorRunning}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource AccentBlueBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Canvas.Left="18" Canvas.Top="64"
                    Width="1516" Height="112"
                    Tag="{Binding ConveyorRunning}"
                    Style="{StaticResource ConveyorBedStyle}"/>

            <TextBlock Canvas.Left="194" Canvas.Top="42"
                        Width="{StaticResource BackupPlateWidth}"
                       Text="PLACE"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>
            <TextBlock Canvas.Left="604" Canvas.Top="42"
                        Width="{StaticResource BackupPlateWidth}"
                       Text="FASTEN"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>
            <TextBlock Canvas.Left="1014" Canvas.Top="42"
                        Width="{StaticResource BackupPlateWidth}"
                       Text="INSPECT"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>

            <Ellipse Canvas.Left="160" Canvas.Top="108"
                     Tag="{Binding MainConveyorEntryCarrierDetected}"
                     ToolTip="Entry carrier sensor"
                     Style="{StaticResource MainConveyorSensorStyle}"/>
            <TextBlock Canvas.Left="150" Canvas.Top="137"
                       Width="40"
                       Text="IN"
                       FontSize="10"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>

            <Border Canvas.Left="194" Canvas.Top="70"
                    Tag="{Binding PcbPlacementBackupPlateUp}"
                    ToolTip="Placement backup plate"
                    Style="{StaticResource BackupPlateVisualStyle}"/>
            <ContentControl Canvas.Left="202" Canvas.Top="78"
                            Panel.ZIndex="2"
                            Style="{StaticResource CarrierStyle}"
                            Visibility="{Binding PcbPlacementCarrierPresent,
                                                 Converter={StaticResource BoolToVis}}">
                <Grid Margin="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Tag="{Binding PcbPlacementHeatSink1Present}"
                            Style="{StaticResource HeatSinkPocketStyle}">
                        <Grid>
                            <TextBlock Text="HS1"
                                       Style="{StaticResource HeatSinkPocketLabelStyle}"/>
                            <Border Style="{StaticResource HeatSink1LandingTargetStyle}"
                                    Visibility="{Binding PcbPlacementHeatSink1Present,
                                                         Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Border Style="{StaticResource PcbSlotStyle}"/>
                                    <Border Style="{StaticResource PcbFootprintStyle}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding PcbPlacementHeatSink1Completed,
                                                                  Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2"
                            Tag="{Binding PcbPlacementHeatSink2Present}"
                            Style="{StaticResource HeatSinkPocketStyle}">
                        <Grid>
                            <TextBlock Text="HS2"
                                       Style="{StaticResource HeatSinkPocketLabelStyle}"/>
                            <Border Style="{StaticResource HeatSink2LandingTargetStyle}"
                                    Visibility="{Binding PcbPlacementHeatSink2Present,
                                                         Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Border Style="{StaticResource PcbSlotStyle}"/>
                                    <Border Style="{StaticResource PcbFootprintStyle}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding PcbPlacementHeatSink2Completed,
                                                                  Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ContentControl>
            <Border Canvas.Left="463" Canvas.Top="105"
                     Tag="{Binding PcbPlacementStopperUp}"
                     ToolTip="Placement stopper"
                     Style="{StaticResource StopperVisualStyle}"/>
            <Border Canvas.Left="604" Canvas.Top="70"
                    Tag="{Binding BoltFasteningBackupPlateUp}"
                    ToolTip="Bolt fastening backup plate"
                    Style="{StaticResource BackupPlateVisualStyle}"/>
            <ContentControl Canvas.Left="612" Canvas.Top="78"
                            Panel.ZIndex="2"
                            Style="{StaticResource CarrierStyle}"
                            Visibility="{Binding BoltFasteningCarrierPresent,
                                                 Converter={StaticResource BoolToVis}}">
                <Grid Margin="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Tag="{Binding BoltFasteningHeatSink1Present}"
                            Style="{StaticResource HeatSinkPocketStyle}">
                        <Grid>
                            <TextBlock Text="HS1"
                                       Style="{StaticResource HeatSinkPocketLabelStyle}"/>
                            <TextBlock Text="{Binding BoltFasteningHeatSink1Result,
                                                     Converter={StaticResource EnumDescriptionConverter}}"
                                       Tag="{Binding BoltFasteningHeatSink1Result}"
                                       Style="{StaticResource ResultTextStyle}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2"
                            Tag="{Binding BoltFasteningHeatSink2Present}"
                            Style="{StaticResource HeatSinkPocketStyle}">
                        <Grid>
                            <TextBlock Text="HS2"
                                       Style="{StaticResource HeatSinkPocketLabelStyle}"/>
                            <TextBlock Text="{Binding BoltFasteningHeatSink2Result,
                                                     Converter={StaticResource EnumDescriptionConverter}}"
                                       Tag="{Binding BoltFasteningHeatSink2Result}"
                                       Style="{StaticResource ResultTextStyle}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding BoltTargets}"
                                  Style="{StaticResource BoltTargetItemsStyle}"/>
                </Grid>
            </ContentControl>
            <Border Canvas.Left="873" Canvas.Top="105"
                     Tag="{Binding BoltFasteningStopperUp}"
                     ToolTip="Bolt fastening stopper"
                     Style="{StaticResource StopperVisualStyle}"/>
            <Border Canvas.Left="1014" Canvas.Top="70"
                    Tag="{Binding InspectionBackupPlateUp}"
                    ToolTip="Inspection backup plate"
                    Style="{StaticResource BackupPlateVisualStyle}"/>
            <ContentControl Canvas.Left="1022" Canvas.Top="78"
                            Panel.ZIndex="2"
                            Style="{StaticResource CarrierStyle}"
                            Visibility="{Binding InspectionCarrierPresent,
                                                 Converter={StaticResource BoolToVis}}">
                <Grid Margin="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Tag="{Binding InspectionHeatSink1Present}"
                            Style="{StaticResource HeatSinkPocketStyle}">
                        <Grid>
                            <TextBlock Text="HS1"
                                       Style="{StaticResource HeatSinkPocketLabelStyle}"/>
                            <TextBlock Text="{Binding InspectionHeatSink1Result,
                                                     Converter={StaticResource EnumDescriptionConverter}}"
                                       Tag="{Binding InspectionHeatSink1Result}"
                                       Style="{StaticResource ResultTextStyle}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2"
                            Tag="{Binding InspectionHeatSink2Present}"
                            Style="{StaticResource HeatSinkPocketStyle}">
                        <Grid>
                            <TextBlock Text="HS2"
                                       Style="{StaticResource HeatSinkPocketLabelStyle}"/>
                            <TextBlock Text="{Binding InspectionHeatSink2Result,
                                                     Converter={StaticResource EnumDescriptionConverter}}"
                                       Tag="{Binding InspectionHeatSink2Result}"
                                       Style="{StaticResource ResultTextStyle}"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding InspectionTargets}"
                                  Style="{StaticResource BoltTargetItemsStyle}"/>
                </Grid>
            </ContentControl>
            <Border Canvas.Left="1283" Canvas.Top="105"
                     Tag="{Binding InspectionStopperUp}"
                     ToolTip="Inspection stopper"
                     Style="{StaticResource StopperVisualStyle}"/>
            <Ellipse Canvas.Left="1368" Canvas.Top="108"
                     Tag="{Binding MainConveyorExitCarrierDetected}"
                     ToolTip="Exit carrier sensor"
                     Style="{StaticResource MainConveyorSensorStyle}"/>
            <TextBlock Canvas.Left="1358" Canvas.Top="137"
                       Width="40"
                       Text="OUT"
                       FontSize="10"
                       Style="{StaticResource EquipmentRoleLabelStyle}"/>
            <ContentControl Canvas.Left="407" Canvas.Top="78"
                            Panel.ZIndex="2"
                            Style="{StaticResource CarrierStyle}"
                            Visibility="{Binding CarrierBetweenPlacementAndBolt,
                                                 Converter={StaticResource BoolToVis}}">
                <TextBlock Text="CARRIER"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Style="{StaticResource EquipmentRoleLabelStyle}"/>
            </ContentControl>
            <ContentControl Canvas.Left="817" Canvas.Top="78"
                            Panel.ZIndex="2"
                            Style="{StaticResource CarrierStyle}"
                            Visibility="{Binding CarrierBetweenBoltAndInspection,
                                                 Converter={StaticResource BoolToVis}}">
                <TextBlock Text="CARRIER"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Style="{StaticResource EquipmentRoleLabelStyle}"/>
            </ContentControl>

        </Canvas>
    </Grid>
</UserControl>
