<Window x:Class="IBTM.UI.OutputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:IBTM.UI"
    xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:OutputViewModel, IsDesignTimeCreatable=False}"
    Title="{ui:Text 'Digital Outputs'}"
    Width="1120"
    Height="720"
    MinWidth="900"
    MinHeight="480"
    FontSize="14" WindowStartupLocation="CenterOwner"
    Background="{StaticResource AppBgBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{ui:Text 'Search signals'}" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBox Margin="0,6,0,0"
                    Text="{Binding Filter.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{ui:Text 'Unit'}" Style="{StaticResource SectionHeaderStyle}"/>
                <ComboBox Margin="0,6,0,0"
                    ItemsSource="{Binding Filter.Areas}"
                    ItemTemplate="{x:Null}" DisplayMemberPath="Value"
                    SelectedItem="{Binding Filter.SelectedArea, Mode=TwoWay}"/>
            </StackPanel>
            <Button Grid.Column="4" Style="{StaticResource CompactButtonStyle}" Content="{ui:Text 'Clear Messages'}"
                VerticalAlignment="Bottom" Command="{Binding ClearMessagesCommand}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="12,0,28,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{ui:Text 'Output'}" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="1" Text="{ui:Text 'State'}" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="2" Text="{ui:Text 'Feedback inputs'}" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="3" Text="{ui:Text 'Match'}" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="4" Text="{ui:Text 'Manual'}" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
        </Grid>

        <ListBox Grid.Row="2"
            ItemsSource="{Binding Filter.FilteredRows}"
            Style="{StaticResource IoListStyle}" ItemContainerStyle="{StaticResource IoListItemStyle}">
            <ListBox.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}" HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
                <GroupStyle ContainerStyle="{StaticResource IoSectionGroupItemStyle}"
                    HeaderTemplate="{StaticResource IoSectionGroupHeaderTemplate}"/>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type ui:OutputSignalRow}">
                    <Border Style="{StaticResource IoSignalRowStyle}" x:Name="Row">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Io.Signal, Converter={StaticResource UiTextConverter}}"
                                VerticalAlignment="Center" Margin="0,0,12,0"
                                Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1"
                                Tag="{Binding Io.IsOn}"
                                Text="{Binding Io.IsOn, Converter={StaticResource SignalTextConverter}}"
                                Style="{StaticResource IoOutputStateStyle}"/>
                            <ItemsControl Grid.Column="2" Margin="0,0,12,0"
                                ItemsSource="{Binding Io.Feedback}"
                                ItemTemplate="{StaticResource IoSignalReadoutTemplate}"/>
                            <TextBlock x:Name="FeedbackStatus" Grid.Column="3" Text="{ui:Text 'Not matched'}"
                                Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                Visibility="{Binding Io.HasFeedback, Converter={StaticResource BoolToVis}}"/>
                            <Button x:Name="ToggleOutput" Grid.Column="4" Content="ON"
                                Command="{Binding ToggleCommand}"
                                Style="{StaticResource IoToggleButtonStyle}"/>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding ActionMessage}"
                                Style="{StaticResource StatusMessageStyle}" FontSize="13"
                                Foreground="{StaticResource AccentAmberBrush}"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Io.IsOn}" Value="True">
                            <Setter TargetName="ToggleOutput" Property="Content" Value="OFF"/>
                            <Setter TargetName="Row" Property="Background" Value="#493B21"/>
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource IoOutputOnBrush}"/>
                            <Setter TargetName="Row" Property="BorderThickness" Value="3,0,0,1"/>
                            <Setter TargetName="Row" Property="Padding" Value="8,7,11,7"/>
                            <Setter TargetName="Row" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Io.Signal}" Value="{x:Static device:OutputIo.PcbPlacementHandlerRotate}">
                            <Setter TargetName="ToggleOutput" Property="Content" Value="{ui:Text 'Fixed OFF'}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Io.IsMatched}" Value="True">
                            <Setter TargetName="FeedbackStatus" Property="Text" Value="{ui:Text 'Matched'}"/>
                            <Setter TargetName="FeedbackStatus" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Io.IsOn}" Value="{x:Null}">
                            <Setter TargetName="FeedbackStatus" Property="Text" Value="{ui:Text 'Unknown'}"/>
                            <Setter TargetName="FeedbackStatus" Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Io.HasConflict}" Value="True">
                            <Setter TargetName="FeedbackStatus" Property="Text" Value="{ui:Text 'Input conflict'}"/>
                            <Setter TargetName="FeedbackStatus" Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
