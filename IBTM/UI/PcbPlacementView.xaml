<UserControl x:Class="IBTM.UI.PcbPlacementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:supply="clr-namespace:IBTM.PcbSupply;assembly=IBTM.PcbSupply"
    xmlns:ui="clr-namespace:IBTM.UI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
    Width="566"
    Height="650">
    <Grid>
        <Canvas>
            <TextBlock Canvas.Left="{x:Static ui:MachinePlan.HeaderInset}" Canvas.Top="{x:Static ui:MachinePlan.HeaderTop}"
                Text="PCB Supply / Placement" Style="{StaticResource TitleStyle}" FontWeight="Bold"/>

            <StackPanel Canvas.Left="{x:Static ui:MachinePlan.HeaderInset}" Canvas.Top="{x:Static ui:MachinePlan.StatusTop}"
                Orientation="Horizontal">
                <Border Tag="{Binding SupplyDisplayState}" Style="{StaticResource HandlerStateBadgeStyle}" Height="54" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="SUPPLY" Style="{StaticResource EquipmentRoleLabelStyle}" HorizontalAlignment="Left"/>
                        <TextBlock
                            Text="{Binding SupplyStatus,
                                                  Converter={StaticResource EnumDescriptionConverter}}"
                            Margin="0,4,0,0" Style="{StaticResource PrimaryStateTextStyle}" TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding SupplyStatus, Converter={StaticResource EnumDescriptionConverter}}"/>
                    </StackPanel>
                </Border>
                <Border Tag="{Binding PlacementDisplayState}" Style="{StaticResource HandlerStateBadgeStyle}" Height="54">
                    <StackPanel>
                        <TextBlock Text="PLACEMENT" Style="{StaticResource EquipmentRoleLabelStyle}" HorizontalAlignment="Left"/>
                        <TextBlock
                            Text="{Binding PlacementStatus,
                                                  Converter={StaticResource EnumDescriptionConverter}}"
                            Margin="0,4,0,0" Style="{StaticResource PrimaryStateTextStyle}" TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding PlacementStatus, Converter={StaticResource EnumDescriptionConverter}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Canvas.Left="54" Canvas.Top="142" Width="220" Text="PCB In" Style="{StaticResource EquipmentRoleLabelStyle}"/>

            <Border Canvas.Left="{x:Static ui:MachinePlan.SupplyRailLeft}" Canvas.Top="{x:Static ui:MachinePlan.SupplyRailTop}"
                Width="{x:Static ui:MachinePlan.SupplyRailWidth}" Height="{x:Static ui:MachinePlan.SupplyRailHeight}"
                Style="{StaticResource DeviceBodyStyle}">
                <Grid Width="{x:Static ui:MachinePlan.SupplyCarrierFrameWidth}" Height="{x:Static ui:MachinePlan.SupplyCarrierHeight}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="{x:Static ui:MachinePlan.SupplyCarrierWidth}" HorizontalAlignment="Left"
                        Tag="{Binding Supply.UpstreamCarrierAvailable}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                                <Setter Property="BorderThickness" Value="{x:Static ui:MachinePlan.CarrierBorderThickness}"/>
                                <Setter Property="CornerRadius" Value="2"/>
                                <Style.Triggers>
                                    <Trigger Property="Tag">
                                        <Trigger.Value>
                                            <sys:Boolean>True</sys:Boolean>
                                        </Trigger.Value>
                                        <Setter Property="Background" Value="{StaticResource MapActiveBackgroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource CarrierBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="{x:Static ui:MachinePlan.SupplyCarrierMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{x:Static ui:MachinePlan.SupplySlotGapWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource UnknownPcbFootprintStyle}"/>
                            <Border Grid.Column="2" Style="{StaticResource UnknownPcbFootprintStyle}"/>
                        </Grid>
                    </Border>
                    <Ellipse HorizontalAlignment="Right" VerticalAlignment="Center"
                        Tag="{Binding Supply.UpstreamCarrierAvailable}"
                        Style="{StaticResource PresenceLedStyle}"/>
                </Grid>
            </Border>
            <Grid Width="{x:Static ui:MachinePlan.SupplyWidth}" Height="{x:Static ui:MachinePlan.SupplyHeight}"
                Visibility="{Binding SupplyPositionKnown, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="20">
                <Grid.RenderTransform>
                    <TranslateTransform X="{Binding PcbSupplyMapPosition.X, TargetNullValue=0, FallbackValue=0}" Y="{Binding PcbSupplyMapPosition.Y, TargetNullValue=0, FallbackValue=0}"/>
                </Grid.RenderTransform>
                <Grid Width="92" Height="72" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Border Tag="{Binding Supply.Motion.IsMoving}" Style="{StaticResource OverheadBodyStyle}"/>
                    <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">
                        <Ellipse Width="12" Height="12" VerticalAlignment="Top" Fill="{StaticResource EquipBgBrush}"
                            Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"/>
                        <Border Width="2" Height="7" VerticalAlignment="Bottom" Background="{StaticResource TextMutedBrush}"/>
                    </Grid>
                    <Border Width="66" Height="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                        Background="{StaticResource MachineStructureBrush}" BorderBrush="{StaticResource TextMutedBrush}"
                        BorderThickness="1" CornerRadius="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[PcbSupplyGripperClosed].IsOn}" Value="True"/>
                                            <Condition Binding="{Binding Signals.Inputs[PcbSupplyGripperOpen].IsOn}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Grid Width="{StaticResource PcbWidth}" Height="{StaticResource PcbHeight}" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="0,0,0,1"
                        Visibility="{Binding Signals.Inputs[PcbSupplyPcbDetected].IsOn,
                                               Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource PcbFootprintStyle}"/>
                        <Border Width="22" Height="4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"
                            Background="{StaticResource MaterialIpmBrush}" CornerRadius="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Supply.Rotation}" Value="{x:Static supply:PcbSupplyRotationState.Rotated}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                    <Border Tag="{Binding Signals.Inputs[PcbSupplyIpmFixerForward].IsOn}" Style="{StaticResource LeftGripperJawStyle}"/>
                    <Border Tag="{Binding Signals.Inputs[PcbSupplyIpmFixerForward].IsOn}" Style="{StaticResource RightGripperJawStyle}"/>
                </Grid>
            </Grid>

            <Grid Width="{x:Static ui:MachinePlan.PlacementWidth}" Height="{x:Static ui:MachinePlan.PlacementHeight}"
                Visibility="{Binding PlacementPositionKnown, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="21">
                <Grid.RenderTransform>
                    <TranslateTransform X="{Binding PcbPlacementMapPosition.X, TargetNullValue=0, FallbackValue=0}"
                        Y="{Binding PcbPlacementMapPosition.Y, TargetNullValue=0, FallbackValue=0}"/>
                </Grid.RenderTransform>
                <Grid Width="92" Height="72" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="{x:Static ui:MachinePlan.PlacementToolMargin}">
                    <Border Tag="{Binding Placement.Motion.IsMoving}" Style="{StaticResource PlacementBodyStyle}"/>
                    <Grid Width="24" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">
                        <Border Width="20" Height="3" VerticalAlignment="Top" Background="{StaticResource TextMutedBrush}"
                            CornerRadius="1"/>
                        <Border Width="3" Height="10" VerticalAlignment="Center" Background="{StaticResource TextMutedBrush}"/>
                        <Ellipse Width="9" Height="5" VerticalAlignment="Bottom" Fill="{StaticResource EquipBgBrush}"
                            Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1"/>
                    </Grid>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0" Style="{StaticResource PcbFootprintStyle}"
                        Visibility="{Binding Signals.Inputs[PcbPlacementPcbDetected].IsOn,
                                                 Converter={StaticResource BoolToVis}}"/>
                    <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7"
                        Fill="{StaticResource EquipBgBrush}" Stroke="{StaticResource AccentGreenBrush}" StrokeThickness="2"
                        Panel.ZIndex="2"
                        Visibility="{Binding Signals.Inputs[PcbPlacementVacuumDetected].IsOn,
                                                  Converter={StaticResource BoolToVis}}"/>
                    <Border Width="24" Height="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                        Background="{StaticResource MaterialIpmBrush}" CornerRadius="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Signals.Inputs[PcbPlacementIpmDown].IsOn}" Value="True"/>
                                            <Condition Binding="{Binding Signals.Inputs[PcbPlacementIpmUp].IsOn}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Grid>

        </Canvas>
    </Grid>
</UserControl>
