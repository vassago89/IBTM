<Window x:Class="IBTM.UI.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:IBTM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ui:InputWindow, IsDesignTimeCreatable=False}"
        Title="Digital Inputs"
        Width="720"
        Height="720"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Digital Inputs"
                   Style="{StaticResource TitleStyle}"/>

        <TextBlock Grid.Row="1"
                   Margin="0,4,0,18">
            <TextBlock.Style>
                <Style TargetType="TextBlock"
                       BasedOn="{StaticResource PageSubtitleStyle}">
                    <Setter Property="Text" Value="Live input state"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                            <Setter Property="Text"
                                    Value="Virtual mode - Toggle inputs to simulate the machine"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="2"
              Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="INPUT" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="1"
                       Text="STATE"
                       Style="{StaticResource SectionHeaderStyle}"/>
        </Grid>

        <ListBox x:Name="InputList"
                 Grid.Row="3"
                 ItemsSource="{Binding Rows}"
                 Style="{StaticResource IoListStyle}"
                 ItemContainerStyle="{StaticResource IoListItemStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Input,
                                                 Converter={StaticResource EnumDescriptionConverter}}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <ContentControl Grid.Column="1"
                                        Tag="{Binding IsOn}"
                                        Style="{StaticResource IoInputStateStyle}"/>
                        <Button Grid.Column="2"
                                Content="Toggle"
                                Style="{StaticResource IoToggleButtonStyle}"
                                Visibility="{Binding DataContext.IsVirtual,
                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                     Converter={StaticResource BoolToVis}}"
                                Click="OnToggleInput"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
