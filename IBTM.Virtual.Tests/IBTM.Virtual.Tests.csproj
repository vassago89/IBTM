<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Long machine-flow simulations are opt-in; an explicit test filter overrides this. -->
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">Category!=MachineFlow</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IBTM\IBTM.csproj" />
    <ProjectReference Include="..\IBTM.BoltFastening\IBTM.BoltFastening.csproj" />
    <ProjectReference Include="..\IBTM.BoltFeeder\IBTM.BoltFeeder.csproj" />
    <ProjectReference Include="..\IBTM.Conveyor\IBTM.Conveyor.csproj" />
    <ProjectReference Include="..\IBTM.Hantas\IBTM.Hantas.csproj" />
    <ProjectReference Include="..\IBTM.Hik\IBTM.Hik.csproj" />
    <ProjectReference Include="..\IBTM.Inspection\IBTM.Inspection.csproj" />
    <ProjectReference Include="..\IBTM.NgConveyor\IBTM.NgConveyor.csproj" />
    <ProjectReference Include="..\IBTM.PcbBuffer\IBTM.PcbBuffer.csproj" />
    <ProjectReference Include="..\IBTM.PcbPlacement\IBTM.PcbPlacement.csproj" />
    <ProjectReference Include="..\IBTM.PcbSupply\IBTM.PcbSupply.csproj" />
    <ProjectReference Include="..\IBTM.Virtual\IBTM.Virtual.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MvCameraControl.Net">
      <HintPath>..\IBTM.Hik\Vendor\MVS\MvCameraControl.Net.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
