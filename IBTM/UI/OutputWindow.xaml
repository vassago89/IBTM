<Window x:Class="IBTM.UI.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:IBTM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ui:OutputWindow, IsDesignTimeCreatable=False}"
        Title="Digital Outputs"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Digital Outputs"
                       Style="{StaticResource TitleStyle}"/>
            <Button Content="Refresh"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,5"
                    Click="OnRefresh"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,4,0,18">
            <TextBlock Text="Amber = output ON · blue = input ON · paired numbers = ON / OFF channels"
                       Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ControlStatus}" Foreground="{StaticResource AccentAmberBrush}"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ContentControl Grid.Row="2" Margin="0,0,0,14"
                        Content="{Binding Filter}" ContentTemplate="{StaticResource IoFilterTemplate}"
                        HorizontalContentAlignment="Stretch"/>

        <Grid Grid.Row="3"
              Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="NO. (ON/OFF)" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="1" Text="OUTPUT" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="2" Text="DO" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="3" Text="FEEDBACK INPUTS" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Grid.Column="4" Text="MATCH" Style="{StaticResource SectionHeaderStyle}"/>
        </Grid>

        <ListBox Grid.Row="4"
                 ItemsSource="{Binding Filter.FilteredRows}"
                 Style="{StaticResource IoListStyle}"
                 ItemContainerStyle="{StaticResource IoOutputListItemStyle}">
            <ListBox.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource IoGroupItemStyle}"
                            HeaderTemplate="{StaticResource IoGroupHeaderTemplate}"/>
                <GroupStyle ContainerStyle="{StaticResource IoSectionGroupItemStyle}"
                            HeaderTemplate="{StaticResource IoSectionGroupHeaderTemplate}"/>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Io.Address}" Style="{StaticResource IoAddressStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Io.Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                        <ContentControl Grid.Column="2"
                                        Tag="{Binding Io.IsOn}"
                                        Style="{StaticResource IoOutputStateStyle}"/>
                        <ItemsControl Grid.Column="3" Margin="0,0,12,0"
                                      ItemsSource="{Binding Io.Feedback}"
                                      ItemTemplate="{StaticResource IoSignalReadoutTemplate}"/>
                        <StackPanel Grid.Column="4"
                                    ToolTip="{Binding FeedbackError}"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Io.HasFeedback, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding FeedbackState,
                                                      Converter={StaticResource EnumDescriptionConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FeedbackState}"
                                                         Value="{x:Static ui:OutputFeedbackState.Matched}">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FeedbackState}"
                                                         Value="{x:Static ui:OutputFeedbackState.Conflict}">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource AccentRedBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FeedbackState}"
                                                         Value="{x:Static ui:OutputFeedbackState.Waiting}">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource AccentAmberBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FeedbackState}"
                                                         Value="{x:Static ui:OutputFeedbackState.Timeout}">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource AccentRedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="5"
                                Content="{Binding ToggleLabel}"
                                Style="{StaticResource IoToggleButtonStyle}"
                                ToolTip="{Binding ToggleHint}"
                                ToolTipService.ShowOnDisabled="True"
                                Command="{Binding ActionCommand}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Window>
