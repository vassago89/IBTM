<Window x:Class="IBTM.UI.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logs" Width="1100" Height="720" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBgBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="PauseBox" Content="Pause display" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" Click="OnCopy" Margin="0,0,8,0"/>
                <Button Content="Clear view" Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" Click="OnClear"/>
            </StackPanel>
            <TextBlock Text="Logs" Style="{StaticResource TitleStyle}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Grid.Row="1" Margin="0,8,0,16" Style="{StaticResource PageSubtitleStyle}"
                   Text="Newest messages first. Select text to copy. Pausing or clearing the view does not stop file logging." TextWrapping="Wrap"/>
        <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="12"/>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            <TextBox x:Name="FilePathBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     Foreground="{StaticResource TextSecondaryBrush}" Padding="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>
