<UserControl x:Class="IBTM.UI.StationTeachingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:StationTeachingViewModel, IsDesignTimeCreatable=False}"
             Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource AppBgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Station Teaching" Style="{StaticResource TitleStyle}" Margin="0,0,0,10"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="330" MaxWidth="420"/>
                <ColumnDefinition Width="10"/><ColumnDefinition Width="2*" MinWidth="280"/>
                <ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="270"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80" MaxHeight="260"/>
                        <RowDefinition Height="3*" MinHeight="270"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Teaching Unit" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding TeachingUnits}" SelectedItem="{Binding SelectedTeachingUnit}"/>
                        <TextBlock Text="{Binding ActiveMotionGroup, Converter={StaticResource EnumDescriptionConverter}, StringFormat=Axes · {0}}"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                        <ComboBox ItemsSource="{Binding HeatSinkSlots}" SelectedItem="{Binding SelectedPcb}" Margin="0,6,0,0"
                                  Visibility="{Binding BoltPointEditorVisible, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <ui:TeachingPointList Grid.Row="1" ItemsSource="{Binding FilteredPoints}" SelectedItem="{Binding SelectedPoint}"
                                          Background="{StaticResource EquipBgBrush}" BorderThickness="1" BorderBrush="{StaticResource DividerBrush}"
                                          ItemContainerStyle="{StaticResource FlatListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:TeachingPoint}">
                                <StackPanel Margin="4,4">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding PositionLabel}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ui:TeachingPointList>
                    <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding SelectedPoint.Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding HomeBlock, Converter={StaticResource EnumDescriptionConverter}}"
                                   Foreground="{StaticResource AccentAmberBrush}" TextWrapping="Wrap"/>
                        <ui:TeachingMotionView/>
                        <Button Content="Return from Pickup" Command="{Binding ReturnFromPickupCommand}" Margin="0,6,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Raise Z to Safe Z, then raise Head 1. XY and vacuum remain unchanged."
                                Visibility="{Binding BoltPresetEditorVisible, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="8"
                    Visibility="{Binding IsInspectionSelected, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TabControl SelectedIndex="{Binding SelectedCameraTab}">
                        <TabItem Header="Live / Inspect">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Command="{Binding ToggleLiveViewCommand}" Margin="0,0,6,6" MinWidth="70">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Content" Value="Live"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Inspector.IsLiveView}" Value="True">
                                                        <Setter Property="Content" Value="Stop Live"/>
                                                        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource EquipBgBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Move &amp; Inspect" Command="{Binding CaptureInspectionCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,6"/>
                                    <Button Content="Reinspect" Command="{Binding ReinspectImageCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                                    <Button Content="Collect Bolt Images" Command="{Binding CollectBoltImagesCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                                </WrapPanel>
                                <Border Grid.Row="1" Background="{StaticResource ImageBackgroundBrush}">
                                    <ui:ImageTeachingView SourceRegion="{Binding Preview.Region}" SourceOverlay="{Binding Preview.Overlay}">
                                        <ui:ImageTeachingView.Style>
                                            <Style TargetType="ui:ImageTeachingView">
                                                <Setter Property="Source" Value="{Binding Preview.Image}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Inspector.IsLiveView}" Value="True">
                                                        <Setter Property="Source" Value="{Binding LiveImage}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:ImageTeachingView.Style>
                                    </ui:ImageTeachingView>
                                </Border>
                                <TextBlock Grid.Row="2" Text="{Binding Preview.Result}" TextWrapping="Wrap"
                                           Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Carrier Map">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Content="Add Current Image" Command="{Binding CaptureCarrierImageCommand}" Margin="0,0,8,6"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="Capture one image here and add it to the map. Does not move any axis."/>
                                    <Button Content="Clear Map" Command="{Binding ClearCarrierImagesCommand}" Margin="0,0,8,6"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    <TextBlock Text="mm/px" VerticalAlignment="Center" Margin="0,0,4,6"/>
                                    <TextBox Text="{Binding MillimetersPerPixel, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,8,6"
                                             IsEnabled="{Binding CanEditInspectionRecipe}"/>
                                </WrapPanel>
                                <Grid Grid.Row="1" Background="{StaticResource ImageBackgroundBrush}">
                                    <ui:ImageTeachingView x:Name="ImageMap"
                                          Tiles="{Binding CarrierImages}"
                                          MillimetersPerPixel="{Binding MillimetersPerPixel}"
                                          Markers="{Binding ImageMarkers}"
                                          CameraFieldOfView="{Binding CameraFieldOfView}"
                                          CoordinateOrigin="{Binding ImageOrigin}"
                                          ClickCommand="{Binding TeachImagePointCommand}"
                                          RegionCommand="{Binding TeachImageRegionCommand}"
                                          Regions="{Binding TeachingRegions}"
                                          Cursor="Cross"
                                          ToolTip="Teach PCB 1 bounds, then click the matching upper-left corner on PCB 2. Bolts and barcode share one PCB pattern. Esc: cancel. Wheel: zoom. Right drag: pan."
                                          RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <TextBlock Text="Jog to each position, stop, then Add Current Image. Each image is saved to the map." TextWrapping="Wrap" Margin="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCarrierImages}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding HoverPositionText, ElementName=ImageMap}" Margin="8" Padding="6"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                                               Background="{StaticResource EquipBgBrush}" FontFamily="Consolas"/>
                                </Grid>
                                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                    <ComboBox ItemsSource="{Binding FasteningHeads}" SelectedItem="{Binding NewFasteningHead}" MinWidth="145" Margin="0,0,6,6"/>
                                    <Button Content="Add Bolt" Command="{Binding AddBoltPointCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                                    <Button Content="Remove Bolt" Command="{Binding RemoveBoltPointCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="FOV / ROI">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,8">
                                    <ComboBox ItemsSource="{Binding CarrierImages}" SelectedItem="{Binding SelectedFov}" MinWidth="120" Margin="0,0,12,6">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ui:CarrierImageTileView}">
                                                <TextBlock Text="{Binding Number, StringFormat=FOV {0}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Resolution (mm/px)" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <TextBox Text="{Binding MillimetersPerPixel, UpdateSourceTrigger=LostFocus}" Width="80" Margin="0,0,8,6"
                                             IsEnabled="{Binding CanEditInspectionRecipe}"/>
                                    <Button Content="Apply ROI Center" Command="{Binding TeachFovRegionCommand}" CommandParameter="{Binding FovRegion}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6"
                                            ToolTip="Recalculate the selected bolt from this ROI using the entered resolution, then save."/>
                                </WrapPanel>
                                <ui:ImageTeachingView Grid.Row="1" Source="{Binding SelectedFov.Image}"
                                                      SourceRegion="{Binding FovRegion}" RegionCommand="{Binding TeachFovRegionCommand}"
                                                      Cursor="Cross" ToolTip="Drag one ROI. Drawing again replaces it. Capture XY does not change. Esc cancels."/>
                                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding SelectedPoint.Name, StringFormat=Draw ROI for · {0}}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding FovRoiLabel}" TextWrapping="Wrap"/>
                                    <TextBlock Text="ROI center sets the bolt coordinate. Inspection returns to the original capture XY." TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="Capture XY · "/><Run Text="{Binding SelectedFov.Center.X, StringFormat={}{0:F3}}"/>
                                        <Run Text=", "/><Run Text="{Binding SelectedFov.Center.Y, StringFormat={}{0:F3}}"/>
                                        <Run Text=" mm · ROI saves automatically"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Camera Settings">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="4">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Camera / Inspection" Style="{StaticResource PanelTitleStyle}" Margin="0,12,0,0"/>
                                    <Grid Margin="0,12,0,0" IsEnabled="{Binding CanEditInspectionRecipe}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0.7*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Margin" Value="0,0,8,8"/>
                            </Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>
                        </Grid.Resources>
                        <TextBlock Text="Draw one ROI per image in FOV / ROI." Grid.Row="0" Grid.ColumnSpan="2"/>
                        <TextBlock Text="Minimum Mask (%)" Grid.Row="1"/>
                        <TextBox x:Name="InspectionMaskRatioInput" Grid.Row="1" Grid.Column="1"
                                 IsEnabled="{Binding Preview.IsBolt}"
                                 Text="{Binding Preview.MinimumMaskPercent, StringFormat={}{0:G6}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                 ToolTip="Required percentage of ROI pixels. Applies immediately without another camera capture."/>
                        <TextBlock Text="Exposure (us)" Grid.Row="2"/>
                        <TextBox x:Name="InspectionExposureInput" Grid.Row="2" Grid.Column="1"
                                 Text="{Binding InspectionRecipe.ExposureMicroseconds, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Applies on the next capture or live preview start."/>
                        <TextBlock Text="Gain" Grid.Row="3"/>
                        <TextBox x:Name="InspectionGainInput" Grid.Row="3" Grid.Column="1"
                                 Text="{Binding InspectionRecipe.Gain, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Light Level" Grid.Row="4"/>
                        <TextBox x:Name="InspectionLightInput" Grid.Row="4" Grid.Column="1"
                                 Text="{Binding InspectionRecipe.LightLevel, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="0 to 255. Applies on the next capture or live preview start."/>
                    </Grid>
                                    <TextBlock Text="Exposure, gain and light apply on the next capture or Live start. Save Recipe to keep changes."
                                               TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                    <TextBlock Grid.Row="1" Text="{Binding CameraError}" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentRedBrush}" Margin="4"/>
                </Grid>
            </Border>
            <Border Padding="12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.ColumnSpan" Value="3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInspectionSelected}" Value="True">
                                <Setter Property="Grid.Column" Value="4"/><Setter Property="Grid.ColumnSpan" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IoStatusTemplate}"/>
                    <StackPanel Grid.Row="1" Visibility="{Binding BoltPresetEditorVisible, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{Binding CanEditInspectionRecipe}">
                        <TextBlock Text="Bolt presets" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,6,0,0"
                                    Visibility="{Binding BoltPresetEditorVisible,
                                                         Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="PCB" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding BoltRecipe.PcbPreset, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="11" Width="36" Margin="4,0,10,0"/>
                            <TextBlock Text="IPM 1" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding BoltRecipe.IpmSeatingPreset, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="11" Width="36" Margin="4,0,10,0"/>
                            <TextBlock Text="IPM 2" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding BoltRecipe.IpmFinalPreset, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="11" Width="36" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
