<UserControl x:Class="IBTM.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IBTM.Presentation.Converters"
             Background="{StaticResource AppBgBrush}"
             Loaded="OnLoaded" Unloaded="OnUnloaded">

    <UserControl.Resources>
        <conv:IntEqualsConverter x:Key="IntEquals"/>
        <Style x:Key="SettingFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SettingFieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource EquipBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="SettingSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Settings" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Machine setup and configuration"
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Center" Margin="0,0,8,0">
                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Manual Control" Style="{StaticResource SettingSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Zone" Style="{StaticResource SettingFieldLabel}"/>
                                <UniformGrid Columns="3">
                                    <RadioButton Content="1" GroupName="SettingsZone"
                                                 IsChecked="{Binding SelectedZone, Mode=TwoWay, Converter={StaticResource IntEquals}, ConverterParameter=1}"
                                                 Style="{StaticResource NavButtonStyle}"/>
                                    <RadioButton Content="2" GroupName="SettingsZone"
                                                 IsChecked="{Binding SelectedZone, Mode=TwoWay, Converter={StaticResource IntEquals}, ConverterParameter=2}"
                                                 Style="{StaticResource NavButtonStyle}"/>
                                    <RadioButton Content="3" GroupName="SettingsZone"
                                                 IsChecked="{Binding SelectedZone, Mode=TwoWay, Converter={StaticResource IntEquals}, ConverterParameter=3}"
                                                 Style="{StaticResource NavButtonStyle}"/>
                                </UniformGrid>
                                <Button Content="Laser" Command="{Binding ToggleLaserCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                <TextBlock Text="Position" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="X  "/><Run Text="{Binding CurrentX, StringFormat=F3}"/>
                                </TextBlock>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="Y  "/><Run Text="{Binding CurrentY, StringFormat=F3}"/>
                                </TextBlock>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="Z  "/><Run Text="{Binding CurrentZ, StringFormat=F3}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Jog" Style="{StaticResource SettingFieldLabel}"/>
                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="38"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="1" Content="Y+" Style="{StaticResource SecondaryButtonStyle}"
                                            PreviewMouseLeftButtonDown="JogYPlus_Down" PreviewMouseLeftButtonUp="Jog_Up"
                                            MouseLeave="Jog_Cancel" LostMouseCapture="Jog_Cancel"/>
                                    <Button Grid.Row="1" Grid.Column="0" Content="X-" Style="{StaticResource SecondaryButtonStyle}"
                                            PreviewMouseLeftButtonDown="JogXMinus_Down" PreviewMouseLeftButtonUp="Jog_Up"
                                            MouseLeave="Jog_Cancel" LostMouseCapture="Jog_Cancel"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="■" Command="{Binding JogStopCommand}"
                                            Style="{StaticResource DangerButtonStyle}" FontSize="14"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="X+" Style="{StaticResource SecondaryButtonStyle}"
                                            PreviewMouseLeftButtonDown="JogXPlus_Down" PreviewMouseLeftButtonUp="Jog_Up"
                                            MouseLeave="Jog_Cancel" LostMouseCapture="Jog_Cancel"/>
                                    <Button Grid.Row="2" Grid.Column="1" Content="Y-" Style="{StaticResource SecondaryButtonStyle}"
                                            PreviewMouseLeftButtonDown="JogYMinus_Down" PreviewMouseLeftButtonUp="Jog_Up"
                                            MouseLeave="Jog_Cancel" LostMouseCapture="Jog_Cancel"/>
                                    <Button Grid.Row="0" Grid.Column="4" Content="Z+" Style="{StaticResource SecondaryButtonStyle}"
                                            PreviewMouseLeftButtonDown="JogZPlus_Down" PreviewMouseLeftButtonUp="Jog_Up"
                                            MouseLeave="Jog_Cancel" LostMouseCapture="Jog_Cancel"/>
                                    <Button Grid.Row="2" Grid.Column="4" Content="Z-" Style="{StaticResource SecondaryButtonStyle}"
                                            PreviewMouseLeftButtonDown="JogZMinus_Down" PreviewMouseLeftButtonUp="Jog_Up"
                                            MouseLeave="Jog_Cancel" LostMouseCapture="Jog_Cancel"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton Content="1" GroupName="SettingsJogSpeed"
                                                 IsChecked="{Binding JogSpeedIndex, Mode=TwoWay, Converter={StaticResource IntEquals}, ConverterParameter=0}"
                                                 Style="{StaticResource NavButtonStyle}" MinWidth="42"/>
                                    <RadioButton Content="10" GroupName="SettingsJogSpeed"
                                                 IsChecked="{Binding JogSpeedIndex, Mode=TwoWay, Converter={StaticResource IntEquals}, ConverterParameter=1}"
                                                 Style="{StaticResource NavButtonStyle}" MinWidth="42"/>
                                    <RadioButton Content="50" GroupName="SettingsJogSpeed"
                                                 IsChecked="{Binding JogSpeedIndex, Mode=TwoWay, Converter={StaticResource IntEquals}, ConverterParameter=2}"
                                                 Style="{StaticResource NavButtonStyle}" MinWidth="42"/>
                                    <TextBlock Text="mm/s" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Zone Calibration" Style="{StaticResource SettingSectionTitle}"/>
                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="ZONE 1 REFERENCE" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="X "/><Run Text="{Binding Config.Calibration.Zone1Ref.X, StringFormat=F3}"/>
                                    <Run Text="   Y "/><Run Text="{Binding Config.Calibration.Zone1Ref.Y, StringFormat=F3}"/>
                                    <Run Text="   Z "/><Run Text="{Binding Config.Calibration.Zone1Ref.Z, StringFormat=F3}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <TextBlock Text="ZONE 2 REFERENCE" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="X "/><Run Text="{Binding Config.Calibration.Zone2Ref.X, StringFormat=F3}"/>
                                    <Run Text="   Y "/><Run Text="{Binding Config.Calibration.Zone2Ref.Y, StringFormat=F3}"/>
                                    <Run Text="   Z "/><Run Text="{Binding Config.Calibration.Zone2Ref.Z, StringFormat=F3}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0">
                                <TextBlock Text="ZONE 3 REFERENCE" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBlock FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="X "/><Run Text="{Binding Config.Calibration.Zone3Ref.X, StringFormat=F3}"/>
                                    <Run Text="   Y "/><Run Text="{Binding Config.Calibration.Zone3Ref.Y, StringFormat=F3}"/>
                                    <Run Text="   Z "/><Run Text="{Binding Config.Calibration.Zone3Ref.Z, StringFormat=F3}"/>
                                </TextBlock>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Record Selected Zone" Command="{Binding RecordRefCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Compute Offsets" Command="{Binding ComputeOffsetsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding OffsetResultText}" VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="Motion" Style="{StaticResource SettingSectionTitle}"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="XY Speed (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding CurrentMotionParams.SpeedXY, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Z Speed (mm/s)" Style="{StaticResource SettingFieldLabel}"/>
                                <TextBox Text="{Binding CurrentMotionParams.SpeedZ, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingFieldBox}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="3">
                    <Border Style="{StaticResource SettingCard}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Text="Bolt" Style="{StaticResource SettingSectionTitle}"/>
                            <TextBlock Text="Default Torque (Nm)" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Config.BoltFastening.DefaultTorqueNm, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Retry Count" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Config.BoltFastening.RetryCount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingCard}" Margin="6,0,6,12">
                        <StackPanel>
                            <TextBlock Text="Vision" Style="{StaticResource SettingSectionTitle}"/>
                            <TextBlock Text="Zone 2 Pixels/mm" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Config.BoltFastening.PixelsPerMm, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="Zone 3 Pixels/mm" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Config.Inspection.PixelsPerMm, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingCard}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Production" Style="{StaticResource SettingSectionTitle}"/>
                            <TextBlock Text="NG Stack Max" Style="{StaticResource SettingFieldLabel}"/>
                            <TextBox Text="{Binding Config.Inspection.NgStackMaxCount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingFieldBox}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="Save Configuration" Command="{Binding SaveConfigCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right" MinWidth="150"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
