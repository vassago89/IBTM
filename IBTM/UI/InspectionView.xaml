<UserControl x:Class="IBTM.UI.InspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:IBTM.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ui:OperationViewModel, IsDesignTimeCreatable=False}"
             Width="{x:Static ui:MachinePlan.InspectionWidth}"
             Height="{x:Static ui:MachinePlan.PlanHeight}">
    <Grid>
        <Canvas>
            <TextBlock Canvas.Left="{x:Static ui:MachinePlan.HeaderInset}" Canvas.Top="{x:Static ui:MachinePlan.HeaderTop}"
                       Text="Inspection / Sort"
                       Style="{StaticResource TitleStyle}"
                       FontWeight="Bold"/>
            <Border Canvas.Left="{x:Static ui:MachinePlan.HeaderInset}" Canvas.Top="{x:Static ui:MachinePlan.StatusTop}"
                    Tag="{Binding InspectionDisplayState}"
                    Style="{StaticResource StationStateBadgeStyle}">
                <TextBlock Text="{Binding InspectionDisplayState,
                                          Converter={StaticResource EnumDescriptionConverter}}"
                           Style="{StaticResource PrimaryStateTextStyle}"/>
            </Border>

            <TextBlock Canvas.Left="{x:Static ui:MachinePlan.HeaderInset}" Canvas.Top="{x:Static ui:MachinePlan.DetailTop}"
                       Width="390"
                       Text="{Binding InspectionState,
                                      Converter={StaticResource EnumDescriptionConverter}}"
                       TextAlignment="Left"
                       Style="{StaticResource MapLabelStyle}"
                       FontSize="14"
                       Visibility="{Binding InspectionStateVisible,
                                            Converter={StaticResource BoolToVis}}"/>

            <StackPanel Width="{StaticResource CarrierWidth}"
                        Visibility="{Binding InspectionPositionKnown, Converter={StaticResource BoolToVis}}"
                        Panel.ZIndex="20">
                <StackPanel.RenderTransform>
                    <TranslateTransform X="{Binding InspectionGantryMapLeft}"
                                        Y="{Binding InspectionGantryMapTop}"/>
                </StackPanel.RenderTransform>
                <Grid x:Name="CarrierPicker"
                      Width="{StaticResource CarrierWidth}"
                      Height="{StaticResource CarrierHeight}"
                      VerticalAlignment="Top">
                    <ui:CarrierView Visibility="{Binding NgCarrierDetected, Converter={StaticResource BoolToVis}}"/>
                    <Border Margin="-8,-6"
                            Background="{StaticResource MachineGhostBrush}"
                            Tag="{Binding InspectionGantry.Motion.IsMoving}"
                            Style="{StaticResource OverheadBodyStyle}"/>
                    <Border Tag="{Binding NgCarrierPickupDown}"
                            Style="{StaticResource DownFootprintStyle}"/>
                    <Border Tag="{Binding NgCarrierGripperClosed}"
                            Style="{StaticResource CarrierPickerLeftJawStyle}"/>
                    <Border Tag="{Binding NgCarrierGripperClosed}"
                            Style="{StaticResource CarrierPickerRightJawStyle}"/>
                    <TextBlock Margin="0,5,0,0"
                               VerticalAlignment="Top"
                               Text="NG Pick"
                               Style="{StaticResource EquipmentRoleLabelStyle}"/>
                </Grid>
                <Border Width="18" Height="{x:Static ui:MachinePlan.CameraGap}"
                        Tag="{Binding InspectionGantry.Motion.IsMoving}"
                        Style="{StaticResource OverheadBodyStyle}"/>
                <Grid x:Name="InspectionCamera"
                      Width="{x:Static ui:MachinePlan.CameraSize}"
                      Height="{x:Static ui:MachinePlan.CameraSize}">
                    <Ellipse Width="42" Height="42"
                             Fill="{StaticResource EquipBgBrush}"
                             Stroke="{StaticResource AccentBlueBrush}"
                             StrokeThickness="2"/>
                    <Ellipse Width="16" Height="16"
                             Fill="{StaticResource OpticGlassBrush}"
                             Stroke="{StaticResource TextMutedBrush}"
                             StrokeThickness="1"/>
                </Grid>
                <StackPanel Margin="0,2,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <TextBlock Text="Camera"
                               Style="{StaticResource EquipmentRoleLabelStyle}"/>
                    <TextBlock Margin="5,0,0,0"
                               Text="{Binding InspectionActiveBolt.Number}"
                               Style="{StaticResource ActiveToolNumberStyle}"/>
                </StackPanel>
            </StackPanel>

        </Canvas>
    </Grid>
</UserControl>
