<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:device="clr-namespace:IBTM.Device;assembly=IBTM.Device"
                    xmlns:ui="clr-namespace:IBTM.UI">

    <ui:SignalTextConverter x:Key="SignalTextConverter"/>
    <SolidColorBrush x:Key="IoInputOnBrush" Color="#39BAFF"/>
    <SolidColorBrush x:Key="IoOutputOnBrush" Color="#FFD166"/>

    <Style x:Key="IoAddressStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip" Value="Configured I/O channel number. Paired outputs show ON / OFF numbers."/>
    </Style>

    <Style x:Key="IoListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
    </Style>

    <DataTemplate x:Key="IoGroupHeaderTemplate" DataType="{x:Type CollectionViewGroup}">
        <Grid Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding ItemCount, StringFormat={}{0} items}"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <Style x:Key="IoGroupItemStyle" TargetType="GroupItem">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Border Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource ControlBgBrush}"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="4,4,0,0">
                                <ContentPresenter/>
                            </Border>
                            <ItemsPresenter Grid.Row="1"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="IoSectionGroupHeaderTemplate" DataType="{x:Type CollectionViewGroup}">
        <Border x:Name="Header"
                Padding="12,7"
                Background="{StaticResource EquipBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                <Setter TargetName="Header" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="IoSectionGroupItemStyle" TargetType="GroupItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter/>
                        <ItemsPresenter Grid.Row="1"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IoListItemStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource FlatListItemStyle}">
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="IoToggleButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="OutputToggleButtonStyle" TargetType="Button"
           BasedOn="{StaticResource IoToggleButtonStyle}">
        <Setter Property="Content" Value="ON"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Io.IsOn}" Value="True">
                <Setter Property="Content" Value="OFF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OutputControlButtonStyle" TargetType="Button"
           BasedOn="{StaticResource OutputToggleButtonStyle}">
        <Style.Triggers>
            <!-- An owned operation can be cancelled before ON feedback arrives. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMaintainedOutput}" Value="True"/>
                    <Condition Binding="{Binding ToggleCommand.IsRunning}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Content" Value="OFF"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OutputFeedbackTextStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="Not matched"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Io.IsMatched}" Value="True">
                <Setter Property="Text" Value="Matched"/>
                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Io.IsOn}" Value="{x:Null}">
                <Setter Property="Text" Value="Unknown"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Io.HasConflict}" Value="True">
                <Setter Property="Text" Value="Input conflict"/>
                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IoInputListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource IoListItemStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Io.IsOn}" Value="True">
                <Setter Property="Background" Value="#173B50"/>
                <Setter Property="BorderBrush" Value="{StaticResource IoInputOnBrush}"/>
                <Setter Property="BorderThickness" Value="3,0,0,1"/>
                <Setter Property="Padding" Value="8,7,11,7"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IoOutputListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource IoListItemStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Io.IsOn}" Value="True">
                <Setter Property="Background" Value="#493B21"/>
                <Setter Property="BorderBrush" Value="{StaticResource IoOutputOnBrush}"/>
                <Setter Property="BorderThickness" Value="3,0,0,1"/>
                <Setter Property="Padding" Value="8,7,11,7"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IoInputLedStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Fill" Value="{StaticResource EquipBgBrush}"/>
        <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="Tag">
                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                <Setter Property="Fill" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="Stroke" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="StrokeThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IoInputStateStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="Background" Value="#222C32"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="MinWidth" Value="68"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="ON">
                <Setter Property="Foreground" Value="#0D1B26"/>
                <Setter Property="Background" Value="{StaticResource IoInputOnBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IoOutputStateStyle" TargetType="TextBlock" BasedOn="{StaticResource IoInputStateStyle}">
        <Style.Triggers>
            <Trigger Property="Text" Value="ON">
                <Setter Property="Background" Value="{StaticResource IoOutputOnBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="IoSignalReadoutTemplate" DataType="{x:Type device:IoInputStatus}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Address}" Style="{StaticResource IoAddressStyle}" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="{Binding Signal, Converter={StaticResource EnumDescriptionConverter}}"
                       TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            <TextBlock Grid.Column="2" Text="{Binding IsOn, Converter={StaticResource SignalTextConverter}}"
                            Style="{StaticResource IoInputStateStyle}" FontSize="11"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="IoStatusTemplate" DataType="{x:Type ui:TeachingMotionViewModel}">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Related I/O" Style="{StaticResource PanelTitleStyle}"/>
                <TextBlock Text="DI = feedback · DO = command"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ui:IoGroupList ItemsSource="{Binding TeachingIoGroups}">
                    <ui:IoGroupList.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:TeachingIoGroup}">
                            <StackPanel Margin="0,0,10,18">
                                <TextBlock Text="{Binding Area, Converter={StaticResource EnumDescriptionConverter}}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Sensors}"
                                              ItemTemplate="{StaticResource IoSignalReadoutTemplate}"/>
                                <ItemsControl ItemsSource="{Binding Outputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:TeachingOutputRow}">
                                            <StackPanel Margin="0,8,0,0">
                                                <Grid Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="72"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Io.Signal, Converter={StaticResource EnumDescriptionConverter}}"
                                                               TextWrapping="Wrap" Margin="0,0,8,0" FontSize="12"
                                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Io.IsOn, Converter={StaticResource SignalTextConverter}}"
                                                                    Style="{StaticResource IoOutputStateStyle}" FontSize="11"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Io.Feedback}" Margin="12,0,0,0"
                                                              ItemTemplate="{StaticResource IoSignalReadoutTemplate}"/>
                                                <Grid x:Name="OutputControls" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                    <StackPanel x:Name="SwitchButtons" Orientation="Horizontal">
                                                        <Button Content="ON" Command="{Binding SetOutputOnCommand}" CommandParameter="{Binding Output}"
                                                                Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" MinWidth="48" Margin="0,0,6,0"/>
                                                        <Button Content="OFF" Command="{Binding SetOutputOffCommand}" CommandParameter="{Binding Output}"
                                                                Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" MinWidth="48"/>
                                                    </StackPanel>
                                                    <ui:HoldButton x:Name="HoldOutput" Content="HOLD" Visibility="Collapsed"
                                                                   CommandParameter="{Binding Output}"
                                                                   PressCommand="{Binding SetOutputOnCommand}"
                                                                   ReleaseCommand="{Binding SetOutputOnCancelCommand}"
                                                                   ToolTip="Hold to run; release to stop."
                                                                   Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" MinWidth="102"/>
                                                </Grid>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Output}" Value="{x:Null}">
                                                    <Setter TargetName="OutputControls" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Output.HoldToRun}" Value="True">
                                                    <Setter TargetName="SwitchButtons" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="HoldOutput" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ui:IoGroupList.ItemTemplate>
                </ui:IoGroupList>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
